		<defaultValueExpression><![CDATA["select pr.* ,att.codice_attivita as cod_att, att.descrizione as modello_di_progetto from entrasp.progetti pr join entrasp.attivita att on pr.codice_azienda=att.codice_azienda and pr.codice_attivita=att.codice_attivita where pr.codice_azienda='DEMO'"]]></defaultValueExpression>
