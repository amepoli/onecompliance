	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select tn.id_testo_normativo as tn_idtn, tn.descrizione as tn_descr, an.codice_articolo_normativo as an_codartnorm, an.rubrica as an_rub,an.id_testo_normativo as an_idtn, r.codice as r_cod, r.titolo as r_tit, r.descrizione as r_descr, entrasp.cpl_soglie_descrizione(r.codice_azienda,'T',r.intensita_totale_pre) as int_tot_ante, entrasp.cpl_soglie_descrizione(r.codice_azienda,'T',r.intensita_totale_post) as int_tot_post from entrasp.testi_normativi tn join entrasp.articoli_normativi an on  tn.id_testo_normativo = an.id_testo_normativo right join entrasp.rischi_articoli_normativi ran on an.id_testo_normativo = ran.id_testo_normativo and an.codice_articolo_normativo = ran.codice_articolo_normativo right join entrasp.rischi r on r.codice_azienda = ran.codice_azienda and r.codice_rischio = ran.codice_rischio where r.codice_azienda='DEMO'"]]></defaultValueExpression>
	</parameter>
	<parameter name="codice_azienda" class="java.lang.String">
