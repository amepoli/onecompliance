	</parameter>
	<queryString>
		<![CDATA[select snd.id_sondaggio,  mtrr.codice_azienda, mtrr.prog_riga, mtrr.descrizione, mtrr.pct_da, ss.somministrazione_completata, ss.giudizio, ss.object_description, 
round(ss.ris_percentuale,2) as ris_percentuale,
case when mtrr.colore='darkviolet' then '#800080' 
     when mtrr.colore='yellow' then '#FFCC00' 
     when mtrr.colore='orange' then '#FF6600'
     else coalesce(mtrr.colore,'grey')
end as codice_colore, case when ss.somministrazione_completata='Completo' then 'green' else 'yellow' end as codice_colore_completo

from entrasp.sondaggi_somministrati ss
inner join entrasp.sondaggi snd on ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio
inner join entrasp.modelli_test_vr mtvr on snd.id_modello_test_vr=mtvr.id_modello_test_vr and snd.id_modello_test=mtvr.id_modello_test and snd.codice_azienda=mtvr.codice_azienda
left join entrasp.modelli_test_risultati mtr on mtvr.codice_azienda=mtr.codice_azienda and mtvr.id_risultato=mtr.id_risultato
left join entrasp.modelli_test_risultati_righe mtrr on mtr.codice_azienda=mtrr.codice_azienda and mtr.id_risultato=mtrr.id_risultato
where mtrr.pct_da=ss.pct_da and snd.codice_azienda= $P{codice_azienda} and snd.id_sondaggio=$P{id_sondaggio}]]>
	</queryString>
