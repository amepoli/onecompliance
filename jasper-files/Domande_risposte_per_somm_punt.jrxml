	<parameter name="REPORTS_MAP" class="java.util.Map" isForPrompting="false"/>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["UNIFACTOR"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_sondaggio" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[new BigDecimal(454)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT rp.id_risposta_prev,
							sddr.ordinamento_sezione,
							sddr.object_description,
							sddr.descrizione_sez,
							sddr.descrizione,
							sddr.note,
							round(sddr.peso * sddr.punteggio / 100, 2)::varchar || ' su ' || sddr.punteggio::varchar AS giudizio_domanda,
							rp.risposta AS rp_risposta,
							sddr.risposta AS r_risposta,
							entrasp.note_risposta(sddr.codice_azienda, sddr.id_sondaggio, sddr.id_somministrazione, sddr.id_modello_test, sddr.id_modello_test_vr, sddr.id_domanda) AS note_risposta,
							sddr.ordinamento,
							sddr.id_sezione,
							length(replace(coalesce(sddr.note, 'Nessuna'::text),' '::text,' '::text)) AS LEN,
							(
								SELECT CASE WHEN count(*) > 0 THEN TRUE
																				ELSE FALSE
																					END
										FROM entrasp.risposte
									WHERE codice_azienda=sddr.codice_azienda
											AND id_sondaggio=sddr.id_sondaggio
											AND id_somministrazione=sddr.id_somministrazione
											AND id_risposta_prev=rp.id_risposta_prev
							) AS CHECKED,
							sddr.id_sondaggio,
							sddr.id_somministrazione,
							sddr.colore,
							sddr.id_domanda
		FROM entrasp.risposte_previste rp
		LEFT JOIN entrasp.select_domande_delle_risposte sddr
				ON rp.codice_azienda = sddr.codice_azienda
			AND rp.id_modello_test = sddr.id_modello_test
			AND rp.id_modello_test_vr = sddr.id_modello_test_vr
			AND rp.id_domanda = sddr.id_domanda
	WHERE sddr.codice_azienda = $P{codice_azienda}
			AND sddr.id_sondaggio = $P{id_sondaggio}
			AND entrasp.domanda_active(sddr.codice_azienda, sddr.id_modello_test, sddr.id_modello_test_vr, sddr.id_domanda, sddr.id_somministrazione) = 1
	GROUP BY rp.id_risposta_prev,
										sddr.ordinamento_sezione,
										sddr.object_description,
										sddr.descrizione_sez,
										sddr.descrizione,
										sddr.note,
										round(sddr.peso * sddr.punteggio / 100, 2)::varchar || ' su ' || sddr.punteggio::varchar,
										rp.risposta,
										sddr.risposta,
										entrasp.note_risposta(sddr.codice_azienda, sddr.id_sondaggio, sddr.id_somministrazione, sddr.id_modello_test, sddr.id_modello_test_vr, sddr.id_domanda),
										sddr.ordinamento,
										sddr.id_sezione,
										rp.codice_azienda,
										rp.id_domanda,
										rp.id_modello_test,
										rp.id_modello_test_vr,
										sddr.id_sondaggio,
										sddr.id_somministrazione,
										sddr.codice_azienda,
										sddr.colore,
										sddr.id_domanda
	ORDER BY sddr.codice_azienda,
										sddr.id_sondaggio,
										sddr.id_somministrazione,
										sddr.ordinamento_sezione,
										sddr.ordinamento,
										rp.ordinamento;]]>
	</queryString>
