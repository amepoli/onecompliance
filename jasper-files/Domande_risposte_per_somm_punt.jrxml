	<queryString>
		<![CDATA[SELECT ds.id_sezione,ds.ordinamento,d.note as note_domanda,d.ordinamento as domanda_ord, s.codice_azienda,s.id_modello_test, s.id_modello_test_vr, mtst.codice AS codice_modello_test, (select case when r.punteggio=0 then '#C0C0C0' else coalesce(codice_colore,'grey') end as codice_colore from entrasp.modelli_test_risultati_righe_da_punteggio_ottenuto(r.codice_azienda, mt.id_risultato, r.peso)),mtst.descrizione AS modello_test, s.id_sondaggio, s.data_esecuzione, ss.id_somministrazione, ss.object_name, ss.object_key, ss.object_description AS oggetto, ss.note, ds.descrizione AS descrizione_sezione, d.id_domanda, d.descrizione AS domanda, COALESCE(r.id_risposta, 0::numeric) AS idrisposta, COALESCE(r.id_risposta_prev, 0::numeric) AS idrispostaprev, COALESCE(rp.id_risposta_prev, 0::numeric) AS rp_idrispostaprev, CASE WHEN r.id_risposta_prev=rp.id_risposta_prev THEN true else false END as checked,rp.risposta as rp_risposta, r.risposta as r_risposta, replace(COALESCE(rp.risposta, r.risposta), ' '::text, ' '::text) AS descrizione_risposta,entrasp.note_risposta(d.codice_azienda, ss.id_sondaggio, ss.id_somministrazione, s.id_modello_test, d.id_modello_test_vr, d.id_domanda) AS note_risposta,length(replace(COALESCE(r.note, 'Nessuna'::text), ' '::text, ' '::text)) as len, COALESCE(d.punteggio, ds.punteggio_domande_default, mt.punteggio_domande_default) AS punteggio, COALESCE(r.peso, ds.peso_risposte_default, mt.peso_risposte_default) AS peso, COALESCE(r.punteggio_risposta, 0::numeric) AS punt_risposta,  COALESCE(prg.codice_progetto, '000'::character varying) AS cod_progetto, replace(prg.titolo::text, ' '::text, ' '::text) AS titolo_prog,  round(r.peso*r.punteggio/100, 2)::varchar||' su '||r.punteggio::varchar as giudizio_domanda  FROM entrasp.sondaggi s JOIN entrasp.sondaggi_somministrati ss ON ss.codice_azienda::text = s.codice_azienda::text AND ss.id_sondaggio = s.id_sondaggio JOIN entrasp.modelli_test_vr mt ON mt.codice_azienda::text = s.codice_azienda::text AND mt.id_modello_test = s.id_modello_test AND mt.id_modello_test_vr = s.id_modello_test_vr JOIN entrasp.modelli_test mtst ON mt.codice_azienda::text = mtst.codice_azienda::text AND mt.id_modello_test = mtst.id_modello_test LEFT JOIN entrasp.domande d ON mt.codice_azienda::text = d.codice_azienda::text AND mt.id_modello_test = d.id_modello_test AND mt.id_modello_test_vr = d.id_modello_test_vr LEFT JOIN entrasp.domande_sezioni ds ON d.codice_azienda::text = ds.codice_azienda::text AND d.id_modello_test = ds.id_modello_test AND d.id_modello_test_vr = ds.id_modello_test_vr AND d.id_sezione = ds.id_sezione LEFT JOIN (select * from entrasp.risposte where id_risposta_prev is null) ra ON d.codice_azienda::text = ra.codice_azienda::text AND d.id_modello_test = ra.id_modello_test AND d.id_modello_test_vr = ra.id_modello_test_vr AND d.id_domanda = ra.id_domanda AND ss.id_sondaggio = ra.id_sondaggio AND ss.id_somministrazione = ra.id_somministrazione LEFT JOIN entrasp.risposte_previste rp ON d.codice_azienda::text = rp.codice_azienda::text AND d.id_modello_test = rp.id_modello_test AND d.id_modello_test_vr = rp.id_modello_test_vr AND d.id_domanda = rp.id_domanda LEFT JOIN entrasp.risposte r ON rp.codice_azienda::text = r.codice_azienda::text AND rp.id_modello_test = r.id_modello_test AND rp.id_modello_test_vr = r.id_modello_test_vr AND rp.id_domanda = r.id_domanda AND rp.id_risposta_prev=r.id_risposta_prev AND ss.id_sondaggio = r.id_sondaggio AND ss.id_somministrazione = r.id_somministrazione LEFT JOIN entrasp.progetti_fasi pf ON s.id_sondaggio = pf.id_sondaggio AND s.codice_azienda::text = pf.codice_azienda::text LEFT JOIN entrasp.progetti prg ON pf.id_progetto = prg.id_progetto AND pf.codice_azienda::text = prg.codice_azienda::text where d.codice_azienda=$P{codice_azienda} and ss.id_sondaggio=$P{id_sondaggio} and entrasp.domanda_active(d.codice_azienda, d.id_modello_test, d.id_modello_test_vr, d.id_domanda, ss.id_somministrazione)=1 ORDER BY s.codice_azienda, s.id_sondaggio, ds.ordinamento, d.ordinamento,ss.object_key;]]>
	</queryString>
