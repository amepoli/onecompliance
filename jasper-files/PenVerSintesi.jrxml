	<parameter name="REPORTS_MAP" class="java.util.Map" isForPrompting="false"/>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["INVESTIRE"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_sondaggio" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[new BigDecimal(253)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a.codice_azienda,a.id_risultato,a.pct_da,a.pct_target,a.base,a.pt_soglia,f.descrizione,count(*) as count_criticita, d.id_somministrazione,d.object_description,f.codice_colore
FROM entrasp.modelli_test_risultati_righe_vr a 
INNER JOIN entrasp.modelli_test_risultati_righe g ON g.codice_azienda=a.codice_azienda AND g.ID_RISULTATO=a.id_risultato and g.pct_da=a.pct_da 
INNER JOIN entrasp.tipi_modelli_test_risultati_righe f ON f.id_tipo_risultato=g.id_tipo_risultato and f.codice_azienda=g.codice_azienda and f.prog_riga=g.prog_riga 
INNER JOIN entrasp.sondaggi c ON c.id_modello_test=a.id_modello_test and c.id_modello_test_vr=a.id_modello_test_vr and c.codice_azienda=a.codice_azienda 
INNER JOIN entrasp.sondaggi_somministrati d ON d.id_sondaggio=c.id_sondaggio and c.codice_azienda=d.codice_azienda 
INNER JOIN entrasp.risposte e ON e.id_somministrazione=d.id_somministrazione and d.id_sondaggio=e.id_sondaggio and e.codice_azienda=d.codice_azienda 
WHERE d.id_sondaggio=$P{id_sondaggio} and d.codice_azienda=$P{codice_azienda}
AND entrasp.domanda_active(e.codice_azienda, e.id_modello_test, e.id_modello_test_vr, e.id_domanda, e.id_somministrazione)=1 AND e.peso*e.punteggio/100 BETWEEN (SELECT pt_soglia FROM entrasp.modelli_test_risultati_righe_vr WHERE codice_azienda=a.codice_azienda AND id_modello_test=a.id_modello_test AND id_modello_test_vr=a.id_modello_test_vr AND pct_da = a.pct_da AND pct_da > 0) AND (SELECT coalesce(MIN(pt_soglia),1000) FROM entrasp.modelli_test_risultati_righe_vr WHERE codice_azienda=a.codice_azienda AND id_modello_test=a.id_modello_test AND id_modello_test_vr=a.id_modello_test_vr AND pct_da > a.pct_da)
group by a.codice_azienda,a.id_risultato,a.pct_da,a.pct_target,a.base,a.pt_soglia,f.descrizione, d.id_somministrazione,d.object_description,f.codice_colore
order by d.id_somministrazione]]>
	</queryString>
