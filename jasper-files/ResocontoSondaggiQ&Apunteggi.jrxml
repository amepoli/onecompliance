	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select snd.*, cr.codice_azienda ,cr.id_risultato, cr.id_giudizio, cr.risultati_emersi ,cr.proposte_formulate ,cr.decisioni_assunte, cr.id_somministrazione ,cr.follow_up ,cr.id_giudizio_follow_up ,cr.id_giudizio_livello_1 ,cr.id_giudizio_livello_2, mt.titolo as mt_titolo, entrasp.centri_gestionali_descr(snd.codice_part, snd.id_centro_gest) as cg_descr, entrasp.anagrafiche_vr_dati_identificativi_nom1(snd.codice_part, snd.id_anagrafica_assegnataria) as assegnato_a ,snd.giudizio as giudizio_trans,entrasp.transcodifiche_transcodifica( 'STATO_SONDAGGI', snd.stato) as stato_transcodificato, snd.ris_percentuale as percentuale, replace(entrasp.modelli_test_risultati_righe_codice_colore(snd.codice_azienda, mtv.id_risultato, snd.ris_percentuale),'grey','#C0C0C0') as colore_giudizio_trans,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio) as giudizio_complessivo,replace(entrasp.cpl_giudizi_verifiche_colore(snd.codice_azienda, cr.id_giudizio),'grey','#C0C0C0') as colore_giudizio_complessivo,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_livello_1) as giudizio_1,replace(entrasp.cpl_giudizi_verifiche_colore(snd.codice_azienda, cr.id_giudizio_livello_1),'grey','#C0C0C0') as colore_giudizio_1,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_livello_2) as giudizio_2,replace(entrasp.cpl_giudizi_verifiche_colore(snd.codice_azienda, cr.id_giudizio_livello_2),'grey','#C0C0C0') as colore_giudizio_2,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_follow_up) as giudizio_follow_up,replace(entrasp.cpl_giudizi_verifiche_colore(snd.codice_azienda, cr.id_giudizio_follow_up),'grey','#C0C0C0') as colore_giudizio_follow_up from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mtv on snd.codice_azienda=mtv.codice_azienda and snd.id_modello_test=mtv.id_modello_test and snd.id_modello_test_vr=mtv.id_modello_test_vr inner join entrasp.modelli_test mt on mtv.codice_azienda = mt.codice_azienda  and mtv.id_modello_test =mt.id_modello_test left join entrasp.cpl_risultati cr on snd.codice_azienda = cr.codice_azienda  and snd.id_sondaggio =cr.id_sondaggio where cr.id_somministrazione is null and snd.id_sondaggio=14 and snd.codice_azienda='ADMIRALPAY'"]]></defaultValueExpression>
	</parameter>
