<?xml version="1.0" encoding="iso-8859-1"?>
<ViewGroup>
  <View name="progettiList" type="list" businessObjectName="progetti"
    title="Progetti" detailViewName="progettiDetail" gridSize="2"
    orderBy="dataInserimento desc" allowExpand="true">
	<ViewItem content="codiceAttivita" newLine="false"
      size="10" prompt="Cod.mod.prog." />
    <ViewItem content="codiceProgetto" newLine="false" size="10"
      prompt="Codice" contentClass="?cssClass" />
    <ViewItem content="titolo" newLine="false" size="40"
      prompt="Titolo" contentClass="?cssClass" />
    <ViewItem content="cliente" newLine="false" size="30"
      controlType="List" isVisible="?tipoProgetto.flagClienti" prompt="Cliente" contentClass="?cssClass" />
    <ViewItem content="progettoVr.dataConsegna" newLine="false"
      size="10" prompt="Consegna" contentClass="?cssClass" />
    <ViewItem
      content="{coalesce(progettoVr.pctAvanzamentoManuale, progettoVr.pctAvanzamento, 0)}"
      newLine="false" size="10" controlType="Number" format="###.##"
      prompt="% avanz." postPrompt="%" contentClass="?cssClass" />
    <ViewItem tag="workflowStatus" content="this" controlType="WorkflowStatus"
      newLine="false" size="20" prompt="Stato" contentClass="?cssClass" />
    <ViewItem content="dataInserimento" newLine="true"
      size="10" prompt="Data inserimento" contentClass="?cssClass" expandOnly="true"/>
    <ViewItem content="attivita.descrizione" newLine="false"
      size="30" prompt="Modello di progeto" contentClass="?cssClass" expandOnly="true"/>


	  </View>
</ViewGroup>
