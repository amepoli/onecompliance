	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select an2.id_testo_normativo as an2_idtn, tn2.descrizione as tn2_descr, an2.codice_articolo_normativo as an2_codartnorm, an2.rubrica as an2_rub, tn.id_testo_normativo as tn_idtn,tn2.id_testo_normativo as tn2_idtn,tn2.id_testo_normativo as tn2_idtn, tn.descrizione as tn_descr, an.codice_articolo_normativo as an_codartnorm,an.rubrica as an_rub , r.codice_rischio as r_cod, r.titolo as r_tit, r.descrizione as r_descr, entrasp.cpl_soglie_descrizione(r.codice_azienda,'T',r.intensita_totale_pre) as int_tot_ante,entrasp.cpl_soglie_descrizione(r.codice_azienda,'T',r.intensita_totale_post) as int_tot_post from entrasp.testi_normativi tn join entrasp.articoli_normativi an on  tn.id_testo_normativo = an.id_testo_normativo  join entrasp.articoli_normativi_rif  anr on an.codice_articolo_normativo = anr.codice_articolo_normativo_rif and an.id_testo_normativo = anr.id_testo_normativo_rif join entrasp.articoli_normativi an2 on anr.codice_articolo_normativo = an2.codice_articolo_normativo and anr.id_testo_normativo = an2.id_testo_normativo join entrasp.testi_normativi tn2 on an2.id_testo_normativo=tn2.id_testo_normativo join entrasp.rischi_articoli_normativi ran on anr.id_testo_normativo = ran.id_testo_normativo and anr.codice_articolo_normativo = ran.codice_articolo_normativo join entrasp.rischi r on ran.codice_azienda=r.codice_azienda and ran.codice_rischio=r.codice_rischio where  r.codice_azienda='ASCOHOLDING'"]]></defaultValueExpression>
	</parameter>
