		<defaultValueExpression><![CDATA["select * from entrasp.valutazione_contratti vc left join entrasp.contratti con on vc.codice_azienda=con.codice_azienda and vc.id_contratto=con.id_contratto left join entrasp.stato_clienti sc on con.codice_azienda=sc.codice_azienda and con.id_cliente=sc.id_anagrafica where vc.codice_azienda='DEMO'"]]></defaultValueExpression>
