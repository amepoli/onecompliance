	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select vc.*, sc.codice_azienda as sc_codice_azienda, sc.codice_part as sc_codice_part, sc.cod_stato_clienti as stato_clienti,  sc.id_anagrafica as sc_id_anagrafica, sc.data_cambio as sc_data_cambio, sc.valore_nominale_credito as sc_valore_nominale_credito, sc.perdita_registrata as sc_perdita_registrata, sc.note as sc_note, con.codice_azienda as con_codice_azienda, con.id_contratto as con_id_contratto, con.descrizione as con_descrizione, con.numero_contratto as con_numero_contratto from entrasp.valutazione_contratti vc left join entrasp.contratti con on vc.codice_azienda=con.codice_azienda and vc.id_contratto=con.id_contratto left join entrasp.stato_clienti sc on con.codice_azienda=sc.codice_azienda and con.id_cliente=sc.id_anagrafica where vc.codice_azienda='DEMO'"]]></defaultValueExpression>
