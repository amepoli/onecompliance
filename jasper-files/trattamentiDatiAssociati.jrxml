	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select td.*, tdc.tipo, tdc.id_argomento_categoria, entrasp.anagrafiche_vr_dati_identificativi(az.codice_part, tdr.id_responsabile) as responsabile, entrasp.argomenti_descr_breve(id_argomento_categoria)from entrasp.cpl_trattamenti_dati td inner join entrasp.cpl_trattamenti_dati_responsabili tdr on td.codice_azienda=tdr.codice_azienda and  td.id_trattamento_dati=tdr.id_trattamento_dati inner join entrasp.cpl_trattamenti_dati_categorie tdc on td.codice_azienda=tdc.codice_azienda and td.id_trattamento_dati=tdc.id_trattamento_dati inner join entrasp.aziende az on tdc.codice_azienda=az.codice_azienda where tdr.id_responsabile=11 and td.codice_azienda='AVM'"]]></defaultValueExpression>
	</parameter>
