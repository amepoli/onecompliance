	<queryString>
		<![CDATA[select d.*, rp.id_risposta_prev, rp.risposta as rp_risposta, rp.ordinamento as rp_ordinamento, rp.note as rp_note, rp.peso as rp_peso, rp.punteggio as rp_punteggio from entrasp.domande d, entrasp.risposte_previste rp where d.id_sezione is not null 
