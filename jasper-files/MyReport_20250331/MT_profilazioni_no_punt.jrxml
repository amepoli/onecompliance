				<textElement>
					<font size="6"/>
				</textElement>
				<text><![CDATA[* Nome e cognome del cliente persona fisica ovvero denominazione sociale del cliente persona giuridica.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="210" width="266" height="26" uuid="bdcf9537-707d-4421-a7fa-9c89daed8bca"/>
				<textElement>
					<font size="6"/>
				</textElement>
				<text><![CDATA[* Nominativo della parsona fisica che compila il questionario per conto del cliente, laddove quest'ultimo risulti essere una persona giuridica. In caso di cliente persona fisica, il compilatore coincide con il cliente stesso.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" mode="Opaque" x="127" y="276" width="90" height="20" forecolor="#FFFFFF" backcolor="#25599C" uuid="5b940bd6-6c9c-4a4f-849a-5af6412faee7">
