	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select an.id_anagrafica,entrasp.anagrafiche_cognnome(avr.codice_part, avr.id_anagrafica)as anagrafica, avr.codice_fiscale, avr.partita_iva,nascita_data, nascita_luogo, avr.indirizzo, avr.comune, avr.provincia, avr.cap, entrasp.nazione_descr(avr.codice_nazione)as nazione, entrasp.argomenti_descr_breve_no_num(id_argomento_tipo_documento)as tipo_documento, avr.numero_documento, avr.data_scadenza_documento, avr.data_rilascio_documento, avr.rilasciato_da, avr.cod_sae, entrasp.ateco_descr(avr.id_ateco) as cod_ateco from entrasp.anagrafiche_vr avr inner join entrasp.anagrafiche_id an on avr.codice_part = an.codice_part and avr.id_anagrafica=an.id_anagrafica where avr.codice_part='DEMO' and avr.id_anagrafica= 2 "]]></defaultValueExpression>
