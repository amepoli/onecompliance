	<parameter name="REPORTS_MAP" class="java.util.Map" isForPrompting="false"/>
	<parameter name="codice_azienda" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["DEMO"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_modello_test" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[new BigDecimal(71.000)]]></defaultValueExpression>
	</parameter>
	<parameter name="id_modello_test_vr" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[new BigDecimal(1.000)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select coalesce(ds.descrizione,'Sezione I - Default') as ds_descrizione, d.*, rp.id_risposta_prev, rp.risposta as rp_risposta, rp.ordinamento as rp_ordinamento, rp.note as rp_note, rp.peso as rp_peso, rp.punteggio as rp_punteggio 
from entrasp.domande d 
left join entrasp.risposte_previste rp on d.codice_azienda=rp.codice_azienda 
and d.id_modello_test= rp.id_modello_test 
and d.id_modello_test_vr= rp.id_modello_test_vr
and d.id_domanda= rp.id_domanda
left join entrasp.domande_sezioni ds on d.codice_azienda=ds.codice_azienda 
and d.id_modello_test= ds.id_modello_test 
and d.id_modello_test_vr= ds.id_modello_test_vr
and d.id_sezione= ds.id_sezione
where d.codice_azienda=  $P{codice_azienda}
and d.id_modello_test= $P{id_modello_test}
and d.id_modello_test_vr= $P{id_modello_test_vr}
and d.flag_non_applicabile_domanda = '0'
and (rp.flag_escludi_risposta = '0' or rp.flag_escludi_risposta is null)
order by ds.ordinamento asc, d.ordinamento asc, rp.ordinamento asc]]>
	</queryString>
