	<queryString>
		<![CDATA[select prf.titolo as prf_titolo, prf.codice, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', prf.stato) as prf_stato, prf.id_fase as prd_idfase,prf.id_sondaggio as prf_idsond,snd.titolo as s1_titolo, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', snd.stato) as stato_sondaggio1, snd.data_prevista, snd.descrizione from entrasp.progetti_fasi prf left join entrasp.sondaggi snd on prf.codice_azienda=snd.codice_azienda and prf.id_sondaggio=snd.id_sondaggio  WHERE prf.codice_azienda=$P{codice_azienda} and prf.id_fase_sup= $P{id_fase_sup}]]>
