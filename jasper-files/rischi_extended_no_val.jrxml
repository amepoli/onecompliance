	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select r.codice_part, coalesce(r.intensita_totale_post_rilevata,0) as intensita_totale_post_rilevata,entrasp.cpl_soglie_descrizione(codice_azienda,'T', coalesce(intensita_totale_post_rilevata,0)) as intensita_totale_post_rett_descrizione,coalesce(r.intensita_singola_post_rilevata,0) as intensita_singola_post_rilevata,  entrasp.cpl_soglie_descrizione(codice_azienda,'I', coalesce(intensita_singola_post_rilevata,0)) as intensita_rett_descrizione, coalesce(r.probabilita_post_rilevata,0) as probabilita_post_rilevata,entrasp.cpl_soglie_descrizione(codice_azienda,'P', coalesce(probabilita_post_rilevata,0)) as probabilita_rett_descrizione, r.codice_azienda, r.codice_rischio, r.descrizione, entrasp.centri_gestionali_descr(r.codice_part, r.id_centro_gest), entrasp.centri_gestionali_descr(r.codice_part, r.id_centro_gest_liv2) as centri_gestionali_descr_liv2, r.probabilita_pre, r.intensita_singola_pre, r.intensita_totale_pre, r.probabilita_post, r.intensita_singola_post, r.intensita_totale_post, entrasp.cpl_soglie_descrizione(r.codice_azienda, 'T',r.intensita_totale_pre) as soglia_intensita_totale_pre, entrasp.cpl_soglie_descrizione(r.codice_azienda, 'P',r.probabilita_pre) as soglia_probabilita_pre, entrasp.cpl_soglie_descrizione(r.codice_azienda, 'I',r.intensita_singola_pre)as soglia_intensita_singola_pre, entrasp.cpl_soglie_descrizione(r.codice_azienda, 'T',r.intensita_totale_post) as soglia_intensita_totale_post, entrasp.cpl_soglie_descrizione(r.codice_azienda, 'P',r.probabilita_post) as soglia_probabilita_post, entrasp.cpl_soglie_descrizione(r.codice_azienda, 'I',r.intensita_singola_post) as soglia_intensita_singola_post, r.titolo from entrasp.rischi r where codice_azienda='ASCOHOLDING'"]]></defaultValueExpression>
