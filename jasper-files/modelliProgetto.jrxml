	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select cg.descrizione as centro_gestionale,at1.codice_attivita_parent as uno_cap, at1.codice_azienda as uno_caz,at1.codice_attivita as uno_cat,at1.descrizione as uno_des, at1.data_inizio_validita as uno_div,at1.data_fine_validita as uno_dfv, at2.codice_azienda as due_caz,at2.codice_attivita_parent as due_cap,at2.codice_attivita as due_cat,at2.descrizione as due_des, at3.codice_azienda as tre_caz,at3.codice_attivita as tre_cat,at3.descrizione as tre_des, at3.codice_attivita_parent as tre_cap from entrasp.attivita at1 left join entrasp.attivita at2 on at1.codice_attivita=at2.codice_attivita_parent and at1.codice_azienda=at2.codice_azienda left join entrasp.attivita at3 on at2.codice_attivita=at3.codice_attivita_parent and at2.codice_azienda=at3.codice_azienda left join entrasp.centri_gestionali cg on at1.codice_part=cg.codice_part and at1.id_centro_gest=cg.id_centro_gest where at1.codice_azienda ='INVESTIRE' and at1.codice_attivita = '21' and at1.codice_attivita_parent is null"]]></defaultValueExpression>
