	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select cg.descrizione as centro_gestionale, at1.codice_attivita_parent as uno_codAttParent,at1.codice_attivita as uno_codAtt,at2.codice_attivita_parent as due_codAttParent ,at2.codice_attivita as due_codAtt,at3.codice_attivita_parent as tre_codAttParent, at3.codice_attivita as tre_codAtt,at1.codice_azienda as uno_codAz,at1.descrizione as uno_descr, at1.data_inizio_validita as uno_DateStart,at1.data_fine_validita as uno_DateEnd, at2.codice_azienda as due_codAz,at2.descrizione as due_descr, at3.codice_azienda as tre_codAz,at3.descrizione as tre_descr from entrasp.attivita at1 left join entrasp.attivita at2 on at1.codice_attivita=at2.codice_attivita_parent and at1.codice_azienda=at2.codice_azienda left join entrasp.attivita at3 on at2.codice_attivita=at3.codice_attivita_parent and at2.codice_azienda=at3.codice_azienda left join entrasp.centri_gestionali cg on at1.codice_part=cg.codice_part and at1.id_centro_gest=cg.id_centro_gest where at1.codice_attivita_parent is null AND at1.codice_azienda='INVESTIRE' AND at1.codice_attivita='21'"]]></defaultValueExpression>
