	</parameter>
	<parameter name="LOGO" class="java.lang.String" isForPrompting="false"/>
	<parameter name="codice_azienda" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["DEMO"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_sondaggio" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[new BigDecimal(77.0000)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select s.id_sondaggio, object_description, id_domanda, 
entrasp.domande_ordinamento(r.codice_azienda, r.id_modello_test, r.id_modello_test_vr, r.id_domanda) as d_ordinamento , 
entrasp.domande_sezione(r.codice_azienda, r.id_modello_test, r.id_modello_test_vr, r.id_domanda) as id_sezione,
entrasp.domande_sezioni_ordinamento(r.codice_azienda, r.id_modello_test, r.id_modello_test_vr, entrasp.domande_sezione(r.codice_azienda, r.id_modello_test, r.id_modello_test_vr, r.id_domanda))as ds_ordinamento, 
entrasp.tipi_modelli_test_risultati_righe_descr(id_risultato, s.codice_azienda) as giudizio, 
descrizione_sezione, descrizione_domanda,
coalesce(entrasp.risposte_previste_risposta(s.codice_azienda, r.id_modello_test, r.id_modello_test_vr, r.id_domanda, r.id_risposta_prev), descrizione_risposta) as risposta
from entrasp.sondaggi_somministrati s, entrasp.riepilogo_risposte r 
where r.id_somministrazione = s.id_somministrazione and r.codice_azienda = s.codice_azienda and s.codice_azienda= $P{codice_azienda}  and s.id_sondaggio= $P{id_sondaggio}  
order by object_description, ds_ordinamento, d_ordinamento]]>
	</queryString>
