		<defaultValueExpression><![CDATA["select cmp.titolo, cmp.note, cmp.trattamento, cmp.analisi_cause, entrasp.anagrafiche_vr_dati_identificativi((select az.codice_part from entrasp.aziende az where az.codice_azienda=cmp.codice_azienda),cmp.id_responsabile) as responsabile, cmp.data_chiusura,entrasp.tipo_segnalazione_descr_new(cmp.id_tipo_segnalazione) as tipo_segnalazione, cmp.codice_compito, cmp.data_segnalazione, cmp.id_progetto, entrasp.progetto_titolo(cmp.codice_azienda, cmp.id_progetto), cmp.foreseen_date, entrasp.anagrafiche_vr_dati_identificativi((select az.codice_part from entrasp.aziende az where az.codice_azienda=cmp.codice_azienda),cmp.id_cliente) as cliente, entrasp.transcodifiche_transcodifica('STATO_COMPITI', cmp.stato) as stato, entrasp.centri_gestionali_descr((select az.codice_part from entrasp.aziende az where az.codice_azienda=cmp.codice_azienda), cmp.id_centro_gest) as centro_gest, entrasp.centri_gestionali_descr((select az.codice_part from entrasp.aziende az where az.codice_azienda=cmp.codice_azienda), cmp.id_centro_gest_monitor) as centro_gest_monitor from entrasp.compiti cmp where cmp.codice_azienda='AUDITFT"]]></defaultValueExpression>
