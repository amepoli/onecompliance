	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select  snd.*, cr.*, mt.titolo as mt_titolo,entrasp.centri_gestionali_descr(snd.codice_part, snd.id_centro_gest) as cg_descr,funct.giudizio as giudizio_trans,entrasp.transcodifiche_transcodifica( 'STATO_SONDAGGI', snd.stato) as stato_transcodificato,funct.percentuale ,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio) as giudizio_complessivo,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_livello_1) as giudizio_1,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_livello_2) as giudizio_2,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_follow_up) as giudizio_follow_up,ss.id_somministrazione as ss_id_somm from entrasp.sondaggi_somministrati ss join entrasp.sondaggi snd on ss.id_sondaggio=snd.id_sondaggio and ss.codice_azienda=snd.codice_azienda left join entrasp.modelli_test mt on snd.codice_azienda = mt.codice_azienda  and snd.id_modello_test =mt.id_modello_test left join entrasp.cpl_risultati cr on ss.codice_azienda = cr.codice_azienda  and ss.id_sondaggio =cr.id_sondaggio and ss.id_somministrazione=cr.id_somministrazione left join entrasp.grc_punteggi_giudizi_finali(ss.codice_azienda, ss.id_somministrazione) funct on snd.id_sondaggio=funct.idsondaggio and snd.codice_azienda=funct.codiceazienda where snd.codice_azienda = 'FINAFARM' and snd.id_sondaggio = 26081 and ss.id_somministrazione=1"]]></defaultValueExpression>
	</parameter>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["FINAFARM"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_sondaggio" class="java.lang.String">
		<defaultValueExpression><![CDATA[new BigDecimal(26081)]]></defaultValueExpression>
	</parameter>
