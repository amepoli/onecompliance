	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select pr.codice_azienda, pr.id_progetto,pr.codice_progetto, pr.titolo , pr.id_tipo_progetto, pr.id_cliente, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', pr.stato) as stato,entrasp.anagrafiche_vr_dati_identificativi(pr.codice_part, pr.id_cliente), prf.titolo ||coalesce(' (ID ' || s1.id_sondaggio ||')','') as prf_titolo, prf.codice, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', prf.stato) as prf_stato, prf.id_fase as prf_idfase, coalesce(prf.id_fase_sup,0) as prf_idfase_sup, prf.id_sondaggio as prf_idsond, prf.ordinamento as prf_ordinamento, s1.titolo ||' (ID ' || s1.id_sondaggio ||')' as s_titolo, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', s1.stato) as stato_sondaggio, coalesce(to_char(s1.data_esecuzione::date, 'Month YYYY'), 'Prevista: '||to_char(s1.data_prevista::date, 'Month YYYY')) as data_prevista, prf2.titolo ||' (ID ' || s2.id_sondaggio ||')' as prf_titolo2, prf2.codice as prf_codice2, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', prf2.stato) as prf2_stato,prf2.id_fase as prf2_idfase, coalesce(prf2.id_fase_sup,0) as prf2_idfase_sup, prf2.id_sondaggio as prf2_idson, prf2.ordinamento as prf2_ordinamento, s2.titolo ||coalesce(' (ID ' || s2.id_sondaggio ||')', '') as s2_titolo, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', s2.stato) as stato_sondaggio2, coalesce(to_char(s2.data_esecuzione::date, 'Month YYYY'), 'Prevista: '||to_char(s2.data_prevista::date, 'Month YYYY')) as s2_data_prevista, prf3.titolo as prf_titolo3, prf3.codice as prf_codice3, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', prf3.stato) as prf3_stato,prf3.id_fase as prf3_idfase, coalesce(prf3.id_fase_sup,0) as prf3_idfase_sup, prf3.id_sondaggio as prf3_idson, prf3.ordinamento as prf3_ordinamento, s3.titolo as s3_titolo, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', s3.stato) as stato_sondaggio3, coalesce(to_char(s3.data_esecuzione::date, 'Month YYYY'), 'Prevista: '||to_char(s3.data_prevista::date, 'Month YYYY')) as s3_data_prevista from entrasp.progetti pr left join entrasp.progetti_fasi prf on pr.codice_azienda=prf.codice_azienda and pr.id_progetto=prf.id_progetto left join entrasp.sondaggi s1 on prf.codice_azienda=s1.codice_azienda and prf.id_sondaggio=s1.id_sondaggio left join entrasp.progetti_fasi prf2 on prf.codice_azienda=prf2.codice_azienda and prf.id_fase=prf2.id_fase_sup left join entrasp.sondaggi s2 on prf2.codice_azienda=s2.codice_azienda and prf2.id_sondaggio=s2.id_sondaggio left join entrasp.progetti_fasi prf3 on prf2.codice_azienda=prf3.codice_azienda and prf2.id_fase=prf3.id_fase_sup left join entrasp.sondaggi s3 on prf3.codice_azienda=s3.codice_azienda and prf3.id_sondaggio=s3.id_sondaggio where prf.id_fase_sup is null and pr.codice_azienda='ADMIRALPAY' and prf.id_fase_sup is null"]]></defaultValueExpression>
	</parameter>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["admiralpay"]]></defaultValueExpression>
	</parameter>
