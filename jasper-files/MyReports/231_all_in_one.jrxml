	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select  az.articolazione_documento, az.ragione_sociale,az.descrizione as descrizione_az, pa.codice_azienda, pa.id_procedura, entrasp.attivita_a_rischio (pa.id_procedura, pa.codice_azienda) as attivita,  entrasp.tipologie_reato_processo (pa.id_procedura, pa.codice_azienda) as reato,  entrasp.centri_gestionali_coinvolti_processo (pa.id_procedura, pa.codice_azienda) as centri_gest, entrasp.descrizione_attivita_a_rischio (pa.id_procedura, pa.codice_azienda) as descrizione, 	descrizione_breve from entrasp.procedure_aziendali pa inner join entrap.aziende az on pa.codice_azienda=az.codice_azienda where pa.codice_azienda='RICREATIVO' and pa.id_procedura_parent is null"

]]></defaultValueExpression>
	</parameter>
	<parameter name="codice_azienda" class="java.lang.String">
