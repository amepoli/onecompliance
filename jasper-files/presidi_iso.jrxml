	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select pr.codice_azienda, pr.id_presidio, pr.descrizione_breve, pr.note, pr.id_procedura,pr.livello,pr.tipo,pr.fase,tipo_dato, entrasp.transcodifiche_transcodifica(STATO_ATTUAZIONE, pr.stato)as stato_attuazione,pr.codice_part,pr.id_centro_gest, entrasp.centri_gestionali_descr(pr.codice_part, pr.id_centro_gest) as centro_gest, pr.descrizione, pr.codice, pr.id_presidio_parent, pr.id_tipo_presidio,pr2.codice_azienda as codice_azienda2, pr2.id_presidio as id_presidio2, pr2.descrizione_breve as descrizione_breve2, pr2.note as note2, pr2.id_procedura as id_procedura2,pr2.livello as livello2,pr2.tipo as tipo2,pr2.fase as fase2,pr2.stato_attuazione as stato_attuazione2,pr2.codice_part as codice_part2,pr2.id_centro_gest as id_centro_gest2, pr2.descrizione as descrizione2, pr2.codice as codice2,pr2.id_presidio_parent as id_presidio_parent2, pr2.id_tipo_presidio as id_tipo_presidio2 ,pr3.codice_azienda as codice_azienda3, pr3.id_presidio as id_presidio3,pr3.descrizione_breve as descrizione_breve3 ,pr3.codice_part as codice_part3,pr3.descrizione as descrizione3,pr3.codice as codice3,pr3.id_presidio_parent as id_presidio_parent3, pr3.id_tipo_presidio as id_tipo_presidio3, tp.descrizione as tipo_presidio1,tp2.descrizione as tipo_presidio2,tp3.descrizione as tipo_presidio3 from entrasp.presidi pr left join entrasp.tipi_processi tp on pr.codice_azienda= tp.codice_azienda and pr.id_tipo_presidio=tp.id_tipo_processo left join entrasp.presidi pr2 on pr.id_presidio=pr2.id_presidio_parent and pr.codice_azienda=pr2.codice_azienda left join entrasp.tipi_processi tp2 on pr2.codice_azienda= tp2.codice_azienda and pr2.id_tipo_presidio=tp2.id_tipo_processo left join entrasp.presidi pr3 on pr2.id_presidio=pr3.id_presidio_parent and pr2.codice_azienda=pr3.codice_azienda left join entrasp.tipi_processi tp3 on pr3.codice_azienda= tp3.codice_azienda and pr3.id_tipo_presidio=tp3.id_tipo_processo where pr.codice_azienda='QUANTYXSRL' and pr.id_presidio_parent is null"]]></defaultValueExpression>
