			<![CDATA[SELECT pr.codice_azienda, pr.id_presidio, pr.descrizione_breve, pAzPr .note, pAzPr .id_procedura FROM entrasp.presidi as pr INNER JOIN entrasp.procedure_aziendali_presidi as pAzPr ON pr.id_presidio = pAzPr.id_presidio AND pr.codice_azienda = pAzPr.codice_azienda 
