	<subDataset name="Gap" uuid="52bc3176-f47d-475a-a123-386a9aeba605">
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="OC_prod"/>
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<parameter name="id_presidio" class="java.math.BigDecimal"/>
		<parameter name="codice_azienda" class="java.lang.String"/>
		<queryString>
			<![CDATA[Select cmp.note,cmp.trattamento, cmp.codice_azienda, cbo.id_procedura, cbo.id_presidio from entrasp.compiti cmp inner join entrasp.compiti_rif_bo cbo on cmp.codice_compito=cbo.codice_compito and cmp.codice_azienda=cbo.codice_azienda where cmp.codice_azienda='LOTTOMATICA' and cbo.id_procedura=7 and cbo.id_presidio=1]]>
		</queryString>
		<field name="note" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="note"/>
