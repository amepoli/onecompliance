	<subDataset name="Presidi" uuid="a29e5bc9-211b-4bed-9519-e46ba587ae0f">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="OC_prod"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="0"/>
		<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="1000"/>
		<parameter name="id_presidio" class="java.math.BigDecimal"/>
		<parameter name="codice_azienda" class="java.lang.String"/>
		<parameter name="id_procedura" class="java.math.BigDecimal"/>
		<queryString language="SQL">
			<![CDATA[SELECT 
    pr.codice_azienda,
    pr.id_presidio,
    pr.descrizione_breve,
		pap.note,
		pap.id_procedura,
    STRING_AGG(cmp.note, CHR(10)) AS note_compiti,
    STRING_AGG(cmp.trattamento, CHR(10)) AS trattamenti
FROM 
    entrasp.presidi AS pr
INNER JOIN 
    entrasp.procedure_aziendali_presidi AS pap 
    ON pr.id_presidio = pap.id_presidio AND pr.codice_azienda = pap.codice_azienda
left JOIN 
    entrasp.compiti_rif_bo AS cbo 
    ON pap.codice_azienda = cbo.codice_azienda 
    AND pap.id_procedura = cbo.id_procedura 
    AND pap.id_presidio = cbo.id_presidio
left JOIN 
    entrasp.compiti AS cmp 
    ON cbo.codice_azienda = cmp.codice_azienda 
    AND cbo.codice_compito = cmp.codice_compito
WHERE 
    pap.codice_azienda =  $P{codice_azienda} 
    AND pap.id_procedura =  $P{id_procedura} 
GROUP BY 
    pr.codice_azienda, 
    pr.id_presidio, 
		pap.id_procedura,
		pap.note,
    pr.descrizione_breve;]]>
		</queryString>
		<field name="codice_azienda" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="codice_azienda"/>
			<property name="com.jaspersoft.studio.field.label" value="codice_azienda"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="presidi"/>
		</field>
		<field name="id_presidio" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="id_presidio"/>
			<property name="com.jaspersoft.studio.field.label" value="id_presidio"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="presidi"/>
		</field>
		<field name="descrizione_breve" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="descrizione_breve"/>
			<property name="com.jaspersoft.studio.field.label" value="descrizione_breve"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="presidi"/>
		</field>
		<field name="note" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="note"/>
			<property name="com.jaspersoft.studio.field.label" value="note"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="procedure_aziendali_presidi"/>
		</field>
		<field name="id_procedura" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="id_procedura"/>
			<property name="com.jaspersoft.studio.field.label" value="id_procedura"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="procedure_aziendali_presidi"/>
		</field>
		<field name="note_compiti" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="note_compiti"/>
			<property name="com.jaspersoft.studio.field.label" value="note_compiti"/>
		</field>
		<field name="trattamenti" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="trattamenti"/>
			<property name="com.jaspersoft.studio.field.label" value="trattamenti"/>
		</field>
	</subDataset>
	<parameter name="REPORTS_MAP" class="java.util.Map" isForPrompting="false"/>
	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["SELECT pr.descrizione_breve, pAzPr .note, pAzPr .id_procedura FROM entrasp.presidi as pr INNER JOIN entrasp.procedure_aziendali_presidi as pAzPr ON pr.id_presidio = pAzPr.id_presidio AND pr.codice_azienda = pAzPr.codice_azienda where pAzPr.codice_azienda='LOTTOMATICA' and pAzPr.id_procedura=7"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_procedura" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[$F{id_procedura}]]></defaultValueExpression>
	</parameter>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["LOTTOMATICA"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT distinct pr.codice_azienda,pr.id_presidio, pr.descrizione_breve, pAzPr .note, pAzPr .id_procedura FROM entrasp.presidi as pr INNER JOIN entrasp.procedure_aziendali_presidi as pAzPr ON pr.id_presidio = pAzPr.id_presidio AND pr.codice_azienda = pAzPr.codice_azienda where pAzPr.codice_azienda= $P{codice_azienda} and pAzPr.id_procedura= $P{id_procedura}]]>
	</queryString>
