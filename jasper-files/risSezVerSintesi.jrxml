					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#050505"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Bold_arial" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{giudizio_automatico}]]></textFieldExpression>
			</textField>
		</band>
	</detail>
	<summary>
		<band splitType="Stretch"/>
	</summary>
</jasperReport>
