	<parameter name="REPORTS_MAP" class="java.util.Map" isForPrompting="false"/>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["DEMO-KYC"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_sondaggio" class="java.math.BigDecimal" isForPrompting="false">
		<defaultValueExpression><![CDATA[new BigDecimal(830)]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT ssrs.codice_azienda, ssrs.id_sondaggio, ssrs.id_modello_test, ssrs.id_modello_test_vr, ssrs.id_sezione, ds.ordinamento, ds.descrizione as descr_sezione,ssrs.sezione_completata, round(AVG(round(ssrs.punteggio_ottenuto,2)),2) as punteggio_medio,round(AVG(pct_risultato_ottenuto_calcolato),2) as pct_ottenuto_medio,round(AVG(ssrs.pct_risultato_ottenuto_calcolato_ponderato),2) as ponderato_medio ,entrasp.modelli_test_risultati_righe_descr(ssrs.id_risultato, ssrs.pct_da, ssrs.codice_azienda) as giudizio_automatico,  f.codice_colore 
FROM entrasp.sondaggi_somministrati_risultati_sezioni ssrs
INNER JOIN entrasp.domande_sezioni ds on ssrs.id_sezione=ds.id_sezione and ssrs.codice_azienda=ds.codice_azienda and ssrs.id_modello_test=ds.id_modello_test and ssrs.id_modello_test_vr=ds.id_modello_test_vr 
LEFT JOIN entrasp.modelli_test_risultati_righe g ON g.codice_azienda=ssrs.codice_azienda AND g.ID_RISULTATO=ssrs.id_risultato and g.pct_da=ssrs.pct_da 
LEFT JOIN entrasp.tipi_modelli_test_risultati_righe f ON f.id_tipo_risultato=g.id_tipo_risultato and f.codice_azienda=g.codice_azienda and f.prog_riga=g.prog_riga
WHERE ssrs.codice_azienda=$P{codice_azienda}  and ssrs.id_sondaggio=$P{id_sondaggio} and ds.flag_non_applicabile_sezione='0' 
GROUP BY ssrs.sezione_completata, ssrs.codice_azienda, ssrs.id_sondaggio, ssrs.id_modello_test, ssrs.id_modello_test_vr, ssrs.id_sezione, ds.ordinamento, ds.descrizione, ssrs.id_risultato, ssrs.pct_da, f.codice_colore ]]>
	</queryString>
