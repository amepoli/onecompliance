	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select pa1.descrizione_breve as uno_db, pa2.descrizione_breve as due_db, pa3.descrizione_breve as tre_db, pa1.codice as uno_c, pa2.codice as due_c, pa3.codice as tre_c, pa1.id_procedura as uno_id_proc, pa2.id_procedura as due_id_proc, pa3.id_procedura as tre_id_proc, pa1.descrizione as uno_d, pa2.descrizione as due_d, pa3.descrizione as tre_d, pa1.codice_azienda as uno_ca, pa2.codice_azienda as due_ca, pa3.codice_azienda as tre_ca, pa1.id_procedura_parent as uno_id_pp, pa2.id_procedura_parent as due_id_pp,pa3.id_procedura_parent as tre_id_pp,fr1.codice_azienda as fr1_ca, fr1.codice_rischio as fr1_cr,fr2.codice_azienda as fr2_ca, fr2.codice_rischio as fr2_cr,fr3.codice_azienda as fr3_ca, fr3.codice_rischio as fr3_cr from entrasp.procedure_aziendali pa1 left join entrasp.procedure_aziendali pa2 on pa1.id_procedura=pa2.id_procedura_parent and pa1.codice_azienda=pa2.codice_azienda left join entrasp.procedure_aziendali pa3 on pa2.id_procedura=pa3.id_procedura_parent and pa2.codice_azienda=pa3.codice_azienda left join entrasp.fonti_rischio fr1 on fr1.codice_azienda= pa1.codice_azienda and fr1.id_procedura=pa1.id_procedura left join entrasp.fonti_rischio fr2 on fr2.codice_azienda= pa2.codice_azienda and fr2.id_procedura=pa2.id_procedura left join entrasp.fonti_rischio fr3 on fr3.codice_azienda= pa3.codice_azienda and fr3.id_procedura=pa3.id_procedura where pa1.codice_azienda ='ASCOHOLDING'"]]></defaultValueExpression>
