	<parameter name="mainQuery" class="java.lang.String">
		<defaultValueExpression><![CDATA["select  snd.*, cr.codice_azienda ,cr.id_risultato, cr.id_giudizio, cr.risultati_emersi ,cr.proposte_formulate ,cr.decisioni_assunte, cr.id_somministrazione ,cr.follow_up ,cr.id_giudizio_follow_up ,cr.id_giudizio_livello_1 ,cr.id_giudizio_livello_2, mt.titolo as mt_titolo,entrasp.centri_gestionali_descr(snd.codice_part, snd.id_centro_gest) as cg_descr,funct.giudizio as giudizio_trans,entrasp.transcodifiche_transcodifica( 'STATO_SONDAGGI', snd.stato) as stato_transcodificato, funct.percentuale ,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio) as giudizio_complessivo,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_livello_1) as giudizio_1,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_livello_2) as giudizio_2,entrasp.cpl_giudizi_verifiche_descrizione(snd.codice_azienda, cr.id_giudizio_follow_up) as giudizio_follow_up  from entrasp.sondaggi snd left join entrasp.modelli_test mt on snd.codice_azienda = mt.codice_azienda  and snd.id_modello_test =mt.id_modello_test left join entrasp.cpl_risultati cr on snd.codice_azienda = cr.codice_azienda  and snd.id_sondaggio =cr.id_sondaggio left join entrasp.grc_punteggi_giudizi_finali_per_sondaggio(snd.codice_azienda, snd.id_sondaggio) funct on snd.id_sondaggio=funct.idsondaggio and snd.codice_azienda=funct.codiceazienda where snd.codice_azienda='FSI' and snd.id_sondaggio=10"]]></defaultValueExpression>
	</parameter>
	<parameter name="codice_azienda" class="java.lang.String">
		<defaultValueExpression><![CDATA["FININTSGR"]]></defaultValueExpression>
	</parameter>
	<parameter name="id_sondaggio" class="java.lang.String">
		<defaultValueExpression><![CDATA[920]]></defaultValueExpression>
	</parameter>
