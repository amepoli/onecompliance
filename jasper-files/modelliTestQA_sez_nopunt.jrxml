	<queryString>
		<![CDATA[select d.id_domanda,ds.id_sezione,d.descrizione,ds.descrizione as descrizione_sezione, d.ordinamento, rp.id_modello_test, rp.risposta, d.note as note_domanda, rp.ordinamento as r_ordinamento from entrasp.domande d

join entrasp.risposte_previste rp on d.codice_azienda=rp.codice_azienda and d.id_domanda=rp.id_domanda and d.id_modello_test_vr=rp.id_modello_test_vr and d.id_modello_test=rp.id_modello_test

join entrasp.domande_sezioni ds on d.codice_azienda=rp.codice_azienda and d.id_modello_test=ds.id_modello_test and d.id_modello_test_vr=ds.id_modello_test_vr

where d.codice_azienda=$P{codice_azienda} and d.id_modello_test=$P{id_modello_test} and d.id_modello_test_vr=$P{id_modello_test_vr}

order by ds.id_sezione, ordinamento, r_ordinamento]]>
