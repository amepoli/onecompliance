	<queryString>
		<![CDATA[select distinct rs.codice_part, coalesce(rs.intensita_totale_post_rilevata,0) as intensita_totale_post_rilevata,entrasp.cpl_soglie_descrizione(codice_azienda,'T', coalesce(intensita_totale_post_rilevata,0)) as intensita_totale_post_rett_descrizione,coalesce(rs.intensita_singola_post_rilevata,0) as intensita_singola_post_rilevata,  entrasp.cpl_soglie_descrizione(codice_azienda,'I', coalesce(intensita_singola_post_rilevata,0)) as intensita_rett_descrizione, coalesce(rs.probabilita_post_rilevata,0) as probabilita_post_rilevata,entrasp.cpl_soglie_descrizione(codice_azienda,'P', coalesce(probabilita_post_rilevata,0)) as probabilita_rett_descrizione, rs.codice_azienda, rs.codice as codice_rischio, rs.descrizione, entrasp.centri_gestionali_descr(rs.codice_part, rs.id_centro_gest), rs.probabilita_pre, rs.intensita_singola_pre, rs.intensita_totale_pre, rs.probabilita_post, rs.intensita_singola_post, rs.intensita_totale_post, entrasp.cpl_soglie_descrizione(rs.codice_azienda, 'T',rs.intensita_totale_pre) as soglia_intensita_totale_pre, entrasp.cpl_soglie_descrizione(rs.codice_azienda, 'P',rs.probabilita_pre) as soglia_probabilita_pre, entrasp.cpl_soglie_descrizione(rs.codice_azienda, 'I',rs.intensita_singola_pre)as soglia_intensita_singola_pre, entrasp.cpl_soglie_descrizione(rs.codice_azienda, 'T',rs.intensita_totale_post) as soglia_intensita_totale_post, entrasp.cpl_soglie_descrizione(rs.codice_azienda, 'P',rs.probabilita_post) as soglia_probabilita_post, entrasp.cpl_soglie_descrizione(rs.codice_azienda, 'I',rs.intensita_singola_post) as soglia_intensita_singola_post, rs.titolo from entrasp.sondaggi snd inner join entrasp.domande_presidi dp using(codice_azienda, id_modello_test, id_modello_test_vr) inner join entrasp.rischi_presidi ps using(codice_azienda, id_presidio) inner join entrasp.rischi rs using(codice_azienda, codice_rischio) where codice_azienda=$P{codice_azienda} and id_sondaggio= $P{id_sondaggio}]]>
