	<queryString language="SQL">
		<![CDATA[SELECT pr.codice_azienda, pr.id_presidio, pr.descrizione_breve, COALESCE(pap.note, '') AS note, pap.id_procedura, COALESCE(STRING_AGG(COALESCE(cmp.note, ''), CHR(10)), '') AS note_compiti, COALESCE(STRING_AGG(COALESCE(cmp.trattamento, ''), CHR(10)), '') AS trattamenti FROM entrasp.presidi AS pr INNER JOIN entrasp.procedure_aziendali_presidi AS pap ON pr.id_presidio = pap.id_presidio AND pr.codice_azienda = pap.codice_azienda LEFT JOIN entrasp.compiti_rif_bo AS cbo ON pap.codice_azienda = cbo.codice_azienda AND pap.id_procedura = cbo.id_procedura AND pap.id_presidio = cbo.id_presidio LEFT JOIN entrasp.compiti AS cmp ON cbo.codice_azienda = cmp.codice_azienda AND cbo.codice_compito = cmp.codice_compito WHERE pap.codice_azienda = $P{codice_azienda}   AND pap.id_procedura = $P{id_procedura}   GROUP BY pr.codice_azienda, pr.id_presidio, pap.id_procedura, pap.note, pr.descrizione_breve;]]>
