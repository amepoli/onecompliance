		<defaultValueExpression><![CDATA["select an.descrizione as an_descr, an.codice_articolo_normativo as an_cod_art_norm, an.rubrica as an_rub, an.rif_esterno_url as an_rifesturl, an.id_testo_normativo as an_id_test_norm, r.codice as r_cod, r.titolo as r_tit from entrasp.testi_normativi tn join entrasp.articoli_normativi an on  tn.id_testo_normativo = an.id_testo_normativo right join entrasp.rischi_articoli_normativi ran on an.id_testo_normativo = ran.id_testo_normativo and an.codice_articolo_normativo = ran.codice_articolo_normativo right join entrasp.rischi r on r.codice_azienda = ran.codice_azienda and r.codice_rischio = ran.codice_rischio where r.codice_azienda='FINAFARM'"]]></defaultValueExpression>
