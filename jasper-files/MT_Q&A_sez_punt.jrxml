		<defaultValueExpression><![CDATA["select m.*, m_vr.*, entrasp.centri_gestionali_descr(m.codice_part,m.id_centro_gest) as cg_descr, entrasp.tipo_modello_test_descr(m.id_tipo_modello_test) as tipoModelloTest_descrizione  from entrasp.modelli_test m, entrasp.modelli_test_vr m_vr  where m.id_modello_test=m_vr.id_modello_test and m.codice_azienda=m_vr.codice_azienda and m.flag_sezioni='1' and m.codice_azienda = 'FININTSGR' and m.id_modello_test = 621 and m.id_modello_test_vr=1"]]></defaultValueExpression>
