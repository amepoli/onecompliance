ALTER TABLE IF EXISTS entrasp.attivita
 ADD COLUMN available_report_list numeric[];

	
update entrasp.attivita
set enabled_report_list= array[64]
where (codice_azienda, codice_attivita) in (select prg.codice_azienda, prg.codice_attivita
from entrasp.progetti prg
inner join entrasp.attivita att
on prg.codice_azienda=att.codice_azienda and prg.codice_attivita=att.codice_attivita
where prg.codice_azienda in('IREN', 'ADMIRALPAY', 'AXACTOR', 'PACCAR')
)

SELECT prg.id_progetto AS id, prg.titolo AS name
FROM entrasp.progetti prg
INNER JOIN entrasp.attivita att
    ON prg.codice_azienda = att.codice_azienda 
    AND prg.codice_attivita = att.codice_attivita
WHERE 64 = ANY(att.enabled_report_list)
  AND prg.codice_azienda = 'PACCAR';


