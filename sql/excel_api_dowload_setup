SELECT snd.id_sondaggio AS id, snd.titolo AS name
FROM entrasp.sondaggi snd
INNER JOIN entrasp.modelli_test mt
    ON snd.codice_azienda = mt.codice_azienda 
    AND snd.id_modello_test =mt.id_modello_test
WHERE 30 = ANY(mt.enabled_report_list)
  AND snd.codice_azienda = 'PACCAR';

