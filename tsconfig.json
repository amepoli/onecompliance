{
    "compileOnSave": false,
    "compilerOptions": {
      "baseUrl": "./src",
      "downlevelIteration": true,
      "importHelpers": true,
      "module": "es2020",
      "outDir": "./dist/out-tsc",
      "sourceMap": true,
      "declaration": false,
      "moduleResolution": "node",
      "experimentalDecorators": true,
      "resolveJsonModule": true,
      "paths": {
        "@fuse": [
          "@fuse/"
        ]
      },
      "target": "ES2022",
      "typeRoots": [
        "node_modules/@types"
      ],
      "lib": [
        "es2017",
        "dom"
      ],
      "skipLibCheck": false,
      "useDefineForClassFields": false
    }
}
