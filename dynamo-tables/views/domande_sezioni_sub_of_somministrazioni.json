  "predefinedQueries": [
    {
      "operation": "selectTable",
      "queryString": "select distinct ss.codice_azienda, ss.id_somministrazione, snd.id_sondaggio, mvr.id_modello_test, mvr.id_modello_test_vr, ds.id_sezione, ds.ordinamento, ds.descrizione as descr_sezione, round(prs.punteggio,2) as punteggio, prs.pesosezione, round(prs.risultatopercsezione,2) as risultatopercsezione, prs.risultatopercsezionepesata from entrasp.sondaggi snd left join entrasp.sondaggi_somministrati ss on snd.codice_azienda=ss.codice_azienda and snd.id_sondaggio=ss.id_sondaggio join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr join entrasp.domande_sezioni ds on mvr.codice_azienda=ds.codice_azienda and mvr.id_modello_test=ds.id_modello_test and mvr.id_modello_test_vr=ds.id_modello_test_vr join entrasp.grc_punteggio_risposte_somministrazione_per_sezione(snd.codice_azienda,ss.id_somministrazione) prs on ds.id_sezione=prs.idsezione and ds.codice_azienda=prs.codiceazienda where snd.codice_azienda=$codice_azienda$ and snd.id_sondaggio=$id_sondaggio$ and ss.id_somministrazione=$id_somministrazione$ order by ds.ordinamento asc;",
      "type": "main"
    },
    {
      "operation": "selectForm",
      "queryString": "select distinct ss.codice_azienda, ss.id_somministrazione, snd.id_sondaggio, mvr.id_modello_test, mvr.id_modello_test_vr, ds.id_sezione, ds.ordinamento, ds.descrizione as descr_sezione from entrasp.sondaggi snd left join entrasp.sondaggi_somministrati ss on snd.codice_azienda=ss.codice_azienda and snd.id_sondaggio=ss.id_sondaggio join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr join entrasp.domande_sezioni ds on mvr.codice_azienda=ds.codice_azienda and mvr.id_modello_test=ds.id_modello_test and mvr.id_modello_test_vr=ds.id_modello_test_vr where snd.codice_azienda=$codice_azienda$ and mvr.id_modello_test=$id_modello_test$ and mvr.id_modello_test_vr=$id_modello_test_vr$ and snd.id_sondaggio=$id_sondaggio$ and ss.id_somministrazione=$id_somministrazione$ and ds.id_sezione=$id_sezione$;",
      "type": "main"
    },
    {
      "operation": "selectForm",
      "queryString": "select round(punteggio,2) as punteggio, round(risultatopercsezione, 2) as risultatopercsezione, pesosezione, round(risultatopercsezionepesata, 2) as risultatopercsezionepesata from entrasp.grc_punteggio_risposte_somministrazione_per_sezione($codice_azienda$, $id_somministrazione$) where idsezione=$id_sezione$",
      "type": "postProcessing"
    }
