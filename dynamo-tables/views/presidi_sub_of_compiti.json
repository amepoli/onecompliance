{
    "$schema": "../views.schema.json",
    "entryKey": "presidi_sub_of_compiti",
    "inheritsFrom": "presidi",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select distinct pr.codice_azienda, pr.codice, crb.codice_compito, case when crb.object_name='presidi' then true else false end as disassocia_segnalazione, pr.id_presidio, pr.descrizione, pr.note from entrasp.presidi pr join entrasp.compiti_rif_bo crb on pr.id_presidio=crb.id_presidio and pr.codice_azienda=crb.codice_azienda where pr.codice_azienda=$codice_azienda$ and crb.codice_compito=$codice_compito$"
        },
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "SELECT pr.codice_azienda, pr.id_presidio, pr.id_presidio_parent, pr.codice, pr.id_tipo_presidio, pr.id_argomento_stato_automazione, pr.id_argomento_frequenza, pr.stato_attuazione, pr.rettifica_verifiche, pr.rettifica_indicatori, pr.rettifica_stato, pr.rettifica_complessiva, pr.id_argomento, pr.descrizione_breve, pr.id_centro_gest, pr.descrizione, pr.guida_attuativa, pr.note WHERE pr.codice_azienda=$codice_azienda$ AND id_presidio=$id_presidio$"
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "width": "3%",
            "key": "disassocia_segnalazione",
            "label": "",
            "style": [
                {
                    "button_icon": "close",
                    "value": "*"
                }
            ],
            "isButton": true,
            "buttonAction": {
                "target": "sondaggi_sub_of_compiti",
                "viewType": "form",
                "action": "query",
                "query": "delete from entrasp.compiti_rif_bo where codice_azienda='£codice_azienda£' and codice_compito='£codice_compito£' and id_somministrazione=£id_somministrazione£ and id_sondaggio=£id_sondaggio£ and object_name='sondaggiSomministrati'",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "codice_compito",
                        "destination": "codice_compito"
                    },
                    {
                        "source": "id_somministrazione",
                        "destination": "id_somministrazione"
                    },
                    {
                        "source": "id_sondaggio",
                        "destination": "id_sondaggio"
                    }
                ],
                "confirmAction": true,
                "confirmMessage": {
                    "title": "Dissocia presidio",
                    "text": "Dissociare il presidio selezionata dalla segnalazione?"
                },
                "onSuccessAction": "reload"
            }
        },
