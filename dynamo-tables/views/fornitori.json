                    "key": "unifica",
                    "icon": "merge_type",
                    "label": "Unifica anagrafiche",
                    "query": "select entrasp.unifica_anagrafiche_selezionate(array[$selected_rows_data$], '€global_username€', '€global_codice_azienda€')",
