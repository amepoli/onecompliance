{
    "$schema": "../views.schema.json",
    "entryKey": "settori_sub_of_questionari",
    "origin": "entrasp.settori_questionari",
    "businessObjectName": "settori_questionari",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select true as delete_settori, sq.id_argomento_settore, entrasp.argomenti_codice_descr_breve(sq.id_argomento_settore) as settore, sq.id_questionario, sq.codice_azienda, qs.id_norma, cs.id_argomento_complessita, entrasp.argomenti_descr_breve_no_id(cs.id_argomento_complessita) as complessita, entrasp.argomenti_descr_breve_no_id(qs.idnorma) as norma from entrasp.settori_questionari sq inner join (select * from entrasp.questionari_certificazione qc, unnest(qc.id_norma) as idnorma) qs on sq.codice_azienda=qs.codice_azienda and sq.id_questionario=qs.id_questionario left join entrasp.complessita_settori cs on qs.idnorma=cs.id_argomento_tipo_norma and sq.id_argomento_settore=cs.id_argomento_settore where sq.id_questionario=$id_questionario$ and sq.codice_azienda=$codice_azienda$",
            "type": "main"
        }
    ],
