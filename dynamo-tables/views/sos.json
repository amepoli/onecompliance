    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "main",
            "queryString": "select * from entrasp.compiti where codice_azienda=$codice_azienda$ and codice_compito=$codice_compito$ and id_tipo_segnalazione!=0"
        },
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select codice_compito,entrasp.time_report_stop_active((€global_id_anagrafiche€)::text), true as time_report_play, entrasp.anagrafiche_vr_dati_identificativi(cmp.codice_part, id_cliente) as cliente_desc, data_segnalazione, data_chiusura, codice_azienda, substring(titolo from 1 for 100) as titolo, entrasp.centri_gestionali_descr(cmp.codice_part, cmp.id_centro_gest) as descr_centro_gest, entrasp.centri_gestionali_descr(cmp.codice_part, cmp.id_centro_gest_monitor) as descr_centro_gest_monitor, entrasp.compiti_count_open_compiti_sub(cmp.codice_azienda, codice_compito) as conta_aperti, entrasp.tipo_segnalazione_descr_new(id_tipo_segnalazione) as tipo_segnalazione, entrasp.transcodifiche_transcodifica('STATO_WHISTLE', stato) as stato from entrasp.compiti cmp left join entrasp.anagrafiche_id an on cmp.codice_part=an.codice_part and cmp.id_responsabile=an.id_anagrafica where cmp.codice_azienda=$codice_azienda$ and id_tipo_segnalazione=750 and (an.dynamo_user='€global_username€' or entrasp.idutente_from_aziende_utenti((€global_id_anagrafiche€)::text, '€global_codice_part€')::numeric in (select id_anagrafica from entrasp.gruppi_lavoro_membri where codice_part='€global_codice_part€' and id_gruppo_lavoro=-2))"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "select entrasp.sos_after_insertupdate($codice_azienda$, '€global_username€'::varchar, $codice_compito$);"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "select entrasp.sos_after_insertupdate($codice_azienda$, '€global_username€'::varchar, $codice_compito$);"
        },
        {
            "operation": "delete",
            "type": "main",
            "queryString": "select entrasp.delete_whistleblowing($codice_azienda$, '€global_username€'::varchar, $codice_compito$)"
        }
    ],
