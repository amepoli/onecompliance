            "type": "main"
        },
        {
            "operation": "update",
            "type": "main",
            "queryString": "update entrasp.odg_riunioni odg set id_anagrafica=coalesce ($id_anagrafica$, odg.id_anagrafica), data_riunione=coalesce ($data_riunione$,odg.data_riunione), ora_inizio=coalesce ($ora_inizio$, odg.ora_inizio), durata=coalesce ($durata$,odg.durata), id_argomento_settore=coalesce($id_argomento_settore$, odg.id_argomento_settore), cantiere=coalesce ($cantiere$, odg.cantiere), id_argomento_controllo = coalesce ($id_argomento_controllo$, odg.id_argomento_controllo), id_argomento_funzione = coalesce(nullif(string_to_array(trim(both '[]' from '$id_argomento_funzione$'), ', '),'{}'), odg.id_argomento_funzione) where odg.id_odg||'~'||odg.id_riunione||'~'||odg.codice_azienda||'~'||odg.id_contratto in (select unnest(ARRAY[$selected_rows_data$]))"
        }
