    "addElementSettings": {
        "labelAdd": "Nuovo Template Riunione",
        "navigateOnSuccess": false
    },
    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "preProcessing",
            "queryString": "update entrasp.template_riunioni tmplrn set codice_part=az.codice_part from entrasp.aziende az WHERE tmplrn.codice_azienda=az.codice_azienda and id_templ_riunione=$id_templ_riunione$;"
        },
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select id_templ_riunione, codice_protocollo, oggetto, entrasp.argomenti_descr(id_argomento) as descr_riunione, data_riunione, entrasp.time_report_stop_active((€global_id_anagrafiche€)::text), true as time_report_play, codice_azienda,  entrasp.centri_gestionali_descr(codice_part, id_centro_gest) as descr_centro_gest, entrasp.transcodifiche_transcodifica('STATO_COMPITI', stato) as stato from entrasp.template_riunioni where (codice_azienda is null or codice_azienda='€global_codice_azienda€')"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "UPDATE entrasp.templ_riunioni cmp set codice_part=az.codice_part from entrasp.aziende az where cmp.codice_azienda=az.codice_azienda"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "update entrasp.templ_riunioni cmp set codice_part=az.codice_part from entrasp.aziende az where cmp.codice_azienda=az.codice_azienda"
        },
        {
            "type": "main",
            "operation": "stopEvent",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
        },
        {
            "type": "main",
            "operation": "startEvent",
            "queryString": "select entrasp.business_object_play((€global_id_anagrafiche€)::text, 'template_riunioni, $id_template_riunione$, '$codice_azienda$'::varchar)"
        }
    ],
