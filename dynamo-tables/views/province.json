{
    "$schema": "../views.schema.json",
    "entryKey": "province",
    "origin": "entrasp.province",
    "businessObjectName": "province",
    "predefinedQueries": [
        {
            "type": "main",
            "queryString": "select codice_provincia,rischio_giudizio, codice_regione, sigla_provincia, descrizione, CASE WHEN flag_a_rischio = true THEN 'Alto' ELSE 'Basso' END as descr_rischio, CASE WHEN flag_a_rischio_2 = true THEN 'Alto' ELSE 'Basso' END as descr_rischio_2, (select descrizione from entrasp.regioni where codice_regione=p.codice_regione) as descr_regione from entrasp.province p",
            "operation": "selectTable"
        }
    ],
    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menuProvince",
            "label": "Azioni",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "update_rischio",
                    "icon": "swap_vert",
                    "label": "Modifica il livello di rischio",
                    "confirmAction": true,
                    "confirmActionMessage": "Modificare il livello di rischio? Alto -> Basso | Basso -> Alto",
                    "query": "select entrasp.modifica_rischio_province(array[$selected_rows_data$])",
                    "reloadOnSuccess": true
                }
            ]
        }
    ],
    "table_keys": [
