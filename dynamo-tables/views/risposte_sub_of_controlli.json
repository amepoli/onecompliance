  "predefinedQueries": [
    {
      "operation": "selectTable",
      "queryString": "select rp.*, $id_argomento_generale$ as id_argomento_generale, $id_argomento_primo_strato$ as id_argomento_primo_strato, substring (entrasp.domande_descrizione(rp.codice_azienda, rp.id_modello_test, rp.id_modello_test_vr, rp.id_domanda),1,200) as descr_domanda, entrasp.risposte_previste_risposta(rp.codice_azienda, rp.id_modello_test, rp.id_modello_test_vr, rp.id_domanda, rp.id_risposta_prev) as risposta_prev_descr, substring (rp.risposta,1,150) as risposta_sint, substring(rp.note,1,100) as note_sint from entrasp.risposte rp inner join entrasp.domande dmd on rp.codice_azienda=dmd.codice_azienda and rp.id_modello_test=dmd.id_modello_test and rp.id_modello_test_vr=dmd.id_modello_test_vr and rp.id_domanda=dmd.id_domanda where rp.codice_azienda=$codice_azienda$ and dmd.id_argomento in (select unnest(elenco_argomenti_controlli) from entrasp.controlli_configuration where id_argomento_primo_strato=$id_argomento_primo_strato$ and id_argomento_generale=$id_argomento_generale$)",
      "type": "main"
    }
  ],
