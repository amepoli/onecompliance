     "label": "Id Verifica",
      "translate": "RESOURCES.id_check",
      "newLine": true,
      "queryCond": "ss.id_somministrazione=$id_somministrazione$"
    },
    {
      "format": {
        "comboQuery": "select id_modello_test as id, id_modello_test||'-'||titolo as name from entrasp.modelli_test where codice_azienda=$codice_azienda$",
