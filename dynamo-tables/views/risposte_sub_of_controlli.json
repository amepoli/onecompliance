  "exportQueries": {
    "tableQueries": [
      {
        "label": "Riepilogo risposte possibili e date",
        "queryString": "SELECT rp.* FROM entrasp.grc_riepilogo_risposte rp inner join entrasp.sondaggi snd on rp.id_sondaggio=snd.id_sondaggio and rp.codice_azienda=snd.codice_azienda inner join entrasp.sondaggi_somministrati ss on snd.codice_azienda=ss.codice_azienda and snd.id_sondaggio=ss.id_sondaggio where rp.codice_azienda=$codice_azienda$"
      },
      {
        "label": "Riepilogo Risposte Date",
        "queryString": "SELECT rp.* FROM entrasp.grc_riepilogo_risposte_date rp where rp.codice_azienda=$codice_azienda$"
      }
    ]
  },
  "search_keys": [
    {
      "fieldName": "id_modello_test_s",
      "format": {
        "comboQuery": "SELECT id_modello_test AS id, id_modello_test||'-'||titolo  AS name  FROM entrasp.modelli_test WHERE codice_azienda=$codice_azienda$ order by id_modello_test;",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Id Modello di Verifica",
      "newLine": false,
      "queryCond": "rp.id_modello_test=$id_modello_test_s$"
    },
    {
      "fieldName": "id_sondaggio",
      "format": {
        "dataType": "number",
