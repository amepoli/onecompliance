        "dataType": "number",
        "viewType": "input"
      },
      "label": "Id Domanda",
      "newLine": false,
      "queryCond": "rp.id_domanda=$id_domanda_s$"
    },
    {
      "fieldName": "id_risposta_prev",
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "label": "ID Risposta Prev",
      "newLine": false,
      "queryCond": "rp.id_risposta_prev =$id_risposta_prev$"
    },
    {
      "fieldName": "data_comp",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data Competenza",
            "translate": "RESOURCES.reference_date",
      "newLine": false,
      "queryCond": "snd.data_comp='€data_comp€'"
    },
    {
      "format": {
        "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
        "options": [],
        "viewType": "combobox",
        "dataType": "text"
      },
      "fieldName": "stato_s",
      "label": "Stato",
      "translate": "RESOURCES.status",
      "newLine": true,
      "queryCond": "ss.stato='€stato_s€'"
    },
    {
      "fieldName": "object_description",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Oggetto di verifica",
      "translate": "RESOURCES.check_subject",
      "newLine": false,
      "queryCond": "(UPPER (ss.object_description) like '%'||UPPER('€object_description€')||'%')"
    },
    {
      "format": {
        "comboQuery": "select prg.id_progetto as id, concat (prg.id_progetto, ' - ', prg.titolo) as name from entrasp.progetti prg where prg.codice_azienda=$codice_azienda$",
        "options": [],
        "viewType": "combobox",
        "dataType": "text"
      },
      "fieldName": "progetto_s",
      "label": "Progetto",
      "newLine": true,
      "queryCond": "ss.id_sondaggio in(select id_sondaggio from entrasp.progetti_fasi pf where id_progetto=$progetto_s$ and codice_azienda=$codice_azienda$)"
    },
    {
      "fieldName": "data_esec_prevista_min",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Esecuzione Prevista dopo il",
      "translate": "RESOURCES.execution_scheduled_after",
      "newLine": false,
      "queryCond": "snd.data_prevista>='€data_esec_prevista_min€'"
    },
    {
      "fieldName": "data_esec_prevista_max",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Esecuzione Prevista entro il",
      "translate": "RESOURCES.execution_scheduled_by",
      "newLine": false,
      "queryCond": "snd.data_prevista<='€data_esec_prevista_max€'"
    },
    {
      "fieldName": "data_esec_min",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data Esecuzione dopo il",
      "newLine": false,
      "queryCond": "snd.data_esecuzione>='€data_esec_min€'"
    },
    {
      "fieldName": "data_esec_max",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data Esecuzione entro il",
      "newLine": false,
      "queryCond": "(snd.data_esecuzione<='€data_esec_max€' and snd.data_esecuzione is not null) or (ss.data_esecuzione<='€data_esec_max€' and ss.data_esecuzione is not null)"
    },
    {
      "fieldName": "incompleto_s",
      "format": {
        "viewType": "checkbox",
        "value": "0"
      },
      "label": "Incompleto",
            "translate": "RESOURCES.incomplete",
      "newLine": false,
      "queryCond": "ss.somministrazione_completata!='Completo'"
    },
    {
      "fieldName": "no_giudizio",
      "format": {
        "viewType": "checkbox",
        "value": "0"
      },
       "label": "Senza giudizio",
      "translate": "RESOURCES.whitout_judgment",
      "newLine": false,
      "queryCond": "ss.giudizio is null"
    },
    {
      "fieldName": "flag_ultimo_modello_test",
      "format": {
        "value": "0",
        "viewType": "checkbox"
      },
      "label": "Ultimo Modello Verifica",
      "newLine": false,
      "queryCond": "entrasp.is_max_modello_test(ss.codice_azienda, ss.id_sondaggio)"
    },
    {
      "fieldName": "flag_ultimo_modello_test_rett",
      "format": {
        "value": "0",
        "viewType": "checkbox"
      },
      "label": "Ultimo Modello Verifica Rett.",
      "newLine": false,
      "queryCond": "entrasp.is_max_modello_test_rett(ss.codice_azienda, ss.id_sondaggio)"
    },
    {
      "fieldName": "flag_ultimo_per_cliente",
      "format": {
        "viewType": "checkbox"
      },
      "label": "Ultimo per Cliente/Sottostante",
      "newLine": false,
      "queryCond": "entrasp.is_max_object_key(ss.codice_azienda, ss.id_sondaggio, ss.id_somministrazione)"
    },
    {
      "fieldName": "flag_ultimo_per_cliente_rett",
      "format": {
        "viewType": "checkbox"
      },
      "label": "Ultimo per Cliente/Sottostante Rett.",
      "newLine": false,
      "queryCond": "entrasp.is_max_object_key_rett(ss.codice_azienda, ss.id_sondaggio, ss.id_somministrazione)"
    }
