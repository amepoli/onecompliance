                "label": "Estrazione per mailing list",
                "queryString": "select tn.id_testo_normativo, riferimenti, tn.descrizione, data_entrata_vigore, tn.note, link_ipertestuale, tna.data_aggiornamento, tna.note as note_aggiornamento, articoli_commento, (select string_agg(entrasp.argomenti_descr_breve_no_num(id_argomento_father), ', ') from entrasp.argomenti_argomenti where id_argomento_son=id_argomento and id_argomento_father!=48418) as tag from entrasp.testi_normativi tn left join entrasp.testi_normativi_aggiornamenti tna on tn.id_testo_normativo=tna.id_testo_normativo order by greatest(data_aggiornamento, data_entrata_vigore) desc"
