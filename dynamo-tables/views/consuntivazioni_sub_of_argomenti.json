{
    "$schema": "../views.schema.json",
    "entryKey": "consuntivazioni_sub_of_argomenti",
    "origin": "entrasp.consuntivazioni",
    "inheritsFrom": "consuntivazioni_consultant_list",
    "define": {
        "_and_": "csn.id_argomento=$id_argomento$",
        "same_origin": "true",
        "is_hidden_esecutore": "true",
        "is_hidden_time_report": "false"
    },
    "search_keys": [
        {
            "fieldName": "id_cons",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Id Consuntivazione",
            "newLine": false,
            "queryCond": "id_cons=$id_cons$",
            "translate": "RESOURCES.id_consuntivazione_consuntivazioni_sub_of_argomenti"
        },
        {
            "format": {
                "comboQuery": "SELECT codice_azienda AS id, codice_azienda AS name FROM entrasp.aziende where codice_azienda in(€global_user_companies€) order by codice_azienda;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "queryCond": "csn.codice_azienda='€codice_azienda_s€'",
            "fieldName": "codice_azienda_s",
            "label": "Codice Azienda",
            "newLine": false,
            "size": 2,
            "translate": "RESOURCES.codice_azienda_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "data_esec_prevista_min",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Esecuzione dopo il",
            "newLine": false,
            "queryCond": "csn.data_intervento>='€data_esec_prevista_min€'",
            "translate": "RESOURCES.esecuzione_dopo_il_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "data_esec_prevista_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Esecuzione prima del",
            "newLine": false,
            "queryCond": "csn.data_intervento<='€data_esec_prevista_max€'",
            "translate": "RESOURCES.esecuzione_prima_del_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "parola_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola chiave",
            "newLine": true,
            "queryCond": "(upper(csn.note) like '%'||upper('€parola_search€')||'%' or upper(csn.titolo) like '%'||upper('€parola_search€')||'%'",
            "translate": "RESOURCES.parola_chiave_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "durata_ft_min",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Durata fatturazione maggiore di",
            "newLine": false,
            "queryCond": "csn.durata_ft>=$durata_ft_min$",
            "translate": "RESOURCES.durata_fatturazione_maggiore_di_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "durata_min",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Durata maggiore di",
            "newLine": false,
            "queryCond": "csn.durata>=$durata_min$",
            "translate": "RESOURCES.durata_maggiore_di_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "dynamo_user_s",
            "format": {
                "comboQuery": "select distinct dynamo_user as id, dynamo_user as name from entrasp.anagrafiche_id order by dynamo_user;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "User",
            "newLine": false,
            "queryCond": "csn.codice_part||'-'||csn.id_risorsa in(select codice_part||'-'||id_anagrafica from entrasp.anagrafiche_id where dynamo_user='€dynamo_user_s€')",
            "translate": "RESOURCES.user_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "stato",
            "format": {
                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Stato",
            "newLine": true,
            "queryCond": "csn.stato='€stato€'",
            "translate": "RESOURCES.stato_consuntivazioni_sub_of_argomenti"
        },
        {
            "fieldName": "open",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Aperti",
            "newLine": true,
            "size": 2,
            "queryCond": "csn.stato!='C'",
            "translate": "RESOURCES.aperti_consuntivazioni_sub_of_argomenti"
        }
    ],
    "hideActions": [
        {
            "formActionType": "add",
            "viewType": "form"
        },
        {
            "tableActionType": "quick-add",
            "viewType": "table"
        },
        {
            "tableActionType": "add",
            "viewType": "table"
        }
    ]
}