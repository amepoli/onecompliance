{
    "$schema": "../views.schema.json",
    "inheritsFrom": "compiti_consultant",
    "entryKey": "user_sub_of_azienda",
    "predefinedQueries": [
        {
            "type": "main",
            "operation": "selectForm",
            "queryString": "select distinct $codice_azienda$ as codice_azienda, coalesce(an.nome||' '||an.cognome, avr.ragione_sociale) as nmrs, dynamo_user, entrasp.consuntivazioni_time_consumed_azienda($codice_azienda$, datainizio=>'2021-01-01'::date, datafine=>'2022-12-31'::date, dynamouser=>an.dynamo_user) as time_consumed, $codice_azienda$ as codice_azienda FROM entrasp.anagrafiche_id an inner join entrasp.anagrafiche_vr avr on an.id_anagrafica=avr.id_anagrafica where an.dynamo_user=$dynamo_user$ and an.codice_part=(select codice_part from entrasp.aziende where codice_azienda=$codice_azienda$)"
        },
        {
            "type": "main",
            "operation": "selectTable",
            "queryString": "select distinct codice_azienda, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as nmrs, an.dynamo_user, entrasp.consuntivazioni_time_consumed_azienda(codice_azienda, datainizio=>'2021-01-01'::date, datafine=>'2022-12-31'::date, dynamouser=>an.dynamo_user) as time_consumed FROM entrasp.anagrafiche_id an inner join entrasp.aziende az on an.codice_part=az.codice_part and az.codice_azienda=$codice_azienda$ and an.dynamo_user is not null;"
        }
    ],
