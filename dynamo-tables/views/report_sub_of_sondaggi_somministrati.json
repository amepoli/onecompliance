{
    "$schema": "../views.schema.json",

    "entryKey": "report_sub_of_sondaggi_somministrati",
    "inheritsFrom": "argomenti_report",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select ar.*,entrasp.report_description(id_report) as report, ss.id_somministrazione, snd.codice_azienda, snd.id_sondaggio from entrasp.argomenti_report ar inner join entrasp.modelli_test mt on ar.id_argomento=mt.id_argomento inner join entrasp.sondaggi snd on mt.codice_azienda=snd.codice_azienda and mt.id_modello_test=snd.id_modello_test inner join entrasp.sondaggi_somministrati ss on snd.codice_azienda=ss.codice_azienda and snd.id_sondaggio=ss.id_sondaggio where snd.codice_azienda=$codice_azienda$ and snd.id_sondaggio=$id_sondaggio$ and ss.id_somministrazione=$id_somministrazione$ and ar.id_tipo=52045"
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "id_argomento",
            "label": "ID",
            "translate": "RESOURCES.id_argomento"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "id_report",
            "width": "5%",
            "label": "ID"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "report",
            "queryFunct": "entrasp.report_description(id_report)",
            "label": "Report",
            "width": "15%"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_sondaggio",
            "label": "ID"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_somministrazione",
            "label": "ID"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "codice_azienda",
            "label": "Azienda"
        }
    ]
}
