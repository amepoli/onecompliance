{
  "$schema": "../views.schema.json",
  "entryKey": "attachments_linkable",
  "inheritsFrom": "attachments",
  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectTable",
      "queryString": "select *, true as sostituisci_risorsa, $id_risorsa_rep$ as id_risorsa_rep, $prog_revisione_rep$ as prog_revisione_rep, entrasp.argomenti_descr_stato(rev_id_argomento_stato) as descr_stato, entrasp.odg_data(codice_azienda, id_odg, id_riunione) as data_riunione, entrasp.riunioni_descr(id_riunione, codice_azienda) as riunione_descr, entrasp.odg_titolo_esteso(codice_azienda, id_odg, id_riunione) as titolo_odg from entrasp.views_attachments_fast_no_bo rev where codice_azienda=$codice_azienda$ and id_argomento_tipo_allegato=$id_argomento_tipo_allegato$"
    },
    {
      "type": "main",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set id_riunione=$id_riunione$, cod_rev=$cod_rev$, data_rif_a=$data_rif_a$,id_odg=$id_odg$ where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "postProcessing",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set client_file_name= 'n/a', content_type= 'n/a' where id_argomento_stato!=4035 and client_file_name='tbd' and content_type='tbd'and codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "main",
      "operation": "delete",
      "queryString": "delete from entrasp.cdms_risorse_revisioni where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    }
  ],
