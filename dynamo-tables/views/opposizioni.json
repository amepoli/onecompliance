            "newLine": false,
            "key": "rating",
            "insertUpdateFunct": "SELECT LEAST(MIN(arg.punteggio),opp.contestazione_credito, opp.quantum_interessi) AS punteggio_minimo FROM entrasp.opposizioni opp CROSS JOIN LATERAL unnest(opp.id_argomento_opposizione) AS id_arg INNER JOIN entrasp.argomenti arg    ON arg.id_argomento = id_arg WHERE opp.codice_azienda = $codice_azienda$  AND opp.id_opposizione = $id_opposizione$ group by opp.contestazione_credito, opp.quantum_interessi",
            "label": "Punteggio Minimo",
            "readOnly": true,
            "size": 1
        },
        {
            "autoGenerate": false,
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "isHidden": false,
            "isPrimary": false,
            "newLine": false,
            "insertUpdateFunct": "select case WHEN rating IN (0, 1, 2) THEN 100 WHEN rating = 3 THEN 70 WHEN rating = 4 THEN 60 WHEN rating = 5 THEN 50 WHEN rating = 6 THEN 40 WHEN rating = 7 THEN 30 WHEN rating IN (8, 9, 10) THEN 0 ELSE NULL END from entrasp.opposizioni where codice_azienda = $codice_azienda$  AND id_opposizione = $id_opposizione$",
