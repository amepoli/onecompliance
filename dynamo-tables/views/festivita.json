        },
        {
            "format": {
                "dataType": "datetime"
            },
            "label": "Fine",
            "key": "date_time_end",
            "isHidden": false,
            "isPrimary": false,
            "width": "15%",
            "translate": "RESOURCES.fine_festivita"
        },
        {
            "format": {
                "dataType": "text"
            },
            "label": "Note",
            "key": "descrizione",
            "isHidden": false,
            "isPrimary": false,
            "width": "20%",
            "translate": "RESOURCES.note_festivita"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by data asc"
    },
    "hideActions": [
        {
            "viewType": "form",
            "formActionType": "attachments"
        }
    ]
}