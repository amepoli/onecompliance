{
    "$schema": "../views.schema.json",
    "entryKey": "festivita",
    "origin": "entrasp.festivita",
    "businessObjectName": "festivita",
    "define": {
        "is_hidden_codice_azienda": "true",
        "is_hidden_dynamo_user": "true"
    },
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select * from entrasp.festivita where dynamo_user is null and (codice_azienda is null or codice_azienda='€global_codice_azienda€')"
        }
    ],
    "form_keys": [
        {
            "autoGenerate": false,
            "format": {
                "viewType": "input",
                "dataType": "text"
            },
            "label": "codice_azienda",
            "key": "codice_azienda",
            "readOnly": false,
            "isHidden": "$Q{is_hidden_codice_azienda}",
            "isPrimary": false,
            "newLine": false,
            "translate": "RESOURCES.codice_azienda_festivita"
        },
        {
            "autoGenerate": false,
            "format": {
                "viewType": "input",
                "dataType": "text"
            },
            "label": "dynamo_user",
            "key": "dynamo_user",
            "readOnly": false,
            "isHidden": "$Q{is_hidden_dynamo_user}",
            "isPrimary": false,
            "newLine": false,
            "translate": "RESOURCES.dynamo_user_festivita"
        },
        {
            "autoGenerate": true,
            "format": {
                "viewType": "input",
                "dataType": "text"
            },
            "label": "Codice",
            "key": "codice",
            "readOnly": false,
            "isHidden": true,
            "isPrimary": true,
            "newLine": false,
            "translate": "RESOURCES.codice_festivita"
        },
        {
            "autoGenerate": false,
            "format": {
                "viewType": "input",
                "dataType": "date"
            },
            "label": "Data",
            "key": "data",
            "readOnly": false,
            "isHidden": false,
            "isPrimary": false,
            "newLine": true,
            "translate": "RESOURCES.data_festivita"
        }
    ],
    "search_keys": [
        {
            "fieldName": "flag_anno_corrente",
            "format": {
                "value": "1",
                "viewType": "toggle"
            },
            "label": "Anno corrente",
            "newLine": false,
            "queryCond": "extract(year from data)=extract( year from current_date)",
            "translate": "RESOURCES.anno_corrente_festivita"
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "text"
            },
            "label": "Azienda",
            "key": "codice_azienda",
            "isHidden": "$Q{is_hidden_codice_azienda}",
            "isPrimary": false,
            "width": "10%",
            "translate": "RESOURCES.azienda_festivita"
        },
        {
            "format": {
                "dataType": "text"
            },
            "label": "Codice",
            "key": "codice",
            "isHidden": true,
            "isPrimary": true,
            "width": "10%",
            "translate": "RESOURCES.codice_festivita"
        },
        {
            "format": {
                "dataType": "date"
            },
            "label": "Data",
            "key": "data",
            "isHidden": false,
            "isPrimary": false,
            "width": "15%",
            "translate": "RESOURCES.data_festivita"
        },
        {
            "format": {
                "dataType": "text"
            },
            "label": "Utente",
            "key": "dynamo_user",
            "isHidden": "$Q{is_hidden_dynamo_user}",
            "isPrimary": false,
            "translate": "RESOURCES.utente_festivita"
