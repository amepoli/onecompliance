{
	"$schema": "../views.schema.json",
	"entryKey": "festivita",
	"origin": "entrasp.festivita",
	"businessObjectName": "festivita",
	"define": {
        "is_hidden_codice_azienda": "true",
		"is_hidden_dynamo_user": "true"
    },
	"predefinedQueries": [
		{
			"operation": "selectTable",
			"type": "main",
			"queryString": "select * from entrasp.festivita where dynamo_user is null and (codice_azienda is null or codice_azienda='€global_codice_azienda€')"
		}
	],
	"form_keys": [
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "codice_azienda",
      "translate": "RESOURCES.company_code",
            "translate": "RESOURCES.company_code",
			"key": "codice_azienda",
			"readOnly": false,
			"isHidden": "$Q{is_hidden_codice_azienda}",
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "dynamo_user",
			"key": "dynamo_user",
			"readOnly": false,
			"isHidden": "$Q{is_hidden_dynamo_user}",
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": true,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Codice",
      "translate": "RESOURCES.code",
			"key": "codice",
			"readOnly": false,
			"isHidden": true,
			"isPrimary": true,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "date"
			},
			"label": "Data",
			"key": "data",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		}
	],
	"search_keys": [
		{
            "fieldName": "flag_anno_corrente",
            "format": {
                "value": "1",
                "viewType": "toggle"
            },
            "label": "Anno corrente",
            "newLine": false,
            "queryCond": "extract(year from data)=extract( year from current_date)"
        }
	],
	"table_keys": [
		{
			"format": {
				"dataType": "text"
			},
			"label": "Azienda",
			"key": "codice_azienda",
			"isHidden": "$Q{is_hidden_codice_azienda}",
			"isPrimary": false,
			"width": "10%"
		},
		{
			"format": {
				"dataType": "text"
			},
			"label": "Codice",
      "translate": "RESOURCES.code",
			"key": "codice",
			"isHidden": true,
			"isPrimary": true,
			"width": "10%"
		},
		{
			"format": {
				"dataType": "date"
			},
			"label": "Data",
			"key": "data",
			"isHidden": false,
			"isPrimary": false,
			"width": "15%"
		},
		{
			"format": {
				"dataType": "text"
			},
			"label": "Utente",
			"key": "dynamo_user",
			"isHidden": "$Q{is_hidden_dynamo_user}",
			"isPrimary": false
		},
		{
			"format": {
				"dataType": "datetime"
			},
			"label": "Inizio",
			"key": "date_time_begin",
			"isHidden": false,
			"isPrimary": false,
			"width": "15%"
		},
		{
			"format": {
				"dataType": "datetime"
			},
			"label": "Fine",
			"key": "date_time_end",
			"isHidden": false,
			"isPrimary": false,
			"width": "15%"
		},
		{
			"format": {
				"dataType": "text"
			},
			  "label": "Note",
      "translate": "RESOURCES.notes",
            "translate": "RESOURCES.notes",
			"key": "descrizione",
			"isHidden": false,
			"isPrimary": false,
			"width": "20%"
		}
	],
	"querySuffixes": {
		"tableViewSuffix": "order by data asc"
	},
	"hideActions": [
		{
			"viewType": "form",
			"formActionType": "attachments"
		}
	]
}