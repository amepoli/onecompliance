		{
			"format": {
				"dataType": "text"
			},
			"label": "Soggetto rilevante",
			"key": "soggetto_rilevante",
			"isHidden": false,
			"isPrimary": false,
			"queryFunct": "SELECT concat(codice, ' - ', nome, ' ', cognome) as name from entrasp.anagrafiche_id an WHERE codice_part='€global_codice_part€' and an.id_anagrafica=operazioni_personali.id_soggetto_rilevante"
		}
	],
	"subTables": [
		{
			"entryKey": "operations_in_black_out_periods",
			"keys": [
			  {
				"parent": "codice_azienda",
				"son": "codice_azienda"
			  },
			  {
				"parent": "id_operazione",
				"son": "id_operazione"
			  }
			],
			"label": "Periodi di black-out"
		  }
	],
	"search_keys": [
		{
			"fieldName": "id_strumento_fin_s",
			"format": {
				"comboQuery": "SELECT an.id_anagrafica as id , entrasp.anagrafiche_vr_dati_identificativi_nom1(an.codice_part, an.id_anagrafica) as name FROM entrasp.anagrafiche_id an JOIN entrasp.anagrafiche_vr avr ON an.codice_part=avr.codice_part AND an.id_anagrafica=avr.id_anagrafica join entrasp.ruoli_anagrafiche ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica WHERE an.codice_part='€global_codice_part€' and avr.prog_vr=entrasp.anagrafiche_vr_max('€global_codice_part€', an.id_anagrafica) and codice_ruolo = 'FONDO';",
				"options": [],
				"viewType": "combobox"
			},
			"label": "Fondo/strumento finanziario",
			"newLine": false,
			"queryCond": "id_strumento_finanziario=$id_strumento_fin_s$"
		}
	],
	"hideActions": [
		{
			"tableActionType": "quick-add",
			"viewType": "table"
		},
		{
