			"key": "id_operazione",
			"readOnly": true,
			"isHidden": false,
			"isPrimary": true,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT id_anagrafica AS id, concat(codice, ' - ', nome, ' ', cognome) as name from entrasp.anagrafiche_id an WHERE codice_part='€global_codice_part€';",
				"options": [],
				"viewType": "combobox",
				"validations": [
                    {
                        "message": "Necessario specificare il soggetto!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
			},
			"label": "Soggetto rilevante",
			"key": "id_soggetto_rilevante",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
