			"key": "id_strumento_finanziario",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"dataType": "date",
				"viewType": "input",
				"validations": [
                    {
                        "message": "Data operazione necessaria!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_op",
			"label": "Data Operazione",
			"newLine": false,
			"size": 2,
			"readOnly": false
		},
		{
			"autoGenerate": false,
			"format": {
				"dataType": "date",
				"viewType": "input"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_valuta",
			"label": "Data Valuta",
			"newLine": true,
			"size": 2,
			"readOnly": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "note",
			"key": "note",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
			  "comboQuery": "select id_argomento as id, id_argomento||'-'||descrizione_breve as name from entrasp.argomenti arg where arg.id_argomento in(select entrasp.descendants_of_argomento(45426, 2)) order by arg.descrizione;",
			  "options": [],
			  "viewType": "combobox",
				"validations": [
                    {
                        "message": "Necessario specificare il tipo operazione!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "id_argomento_tipo_operazione",
