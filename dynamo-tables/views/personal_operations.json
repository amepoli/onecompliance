			"size": 3.5,
			"readOnly": false
		  },
		{
			"autoGenerate": true,
			"format": {
				"viewType": "input",
				"dataType": "number",
				"validations": [
                    {
                        "message": "Necessario specificare la quantità!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
			},
			"label": "Quantità",
			"key": "quantita",
			"readOnly": true,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": true,
			"format": {
				"viewType": "input",
				"dataType": "number",
				"validations": [
                    {
                        "message": "Necessario specificare il prezzo!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
			},
			"label": "Prezzo",
			"key": "prezzo",
			"readOnly": true,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": true,
			"format": {
				"viewType": "input",
				"dataType": "number",
				"validations": [
                    {
                        "message": "Necessario specificare il controvalore!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
			},
			"label": "Controvalore",
			"key": "controvalore",
			"readOnly": true,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Analisi Insider",
			"key": "analisi_rischio_insider",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		}
	],
	"table_keys": [
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": false,
			"isPrimary": true,
			"width": "5%",
			"key": "id_operazione",
			"label": "#"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": true,
			"key": "codice_azienda",
			 "label": "codice_azienda",
            "translate": "RESOURCES.company_code"
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "id_strumento_finanziario",
			"label": "id_strumento_finanziario"
		},
		{
			"format": {
				"dataType": "text"
