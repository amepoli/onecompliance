		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT an.id_anagrafica AS id, concat(codice, ' - ', ragione_sociale) as name from entrasp.anagrafiche_vr an join  entrasp.ruoli_anagrafiche  ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica  WHERE an.codice_part='€global_codice_part€' and codice_ruolo= 'FONDO';",
				"options": [],
				"viewType": "combobox",
				"validations": [
                    {
                        "message": "Necessario specificare lo strumento!",
                        "name": "required",
                        "validator": "Validators.required"
                    }
                ]
