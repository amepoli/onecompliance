    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select id_report,codice_azienda,interval_multiplier||' '||interval_value as frequenza,lista_email_destinatari from entrasp.destinatari_report where codice_azienda in(€global_user_companies€) and id_report=$id_report$"
        },
        {
            "operation": "insert",
            "type": "main",
            "queryString": " INSERT INTO entrasp.destinatari_report ($codice_azienda$, $id_report$, $lista_email_destinatari$,(select interval_value from entrasp.intervalli_temporali where intervallo=interval), (select interval_multiplier from entrasp.intervalli_temporali where intervallo=interval));"
        }

    ],
