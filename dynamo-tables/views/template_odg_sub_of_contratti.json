{
    "$schema": "../views.schema.json",
    "inheritsFrom": "template_odg",
    "entryKey": "template_odg_sub_of_contratti",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select todg.ordinamento, todg.titolo from entrasp.articoli_contratti ac inner join entrasp.argomenti_argomenti aa on ac.id_argomento_tipo_norma=aa.id_argomento_father inner join entrasp.template_odg todg on aa.id_argomento_son=todg.id_argomento where ac.codice_azienda=$codice_azienda$ and ac.id_contratto=$id_contratto$"
        }
    ],
    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menuanag",
            "label": "Actions",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "pianifica",
                    "icon": "edit",
                    "label": "Pianifica Attività",
                    "query": "",
                    "customDialogEntryName": "XXXX",
                    "customDialogTitle": "Pianifica attività"
                }
            ]
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "width": "4%",
