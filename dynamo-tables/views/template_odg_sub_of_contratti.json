                {
                    "button_icon": "delete",
                    "value": "*"
                }
            ],
            "isButton": true,
            "buttonAction": {
                "target": "template_odg",
                "viewType": "table",
                "query": "delete from entrasp.template_odg where id_templ_riunione=£id_template_riunione£ and id_templ_odg=£id_templ_odg£",
                "action": "query",
                "keymap": [
                    {
                        "source": "id_templ_riunione",
                        "destination": "id_templ_riunione"
                    },
                    {
                        "source": "id_templ_odg",
                        "destination": "id_templ_odg"
                    }
                ],
                "confirmAction": true,
                "confirmMessage": {
                    "text": "Sei sicuro di voler cancellare il punto all'ordine del giorno?",
                    "title": "Cancellazione ordine del giorno"
                },
                "onSuccessAction": "reload"
            },
            "translate": "RESOURCES.delete_procedure_aziendali"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
