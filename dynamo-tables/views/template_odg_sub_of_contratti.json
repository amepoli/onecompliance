{
    "$schema": "../views.schema.json",
    "entryKey": "template_odg_sub_of_contratti",
    "origin": "entrasp.odg_riunioni",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select odg.id_odg, odg.id_riunione, odg.codice_azienda, todg.ordinamento, todg.titolo,odg.data_riunione as data, odg.ora_inizio as dalle,odg.ora_fine as alle, odg.id_anagrafica, odg.durata, entrasp.argomenti_descr_breve_no_num(odg.id_argomento_controllo), odg.cantiere, entrasp.argomenti_array(array [odg.id_argomento_funzione]) as funzione_valutata, entrasp.argomenti_descr_breve_no_num(odg.id_argomento_controllo) from entrasp.articoli_contratti ac inner join entrasp.argomenti_argomenti aa on ac.id_argomento_tipo_norma=aa.id_argomento_father inner join entrasp.template_odg todg on aa.id_argomento_son=todg.id_argomento left join entrasp.odg_riunioni odg on todg.id_templ_odg=odg.id_templ_odg and todg.id_templ_riunione=odg.id_templ_riunione where ac.codice_azienda=$codice_azienda$ and ac.id_contratto=$id_contratto$"
        }
    ],
