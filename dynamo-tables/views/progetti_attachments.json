{
  "$schema": "../views.schema.json",
  "entryKey": "progetti_attachments",
  "origin": "entrasp.views_attachments_fast",
  "predefinedQueries": [
    {
      "operation": "selectTable",
      "type": "main",
      "queryString": "select vaf.codice_azienda, vaf.codice_part, vaf.id_risorsa, vaf.client_file_name, pf.titolo as titolo_fase, vaf.stringa, vaf.tipo_allegato, vaf.id_sondaggio, vaf.id_progetto from entrasp.views_attachments_fast vaf left join entrasp.progetti_fasi pf on vaf.codice_azienda=pf.codice_azienda and vaf.id_sondaggio=pf.id_sondaggio where vaf.codice_azienda=$codice_azienda$ and vaf.id_progetto=$id_progetto$"
    }
  ],
