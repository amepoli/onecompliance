    "predefinedQueries": [
        {
            "type": "main",
            "operation": "selectTable",
            "queryString": "select arg.*, (select count(aa2.id_argomento_father) from entrasp.argomenti_argomenti aa2 where aa2.id_argomento_son=arg.id_argomento) as num_argomenti_padre from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=$P{id_argomento_father} and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€') $P{id_argomento_bigger_than};"
        },
        {
            "operation": "insert",
            "queryString": "select entrasp.argomenti_classification_insert($descrizione$, $descrizione$, $codice$, $P{array_argomenti_father_da_aggiungere}) as id_argomento;",
            "type": "main"
        },
        {
            "operation": "update",
            "queryString": "update entrasp.argomenti arg set descrizione_breve=replace(descrizione_breve, '/', ','), nickname=replace(nickname, '/', ',') from entrasp.argomenti_argomenti aa  where arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=3576 and (position('/' in descrizione_breve)!=0 or position('/' in nickname)!=0)",
            "type": "postProcessing"
        },
        {
            "operation": "delete",
            "queryString": "delete from entrasp.argomenti_argomenti where id_argomento_father=$P{id_argomento_father} and id_argomento_son=$id_argomento$;",
            "type": "preProcessing"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_argomento$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE descrizione_breve='£descrizione_breve£'",
            "messageNotNull": "La descrizione breve è già stata utilizzata per un altro argomento: prego verificare o attribuire una descrizione breve diversa"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti where descrizione_breve='£descrizione_breve£' and id_argomento!=$id_argomento$",
            "messageNotNull": "La descrizione breve è già stata utilizzata per un altro argomento: prego verificare o attribuire una descrizione breve diversa"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE descrizione='£descrizione£'",
            "messageNotNull": "La descrizione è già stata utilizzata per un altro argomento: prego verificare o attribuire una descrizione"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti where descrizione='£descrizione£' and id_argomento!=$id_argomento$",
            "messageNotNull": "La descrizione è già stata utilizzata per un altro argomento: prego verificare o attribuire una descrizione"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE nickname='£nickname£'",
            "messageNotNull": "La descrizione breve è già stata utilizzata per un altro argomento: prego verificare o attribuire un nickname diverso"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti where nickname='£dnickname£' and id_argomento!=$id_argomento$",
            "messageNotNull": "La descrizione breve è già stata utilizzata per un altro argomento: prego verificare o attribuire un nickname diverso"
        }
    ],
