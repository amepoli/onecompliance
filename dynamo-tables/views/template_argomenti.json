			"key": "codice",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "number"
			},
			"label": "ID",
			"key": "id_argomento",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": true,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Descrizione breve",
			"key": "descrizione_breve",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Descrizione",
			"key": "descrizione",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "combobox",
				"options": [],
				"comboQuery": "select arg.id_argomento as id, concat (arg.id_argomento, ' - ', arg.descrizione_breve) as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=$P{id_argomento_father} and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€')"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "id_argomento_nuovo",
			"label": "Argomento con cui unire il presente",
			"sameOrigin": false,
			"newLine": false,
			"readOnly": false,
			"size": 6
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "button"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "argomento_unifica_k",
			"buttonIcon": "merge_type",
			"label": "$P{label_unifica}",
			"newLine": false,
			"outputEvent": {
				"eventName": "argomento_unifica",
				"eventTrigger": "press"
			},
			"inputEvents": [
				{
					"eventName": "argomento_unifica",
					"actionType": "query",
					"condition": "none",
					"values": [],
					"queryFunct": "select entrasp.unifica_argomento($id_argomento$, $id_argomento_nuovo$)",
					"successMessage": "Done!"
				}
			],
			"readOnly": false,
			"sameOrigin": false,
			"size": 2
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "button"
			},
			"isHidden": "$Q{is_hidden_unifica_all}",
			"isPrimary": false,
			"key": "argomento_unifica_all_k",
			"buttonIcon": "merge_type",
			"label": "Unifica tutti i duplicati",
			"newLine": false,
			"outputEvent": {
				"eventName": "argomento_unifica_all",
				"eventTrigger": "press"
			},
			"inputEvents": [
				{
					"eventName": "argomento_unifica_all",
					"actionType": "query",
					"condition": "none",
					"values": [],
					"queryFunct": "select entrasp.unifica_argomento(a1.id_argomento, a2.id_argomento) from entrasp.argomenti a1 inner join entrasp.argomenti a2 on trim(a1.descrizione_breve)=trim(a2.descrizione_breve) where a1.id_argomento!=a2.id_argomento and a1.id_argomento<a2.id_argomento",
					"successMessage": "Done!"
				}
			],
			"readOnly": false,
			"sameOrigin": false,
			"size": 2
		}
	],
	"search_keys": [
		{
			"label": "codice_azienda_s",
			"format": {
				"dataType": "text",
				"viewType": "input"
			},
			"fieldName": "codice_azienda",
			"newLine": true,
			"queryCond": "arg.codice_azienda=$codice_azienda_s$"
		},
		{
			"label": "$P{label_id}",
			"format": {
				"dataType": "number",
				"viewType": "input"
			},
			"fieldName": "id_argomento_s",
			"newLine": false,
			"queryCond": "arg.id_argomento=$id_argomento_s$"
		},
		{
            "fieldName": "argomento_s",
            "format": {
                "comboQuery": "SELECT id_argomento AS id, id_argomento||'-'||descrizione AS name  FROM entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=$P{id_argomento_father} where arg.flag_classificazione=true order by descrizione",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Argomento",
            "newLine": false,
            "queryCond": "array[id_argomento]<@any(select entrasp.sotto_argomenti($argomento_s$))"
        },
		{
            "fieldName": "num_argomenti_padre_max",
            "format": {
                "viewType": "input",
				"dataType": "number"
            },
            "label": "Numero argomenti padre minore di",
            "newLine": true,
            "queryCond": "(select count(aa2.id_argomento_father) from entrasp.argomenti_argomenti aa2 where aa2.id_argomento_son=arg.id_argomento)<=$num_argomenti_padre_max$"
        }
	],
