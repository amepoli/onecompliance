				},
				{
					"value": "Non Giudicabile",
					"font_color": "grey",
					"font_weight": "500"
				}
			],
			"isPrimary": false
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": false,
			"queryFunct": "entrasp.anagrafica_key(id_cliente, codice_azienda, '|')",
			"key": "object_key",
			"label": "object_key"
		}
	],
	"querySuffixes": {
		"tableViewSuffix": "order by id_contratto desc limit 100"
	}
