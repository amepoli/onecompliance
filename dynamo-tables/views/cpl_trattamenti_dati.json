            {
                "label": "Cat.interess., finalità e basi giurid.",
                "queryString": "select entrasp.argomenti_descr_breve_no_id(td.id_argomento_conferimento) as tipo_conferimento, entrasp.argomenti_descr_breve_no_id(tdc.id_argomento_categoria) as categoria_interessati, td.id_trattamento_dati id_trattamento, td.titolo as trattamento_dati, td.descrizione, entrasp.argomenti_descr_breve_no_id(tdf.id_argomento_finalita) as finalita_trattamento, entrasp.finalita_e_basi_giuridiche_from_trattamento_dati(td.codice_azienda, td.id_trattamento_dati, tdf.id_argomento_finalita) as basi_giuridiche from entrasp.cpl_trattamenti_dati_categorie tdc inner join entrasp.cpl_trattamenti_dati td on tdc.codice_azienda=td.codice_azienda and tdc.id_trattamento_dati=td.id_trattamento_dati inner join entrasp.cpl_trattamenti_dati_finalita tdf on td.codice_azienda=tdf.codice_azienda and td.id_trattamento_dati=tdf.id_trattamento_dati where td.codice_azienda=$codice_azienda$ and tipo='categorie_interessati' order by td.id_argomento_conferimento, tdc.id_argomento_categoria, td.id_trattamento_dati, tdf.id_argomento_finalita"
            }
        ]
    }
