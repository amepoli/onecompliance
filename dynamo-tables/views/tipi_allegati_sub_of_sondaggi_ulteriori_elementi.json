  "predefinedQueries": [
    {
      "operation": "selectTable",
      "type": "preProcessing",
      "queryString": "update entrasp.cdms_risorse cd set codice_part=az.codice_part from entrasp.aziende az where cd.codice_azienda=az.codice_azienda and cd.codice_part is null;"
    },
    {
      "operation": "selectTable",
      "queryString": "select case when crs.id_argomento_stato!=4035 then true else false end as delete_documents, entrasp.anagrafiche_vr_dati_identificativi_nom(crs.codice_part, crs.id_anagrafica) as anagrafica_descr,entrasp.argomenti_descr_breve(crs.id_argomento_tipo_allegato) as tipo_allegato,entrasp.argomenti_descr_stato(id_argomento_stato) as descr_stato, crs.codice_azienda,crs.codice_part,crs.id_risorsa,crs.data_rif,crs.nickname, crs.descrizione_breve, crs.descrizione, entrasp.centri_gestionali_descr(crs.codice_part, crs.id_centro_gest) as centro_gest,crs.data_scadenza, crs.descrizione FROM entrasp.cdms_risorse crs INNER JOIN entrasp.cdms_risorse_oggetti cdr ON cdr.codice_azienda=crs.codice_azienda and cdr.id_risorsa=crs.id_risorsa WHERE crs.codice_azienda=$codice_azienda$ AND cdr.id_sondaggio=$id_sondaggio$",
      "type": "main"
    },
    {
        "operation": "stopEvent",
        "type": "main",
        "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text);"
    },
    {
        "operation": "startEvent",
        "type": "main",
        "queryString": "select entrasp.business_object_play((€global_id_anagrafiche€)::text, 'risorse', $id_risorsa$, '$codice_azienda$'::varchar) as play_time_report"
    }
  ],
