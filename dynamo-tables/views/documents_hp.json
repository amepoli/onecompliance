  "search_keys": [
    {
      "fieldName": "id_risorsa_s",
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "label": "ID Documento",
      "newLine": false,
      "queryCond": "crs.id_risorsa=$id_risorsa_s$"
    },
    {
      "fieldName": "id_argomento_tipo_allegato_s",
      "format": {
        "comboQuery": "select id_argomento as id, id_argomento||'-'||descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=3576 and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€') order by descrizione asc;",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Tipo Documento",
      "newLine": false,
      "queryCond": "crs.id_argomento_tipo_allegato=$id_argomento_tipo_allegato_s$"
    },
    {
      "fieldName": "id_centro_gest_s",
      "format": {
        "comboQuery": "SELECT id_centro_gest AS id, id_centro_gest||'-'||descrizione AS name  FROM entrasp.centri_gestionali WHERE codice_part='€global_codice_part€' order by descrizione;",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Centro Gestionale Responsabile",
      "newLine": false,
      "queryCond": "crs.id_centro_gest=$id_centro_gest_s$"
    },
    {
      "fieldName": "id_anagrafica_s",
      "format": {
        "comboQuery": "SELECT an.id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name from entrasp.anagrafiche_id an WHERE an.codice_part='€global_codice_part€' order by entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) asc;",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Cliente/Fornitore/Dipendente",
      "newLine": false,
      "queryCond": "crs.id_anagrafica=$id_anagrafica_s$"
    },
    {
      "fieldName": "id_anagrafica_s",
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "label": "ID Anagrafica",
      "newLine": true,
      "queryCond": "crs.id_anagrafica=$id_anagrafica_s$"
    },
    {
      "fieldName": "autore_s",
      "format": {
        "comboQuery": "select distinct autore as id, autore as name from entrasp.cdms_risorse where codice_azienda=$codice_azienda$;",
        "options": [],
        "viewType": "combobox",
        "dataType": "text"
      },
      "label": "Utente",
      "newLine": false,
      "queryCond": "crs.autore=$autore_s$"
    },
    {
      "fieldName": "data_da_s",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data creazione da",
      "newLine": false,
      "queryCond": "crs.data_creazione>=$data_da_s$"
    },
    {
      "fieldName": "data_a_s",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data creazione a",
      "newLine": false,
      "queryCond": "crs.data_creazione<=$data_a_s$"
    },
    {
      "fieldName": "data_scad_da_s",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data scad. da",
      "newLine": false,
      "queryCond": "crs.data_scadenza>=$data_scad_da_s$"
    },
    {
      "fieldName": "data_scad_a_s",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data scad. a",
      "newLine": false,
      "queryCond": "crs.data_scadenza<=$data_scad_a_s$"
    },
    {
      "fieldName": "parola_search_s",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Parola chiave",
      "newLine": false,
      "queryCond": "(upper(crs.client_file_name) like '%'||upper('€parola_search_s€')||'%')"
    },
    {
      "fieldName": "stato_search",
      "format": {
        "dataType": "text",
        "viewType": "combobox",
        "comboQuery": "select distinct id_argomento_stato as id, entrasp.argomenti_descr_stato(id_argomento_stato) as name from entrasp.cdms_risorse where codice_azienda=$codice_azienda$;",
        "options": []
      },
      "label": "Stato",
      "newLine": true,
      "queryCond": "crs.id_argomento_stato=$stato_search$"
    },
    {
      "fieldName": "scaduto_s",
      "format": {
        "value": "0",
        "viewType": "checkbox"
      },
      "label": "Scaduto",
      "newLine": false,
      "queryCond": "data_scadenza<=current_date and id_argomento_stato not in(4035, 5327)"
    },
    {
      "fieldName": "scaduto_s_togg",
      "format": {
        "value": "0",
        "viewType": "toggle"
      },
      "label": "Scaduto",
      "newLine": false,
      "queryCond": "data_scadenza<=current_date and id_argomento_stato not in(4035, 5327)"
    },
    {
      "fieldName": "non_allegato",
      "format": {
        "value": "0",
        "viewType": "checkbox"
      },
      "label": "Non allegato",
      "newLine": false,
      "queryCond": "id_argomento_stato not in(4035, 5327)"
    },
    {
      "fieldName": "non_richiesto",
      "format": {
        "value": "0",
        "viewType": "toggle"
      },
      "label": "Non Richiesto",
      "newLine": false,
      "queryCond": "id_argomento_stato=5327"
    },
    {
      "fieldName": "non_allegato_toggle",
      "format": {
        "value": "1",
        "viewType": "toggle"
      },
      "label": "Non allegato",
      "newLine": false,
      "queryCond": "id_argomento_stato not in(4035, 5327)"
    },
    {
      "fieldName": "my_offices_t",
      "format": {
        "value": "0",
        "viewType": "toggle"
      },
      "label": "Miei uffici",
      "newLine": false,
      "queryCond": "crs.id_centro_gest in(select cg2.id_centro_gest from entrasp.centri_gestionali cg2 where cg2.id_gruppo_lavoro in(select id_gruppo_lavoro from entrasp.gruppi_lavoro_membri glm where glm.id_anagrafica=€global_userid€ and glm.codice_part='€global_codice_part€') and crs.codice_part='€global_codice_part€')"
    }
  ]
}