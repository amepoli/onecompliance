{
    "$schema": "../views.schema.json",
    "businessObjectName": "compiti",
    "origin": "entrasp.azienda",
    "entryKey": "aziende_sub_of_user",
    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "main",
            "queryString": "select * from entrasp.compiti where codice_azienda=$codice_azienda$ and codice_compito=$codice_compito$ and id_tipo_segnalazione!=0"
        },
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select distinct codice_azienda, entrasp.consuntivazioni_time_consumed_new(codiceazienda=> codice_azienda, dynamouser=>$dynamo_user$, datainizio=>'2020-01-01'::date, datafine=>current_date::date) as dd, entrasp.consuntivazioni_time_consumed_new(codiceazienda=> codice_azienda, dynamouser=>$dynamo_user$, datainizio=>entrasp.evaluate_given_field_date('date_rif_begin', '$date_rif_begin$', '$'),  datafine=>entrasp.evaluate_given_field_date('date_rif_end', '$date_rif_end$', '$')) as dd_periodo_rif, entrasp.consuntivazioni_time_consumed_new(codiceazienda=> codice_azienda, dynamouser=>$dynamo_user$, datainizio=>(current_date - interval '12 months')::date, datafine=>current_date::date) as dd_12_months, entrasp.consuntivazioni_time_consumed_new(codiceazienda=> codice_azienda,  dynamouser=>$dynamo_user$, datainizio=>(current_date - interval '1 months')::date, datafine=>current_date::date) as dd_1_months, entrasp.consuntivazioni_time_consumed_new(codiceazienda=> codice_azienda, dynamouser=>$dynamo_user$, datainizio=>(current_date - interval '3 months')::date, datafine=>current_date::date) as dd_3_months from entrasp.aziende WHERE codice_azienda in(€global_user_companies€) and codice_azienda in(select distinct codice_azienda from entrasp.consuntivazioni csn inner join entrasp.anagrafiche_id an on csn.codice_part=an.codice_part and csn.id_risorsa=an.id_anagrafica where an.dynamo_user=$dynamo_user$)"
        }
    ],
    "restrictions": {
        "preventNavigationToForm": true
    },
    "search_keys": [
        {
            "fieldName": "date_rif_begin",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data Inzio Periodo Rif",
            "newLine": false,
            "queryCond": "(current_date> '$date_rif_begin$' or true)"
        },
        {
            "fieldName": "date_rif_end",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data Fine Periodo Rif",
            "newLine": false,
            "queryCond": "(current_date >'$date_rif_end$' or true)"
        }
    ],
