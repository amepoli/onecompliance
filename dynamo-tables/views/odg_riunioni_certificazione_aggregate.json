{
    "$schema": "../views.schema.json",
    "businessObjectName": "odg_riunioni",
    "origin": "entrasp.odg_riunioni",
    "entryKey": "odg_riunioni_certificazione_aggregate",
    "label": "Ordini del giorno Aggregati",
    "addElementSettings": {
        "labelQuickAdd": "Nuovo Punto",
        "navigateOnSuccess": false,
        "translateQuickAdd": "RESOURCES.nuovo_punto"
    },
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select id_riunione,codice_azienda,data_riunione,(ora_inizio::VARCHAR || '-' || ora_fine::VARCHAR) as da_a,string_agg(distinct id_odg::varchar, '; ') as id__odg,string_agg(distinct ordinamento_odg::varchar, '; ') as ordinamento__odg,string_agg(distinct titolo::varchar, '; ') as titolo,string_agg(distinct settore::varchar, '; ') as settore,string_agg(distinct cantiere::varchar,'; ') as cantiere,string_agg(distinct entrasp.argomenti_descr_breve_no_num(id_argomento_controllo), '; ') as id_argomento_controllo, string_agg(distinct entrasp.riunioni_descr(id_riunione, codice_azienda), '; ') as riunione_descr,string_agg(distinct entrasp.argomenti_descr_breve_no_num(id_argomento_liv_competenza), '; ') as auditor,string_agg(distinct entrasp.argomenti_array(ARRAY[id_argomento_funzione]), '; ') as id_argomento_funzione FROM entrasp.odg_riunioni WHERE codice_azienda = $codice_azienda$ AND id_riunione = $id_riunione$ GROUP BY id_riunione, codice_azienda, data_riunione, da_a, ora_inizio, ora_fine, cantiere;"
        }
    ],
    "search_keys": [
        {
            "fieldName": "stato",
            "format": {
                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_COMPITI';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Stato",
            "newLine": true,
            "queryCond": "stato='€stato€'"
        },
        {
            "fieldName": "note_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parole Chiavi",
            "newLine": false,
            "queryCond": "UPPER (annotazioni) like '%'||UPPER('€note_search€')||'%' or UPPER (titolo) like '%'||UPPER('€note_search€')||'%'"
        },
        {
            "fieldName": "id_tipo_segnalazione_s",
            "format": {
                "comboQuery": "select id_tipo_segnalazione as id, descrizione as name from entrasp.tipi_segnalazioni where id_tipo_segnalazione!=0 order by descrizione;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "ID Tipo Segnal.",
            "newLine": false,
            "queryCond": "id_tipo_segnalazione=$id_tipo_segnalazione_s$"
        },
        {
            "fieldName": "no_subject",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Non classificati",
            "newLine": false,
            "size": 1,
            "queryCond": "id_argomento is null"
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "id_odg",
            "width": "5%",
            "label": "ID OdG"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_odg_parent",
            "width": "5%",
            "label": "ID OdG"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_argomento",
            "label": "Argomento"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "id_riunione",
            "label": "ID riunione"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "codice_azienda",
            "label": "Codice Azienda"
        },
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "data_riunione",
            "label": "Data",
            "width": "6%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "da_a",
            "queryFunct": "ora_inizio::varchar||'-'||ora_fine::varchar",
            "label": "Dalle - Alle",
            "width": "8%"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "ordinamento_odg",
            "label": "Ord.",
            "width": "4%"
        },
        {
            "format": {
                "dataType": "number"
            },
            "label": "Settore",
            "key": "settore",
            "isHidden": false,
            "isPrimary": false,
            "width": "11%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "label": "Località Cantiere/Sito Operativo",
            "key": "cantiere",
            "isHidden": false,
            "isPrimary": false
        },
        {
            "format": {
                "dataType": "number"
            },
            "label": "Tipo Verifica",
            "key": "id_argomento_controllo",
            "queryFunct": "entrasp.argomenti_descr_breve_no_num(id_argomento_controllo)",
            "isHidden": false,
            "isPrimary": false
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "titolo",
            "width": "30%",
            "label": "Titolo"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "riunione_descr",
            "queryFunct": "entrasp.riunioni_descr(id_riunione, codice_azienda)",
            "label": "Riunione",
            "width": "15%"
        },
        {
            "format": {
                "dataType": "number"
            },
            "label": "Auditor",
            "key": "auditor",
            "isHidden": false,
            "isPrimary": false
        },
        {
            "format": {
                "dataType": "number"
            },
            "label": "Funzione Auditata",
            "key": "id_argomento_funzione",
            "queryFunct": "entrasp.argomenti_array(array [id_argomento_funzione])",
            "isHidden": false,
            "isPrimary": false
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by ora_inizio asc"
    },
    "hideActions": [
        {
            "viewType": "form",
            "formActionType": "attachments"
        },
        {
            "viewType": "table",
            "tableActionType": "add"
        }
    ]
}