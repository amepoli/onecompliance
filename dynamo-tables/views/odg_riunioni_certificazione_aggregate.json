    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "SELECT (SELECT true) AS delete_procedure_aziendali, id_riunione, codice_azienda, data_riunione, (ora_inizio::VARCHAR || '-' || ora_fine::VARCHAR) AS da_a, string_agg(DISTINCT id_odg::varchar, '; ') AS id__odg, string_agg(DISTINCT id_argomento::varchar, '; ') AS id__argomento, string_agg(DISTINCT id_odg_parent::varchar, '; ') AS id__odg_parent, string_agg(DISTINCT ordinamento_odg::varchar, '; ') AS ordinamento__odg, string_agg(DISTINCT entrasp.argomenti_descr_breve_no_id(id_argomento_settore), '; ') AS settore, string_agg(distinct cantiere::varchar,'; ') as cantiere, string_agg(DISTINCT entrasp.argomenti_descr_breve_no_num(id_argomento_controllo), '; ') AS id_argomento_controllo, string_agg(DISTINCT entrasp.riunioni_descr(id_riunione, codice_azienda), '; ') AS riunione_descr, string_agg(DISTINCT entrasp.anagrafiche_cognnome('ASACERT', id_anagrafica), '; ') AS id_anagrafica, string_agg(DISTINCT entrasp.argomenti_array(ARRAY[id_argomento_funzione]), '; ') AS id_argomento_funzione FROM entrasp.odg_riunioni WHERE codice_azienda = $codice_azienda$ AND id_riunione = $id_riunione$ GROUP BY id_riunione, codice_azienda, data_riunione, da_a, ora_inizio, ora_fine, cantiere;"
        }
    ],
