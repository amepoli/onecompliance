{
    "$schema": "../views.schema.json",
    "entryKey": "operations_in_black_out_periods",
    "inheritsFrom": "registro_insider",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select ri.*, entrasp.anagrafiche_vr_dati_identificativi_nom1(op.codice_part, op.id_strumento_finanziario) as strumento_finanziario, op.data_op, case when op.data_op between ri.data_da and ri.data_a then 'Rischio Insider' else 'Basso rischio' end as segn_rischio from entrasp.registro_insider ri inner join entrasp.operazioni_personali op on ri.codice_azienda=op.codice_azienda and ri.id_strumento_finanziario=op.id_strumento_finanziario where ri.codice_azienda=$codice_azienda$ and op.id_operazione=$id_operazione$"
        }
    ],
