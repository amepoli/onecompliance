{
    "$schema": "../views.schema.json",
    "entryKey": "attachments_sub_of_information_flows",
    "inheritsFrom": "attachments",
    "predefinedQueries": [
        {
            "type": "main",
            "operation": "selectTable",
            "queryString": "select *, (file_id::text || '^'::text) || client_file_name::text AS stringa, entrasp.argomenti_descr_stato(id_argomento_stato) as descr_stato, entrasp.argomenti_descr_stato(id_argomento_stato_approvazione) as descr_stato_approv, entrasp.odg_data(codice_azienda, id_odg, id_riunione) as data_riunione, entrasp.riunioni_descr(id_riunione, codice_azienda) as riunione_descr, entrasp.odg_titolo_esteso(codice_azienda, id_odg, id_riunione) as titolo_odg, cod_rev from entrasp.cdms_risorse_revisioni rev where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$"
        },
        {
            "type": "postProcessing",
            "operation": "update",
            "queryString": "update entrasp.cdms_risorse_revisioni set client_file_name= 'n/a', content_type= 'n/a' where id_argomento_stato!=4035 and client_file_name='tbd' and content_type='tbd' and codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
        },
        {
            "type": "main",
            "operation": "delete",
            "queryString": "delete from entrasp.cdms_risorse_revisioni where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
        }
    ],
    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menutest",
            "label": "Actions",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "delete",
                    "icon": "delete",
                    "label": "Delete",
                    "query": "select entrasp.cancella_risorse_revisioni(array[$selected_rows_data$])",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Eliminare documenti selezionati?"
                },
                {
                    "key": "unifica",
                    "icon": "merge_type",
                    "label": "Unire documenti",
                    "query": "select entrasp.unifica_risorse_revisioni_array(array[$selected_rows_data$])",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Unire i documenti selezionati?"
                },
                {
                    "key": "separa",
                    "icon": "call_split",
                    "label": "Crea flusso informativo",
                    "query": "select entrasp.separa_risorse_revisioni_array(array[$selected_rows_data$])",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Assegnare le risorse selzionate a separati flussi informativi?"
                }
            ]
        }
    ],
