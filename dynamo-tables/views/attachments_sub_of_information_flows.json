{
  "$schema": "../views.schema.json",
  "entryKey": "attachments_sub_of_information_flows",
  "inheritsFrom": "attachments",
  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectTable",
      "queryString": "select *, (file_id::text || '^'::text) || client_file_name::text AS stringa, entrasp.argomenti_descr_stato(id_argomento_stato) as descr_stato, entrasp.argomenti_descr_stato(id_argomento_stato_approvazione) as descr_stato_approv, entrasp.odg_data(codice_azienda, id_odg, id_riunione) as data_riunione, entrasp.riunioni_descr(id_riunione, codice_azienda) as riunione_descr, entrasp.odg_titolo_esteso(codice_azienda, id_odg, id_riunione) as titolo_odg from entrasp.cdms_risorse_revisioni where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$"
    },
    {
      "type": "main",
      "operation": "selectForm",
      "queryString": "SELECT a.codice_azienda,b.codice_part,a.data_rif_a,a.descrizione,a.id_argomento_stato as rev_id_argomento_stato, a.id_argomento_stato_approvazione,a.id_risorsa,a.prog_revisione,a.client_file_name,entrasp.anagrafiche_vr_dati_identificativi(b.codice_part,b.id_anagrafica) as anagrafica,a.revisore, entrasp.argomenti_descr_breve_no_num(b.id_argomento_stato) AS descr_stato,(a.file_id::text||'^')::text||a.client_file_name::text AS stringa, entrasp.argomenti_descr_breve_no_num(b.id_argomento_tipo_allegato) AS tipo_allegato,a.data_rif,left(entrasp.odg_titolo(a.codice_azienda, a.id_odg, a.id_riunione),100) as titolo_odg, b.id_anagrafica, a.id_odg, a.id_riunione, entrasp.centri_gestionali_descr(b.codice_part, b.id_centro_gest) AS centro_gest,a.data_scadenza,b.id_argomento_tipo_allegato FROM entrasp.cdms_risorse_revisioni a INNER JOIN entrasp.cdms_risorse b on a.codice_azienda=b.codice_azienda AND a.id_risorsa=b.id_risorsa where a.codice_azienda=$codice_azienda$ and a.id_risorsa=$id_risorsa$ AND A.prog_revisione=$prog_revisione$"
    },
    {
      "type": "main",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set data_rif=$data_rif$, data_rif_a=$data_rif_a$,id_riunione=$id_riunione$, id_odg=$id_odg$, descrizione=$descrizione$, id_argomento_stato=$rev_id_argomento_stato$ where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "postProcessing",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set client_file_name= 'n/a', content_type= 'n/a' where id_argomento_stato!=4035 and client_file_name='tbd' and content_type='tbd' and codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "main",
      "operation": "delete",
      "queryString": "delete from entrasp.cdms_risorse_revisioni where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    }
  ],
