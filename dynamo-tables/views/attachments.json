            "format": {
                "comboQuery": "select id_argomento as id, id_argomento||'-'||descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=3576 and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€');",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Tipo Documento",
            "newLine": true,
            "queryCond": "id_argomento_tipo_allegato=$id_argomento_tipo_allegato_s$",
            "translate": "RESOURCES.tipo_documento_attachments"
        },
        {
            "fieldName": "id_anagrafica_s",
            "format": {
                "comboQuery": "SELECT an.id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name from entrasp.anagrafiche_id an WHERE an.codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Cliente",
            "newLine": false,
            "queryCond": "id_anagrafica=$id_anagrafica_s$",
            "translate": "RESOURCES.cliente_attachments"
        },
