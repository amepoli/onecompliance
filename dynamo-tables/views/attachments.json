  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectTable",
      "queryString": "select *, entrasp.argomenti_descr_stato(rev_id_argomento_stato) as descr_stato, left(entrasp.odg_titolo_esteso(codice_azienda, id_odg, id_riunione),100)as titolo_odg, entrasp.centri_gestionali_descr(codice_part, id_centro_gest) as centro_gest from entrasp.views_attachments_fast_no_bo where codice_azienda=$codice_azienda$"
    },
    {
      "type": "main",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set data_rif=$data_rif$, id_riunione=$id_riunione$, id_odg=$id_odg$, descrizione=$rev_descrizione$, id_argomento_stato=$rev_id_argomento_stato$, commento_revisione=$commento_revisione$ where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "postProcessing",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set client_file_name= 'n/a', content_type= 'n/a' where id_argomento_stato!=4035 and client_file_name='tbd' and content_type='tbd' and codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "main",
      "operation": "delete",
      "queryString": "delete from entrasp.cdms_risorse_revisioni where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    }
  ],
