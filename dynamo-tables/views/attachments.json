                "comboQuery": "select distinct revisore as id, revisore as name from entrasp.cdms_risorse_revisioni where codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Utente",
            "newLine": false,
            "queryCond": "revisore=$revisore_s$",
            "translate": "RESOURCES.utente_attachments"
        },
        {
            "format": {
                "comboQuery": "select id_argomento as id, descrizione_breve as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=4032;",
