{
  "$schema": "../views.schema.json",
  "entryKey": "cpl_trattamenti_dati_sub_of_finalita",
  "origin": "entrasp.cpl_trattamenti_dati",
  "predefinedQueries": [
    {
      "queryString": "select td.*, td_fin.id_argomento_finalita from entrasp.cpl_trattamenti_dati td inner join entrasp.cpl_trattamenti_dati_finalita td_fin on td.codice_azienda=td_fin.codice_azienda and td.id_trattamento_dati=td_fin.id_trattamento_dati where td_fin.id_argomento_finalita=$id_argomento_finalita$",
      "operation": "selectTable",
      "type": "main"
    }
  ],
  "search_keys": [
    {
      "fieldName": "id_trattamento_dati",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Id Trattamento Dati",
      "newLine": true,
      "queryCond": "id_trattamento_dati=$id_trattamento_dati$"
    },
    {
      "fieldName": "desccrizione",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
