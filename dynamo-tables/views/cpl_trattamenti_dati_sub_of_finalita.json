      },
       "label": "Centro Gestionale",
            "translate": "RESOURCES.office",
      "newLine": true,
      "queryCond": "(select id_centro_gest from entrasp.modello_test_fields(codice_azienda, id_modello_test))= $id_centro_gest$"
    }
  ],
