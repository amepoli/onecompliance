{
    "$schema": "../views.schema.json",
    "inheritsFrom": "miei_compiti",
    "entryKey": "compiti_collaboratori",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "SELECT *,'€global_username€' as global_username,entrasp.centri_costo_del_compito(cc.codice_azienda, cc.codice_compito) as centro_costo_aggregato, entrasp.time_report_stop_active_du('€global_username€',codice_compito,codice_azienda) as time_report_stop_active FROM entrasp.compiti_collaboratori cc where codice_azienda in (€global_user_companies€) and codice_azienda||'-'||codice_compito in(select csn.codice_azienda||'-'||csn.codice_compito from entrasp.consuntivazioni csn inner join entrasp.anagrafiche_id an on csn.codice_part=an.codice_part and csn.id_risorsa=an.id_anagrafica where an.dynamo_user in(select entrasp.colleghi('€global_username€')))"
        },
        {
            "operation": "startEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_play((€global_id_anagrafiche€)::text, '$codice_compito$', '$codice_azienda$') as play_time_report"
        },
        {
            "operation": "stopEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
        }
    ],
    "subTables": [
        {
            "entryKey": "aggiornamenti_sub_of_compiti_all_users",
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                },
                {
                    "parent": "codice_compito",
                    "son": "codice_compito"
                }
            ],
            "label": "Attività",
            "translate": "RESOURCES.attivit_aggiornamenti_sub_of_compiti_all_users"
        },
        {
            "entryKey": "centri_costo_sub_of_compiti",
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda_compiti"
                },
                {
                    "parent": "codice_compito",
                    "son": "codice_compito"
                }
            ],
            "label": "Centri costo associati",
            "translate": "RESOURCES.centri_costo_associati_centri_costo_sub_of_compiti"
        }
    ],
    "search_keys": [
        {
            "fieldName": "codice_compito",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "# Identificativo",
            "newLine": false,
            "queryCond": "codice_compito=$codice_compito$",
            "size": 1.67,
            "translate": "RESOURCES._identificativo_miei_compiti"
        },
        {
            "format": {
                "comboQuery": "SELECT codice_azienda AS id, codice_azienda AS name FROM entrasp.aziende where codice_azienda in(€global_user_companies€) order by codice_azienda;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "queryCond": "codice_azienda='€codice_azienda_s€'",
            "fieldName": "codice_azienda_s",
            "label": "Codice Azienda",
            "newLine": false,
            "size": 1.67,
            "translate": "RESOURCES.codice_azienda_miei_compiti"
        },
        {
            "fieldName": "parola_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola chiave",
            "newLine": false,
            "queryCond": "(upper(titolo) like '%'||upper('€parola_search€')||'%' or upper(codice_azienda) like '%'||upper('€parola_search€')||'%')",
            "size": 3.33,
            "translate": "RESOURCES.parola_chiave_miei_compiti"
        },
        {
            "fieldName": "durata_min",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Durata maggiore di",
            "newLine": false,
            "queryCond": "entrasp.consuntivazioni_time_consumed(codice_azienda, codicecompito => codice_compito, dynamouser => '€global_username€'::text)::numeric(8,0) >= $durata_min$",
            "size": 1.67,
            "translate": "RESOURCES.durata_maggiore_di_miei_compiti"
        },
        {
            "fieldName": "non_associata_a_centri_costo",
            "format": {
                "viewType": "checkbox"
            },
            "label": "No Centri Costo",
            "newLine": false,
            "tooltip": "Individua tutti i compiti non associati ad alcun centro di costo",
            "queryCond": "codice_azienda||'-'||codice_compito not in(select ccc.codice_azienda_compiti||'-'||ccc.codice_compito from entrasp.compiti_centri_costo ccc inner join entrasp.aziende az on ccc.codice_azienda=az.codice_azienda where az.codice_part=entrasp.codice_part_dynamo_user('€global_username€') and ccc.codice_azienda_compiti||'-'||ccc.codice_compito is not null)",
            "size": 1.67,
            "translate": "RESOURCES.no_centri_costo_miei_compiti"
        }
    ]
}
