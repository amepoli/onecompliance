      "operation": "selectTable",
      "queryString": "select distinct codice_azienda,id_risorsa,$id_risorsa_sopra$ as id_risorsa_sopra,codice_part,client_file_name,entrasp.anagrafiche_vr_dati_identificativi(codice_part,id_anagrafica) as denominazione, entrasp.argomenti_descr_stato(id_argomento_stato) as descr_stato, data_creazione, stringa, tipo_allegato, true as unifica_risorse from entrasp.views_attachments_fast_no_bo where id_argomento_tipo_allegato = $id_argomento_tipo_allegato$ and codice_azienda=$codice_azienda$ and id_risorsa != $id_risorsa_sopra$",
      "type": "main"
    }
  ],
