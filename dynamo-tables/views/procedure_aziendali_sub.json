                "query": "select entrasp.procedura_aziendale_delete('£codice_azienda£', £id_procedura£)",
                "action": "query",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_procedura",
                        "destination": "id_procedura"
                    }
                ],
                "confirmAction": true,
