            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "codice_azienda",
            "label": "codice_azienda",
            "translate": "RESOURCES.codice_azienda_procedure_aziendali_sub"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "codice_part",
            "label": "codice_part",
            "translate": "RESOURCES.codice_part_procedure_aziendali_sub"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
