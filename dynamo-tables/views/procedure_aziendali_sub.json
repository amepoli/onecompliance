                    "query": "SELECT entrasp.procedura_aziendale_delete(codice_azienda::text, id_procedura::integer) FROM entrasp.procedure_aziendali where codice_azienda='€global_codice_azienda€' and codice_azienda||'~'||id_procedura=any(ARRAY[$selected_rows_data$])",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Sei sicuro di cancellare i processi selezionati?"
                }
            ]
        }
    ],
    "table_keys": [
