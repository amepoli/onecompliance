{
    "$schema": "../views.schema.json",
    "entryKey": "progetti_manager",
    "inheritsFrom": "progetti",
    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "preProcessing",
            "queryString": "update entrasp.progetti snd set codice_part='€global_codice_part€' WHERE snd.codice_azienda=$codice_azienda$ AND id_progetto=$id_progetto$;"
        },
        {
            "queryString": "select case when count(id_fase) >0 then true else false end as disable_button_attiva_progetto from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_progetto=$id_progetto$",
            "type": "postProcessing",
            "operation": "selectForm"
        },
        {
            "queryString": "update entrasp.progetti set stato=entrasp.stato_progetto_calcolato($id_progetto$, $codice_azienda$) where codice_azienda=$codice_azienda$ and id_progetto=$id_progetto$",
            "type": "preProcessing",
            "operation": "selectForm"
        },
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "select entrasp.automatic_progetti_fasi_order($codice_azienda$, $id_progetto$)"
        },
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select prg.*, entrasp.progetto_sal(prg.codice_azienda, prg.id_progetto) as avanzamento, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', stato)as stato, entrasp.centri_gestionali_descr(prg.codice_part, prg.id_centro_gest) as centro_gest from entrasp.progetti prg inner join entrasp.centri_gestionali cg on prg.codice_part=cg.codice_part and prg.id_centro_gest=cg.id_centro_gest inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where an.dynamo_user='€global_username€'"
        },
        {
            "operation": "delete",
            "type": "main",
            "queryString": "select entrasp.progetto_delete($codice_azienda$, $id_progetto$);"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select codice_progetto from entrasp.progetti where codice_azienda=$codice_azienda$ and codice_progetto='£codice_progetto£'",
            "messageNotNull": "Inserimento: Il codice inserito è già stato utilizzato per un altro modello di test: prego utilizzarne un codice diverso"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_progetto from entrasp.progetti where codice_azienda=$codice_azienda$ and codice_progetto='£codice_progetto£' and id_progetto!=$id_progetto$",
            "messageNotNull": "Aggiornamento: Il codice inserito è già stato utilizzato per un altro modello di test: prego utilizzarne un codice diverso"
        },
        {
            "type": "main",
            "operation": "share",
            "queryString": "select null;"
        },
        {
            "type": "main",
            "operation": "stopEvent",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
        },
        {
            "type": "main",
            "operation": "startEvent",
            "queryString": "select entrasp.business_object_play((€global_id_anagrafiche€)::text, 'progetti', $id_progetto$, '$codice_azienda$'::varchar)"
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "data_inserimento",
            "label": "Data Progetto",
            "width": "8%",
            "translate": "RESOURCES.data_inserimento"
        },
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "data_competenza",
            "label": "Data Competenza",
            "translate": "RESOURCES.reference_date",
            "width": "8%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "codice_azienda",
            "label": "Azienda Cliente",
            "translate": "RESOURCES.codice_azienda"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "stato",
            "queryFunct": "entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', stato)",
            "label": "Stato",
            "translate": "RESOURCES.status",
            "width": "5%",
            "style": [
                {
                    "value": "Chiuso",
                    "font_color": "green",
                    "font_weight": "500"
                },
                {
                    "value": "Provvisorio",
                    "font_color": "#BA68C8",
                    "font_weight": "500"
                },
                {
                    "value": "Pianificato",
                    "font_color": "#FF8100",
                    "font_weight": "500"
                },
                {
                    "value": "Attesa Riscontro",
                    "font_color": "#FF0000",
                    "font_weight": "500"
                },
                {
                    "value": "In Svolgimento",
                    "font_color": " #A1A100",
                    "font_weight": "500"
                },
                {
                    "value": "Annullato",
                    "font_color": "grey",
                    "font_weight": "500"
                }
            ]
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_tipo_progetto",
            "label": "id_tipo_progetto",
            "translate": "RESOURCES.id_project",
            "width": "6%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "codice_attivita",
            "label": "Codice Attività",
            "width": "7%",
            "translate": "RESOURCES.codice_attivita"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "codice_progetto",
            "label": "Codice Progetto",
            "width": "7%",
            "translate": "RESOURCES.codice_progetto"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "id_progetto",
            "label": "Id Progetto",
            "translate": "RESOURCES.Project_ID",
            "width": "6%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "codice_part",
            "label": "codice_part",
            "translate": "RESOURCES.codice_part"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "titolo",
            "label": "Titolo",
            "translate": "RESOURCES.title",
            "width": "31%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "centro_gest",
            "label": "Centro Gestionale",
            "translate": "RESOURCES.office",
            "width": "13%"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "avanzamento",
            "label": "Prv/Pnf/Ris/Svl/Chs/Ann/Tot",
            "width": "16%",
            "translate": "RESOURCES.avanzamento"
        }
    ],
    "search_keys": [
        {
            "fieldName": "stato",
            "format": {
                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Stato",
            "translate": "RESOURCES.status",
            "newLine": false,
            "queryCond": "stato='€stato€'"
        },
        {
            "label": "Id Progetto",
            "translate": "RESOURCES.Project_ID",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "fieldName": "id_progetto_s",
            "newLine": false,
            "queryCond": "id_progetto=$id_progetto_s$"
        },
        {
            "label": "Codice progetto",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "fieldName": "codice_progetto_s",
            "newLine": false,
            "queryCond": "codice_progetto=$codice_progetto_s$",
            "translate": "RESOURCES.codice_progetto"
        },
        {
            "fieldName": "codice_attivita_s",
            "format": {
                "comboQuery": "SELECT codice_attivita AS id, codice_attivita||'-'||descrizione AS name  FROM entrasp.attivita WHERE codice_azienda='€global_codice_azienda€' and codice_attivita_parent is null;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Modello di progetto",
            "newLine": true,
            "queryCond": "codice_attivita=$codice_attivita_s$",
            "translate": "RESOURCES.modello_di_progetto"
        },
        {
            "fieldName": "id_centro_gest",
            "format": {
                "comboQuery": "SELECT id_centro_gest AS id, entrasp.centri_gestionali_descr(codice_part,id_centro_gest) AS name  FROM entrasp.centri_gestionali WHERE codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Centro Gestionale",
            "translate": "RESOURCES.office",
            "newLine": false,
            "queryCond": "id_centro_gest=$id_centro_gest$"
        },
        {
            "fieldName": "id_cliente",
            "format": {
                "comboQuery": "SELECT an.id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name from entrasp.anagrafiche_id an WHERE an.codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Cliente",
            "translate": "RESOURCES.customer",
            "newLine": false,
            "queryCond": "id_cliente=$id_cliente$"
        },
        {
            "fieldName": "data_ins_min",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Inserimento dopo il",
            "newLine": false,
            "queryCond": "data_inserimento>='€data_ins_min€'",
            "translate": "RESOURCES.inserimento_dopo_il"
        },
        {
            "fieldName": "data_ins_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Inserimento entro il",
            "newLine": true,
            "queryCond": "data_inserimento<='€data_ins_max€'",
            "translate": "RESOURCES.inserimento_entro_il"
        },
        {
            "fieldName": "progetti_con_fasi_incomplete",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Progetti con verifiche incomplete",
            "newLine": false,
            "queryCond": "id_progetto in(select id_progetto from entrasp.progetti_fasi pf inner join entrasp.sondaggi_somministrati ss on pf.id_sondaggio=ss.id_sondaggio and pf.codice_azienda=ss.codice_azienda where pf.codice_azienda=$codice_azienda$ and ss.somministrazione_completata!='Completo' and pf.id_sondaggio is not null)",
            "translate": "RESOURCES.progetti_con_verifiche_incomplete"
        },
        {
            "fieldName": "progetti_con_fasi_confermate",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Progetti con verifiche confermate",
            "newLine": false,
            "queryCond": "id_progetto in(select id_progetto from entrasp.progetti_fasi pf inner join entrasp.sondaggi snd on pf.id_sondaggio=snd.id_sondaggio and pf.codice_azienda=snd.codice_azienda where pf.codice_azienda=prg.codice_azienda and snd.stato ='A' and pf.id_sondaggio is not null)",
            "translate": "RESOURCES.progetti_con_verifiche_confermate"
        },
        {
            "fieldName": "data_comp",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data Competenza",
            "translate": "RESOURCES.reference_date",
            "newLine": false,
            "queryCond": "data_competenza>='€data_comp€'"
        },
        {
            "fieldName": "parola_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola chiave",
            "translate": "RESOURCES.key_word",
            "newLine": false,
            "queryCond": "(UPPER(titolo) like '%'||UPPER('€parola_s€')||'%')"
        },
        {
            "fieldName": "flag_progetti_aperti",
            "format": {
                "value": "1",
                "viewType": "toggle"
            },
            "label": "Progetti aperti",
            "newLine": false,
            "queryCond": "stato not in ('C', 'N')",
            "translate": "RESOURCES.progetti_aperti"
        },
        {
            "fieldName": "flag_progetti_miei",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Miei/Mio Ufficio",
            "translate": "RESOURCES.mine_my_office",
            "newLine": false,
            "queryCond": "id_centro_gest in(select cg2.id_centro_gest from entrasp.centri_gestionali cg2 where cg2.id_gruppo_lavoro in(select id_gruppo_lavoro from entrasp.gruppi_lavoro_membri glm where glm.id_anagrafica=€global_userid€ and glm.codice_part='€global_codice_part€') and codice_part='€global_codice_part€')"
        },
        {
            "fieldName": "azienda_corrente",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Azienda corrente",
            "newLine": false,
            "queryCond": "codice_azienda='€global_codice_azienda€'",
            "translate": "RESOURCES.azienda_corrente"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by avanzamento asc"
    },
    "hideActions": [
        {
            "tableActionType": "quick-add",
            "viewType": "table"
        }
    ]
}