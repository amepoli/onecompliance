      "label": "codice_azienda_erogante"
    },
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "tipo_segnalazione",
      "queryFunct": "entrasp.tipo_segnalazione_descr_new(id_tipo_segnalazione)",
      "label": "Tipo",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": false,
      "isPrimary": true,
      "key": "codice_compito",
