{
  "$schema": "../views.schema.json",
  "businessObjectName": "compiti",
  "origin": "entrasp.compiti",
  "entryKey": "compiti_sub_of_user_per_azienda",
  "inheritsFrom": "compiti",
  "predefinedQueries": [
    {
      "operation": "selectForm",
      "type": "preProcessing",
      "queryString": "update entrasp.compiti cmp set codice_part=az.codice_part from entrasp.aziende az WHERE cmp.codice_azienda=az.codice_azienda and codice_compito=$codice_compito$;"
    },
    {
      "operation": "selectForm",
      "type": "main",
      "queryString": "select * from entrasp.compiti where codice_azienda=$codice_azienda$ and codice_compito=$codice_compito$ and id_tipo_segnalazione!=0"
    },
    {
      "operation": "selectTable",
      "type": "main",
      "queryString": "select *, cg.codice_azienda_erogante, entrasp.is_compito_worked_by_dynamo_user(codice_azienda, codice_compito, $dynamo_user$) as dynamo_user, entrasp.compiti_count_open_compiti_sub(codice_azienda, codice_compito) as conta_aperti, entrasp.tipo_segnalazione_descr_new(id_tipo_segnalazione) as tipo_segnalazione, entrasp.transcodifiche_transcodifica('STATO_COMPITI', stato) as stato from entrasp.compiti cmp inner join entrasp.centri_gestionali cg on cmp.codice_part=cg.codice_part and cmp.id_centro_gest=cg.id_centro_gest where cg.codice_azienda_erogante=$codice_azienda_erogante$ and entrasp.is_compito_worked_by_dynamo_user(codice_azienda, codice_compito, $dynamo_user$)=$dynamo_user$"
    }
  ],
  "table_keys": [
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": true,
      "isPrimary": false,
      "key": "codice_codifica_stato",
      "label": "codice_codifica_stato"
    },
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": true,
      "isPrimary": false,
      "key": "dynamo_user",
      "label": "dynamo_user"
    },
    {
      "format": {
        "dataType": "text"
      },
