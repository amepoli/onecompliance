            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "select entrasp.centro_gestionale_delete('€global_codice_part€', $id_centro_gest$);",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select codice from entrasp.centri_gestionali where codice_part=$codice_part$ and codice='£codice£'",
            "messageNotNull": "Inserimento: il codice inserito è già stato utilizzato per un altrocentro gestionale: prego utilizzarne un codice diverso"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select codice from entrasp.centri_gestionali where codice_part=$codice_part$ and codice='£codice£' and id_centro_gest!=$id_centro_gest$",
            "messageNotNull": "Aggiornamento: il codice inserito è già stato utilizzato per un altrocentro gestionale: prego utilizzarne un codice diverso"
        },
        {
            "operation": "insert",
