    "origin": "entrasp.centri_gestionali",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select * from entrasp.centri_gestionali cg inner join entrasp.aziende az on az.codice_part=cg.codice_part inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where az.codice_azienda in(€global_user_companies€) and an.dynamo_user='€global_username€';",
            "type": "main"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_centro_gest$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "queryString": "select entrasp.centro_gest_insert($codice_part$, $codice$, $descrizione$, $id_centro_gest_parent$, $id_responsabile$, $codice_azienda_erogante$)as id_centro_gest",
            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "select entrasp.centro_gestionale_delete('€global_codice_part€', $id_centro_gest$);",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select codice from entrasp.centri_gestionali where codice_part=$codice_part$ and codice='£codice£'",
            "messageNotNull": "Inserimento: il codice inserito è già stato utilizzato per un altrocentro gestionale: prego utilizzarne un codice diverso"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select codice from entrasp.centri_gestionali where codice_part=$codice_part$ and codice='£codice£' and id_centro_gest!=$id_centro_gest$",
            "messageNotNull": "Aggiornamento: il codice inserito è già stato utilizzato per un altrocentro gestionale: prego utilizzarne un codice diverso"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "select entrasp.update_dynamo_user((€global_id_anagrafiche€)::text, (€global_user_companies€)::text, '€global_username€')"
        }
    ],
    "search_keys": [
