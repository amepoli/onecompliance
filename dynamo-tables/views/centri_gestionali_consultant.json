            },
            "label": "Senza TAG",
            "newLine": false,
            "queryCond": "cg.id_argomento IS null"
        },
        {
            "fieldName": "no_liv_controllo",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Senza liv.controllo",
            "newLine": false,
            "queryCond": "cg.id_argomento not in (select ason.id_argomento_son from entrasp.argomenti_argomenti af inner join entrasp.argomenti_argomenti ason on af.id_argomento_son=ason.id_argomento_father where af.id_argomento_father=6871 and ason.id_argomento_son is not null)"
        }
