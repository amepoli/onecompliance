        {
            "type": "main",
            "operation": "selectTable",
            "queryString": "SELECT mt.codice_azienda,mtvr.data_inizio_validita, entrasp.argomenti_descr_breve(mt.id_argomento) as argomento,mt.id_argomento, mt.id_modello_test, mtvr.id_risultato, mt.titolo, entrasp.centri_gestionali_descr(mt.codice_part, mt.id_centro_gest) as centro_gest, codice, mtvr.id_modello_test_vr FROM entrasp.modelli_test mt JOIN entrasp.modelli_test_vr mtvr ON mt.codice_azienda=mtvr.codice_azienda AND mt.id_modello_test=mtvr.id_modello_test inner join entrasp.aziende az on mt.codice_azienda=az.codice_azienda WHERE mtvr.id_modello_test_vr=entrasp.grc_max_id_mdt_vr(mt.codice_azienda, mt.id_modello_test) and az.codice_azienda in(€global_user_companies€);"
        },
        {
            "type": "main",
            "operation": "insert",
            "queryString": "select id_modello_test, id_modello_test_vr from entrasp.modello_test_insert(codiceazienda=>$codice_azienda$::varchar, titolo=>$titolo$, descrizione=> coalesce($descrizione$,$titolo$), flag_applicazione_singola=>coalesce($flag_applicazione_singola$::bpchar,0::bpchar) , idfiltroselezione=>coalesce($id_filtro_selezione$,0), flag_sezioni=>coalesce($flag_sezioni$,0::bpchar), giorni_anticipo_pres_doc=>$giorni_anticipo_pres_doc$, codice_part=>'€global_codice_part€', id_centro_gest=>$id_centro_gest$, codice=>$codice$, id_tipo_modello_test=>$id_tipo_modello_test$, id_argomento=>$id_argomento$, idmodellotestvr=>$id_modello_test_vr$, flag_mostra_punteggi=>coalesce($flag_mostra_punteggi$::bpchar,'0'::bpchar), id_risultato=>$id_risultato$, flagnodomande=>$flag_no_domande$::character, stopreplanningwhencontractsclosed=>coalesce($stop_replanning_when_contracts_closed$,false),titolocartella=>$titolo_cartella$,flagworkflow=>coalesce($flag_workflow$::bpchar,'0'::bpchar),flagripianificapercliente=>coalesce($flag_ripianifica_per_cliente$::bpchar,'0'::bpchar), prezzo_ => $prezzo$);"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_modello_test$ is null as label;",
            "type": "main"
        },
        {
            "type": "main",
            "operation": "update",
            "queryString": "select entrasp.modello_test_update(codice_azienda=>$codice_azienda$, id_modello_test=>$id_modello_test$, titolo=>$titolo$, descrizione=>coalesce($descrizione$,$titolo$), flag_applicazione_singola=>$flag_applicazione_singola$::character, idfiltroselezione=>coalesce($id_filtro_selezione$,0), flag_sezioni=>$flag_sezioni$::character, giorni_anticipo_pres_doc=>coalesce($giorni_anticipo_pres_doc$,15),codice_part=>'€global_codice_part€', id_centro_gest=>$id_centro_gest$, codice=>$codice$, id_tipo_modello_test=>$id_tipo_modello_test$, id_argomento=>$id_argomento$, id_modello_test_vr=>$id_modello_test_vr$, flag_mostra_punteggi=>$flag_mostra_punteggi$::character, id_risultato=>$id_risultato$, flagnodomande=>$flag_no_domande$::character, stopreplanningwhencontractsclosed=>coalesce($stop_replanning_when_contracts_closed$,false),titolocartella=>$titolo_cartella$,flagworkflow=>$flag_workflow$::character,flagripianificapercliente=>$flag_ripianifica_per_cliente$::character, prezzo_ => $prezzo$);"
        }
