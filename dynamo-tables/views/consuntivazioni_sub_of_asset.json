  "predefinedQueries": [
    {
      "operation": "selectTable",
      "queryString": "select * ,entrasp.argomenti_descr_breve_no_num(id_argomento) as tipo_aggiornamento,entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', stato) as descr_stato, note as note_restricted, entrasp.anagrafiche_id_codcognnome(codice_part,id_risorsa) as esecutore from entrasp.consuntivazioni WHERE codice_azienda=$codice_azienda$ and id_asset= $id_asset$",
      "type": "main"
    },
    {
      "operation": "selectForm",
      "queryString": "update entrasp.consuntivazioni cn set codice_part=az.codice_part from entrasp.aziende az where cn.codice_azienda=az.codice_azienda and cn.codice_part is null and cn.codice_azienda=$codice_azienda$",
      "type": "postProcessing"
    },
    {
      "operation": "insert",
      "queryString": "update entrasp.consuntivazioni cn set codice_part=az.codice_part,id_risorsa=coalesce(id_risorsa, entrasp.idutente_from_aziende_utenti((€global_id_anagrafiche€)::text, az.codice_part)::numeric) from entrasp.aziende az where cn.codice_azienda=az.codice_azienda and cn.codice_part is null and cn.codice_azienda=$codice_azienda$",
      "type": "postProcessing"
    },
    {
      "operation": "update",
      "queryString": "update entrasp.consuntivazioni cn set codice_part=az.codice_part,id_risorsa=coalesce(id_risorsa, entrasp.idutente_from_aziende_utenti((€global_id_anagrafiche€)::text, az.codice_part)::numeric) from entrasp.aziende az where cn.codice_azienda=az.codice_azienda and cn.codice_part is null and cn.codice_azienda=$codice_azienda$",
      "type": "postProcessing"
    }
