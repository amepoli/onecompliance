        },
        "columnsQuery": {
          "key": "probabilita",
          "query": "select stato from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$;"
        },
        "rowsQuery": {
          "key": "impatto",
          "query": "select descrizione as label from entrasp.cpl_soglie where tipo_soglia='I' and codice_azienda=$codice_azienda$ and id_esercizio=(select max(id_esercizio) from entrasp.cpl_risk_response where codice_azienda=$codice_azienda$) order by soglia_a;"
        }
      },
