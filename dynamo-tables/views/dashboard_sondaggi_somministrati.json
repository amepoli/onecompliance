          }
        ],
        "measures": [
          {
            "aggregation": "count",
            "availableAggregations": [
              "count",
              "distinctcount"
            ],
            "uniqueName": "Impatto"
          }
        ],
        "rows": [
          {
            "uniqueName": "Impatto"
          }
        ]
