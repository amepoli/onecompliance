            },
            "label": "codice_part",
            "key": "codice_part",
            "readOnly": false,
            "isHidden": true,
            "isPrimary": true,
            "newLine": false,
            "translate": "RESOURCES.codice_part"
        },
        {
            "autoGenerate": false,
