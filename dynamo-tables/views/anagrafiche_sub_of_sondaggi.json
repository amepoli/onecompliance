{
    "$schema": "../views.schema.json",
    "entryKey": "anagrafiche_sub_of_sondaggi",
    "origin": "entrasp.anagrafiche_sondaggi",
    "businessObjectName": "anagrafiche_sondaggi",
    "addElementSettings": {
        "labelQuickAdd": "Associa assegnatario",
        "navigateOnSuccess": false,
        "translateQuickAdd": "RESOURCES.associa_assegnatario"
    },
    "form_keys": [
        {
            "autoGenerate": false,
            "format": {
                "comboQuery": "select distinct an.id_anagrafica as id, an.id_anagrafica||' - '||an.cognome||' '||an.nome as name from entrasp.anagrafiche_id an inner join entrasp.anagrafiche_competenze anco on an.codice_part=anco.codice_part and an.id_anagrafica=anco.id_anagrafica inner join entrasp.articoli_contratti ac on anco.codice_part=(select codice_part from entrasp.aziende where codice_azienda=ac.codice_azienda) and anco.id_argomento_competenza=ac.id_argomento_tipo_norma and anco.id_argomento_iaf=any (ac.id_argomento_settore) inner join entrasp.contratti cnt on ac.codice_azienda=cnt.codice_azienda and ac.id_contratto=cnt.id_contratto inner join entrasp.sondaggi snd on cnt.codice_azienda=snd.codice_azienda and cnt.id_contratto=snd.id_contratto where snd.codice_azienda=$codice_azienda$ and snd.id_sondaggio=$id_sondaggio$;",
                "options": [],
                "dataType": "text",
                "viewType": "combobox"
            },
            "label": "Assegnatario",
            "key": "id_anagrafica",
            "readOnly": false,
            "isHidden": false,
            "isPrimary": true,
            "newLine": false,
            "translate": "RESOURCES.id_anagrafica"
        },
        {
            "autoGenerate": false,
            "format": {
                "viewType": "combobox",
                "dataType": "text",
                "options": [],
                "comboQuery": "select id_argomento as id, descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=52266 order by arg.descrizione"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "id_argomento_competenza",
            "label": "Norma di riferimento",
            "readOnly": false,
            "newLine": false,
            "translate": "RESOURCES.id_argomento_competenza"
        },
        {
            "autoGenerate": false,
            "format": {
                "viewType": "input",
