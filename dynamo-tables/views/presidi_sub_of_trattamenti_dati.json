        "navigateOnSuccess": false
    },
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select tdp.*, true as delete_presidi_td, entrasp.transcodifiche_transcodifica('STATO_ATTUAZIONE', pr.stato_attuazione) as stato_attuazione ,true as visible_button_presidio, entrasp.presidi_descr(pr.id_presidio, pr.codice_azienda)as descr_presidio, entrasp.tipo_processo_descr(pr.id_tipo_presidio, pr.codice_azienda)as tipo_presidio, pr.codice  from entrasp.cpl_trattamenti_dati_presidi tdp inner join entrasp.presidi pr on tdp.codice_azienda=pr.codice_azienda and tdp.id_presidio=pr.id_presidio where tdp.codice_azienda=$codice_azienda$ and tdp.id_trattamento_dati=$id_trattamento_dati$"
        }   
    ],
