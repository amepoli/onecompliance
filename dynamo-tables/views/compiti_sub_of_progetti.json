        {
            "fieldName": "flag_compiti_non_associati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Non associati a oggetti",
            "newLine": false,
            "queryCond": "cmp.codice_azienda||'-'||cmp.codice_compito not in (select crb.codice_azienda||'-'||crb.codice_compito from entrasp.compiti_rif_bo crb)"
        },
        {
            "fieldName": "flag_progetti_miei",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Miei/Mio Ufficio",
            "newLine": false,
            "queryCond": "(cmp.id_centro_gest||'-'||cmp.codice_part in(select cg2.id_centro_gest||'-'||cg2.codice_part from entrasp.centri_gestionali cg2 where cg2.id_gruppo_lavoro||'-'||cg2.codice_part in(select glm.id_gruppo_lavoro||'-'||glm.codice_part from entrasp.gruppi_lavoro_membri glm inner join entrasp.anagrafiche_id an on glm.codice_part=an.codice_part and glm.id_anagrafica=an.id_anagrafica where an.dynamo_user='€global_username€' and an.codice_part='€global_codice_part€')) or cmp.id_centro_gest_monitor||'-'||cmp.codice_part in(select cg2.id_centro_gest||'-'||cg2.codice_part from entrasp.centri_gestionali cg2 where cg2.id_gruppo_lavoro||'-'||cg2.codice_part in(select glm.id_gruppo_lavoro||'-'||glm.codice_part from entrasp.gruppi_lavoro_membri glm inner join entrasp.anagrafiche_id an on glm.codice_part=an.codice_part and glm.id_anagrafica=an.id_anagrafica where an.dynamo_user='€global_username€' and an.codice_part='€global_codice_part€')))"
