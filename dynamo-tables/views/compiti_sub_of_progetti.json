    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select case when cmp.stato !='C' then true else false end as check,codice_compito,entrasp.argomenti_descr_breve_no_num(id_argomento_priorita) as priorita,entrasp.time_report_stop_active((€global_id_anagrafiche€)::text,cmp.codice_compito,cmp.codice_azienda) as time_report_stop_active, case when entrasp.time_report_stop_active((€global_id_anagrafiche€)::text,cmp.codice_compito,cmp.codice_azienda) then false else true end as time_report_play, (€global_id_anagrafiche€)::text as user_companies, entrasp.anagrafiche_vr_dati_identificativi(cmp.codice_part, id_cliente) as cliente_desc, data_segnalazione, data_chiusura, codice_azienda, substring(titolo from 1 for 100) as titolo,  entrasp.compiti_count_open_compiti_sub(cmp.codice_azienda, codice_compito) as conta_aperti, entrasp.tipo_segnalazione_descr_new(id_tipo_segnalazione) as tipo_segnalazione, entrasp.transcodifiche_transcodifica('STATO_COMPITI', stato) as stato, cmp.id_progetto from entrasp.compiti cmp where codice_azienda=$codice_azienda$ and id_tipo_segnalazione=150 and id_progetto=$id_progetto$"
        },
        {
            "operation": "startEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_play((€global_id_anagrafiche€)::text, '$codice_compito$', '$codice_azienda$') as play_time_report"
        },
        {
            "operation": "stopEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
        }
