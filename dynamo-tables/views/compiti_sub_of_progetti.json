            "newLine": false,
            "size": 2,
            "queryCond": "cmp.id_tipo_segnalazione=$id_tipo_segnalazione_s$"
        },
        {
            "fieldName": "id_centro_gest_s",
            "format": {
                "comboQuery": "SELECT id_centro_gest AS id, descrizione AS name  FROM entrasp.centri_gestionali WHERE codice_part='€global_codice_part€' order by descrizione;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Centro Gest.",
            "newLine": false,
