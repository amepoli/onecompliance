{
  "$schema": "../views.schema.json",
  "entryKey": "domande_sub_of_controlli",
  "origin": "entrasp.domande",
  "businessObjectName": "domande",
 "predefinedQueries": [
   {
     "operation": "selectTable",
     "queryString": "select dmd.*, left(entrasp.modello_test_titolo(dmd.codice_azienda, dmd.id_modello_test), 130) as titolo_mt,substring(entrasp.domande_descrizione(codice_azienda, id_modello_test, id_modello_test_vr, id_domanda), 1, 130) as domanda_transc, $id_argomento_generale$ as id_argomento_generale, $id_argomento_primo_strato$ as id_argomento_primo_strato from entrasp.domande dmd where dmd.codice_azienda=$codice_azienda$ and dmd.id_argomento in (select unnest(elenco_argomenti_controlli) from entrasp.controlli_configuration where id_argomento_primo_strato=$id_argomento_primo_strato$ and id_argomento_generale=$id_argomento_generale$)",
     "type": "main"
   }
 ],
