    "search_keys": [
        {
            "fieldName": "id_anagrafica_s",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID Anagrafica",
            "newLine": false,
            "queryCond": "avr.id_anagrafica=$id_anagrafica_s$"
        },
        {
            "fieldName": "nome_rs",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Nome/Cognome/Ragione Sociale",
            "newLine": true,
            "queryCond": "(replace(UPPER(an.nome), '.', '') like '%'||UPPER('€nome_rs€')||'%' or replace(UPPER(an.cognome), '.', '') like '%'||UPPER('€nome_rs€')||'%' or replace(UPPER(avr.ragione_sociale), '.', '') like '%'||UPPER('€nome_rs€')||'%')"
        },
        {
            "fieldName": "codice_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Codice",
            "newLine": false,
            "queryCond": "(UPPER(avr.codice) like '%'||UPPER('€codice_s€')||'%' or UPPER(an.codice) like '%'||UPPER('€codice_s€')||'%')"
        },
        {
            "fieldName": "piva_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Partita IVA",
            "newLine": false,
            "queryCond": "avr.partita_iva = $piva_s$"
        },
        {
            "fieldName": "codice_fiscale_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Codice fiscale",
            "newLine": false,
            "queryCond": "avr.codice_fiscale = $codice_fiscale_s$"
        },
        {
            "fieldName": "ruolo_s",
            "format": {
                "comboQuery": "SELECT codice_ruolo AS id, descrizione AS name  FROM entrasp.ruoli order by descrizione;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Ruolo",
            "newLine": false,
            "queryCond": "an.id_anagrafica in(select ra.id_anagrafica from entrasp.ruoli_anagrafiche ra where ra.codice_ruolo='€ruolo_s€' and ra.codice_azienda='€global_codice_azienda€')"
        },
        {
            "fieldName": "tipo_s",
            "format": {
                "comboQuery": "select codice as id, transcodifica as name from entrasp.transcodifiche where tipo_dato='TIPO_SOGGETTO'",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Tipo",
            "newLine": true,
            "queryCond": "an.tipo_soggetto = $tipo_s$"
        },
        {
            "fieldName": "associated_trattamenti_dati",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Con trattamenti dati associati",
            "newLine": false,
            "size": 1,
            "queryCond": "an.id_anagrafica in(select id_responsabile from entrasp.cpl_trattamenti_dati_responsabili where codice_part='€global_codice_part€' and id_responsabile is not null union select id_titolare_esterno from entrasp.cpl_trattamenti_dati_titolari_esterni where codice_part='€global_codice_part€' and id_titolare_esterno is not null)"
        },
        {
            "fieldName": "duplicati_per_partita_iva",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Duplicati per partita iva",
            "newLine": false,
            "size": 1,
            "queryCond": "avr.partita_iva in(select partita_iva from entrasp.conta_anagrafiche_per_partita_iva where conta>1 and partita_iva is not null and partita_iva!='' and codice_part='€global_codice_part€')"
        },
        {
            "fieldName": "duplicati_per_codice_fiscale",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Duplicati per codice fiscale",
            "newLine": false,
            "size": 1,
            "queryCond": "avr.codice_fiscale in(select codice_fiscale from entrasp.conta_anagrafiche_per_codice_fiscale where conta>1 and codice_fiscale is not null and codice_fiscale!='' and codice_part='€global_codice_part€')"
        },
        {
            "fieldName": "documenti_scaduti",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Documenti scaduti",
            "newLine": false,
            "size": 1,
            "queryCond": "(data_scadenza_documento<CURRENT_DATE and data_scadenza_documento is not null)"
        }
    ],
