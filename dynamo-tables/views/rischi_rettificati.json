        {
            "width": "650px",
            "height": "340px",
            "dashboardHeight": "242",
            "title": "RISCHI: PROBABILITA' E IMPATTO",
            "conditions": [
                {
                    "format": {
                        "backgroundColor": "white",
                        "color": "black",
                        "fontFamily": "Arial",
                        "fontSize": "14px"
                    },
                    "formula": "!isNaN(#value)"
                }
            ],
            "dataSource": {
                "data": []
            },
            "labels": {
                "colorsQuery": {
                    "query": "select crr.codice_colore as color from entrasp.cpl_risk_response crr, entrasp.cpl_srr srr where srr.id_risk_response=crr.id_risk_response and srr.codice_azienda=crr.codice_azienda and crr.codice_azienda=$codice_azienda$ and srr.id_esercizio=crr.id_esercizio and crr.id_esercizio=(select max(id_esercizio) from entrasp.cpl_risk_response where codice_azienda=$codice_azienda$) order by srr.soglia_a_pk, srr.soglia_a_int;",
                    "type": "full"
                },
                "columnsQuery": {
                    "key": "probabilita",
                    "query": "select descrizione as label from entrasp.cpl_soglie where tipo_soglia='P' and codice_azienda=$codice_azienda$ and id_esercizio=(select max(id_esercizio) from entrasp.cpl_risk_response where codice_azienda=$codice_azienda$) order by soglia_a;"
                },
                "rowsQuery": {
                    "key": "impatto",
                    "query": "select descrizione as label from entrasp.cpl_soglie where tipo_soglia='I' and codice_azienda=$codice_azienda$ and id_esercizio=(select max(id_esercizio) from entrasp.cpl_risk_response where codice_azienda=$codice_azienda$) order by soglia_a;"
                }
            },
            "localization": "it",
            "options": {
                "drillThrough": false,
                "grid": {
                    "showHeaders": false
                }
            },
            "slice": {
                "columns": [
                    {
                        "uniqueName": "Measures"
                    },
                    {
                        "uniqueName": "Probabilita"
                    }
                ],
                "measures": [
                    {
                        "aggregation": "count",
                        "availableAggregations": [
                            "count",
                            "distinctcount"
                        ],
                        "uniqueName": "Impatto"
                    }
                ],
                "rows": [
                    {
                        "uniqueName": "Impatto"
                    }
                ]
            }
        },
