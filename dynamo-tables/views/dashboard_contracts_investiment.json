			{
			  "format": {
				"backgroundColor": "white",
				"color": "blak",
				"fontFamily": "Arial",
				"fontSize": "11px"
			  },
			  "formula": "!isNaN(#value)"
			}
		  ],
		  "dataSource": {
			"data": []
		  },
		  "labels": {
			"colorsQuery": {
			  "query": "select background_color as color from entrasp.transcodifiche where tipo_dato='GIUDIZIO_MIFID' order by transcodifica",
