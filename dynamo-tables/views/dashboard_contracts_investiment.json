			},
			"columnsQuery": {
			  "key": "giudizio",
			  "query": "select transcodifica as label from entrasp.transcodifiche where tipo_dato='GIUDIZIO_MIFID' order by label"
			},
			"rowsQuery": {
			  "key": "strumento_finanziario",
			  "query": "select distinct entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_strumento_finanziario) as label from entrasp.contratti"
			}
		  },
		  "localization": "it",
		  "options": {
			"drillThrough": false,
			"grid": {
			  "showGrandTotals": "rows",
			  "showHeaders": false
			}
		  },
		  "slice": {
			"reportFilters": [
			  {
				"uniqueName": "anno_stipula"
			  },
			  {
				"uniqueName": "mese_stipula"
			  }
			],
			"columns": [
			  {
				"uniqueName": "Measures"
			  },
			  {
				"uniqueName": "Giudizio"
			  }
			],
			"measures": [
			  {
				"aggregation": "count",
				"availableAggregations": [
				  "count",
				  "distinctcount"
				],
				"uniqueName": "Giudizio"
			  }
			],
			"rows": [
			  {
				"filter": {
				  "members": [],
				  "negation": true
				},
				"uniqueName": "Strumento_finanziario"
			  }
			]
		  }
		}
	  ],
