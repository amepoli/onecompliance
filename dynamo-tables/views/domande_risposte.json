            },
            "queryFunct": "entrasp.risposte_previste_multipla_aperta(codice_azienda,id_modello_test,id_modello_test_vr,id_domanda)",
            "outputEvent": {
                "eventName": "domande_risposte_multipla_aperta",
                "eventTrigger": "change"
            }
        },
        {
            "isHidden": true,
            "readOnly": false,
            "isPrimary": false,
