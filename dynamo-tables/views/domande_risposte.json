            "format": {
                "viewType": "input",
                "dataType": "number"
            }
        },
        {
            "isHidden": true,
            "readOnly": true,
            "isPrimary": true,
            "key": "id_domanda",
            "label": "id_domanda",
            "format": {
                "viewType": "input",
