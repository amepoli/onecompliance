{
    "entryKey": "domande_risposte",
    "$schema": "../views.schema.json",
    "origin": "entrasp.domande",
    "businessObjectName": "domandeRisposte",
    "orderBy": {
        "key": "ordinamento",
        "order": "ascending"
    },
    "view_properties": [
        {
            "viewType": "formView",
            "propertyType": "isHidden",
            "queryString": "select id_domanda_rif IS NOT NULL as label from entrasp.domande where codice_azienda=$codice_azienda$ and id_modello_test=$id_modello_test$ and id_modello_test_vr=$id_modello_test_vr$;",
            "inputEvents": [
                {
                    "eventName": "toggle_question",
                    "actionType": "showView",
                    "condition": "equalTo",
                    "keys": [
                        {
                            "sender": "id_domanda",
                            "receiver": "id_domanda_rif"
                        },
                        {
                            "sender": "%value%",
                            "receiver": "id_risposta_prev_rif"
                        }
                    ]
                }
            ]
        }
    ],
    "form_keys": [
        {
            "isHidden": true,
            "readOnly": true,
