{
    "entryKey": "domande_risposte",
    "$schema": "../views.schema.json",
    "origin": "entrasp.domande",
    "businessObjectName": "domandeRisposte",
    "orderBy": {
      "key": "ordinamento",
      "order": "ascending"
    },
    "view_properties": [
        {
            "viewType": "formView",
            "propertyType": "isHidden",
            "queryString": "select id_domanda_rif IS NOT NULL as label from entrasp.domande where codice_azienda=$codice_azienda$ and id_modello_test=$id_modello_test$ and id_modello_test_vr=$id_modello_test_vr$;"
        }
    ],
    "form_keys": [
      {
        "isHidden": true,
        "readOnly": true,
        "isPrimary": true,
        "key": "codice_azienda",
        "label": "codice_azienda",
        "format": {
          "viewType": "input",
          "dataType": "text"
        }
      },
      {
        "isHidden": true,
        "readOnly": true,
        "isPrimary": true,
        "key": "id_domanda",
        "label": "id_domanda",
        "format": {
          "viewType": "input",
          "dataType": "number"
        }
      },
      {
        "isHidden": true,
        "readOnly": true,
        "isPrimary": true,
        "key": "id_modello_test",
        "label": "id_modello_test",
        "format": {
          "viewType": "input",
          "dataType": "number"
        }
      },
      {
        "isHidden": true,
        "readOnly": true,
        "isPrimary": true,
        "key": "id_modello_test_vr",
        "label": "id_modello_test_vr",
        "format": {
          "viewType": "input",
          "dataType": "number"
        }
      },
      {
        "isHidden": false,
        "readOnly": true,
        "isPrimary": false,
        "key": "ordinamento",
        "label": "N.",
        "format": {
          "viewType": "input",
          "dataType": "number"
        },
        "newLine": false,
        "size": 2
      },
      {
        "isHidden": false,
        "readOnly": false,
        "isPrimary": false,
        "key": "descrizione",
        "label": "Descrizione",
        "format": {
          "viewType": "textarea"
        },
        "newLine": false,
        "size": 6
      },
      {
        "isHidden": false,
        "readOnly": true,
        "isPrimary": false,
        "key": "punteggio",
        "label": "Punteggio",
        "format": {
          "viewType": "input",
          "dataType": "text"
        },
        "newLine": true,
        "size": 2
      },
      {
        "isHidden": true,
        "readOnly": true,
        "isPrimary": false,
        "key": "anyanswer",
        "label": "anyanswer",
        "format": {
          "viewType": "input",
          "dataType": "boolean"
        },
        "queryFunct": "entrasp.risposte_previste_conteggio(codice_azienda, id_modello_test, id_modello_test_vr, id_domanda)",
        "outputEvent": {
          "eventName": "domande_risposte_anyanswer",
          "eventTrigger": "change"
        }
      }
    ]
  }