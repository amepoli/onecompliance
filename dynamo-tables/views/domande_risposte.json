                        "readOnly": false,
                        "key": "risposta",
                        "label": "Risposta",
                        "queryFunct": "entrasp.risposta_multipla_sondaggio(codice_azienda,id_modello_test,id_modello_test_vr,id_domanda)",
                        "format": {
                            "viewType": "radiobutton",
                            "options": [],
                            "comboQuery": "select id_risposta_prev as id, risposta as name from entrasp.risposte_previste where codice_azienda=$codice_azienda$ and id_modello_test=$id_modello_test$ and id_modello_test_vr=$id_modello_test_vr$ and id_domanda=£id_domanda£;"
                        },
                        "outputEvent": {
                            "eventName": "toggle_question",
                            "eventTrigger": "change"
                        }
                    }
                ]
            }
        },
        {
            "isHidden": true,
            "readOnly": false,
            "isPrimary": false,
            "key": "risposte_aperta",
            "sameOrigin": false,
            "label": "risposte_aperta",
