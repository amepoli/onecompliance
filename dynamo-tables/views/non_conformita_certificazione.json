            "label": "Azioni",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "close_compito",
                    "icon": "check",
                    "label": "Chiudi segnalazioni",
                    "confirmAction": true,
                    "confirmActionMessage": "Chiudere le segnalazioni selezionate?",
                    "query": "update entrasp.compiti set stato='C', data_chiusura=current_date where codice_compito IN (SELECT SPLIT_PART(ARR,'~',1) FROM UNNEST(ARRAY[$selected_rows_data$]) AS ARR ) AND codice_azienda='€global_codice_azienda€' and stato != 'C';",
                    "reloadOnSuccess": true
                },
                {
                    "key": "delete_compito",
                    "icon": "delete",
                    "label": "Cancella",
                    "confirmAction": true,
                    "confirmActionMessage": "Cancellare le segnalazioni selezionate?",
                    "query": "delete from entrasp.compiti where codice_compito IN (SELECT SPLIT_PART(ARR,'~',1) FROM UNNEST(ARRAY[$selected_rows_data$]) AS ARR ) AND codice_azienda='€global_codice_azienda€' and stato != 'C';",
                    "reloadOnSuccess": true
                },
                {
                    "key": "unifica",
                    "icon": "merge_type",
                    "label": "Unisci compiti",
                    "query": "select entrasp.unifica_compiti_selezionati(array[$selected_rows_data$],'€global_codice_azienda€')",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Unire i compiti selezionati?"
                }
            ]
        }
    ],
    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "main",
            "queryString": "select * from entrasp.compiti where codice_azienda=$codice_azienda$ and codice_compito=$codice_compito$ and id_tipo_segnalazione!=0"
        },
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "SELECT entrasp.argomenti_descr_breve_no_num(cmp.id_argomento_priorita) as priorita, cmp.codice_compito,true AS time_report_stop_active,TRUE AS time_report_play,entrasp.anagrafiche_vr_dati_identificativi(cmp.codice_part, cmp.id_cliente) AS cliente_desc,cmp.data_segnalazione,cmp.data_chiusura,cmp.codice_azienda,substring(cmp.titolo FROM 1 FOR 100) AS titolo,entrasp.centri_gestionali_descr(cmp.codice_part, cmp.id_centro_gest) AS descr_centro_gest,entrasp.centri_gestionali_descr(cmp.codice_part, cmp.id_centro_gest_monitor) AS descr_centro_gest_monitor,entrasp.compiti_count_open_compiti_sub(cmp.codice_azienda, cmp.codice_compito) AS conta_aperti,entrasp.tipo_segnalazione_descr_new(cmp.id_tipo_segnalazione) AS tipo_segnalazione,entrasp.transcodifiche_transcodifica('STATO_COMPITI', cmp.stato) AS stato FROM entrasp.compiti CMP where cmp.codice_azienda=$codice_azienda$ and cmp.id_tipo_segnalazione=1"
        },
        {
            "operation": "startEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_play((€global_id_anagrafiche€)::text, '$codice_compito$', '$codice_azienda$') as play_time_report"
        },
        {
            "operation": "stopEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.compiti set foreseen_date=$foreseen_date$ where codice_compito=$codice_compito$ and codice_azienda=$codice_azienda$"
        }
    ],
