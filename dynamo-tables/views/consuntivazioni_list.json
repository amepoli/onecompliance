{
    "$schema": "../views.schema.json",
    "entryKey": "consuntivazioni_list",
    "inheritsFrom": "consuntivazioni_consultant_list",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select csn.date_time_begin, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', csn.stato) as descr_stato, csn.thread,csn.date_time_end, csn.id_cons, csn.codice_compito, substring(entrasp.descrizione_consuntivazione(csn.codice_azienda, csn.id_cons), 1, 200) as titolo_compito, csn.codice_azienda, csn.data_intervento, csn.durata, csn.durata_ft, csn.codice_attivita, csn.id_progetto, csn.id_modello_test, csn.id_fase, csn.id_sondaggio, entrasp.anagrafiche_id_codcognnome(csn.codice_part, csn.id_risorsa) as esecutore, substring(csn.note from 1 for 100) as note_restricted from entrasp.consuntivazioni csn inner join entrasp.aziende az on csn.codice_azienda=az.codice_azienda WHERE csn.codice_azienda=$codice_azienda$;",
            "type": "main"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select £date_time_begin£>now()",
            "messageNotNull": "La data inizio non può essere nel futuro. Correggere e poi salvare."
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select £date_time_begin£>£date_time_end£",
            "messageNotNull": "La data fine non può essere precedente alla data inizio. Correggere e poi salvare."
        }
    ],
