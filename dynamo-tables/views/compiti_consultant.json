  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectTable",
      "queryString": "select cmp.codice_azienda, cmp.foreseen_date, cmp.codice_compito, cmp.codice, cmp.titolo, sustring(cmp.note from 1 to 239) as note, cmp.data_segnalazione, (€global_id_anagrafiche€)::text as user_companies, entrasp.time_report_stop_active((€global_id_anagrafiche€)::text, cmp.codice_compito, cmp.codice_azienda), true as time_report_play, entrasp.tipo_segnalazione_descr_new(cmp.id_tipo_segnalazione) as tipo_segnalazione, entrasp.transcodifiche_transcodifica('STATO_COMPITI', cmp.stato) as stato, entrasp.compiti_count_open_compiti_sub(cmp.codice_azienda, cmp.codice_compito) as compiti_aperti, codice_compito_parent from entrasp.compiti cmp WHERE cmp.codice_azienda in(€global_user_companies€) and cmp.id_tipo_segnalazione!=700"
    },
    {
      "operation": "selectForm",
      "type": "main",
      "queryString": "select * from entrasp.compiti where codice_azienda=$codice_azienda$ and codice_compito=$codice_compito$"
    },
    {
      "operation": "insert",
      "type": "postProcessing",
      "queryString": "select entrasp.assegna_compito_user_centro_gest_default_insert((€global_id_anagrafiche€)::text, $titolo$, $codice_azienda$);"
    },
    {
      "operation": "update",
      "type": "postProcessing",
      "queryString": "select entrasp.assegna_compito_user_centro_gest_default((€global_id_anagrafiche€)::text, $codice_compito$, $codice_azienda$);"
    },
    {
      "operation": "insert",
      "type": "postProcessing",
      "queryString": "update entrasp.compiti cmp set trattamento=$trattamento$, analisi_cause=$analisi_cause$, perdita_diretta_effettiva=$perdita_diretta_effettiva$, perdita_indiretta_effettiva=$perdita_indiretta_effettiva$, perdita_diretta_potenziale=$perdita_diretta_potenziale$, perdita_indiretta_potenziale=$perdita_indiretta_potenziale$, flag_causa_legale=coalesce($flag_causa_legale$,0) , flag_reclamo=coalesce($flag_reclamo$,0) , flag_progetto_informatico=coalesce($flag_progetto_informatico$,0) where cmp.codice_azienda=$codice_azienda$ and cmp.codice_compito = $codice_compito$"
    },
    {
      "operation": "update",
      "type": "postProcessing",
      "queryString": "update entrasp.compiti cmp set trattamento=$trattamento$, analisi_cause=$analisi_cause$, perdita_diretta_effettiva=$perdita_diretta_effettiva$, perdita_indiretta_effettiva=$perdita_indiretta_effettiva$, perdita_diretta_potenziale=$perdita_diretta_potenziale$, perdita_indiretta_potenziale=$perdita_indiretta_potenziale$, flag_causa_legale=coalesce($flag_causa_legale$,0) , flag_reclamo=coalesce($flag_reclamo$,0) , flag_progetto_informatico=coalesce($flag_progetto_informatico$,0)  where cmp.codice_azienda=$codice_azienda$ and cmp.codice_compito = $codice_compito$"
    },
    {
      "operation": "startEvent",
      "type": "main",
      "queryString": "select entrasp.time_report_play((€global_id_anagrafiche€)::text, '$codice_compito$', '$codice_azienda$')"
    },
    {
      "operation": "stopEvent",
      "type": "main",
      "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
    }
  ],
  "search_keys": [
    {
      "fieldName": "codice_azienda_s",
      "format": {
        "comboQuery": "SELECT codice_azienda AS id, codice_azienda AS name FROM entrasp.aziende where codice_azienda in(€global_user_companies€) order by codice_azienda;",
        "options": [],
        "viewType": "combobox",
        "dataType": "text"
      },
      "label": "Azienda",
      "newLine": false,
      "queryCond": "codice_azienda='€codice_azienda_s€'"
    },
    {
      "fieldName": "stato",
      "format": {
        "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_COMPITI';",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Stato",
      "translate": "RESOURCES.status",
      "newLine": true,
      "queryCond": "stato='€stato€'"
    },
    {
      "fieldName": "note_search",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Note/Titolo",
      "newLine": false,
      "queryCond": "UPPER (note) like '%'||UPPER('€note_search€')||'%' or UPPER (titolo) like '%'||UPPER('€note_search€')||'%'"
    },
    {
      "fieldName": "codice_compito_s",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Codice Compito",
      "newLine": false,
      "queryCond": "codice_compito=$codice_compito_s$"
    },
    {
      "fieldName": "titolo",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
       "label": "Titolo",
            "translate": "RESOURCES.title",
      "newLine": true,
      "queryCond": "titolo=$titolo$"
    },
    {
      "fieldName": "id_tipo_segnalazione",
      "format": {
        "comboQuery": "select id_tipo_segnalazione as id, descrizione as name from entrasp.tipi_segnalazioni order by descrizione;",
        "options": [],
        "viewType": "combobox"
      },
      "label": "ID Tipo Segnal.",
      "newLine": false,
      "queryCond": "id_tipo_segnalazione=$id_tipo_segnalazione$"
    },
    {
      "fieldName": "id_centro_gest",
      "format": {
        "comboQuery": "SELECT id_centro_gest AS id, codice_azienda||'-'||entrasp.centri_gestionali_descr(codice_azienda,id_centro_gest) AS name  FROM entrasp.compiti order by codice_azienda;",
        "options": [],
        "viewType": "combobox"
      },
       "label": "Centro Gestionale",
            "translate": "RESOURCES.office",
      "newLine": false,
      "queryCond": "id_centro_gest=$id_centro_gest$"
    },
    {
      "fieldName": "dynamo_user_s",
      "format": {
        "comboQuery": "select distinct dynamo_user as id, dynamo_user as name from entrasp.anagrafiche_id order by dynamo_user;",
        "options": [],
        "viewType": "combobox",
        "dataType": "text"
      },
      "label": "User",
      "newLine": true,
      "queryCond": "codice_part||'-'||id_anagrafica in(select codice_part||'-'||id_anagrafica from entrasp.anagrafiche_id where dynamo_user='€dynamo_user_s€')"
    },
    {
      "fieldName": "main_s",
      "format": {
        "value": "0",
        "viewType": "checkbox"
      },
      "label": "Principali (no sovracompiti)",
      "newLine": false,
      "size": 1,
      "queryCond": "cmp.codice_compito_parent is null"
    },
    {
      "fieldName": "main_s",
      "format": {
        "value": "0",
        "viewType": "checkbox"
      },
      "label": "Includi tutti i sotto compiti",
      "newLine": false,
      "size": 1,
      "queryCond": "(1=1 or entrasp.codice_compito_parent_ver2(cmp.codice_azienda, cmp.codice_compito)=cmp.codice_compito_parent)"
    }
  ],
