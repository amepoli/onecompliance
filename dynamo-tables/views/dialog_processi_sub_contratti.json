            "type": "main",
            "queryString": "update entrasp.procedure_contratti pc1 set controllo_certificazione=coalesce($controllo_certificazione$,pc2.controllo_certificazione), controllo_audit_1=coalesce($controllo_audit_1$,pc2.controllo_audit_1), controllo_audit_2=coalesce($controllo_audit_2$,pc2.controllo_audit_2), controllo_rinnovo = coalesce($controllo_rinnovo$,pc2.controllo_rinnovo) from entrasp.procedure_contratti pc2, (select split_part(arr,'~',1) as codiceazienda, split_part(arr,'~',3)::numeric as idprocedura, split_part(arr,'~',2)::numeric as idcontratto from unnest(ARRAY[$selected_rows_data$]) arr) as s where pc1.codice_azienda=pc2.codice_azienda and pc1.id_contratto=pc2.id_contratto and pc1.id_procedura=pc2.id_procedura and pc1.codice_azienda='€global_codice_azienda€' and pc1.id_contratto=s.idcontratto and pc1.id_procedura=s.idprocedura;"
