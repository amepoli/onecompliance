            "key": "argomento_unifica_all_k",
            "buttonIcon": "merge_type",
            "label": "Unifica tutti i duplicati",
            "newLine": false,
            "outputEvent": {
                "eventName": "argomento_unifica_all",
                "eventTrigger": "press"
            },
            "inputEvents": [
                {
                    "eventName": "argomento_unifica_all",
                    "actionType": "query",
                    "condition": "none",
                    "values": [],
                    "queryFunct": "select entrasp.unifica_argomento(a1.id_argomento, a2.id_argomento) from entrasp.argomenti a1 inner join entrasp.argomenti a2 on trim(a1.descrizione)=trim(a2.descrizione) where a1.id_argomento!=a2.id_argomento and a1.id_argomento<a2.id_argomento",
                    "successMessage": "Done!"
                }
            ],
            "readOnly": false,
