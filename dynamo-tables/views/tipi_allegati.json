    "predefinedQueries": [
        {
            "type": "main",
            "operation": "selectTable",
            "queryString": "select arg.* from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=$P{id_argomento_father} and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€');"
        },
        {
            "operation": "insert",
            "queryString": "select entrasp.argomenti_classification_insert($descrizione$, $descrizione$, $codice$, $P{id_argomento_father}) as id_argomento;",
            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "delete from entrasp.argomenti_argomenti where id_argomento_father=$P{id_argomento_father} and id_argomento_son=$id_argomento$;",
            "type": "preProcessing"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_argomento$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£'",
            "messageNotNull": "Inserimento: Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "update entrasp.argomenti arg set descrizione_breve=replace(descrizione_breve, '/', ','), nickname=replace(nickname, '/', ','), flag_no_delete=true from entrasp.argomenti_argomenti aa  where arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=3576 and (position('/' in descrizione_breve)!=0 or position('/' in nickname)!=0)"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£' and id_argomento!=$id_argomento$",
            "messageNotNull": "Aggiornamento: Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.argomenti arg set descrizione_breve=replace(descrizione_breve, '/', ','), nickname=replace(nickname, '/', ',') from entrasp.argomenti_argomenti aa  where arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=3576 and (position('/' in descrizione_breve)!=0 or position('/' in nickname)!=0)"
        }
    ],
