{
    "businessObjectName": "transcodifiche",
    "entryKey": "progetti_for_state_and_type",
    "$schema": "../views.schema.json",
    "origin": "entrasp.transcodifiche",
    "predefinedQueries": [
        {
            "queryString": "select ts.tipo_dato, arg.id_argomento, arg.descrizione_breve, ts.codice,ts.transcodifica,count(distinct prg.id_progetto) as num_progetti from entrasp.transcodifiche ts inner join entrasp.progetti prg on ts.codice=prg.stato left join entrasp.attivita att on prg.codice_azienda=att.codice_azienda and prg.codice_attivita=att.codice_attivita and prg.attivita_vr=att.attivita_vr left join entrasp.argomenti arg on att.id_argomento=arg.id_argomento inner join entrasp.progetti_fasi pf on prg.codice_azienda=pf.codice_azienda and prg.id_progetto=pf.id_progetto inner join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio inner join entrasp.centri_gestionali cg on snd.codice_part=cg.codice_part and snd.id_centro_gest=cg.id_centro_gest inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where ts.tipo_dato='STATO_SONDAGGI' and prg.codice_azienda=('€global_codice_azienda€')",
            "operation": "selectTable",
            "type": "main"
        },
        {
            "queryString": "select *, $id_argomento$ as id_argomento, entrasp.argomenti_descr_breve($id_argomento$) as tipo_processo from entrasp.transcodifiche where codice=$codice$ and tipo_dato=$tipo_dato$",
            "operation": "selectForm",
            "type": "main"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "group by ts.tipo_dato, arg.id_argomento, arg.descrizione_breve, ts.codice, ts.transcodifica, ts.ordinamento order by arg.descrizione_breve"
    },
    "search_keys": [
        {
            "fieldName": "tipo_dato_s",
            "queryCond": "(UPPER(tipo_dato) like '%'||UPPER('€tipo_dato_s€')||'%' or UPPER(transcodifica) like '%'||UPPER('€tipo_dato_s€')||'%') ",
            "newLine": false,
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola Chiave",
            "translate": "RESOURCES.parola_chiave_progetti_for_state_and_type"
        },
        {
            "fieldName": "tipo_dato_s2",
            "queryCond": "tipo_dato ='€tipo_dato_s2€'",
            "newLine": false,
            "format": {
                "comboQuery": "select distinct tipo_dato as id from entrasp.transcodifiche order by tipo_dato",
                "dataType": "text",
                "viewType": "combobox",
                "options": []
            },
            "label": "Tipo Dato",
            "translate": "RESOURCES.tipo_dato_progetti_for_state_and_type"
        },
        {
            "fieldName": "flag_progetti_aperti",
            "format": {
                "value": "1",
                "viewType": "toggle"
            },
            "label": "In Svolgimento",
            "newLine": false,
            "queryCond": "ts.codice not in ('C', 'N', 'R')",
            "translate": "RESOURCES.in_svolgimento_progetti_for_state_and_type"
        }
    ],
