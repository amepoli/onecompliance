{
    "$schema": "../views.schema.json",
    "entryKey": "categorie_sub_of_contratti_fornitori",
    "origin": "entrasp.contratti_categorie",
    "businessObjectName": "contratti_categorie",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select cd.codice_azienda, id_argomento_categoria, cd.note, true as delete_categorie_contratti, cd.id_contratto, entrasp.argomenti_descr_breve(cd.id_argomento_categoria) as descr_categoria from entrasp.contratti_categorie cd where cd.id_contratto=$id_contratto$ and cd.codice_azienda=$codice_azienda$ and cd.id_argomento_categoria in(select id_argomento_son from entrasp.argomenti_argomenti where id_argomento_father in($P{id_argomento_categoria})) and tipo='$P{categoria_dati}'"
        }
    ],
    "define": {
        "id_argomento_categoria": "53909",
        "categoria_dati": "categorie_bankit",
        "Categoria": "Categoria Segnalazione Bankit"
    },
