                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "fieldName": "stato_s",
            "label": "Stato",
            "newLine": true,
            "queryCond": "stato='€stato_s€'"
        },
        {
            "fieldName": "scaduto_s",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Scaduto",
            "newLine": false,
            "queryCond": "snd.data_prevista<=now() and stato!='C'"
        },
        {
            "fieldName": "flag_sondaggio_riprogrammato",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Riprogrammata",
            "newLine": false,
            "queryCond": "id_sondaggio in(select id_sondaggio_succ from entrasp.sondaggi where id_sondaggio_succ is not null and codice_azienda=$codice_azienda$)"
        },
        {
            "fieldName": "incompleto_s",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Incompleto",
            "translate": "RESOURCES.incomplete",
            "newLine": false,
            "queryCond": "somministrazione_completata!='Completo'"
        },
        {
            "fieldName": "no_giudizio",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Senza giudizio",
            "newLine": false,
            "queryCond": "giudizio is null"
        },
        {
            "fieldName": "flag_giudizio_manuale",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Con giudizio manuale",
            "newLine": false,
            "queryCond": "pct_da_manuale is not null"
        },
        {
            "fieldName": "flag_contratti_cessati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Cessati",
            "newLine": false,
            "queryCond": "(case when ss.object_name='anagraficheId' then nullif(split_part(ss.object_key,'|',2),'')::numeric else null::numeric end)::numeric IN(SELECT c2.id_cliente FROM entrasp.contratti c2 WHERE stato = 'C' and c2.id_cliente is not null GROUP BY c2.id_cliente)"
        },
        {
            "fieldName": "flag_contratti_non_cessati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Escluso Cessati",
            "newLine": false,
            "queryCond": "(case when ss.object_name='anagraficheId' then nullif(split_part(ss.object_key,'|',2),'')::numeric else null::numeric end)::numeric IN(SELECT id_cliente FROM entrasp.contratti WHERE stato!='C' and id_cliente is not null and codice_azienda='€global_codice_azienda€' UNION SELECT anx.id_anagrafica FROM entrasp.anagrafiche_id anx inner join entrasp.ruoli_anagrafiche ra on anx.id_anagrafica=ra.id_anagrafica and anx.codice_part=ra.codice_part where ra.codice_ruolo='CLI' and anx.codice_part='€global_codice_part€' and anx.id_anagrafica not in(select cntx.id_cliente from entrasp.contratti cntx where cntx.codice_azienda='€global_codice_azienda€' and cntx.id_cliente is not null)))"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": " order by somministrazione_completata desc"
      }
}