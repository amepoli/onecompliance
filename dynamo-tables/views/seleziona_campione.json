    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "update entrasp.sondaggi_somministrati set somministrazione_completata=entrasp.sondaggi_somministrati_complete($codice_azienda$, £id_somministrazione£) where codice_azienda=$codice_azienda$ and id_somministrazione=£id_somministrazione£"
        },
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "select round(percentuale,2) as ris_percentuale, giudizio, punteggio_description from entrasp.grc_punteggi_giudizi_finali($codice_azienda$, £id_somministrazione£);"
        },
        {
            "operation": "selectTable",
            "type": "preProcessing",
            "queryString": "update entrasp.sondaggi_somministrati ss set codice_part=az.codice_part from entrasp.aziende az WHERE ss.codice_part is null and ss.codice_azienda=az.codice_azienda;"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_somministrazione$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "main",
            "queryString": "select entrasp.campione_insert($codice_azienda$, $id_sondaggio$, $object_key$, $id_anagrafica$) as id_somministrazione;"
        }
    ],
