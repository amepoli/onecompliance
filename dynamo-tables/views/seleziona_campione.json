    "search_keys": [
        {
            "fieldName": "object_description",
            "format": {
                "comboQuery": "SELECT object_description AS id, object_description AS name  FROM entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Oggetto di verifica",
            "translate": "RESOURCES.check_subject",
            "newLine": false,
            "size": 3.5,
            "queryCond": "(UPPER (object_description) like '%'||UPPER('€object_description€')||'%')"
        },
        {
            "format": {
                "comboQuery": "SELECT distinct giudizio AS id, giudizio AS name  FROM entrasp.sondaggi_somministrati WHERE codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "fieldName": "giudizio_s",
            "label": "Giudizio",
            "translate": "RESOURCES.judgment",
            "newLine": false,
            "queryCond": "giudizio='€giudizio_s€'"
        },
        {
            "format": {
                "comboQuery": "select distinct descrizione as id, descrizione as name from entrasp.tipi_modelli_test_risultati_righe where codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "fieldName": "giudizio_manuale_s",
            "label": "Giudizio Manuale",
            "translate": "RESOURCES.manual_judgment",
            "newLine": false,
            "queryCond": "(select descrizione from entrasp.tipi_modelli_test_risultati_righe_descr_from_pct(codice_azienda, pct_da_manuale, id_risultato))='€giudizio_manuale_s€'"
        },
        {
            "format": {
                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "fieldName": "stato_s",
            "label": "Stato",
            "translate": "RESOURCES.status",
            "newLine": true,
            "queryCond": "stato='€stato_s€'"
        },
        {
            "fieldName": "scaduto_s",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Scaduto",
            "translate": "RESOURCES.expired",
            "newLine": false,
            "queryCond": "snd.data_prevista<=now() and stato!='C'"
        },
        {
            "fieldName": "flag_sondaggio_riprogrammato",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Riprogrammata",
            "translate": "RESOURCES.rescheduled",
            "newLine": false,
            "queryCond": "id_sondaggio in(select id_sondaggio_succ from entrasp.sondaggi where id_sondaggio_succ is not null and codice_azienda=$codice_azienda$)"
        },
        {
            "fieldName": "incompleto_s",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Incompleto",
            "translate": "RESOURCES.incomplete",
            "newLine": false,
            "queryCond": "somministrazione_completata!='Completo'"
        },
        {
            "fieldName": "no_giudizio",
            "format": {
                "viewType": "checkbox",
                "value": "0"
            },
            "label": "Senza giudizio",
            "translate": "RESOURCES.whitout_judgment",
            "newLine": false,
            "queryCond": "giudizio is null"
        },
        {
            "fieldName": "flag_giudizio_manuale",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Con giudizio manuale",
            "translate": "RESOURCES.with_manual_judgment",
            "newLine": false,
            "queryCond": "pct_da_manuale is not null"
        },
        {
            "fieldName": "flag_contratti_cessati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Cessati",
            "translate": "RESOURCES.ceased",
            "newLine": false,
            "queryCond": "(case when ss.object_name='anagraficheId' then nullif(split_part(ss.object_key,'|',2),'')::numeric else null::numeric end)::numeric IN(SELECT c2.id_cliente FROM entrasp.contratti c2 WHERE stato = 'C' and c2.id_cliente is not null GROUP BY c2.id_cliente)"
        },
        {
            "fieldName": "flag_contratti_non_cessati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Escluso Cessati",
            "translate": "RESOURCES.excluding_ceased",
            "newLine": false,
            "queryCond": "(case when ss.object_name='anagraficheId' then nullif(split_part(ss.object_key,'|',2),'')::numeric else null::numeric end)::numeric IN(SELECT id_cliente FROM entrasp.contratti WHERE stato!='C' and id_cliente is not null and codice_azienda='€global_codice_azienda€' UNION SELECT anx.id_anagrafica FROM entrasp.anagrafiche_id anx inner join entrasp.ruoli_anagrafiche ra on anx.id_anagrafica=ra.id_anagrafica and anx.codice_part=ra.codice_part where ra.codice_ruolo='CLI' and anx.codice_part='€global_codice_part€' and anx.id_anagrafica not in(select cntx.id_cliente from entrasp.contratti cntx where cntx.codice_azienda='€global_codice_azienda€' and cntx.id_cliente is not null)))"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": " order by somministrazione_completata desc"
    }
}