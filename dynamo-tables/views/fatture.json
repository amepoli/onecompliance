{
    "$schema": "../views.schema.json",
    "entryKey": "fatture",
    "origin": "entrasp.crediti_ceduti",
    "businessObjectName": "crediti_ceduti",
    "outputEvents": [
        {
            "eventName": "onSaveCessione",
            "eventTrigger": "onSave"
        }
    ],
    "inputEvents": [
        {
            "eventName": "onSaveCessione",
            "actionType": "reload"
        }
    ],
    "search_keys": [
        {
            "fieldName": "id_cessione",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID Fattura",
            "newLine": false,
            "size": 1.5,
            "queryCond": "id_cessione=$id_cessione$"
        },
        {
            "fieldName": "data_fattura_min",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Fattura dopo il",
            "newLine": false,
            "queryCond": "data_fattura>='€data_fattura_min€'"
        },
        {
            "fieldName": "data_pagamento_min",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Pagamento dopo il",
            "newLine": false,
            "queryCond": "id_cessione in (select cc.id_cessione from entrasp.crediti_ceduti cc inner join entrasp.pagamenti_crediti pag on cc.codice_azienda=pag.codice_azienda and cc.id_cessione=pag.id_cessione where cc.codice_azienda=$codice_azienda$ and pag.id_argomento_tipo_pag in (51488,51487) and pag.data_pagamento>='€data_pagamento_min€')"
        },
        {
            "fieldName": "data_scadenza_min",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Scadenza dopo il",
            "newLine": true,
            "queryCond": "data_scadenza>='€data_scadenza_min€'"
        },
        {
            "fieldName": "data_fattura_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Fattura entro il",
            "newLine": false,
            "queryCond": "data_fattura<='€data_fattura_max€'"
        },
        {
            "fieldName": "data_pagamento_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Pagamento entro il",
            "newLine": false,
            "queryCond": "id_cessione in (select cc.id_cessione from entrasp.crediti_ceduti cc inner join entrasp.pagamenti_crediti pag on cc.codice_azienda=pag.codice_azienda and cc.id_cessione=pag.id_cessione where cc.codice_azienda=$codice_azienda$ and pag.id_argomento_tipo_pag in (51488,51487) and pag.data_pagamento<='€data_pagamento_max€')"
        },
        {
            "fieldName": "data_scadenza_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Scadenza entro il",
            "newLine": true,
            "queryCond": "data_scadenza<=€data_scadenza_max€"
        },
        {
            "fieldName": "giorni_scad_max",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Giorni scaduto inferiore a",
            "newLine": false,
            "queryCond": "entrasp.calcola_scaduto (data_fattura, data_pagamento)<='€giorni_scad_max€'"
        },
        {
            "fieldName": "giorni_scad_min",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Giorni scaduto superiore a",
            "newLine": false,
            "queryCond": "entrasp.calcola_scaduto (data_fattura, data_pagamento)>='€giorni_scad_min€'"
        },
        {
            "fieldName": "fascicolo",
            "format": {
                "comboQuery": "SELECT distinct fascicolo AS id, fascicolo AS name FROM entrasp.crediti_ceduti WHERE codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Fascicolo",
            "newLine": false,
            "queryCond": "fascicolo=$fascicolo$"
        },
        {
            "fieldName": "n_fattura",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Fattura N.",
            "newLine": false,
            "queryCond": "upper(n_fattura) like '%'||upper('€n_fattura€')||'%'"
        },
        {
            "fieldName": "id_contratto_s",
            "format": {
                "comboQuery": "SELECT id_contratto AS id, numero_contratto AS name FROM entrasp.contratti WHERE codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Contratto N.",
            "newLine": false,
            "queryCond": "id_contratto=$id_contratto_s$"
        },
        {
            "fieldName": "data_pagamento_il",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data pagamento il",
            "newLine": false,
            "tooltip": "",
            "queryCond": "codice_azienda||'-'||id_cessione in (select pag.codice_azienda||'-'||pag.id_cessione from entrasp.pagamenti_crediti pag where pag.codice_azienda=$codice_azienda$ and pag.id_argomento_tipo_pag in (51488,51487) and pag.data_pagamento='€data_pagamento_il€')"
        },
        {
            "fieldName": "flag_lav_legale",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Lavorazione Legale",
            "newLine": false,
            "queryCond": "lavorazione_legale = '1'"
        },
        {
            "fieldName": "flag_no_lav_legale",
            "format": {
                "viewType": "checkbox"
            },
            "label": " Non Lavorazione Legale",
            "newLine": false,
            "queryCond": "lavorazione_legale = '0'"
        },
        {
            "fieldName": "flag_azionati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Azionati",
            "newLine": false,
            "queryCond": "azionato = '1'"
        },
        {
            "fieldName": "flag_non_azionati",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Non Azionati",
            "newLine": false,
            "queryCond": "azionato = '0'"
        },
        {
            "fieldName": "flag_opposti",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Opposti",
            "newLine": false,
            "queryCond": "opposto = '1'"
        }
    ],
