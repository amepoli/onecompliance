{
    "$schema": "../views.schema.json",
    "entryKey": "fatture",
    "origin": "entrasp.crediti_ceduti",
    "businessObjectName": "crediti_ceduti",
    "addElementSettings": {
        "labelAdd": "Nuova Fattura",
        "navigateOnSuccess": false
    },
    "outputEvents": [
        {
            "eventName": "onSaveCessione",
            "eventTrigger": "onSave"
        }
    ],
