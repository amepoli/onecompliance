            },
            "label": "Id Verifica",
            "newLine": false,
            "queryCond": "snd.id_somministrazione=$id_somministrazione_s$",
            "translate": "RESOURCES.id_verifica_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "id_argomento_tipo_allegato_s",
            "format": {
                "comboQuery": "select id_argomento as id, descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=3576 and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€');",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Tipo Documento",
            "newLine": true,
            "queryCond": "id_argomento_tipo_allegato=$id_argomento_tipo_allegato_s$",
            "translate": "RESOURCES.tipo_documento_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "id_anagrafica_s",
            "format": {
                "comboQuery": "SELECT an.id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name from entrasp.anagrafiche_id an WHERE an.codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Cliente",
            "newLine": false,
            "queryCond": "id_anagrafica=$id_anagrafica_s$",
            "translate": "RESOURCES.cliente_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "id_anagrafica_s",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID Anagrafica",
            "newLine": false,
            "queryCond": "avr.id_anagrafica=$id_anagrafica_s$",
            "translate": "RESOURCES.id_anagrafica_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "autore_s",
            "format": {
                "comboQuery": "select distinct autore as id, autore as name from entrasp.cdms_risorse where codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Utente",
            "newLine": true,
            "queryCond": "autore=$autore_s$",
            "translate": "RESOURCES.utente_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "data_da_s",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data da",
            "newLine": false,
            "queryCond": "data_creazione>=$data_da_s$",
            "translate": "RESOURCES.data_da_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "data_a_s",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data a",
            "newLine": false,
            "queryCond": "data_creazione<=$data_a_s$",
            "translate": "RESOURCES.data_a_attachments_sub_of_tipi_allegati"
        },
        {
            "fieldName": "parola_search_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola chiave",
            "newLine": false,
            "queryCond": "(upper(client_file_name) like '%'||upper('€parola_search_s€')||'%')",
            "translate": "RESOURCES.parola_chiave_attachments_sub_of_tipi_allegati"
        }
