{
    "$schema": "../views.schema.json",
    "entryKey": "dashboard_consuntivazioni",
    "inheritsFrom": "consuntivazioni_consultant_list",
    "querySuffixes": {
        "tableViewSuffix": "order by date_time_end desc limit 100"
    },
    "dashboards": [
        {
            "width": "900px",
            "height": "310px",
            "dashboardHeight": "330",
            "dashboardWidth": "400",
            "title": "ORE PER AZIENDA E ESECUTORE",
            "conditions": [
                {
                    "format": {
                        "backgroundColor": "white",
                        "color": "blak",
                        "fontFamily": "Arial",
                        "fontSize": "11px"
                    },
                    "formula": "!isNaN(#value)"
                }
            ],
            "dataSource": {
                "data": []
            },
            "labels": {
                "colorsQuery": {
                    "query": "select 'black' as color",
                    "type": "column"
                },
                "rowsQuery": {
                    "key": "esecutore",
                    "query": "select distinct entrasp.anagrafiche_id_codcognnome(codice_part,id_risorsa) as label from entrasp.consuntivazioni"
                },
                "columnsQuery": {
                    "key": "codice_azienda",
                    "query": "select codice_azienda as label from entrasp.aziende"
                }
            },
            "localization": "it",
            "options": {
                "drillThrough": false,
                "grid": {
                    "showGrandTotals": "rows",
                    "showHeaders": false
                }
            },
            "slice": {
                "reportFilters": [
                    {
                        "uniqueName": "anno_esecuzione"
                    },
                    {
                        "uniqueName": "mese_esecuzione"
                    }
                ],
                "columns": [
                    {
                        "uniqueName": "Measures"
                    },
                    {
                        "uniqueName": "codice_azienda"
                    }
                ],
                "measures": [
                    {
                        "aggregation": "sum",
                        "availableAggregations": [
                            "sum",
                            "count"
                        ],
                        "uniqueName": "durata"
                    }
                ],
                "rows": [
                    {
                        "filter": {
                            "members": [],
                            "negation": true
                        },
                        "uniqueName": "Esecutore"
                    }
                ]
            }
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "codice_azienda",
            "label": "codice_azienda",
            "width": "10%",
            "translate": "RESOURCES.codice_azienda_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "anno_esecuzione",
            "queryFunct": "date_part('year', date_time_begin)",
            "label": "Anno Esec.",
            "translate": "RESOURCES.AnnoEsec_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "mese_esecuzione",
            "queryFunct": "date_part('month', date_time_begin)",
            "label": "Mese Esec.",
            "translate": "RESOURCES.MeseEsec_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "id_cons",
            "width": "5%",
            "label": "Codice",
            "translate": "RESOURCES.codice_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "titolo_compito",
            "width": "40%",
            "queryFunct": "substring(entrasp.descrizione_consuntivazione(codice_azienda, id_cons), 1, 200)",
            "label": "Titolo attività",
            "translate": "RESOURCES.titolo_attivit_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "datetime"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "date_time_begin",
            "label": "Inizio",
            "width": "9%",
            "translate": "RESOURCES.inizio_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "datetime"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "date_time_end",
            "label": "Fine",
            "width": "9%",
            "translate": "RESOURCES.fine_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "durata",
            "queryFunct": "round(coalesce(durata,0)/60,2)",
            "label": "Durata Intervento (ore)",
            "width": "8%",
            "translate": "RESOURCES.durata_intervento_ore_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "durata_ft",
            "queryFunct": "round(coalesce(durata_ft,0)/60,2)",
            "label": "Durata Fatturabile (ore)",
            "width": "8%",
            "translate": "RESOURCES.durata_fatturabile_ore_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "esecutore",
            "queryFunct": "entrasp.anagrafiche_id_codcognnome(codice_part,id_risorsa)",
            "label": "Esecutore",
            "width": "10%",
            "translate": "RESOURCES.esecutore_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "codice_attivita",
            "label": "codice_attivita",
            "translate": "RESOURCES.codice_attivita_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_progetto",
            "label": "id_progetto",
            "translate": "RESOURCES.id_progetto_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_modello_test",
            "label": "id_modello_test",
            "translate": "RESOURCES.id_modello_test_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_fase",
            "label": "id_fase",
            "translate": "RESOURCES.id_fase_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_sondaggio",
            "label": "id_sondaggio",
            "translate": "RESOURCES.id_sondaggio_dashboard_consuntivazioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "codice_compito",
            "label": "codice_compito",
            "translate": "RESOURCES.codice_compito_dashboard_consuntivazioni"
        }
    ]
}