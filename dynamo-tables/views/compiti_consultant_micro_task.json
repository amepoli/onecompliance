                "options": [],
                "viewType": "combobox"
            },
            "label": "Centro Gestionale",
            "newLine": true,
            "queryCond": "id_centro_gest=$id_centro_gest_s$"
        },
        {
            "fieldName": "flag_compiti_aperti",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Compiti aperti",
            "newLine": false,
            "queryCond": "cmp.stato not in ('C', 'N')"
        },
        {
            "fieldName": "flag_compiti_miei",
            "format": {
                "value": "0",
                "viewType": "toggle"
