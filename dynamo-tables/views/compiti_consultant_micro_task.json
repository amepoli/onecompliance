            "label": "Miei/Mio Ufficio",
            "newLine": false,
            "queryCond": "(cmp.id_centro_gest in(select cg2.id_centro_gest from entrasp.centri_gestionali cg2 where cg2.id_gruppo_lavoro in(select id_gruppo_lavoro from entrasp.gruppi_lavoro_membri glm where glm.id_anagrafica=€global_userid€ and glm.codice_part='€global_codice_part€') and cmp.codice_part='€global_codice_part€') or entrasp.verifica_id(cmp.id_responsabile,cmp.codice_part,(€global_id_anagrafiche€)::text))"
        },
