        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select $id_contratto_principale$ as id_contratto_principale, entrasp.rischio_conflitto(cnt.codice_azienda, cnt.id_contratto, cnt2.id_contratto), cnt.id_contratto, cnt.data_stipulazione, cnt.data_cessazione, cnt.codice_azienda, cnt.numero_contratto, cnt.id_cliente, entrasp.anagrafiche_vr_dati_identificativi(az.codice_part, cnt.id_cliente) as cliente, entrasp.argomenti_descr_breve_no_num(cnt.id_argomento_contratto) as id_argomento_contratto, cnt.id_strumento_finanziario, entrasp.anagrafiche_vr_dati_identificativi_nom1(az.codice_part, cnt.id_strumento_finanziario) as fondo_gestito, entrasp.transcodifiche_transcodifica('STATO_CONTRATTI', cnt.stato) as descr_stato from entrasp.contratti cnt inner join entrasp.aziende az on cnt.codice_azienda=az.codice_azienda inner join entrasp.contratti cnt2 on cnt.codice_azienda=cnt2.codice_azienda and cnt.id_cliente=cnt2.id_cliente and cnt.id_contratto!=cnt2.id_contratto where cnt2.id_contratto=$id_contratto_principale$ and cnt.codice_azienda=$codice_azienda$"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "UPDATE entrasp.contratti cnt set codice_part=az.codice_part from entrasp.aziende az where cnt.codice_azienda=az.codice_azienda"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "select entrasp.sondaggi_delete_after_contract_end($codice_azienda$, $id_contratto$)"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "UPDATE entrasp.contratti cnt set codice_part=az.codice_part from entrasp.aziende az where cnt.codice_azienda=az.codice_azienda"
        }
    ],
