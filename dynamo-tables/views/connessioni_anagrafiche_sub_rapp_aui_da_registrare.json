  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectForm",
      "queryString": "SELECT ca.codice_azienda,ca.codice_part,(select true) AS delete_connessione,ca.id_anagrafica,ca.id_anagrafica_conn,ca.codice_ruolo,(entrasp.ruolo_descr(ca.codice_ruolo)) AS descrizione_ruolo,(entrasp.anagrafiche_vr_dati_identificativi(ca.codice_part, ca.id_anagrafica_conn)) AS anagrafica_connessa,ca.dt_inizio,ca.dt_fine,ai.codice, coalesce(av.denominazione,ai.nome||' '||ai.cognome,av.ragione_sociale) as denominazione, ai.sesso, av.codice_fiscale, ai.nascita_data, ai.nascita_luogo, av.indirizzo, av.comune, av.codice_nazione, av.id_ateco, av.cod_sae, (select codice_esterno from entrasp.ruoli where codice_ruolo=ca.codice_ruolo) as tipo_soggetto, av.annotazioni_interne FROM entrasp.connessioni_anagrafiche ca INNER JOIN entrasp.anagrafiche_id ai ON ca.codice_part=ai.codice_part AND ca.id_anagrafica_conn=ai.id_anagrafica INNER JOIN entrasp.anagrafiche_vr av ON ai.codice_part=av.codice_part AND ai.id_anagrafica=av.id_anagrafica WHERE ca.id_anagrafica=$id_anagrafica$ AND ca.id_anagrafica_conn=$id_anagrafica_conn$ AND ca.codice_part=$codice_part$ AND ca.codice_azienda=$codice_azienda$ AND ca.codice_ruolo=$codice_ruolo$ AND ca.dt_inizio=$dt_inizio$ AND av.prog_vr=entrasp.anagrafiche_vr_max(ai.codice_part, ai.id_anagrafica);"
    }
  ],
