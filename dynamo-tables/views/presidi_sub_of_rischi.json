    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select rp.*, true as delete_presidi_rischi, entrasp.transcodifiche_transcodifica('STATO_ATTUAZIONE', pr.stato_attuazione) as stato_attuazione ,true as visible_button_presidio, entrasp.presidi_descr(pr.id_presidio, pr.codice_azienda)as descr_presidio, entrasp.tipo_processo_descr(pr.id_tipo_presidio, pr.codice_azienda)as tipo_presidio, pr.codice  from entrasp.rischi_presidi rp inner join entrasp.presidi pr on rp.codice_azienda=pr.codice_azienda and rp.id_presidio=pr.id_presidio where rp.codice_azienda=$codice_azienda$ and rp.codice_rischio=$codice_rischio$"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.rischi_presidi rp set pct_mitigazione_probabilita=coalesce(pctmitigazioneprobabilita,0), pct_mitigazione_intensita_singola=coalesce(pctmitigazioneintensitasingola,0), pct_mitigazione_probabilita_rettificata=coalesce(pctmitigazioneprobabilita_rett,0), pct_mitigazione_intensita_singola_rettificata=coalesce(pctmitigazioneintensitasingola_rett,0) from entrasp.rischio_presidi_value($codice_azienda$, $codice_rischio$) rpv where rp.codice_azienda=rpv.azienda and rp.id_presidio=rpv.idpresidio and rp.codice_rischio=$codice_rischio$ and rp.codice_azienda=$codice_azienda$;"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "update entrasp.rischi_presidi rp set pct_mitigazione_probabilita=coalesce(pctmitigazioneprobabilita,0), pct_mitigazione_intensita_singola=coalesce(pctmitigazioneintensitasingola,0), pct_mitigazione_probabilita_rettificata=coalesce(pctmitigazioneprobabilita_rett,0), pct_mitigazione_intensita_singola_rettificata=coalesce(pctmitigazioneintensitasingola_rett,0) from entrasp.rischio_presidi_value($codice_azienda$, $codice_rischio$) rpv where rp.codice_azienda=rpv.azienda and rp.id_presidio=rpv.idpresidio and rp.codice_rischio=$codice_rischio$ and rp.codice_azienda=$codice_azienda$;"
        },
        {
            "operation": "update",
            "queryString": "select entrasp.rischio_update_values($codice_azienda$, $codice_rischio$);",
            "type": "postProcessing"
        },
        {
            "operation": "insert",
            "queryString": "select entrasp.rischio_update_values($codice_azienda$, $codice_rischio$);",
            "type": "postProcessing"
        }
    ],
