			"label": "Valuta fornitura",
			"isButton": true,
			"buttonAction": {
				"target": "sondaggi_somministrati",
				"viewType": "form",
				"action": "query",
				"query": "select codice_azienda, id_sondaggio, id_somministrazione from entrasp.somministrazione_insert_from_list('£codice_azienda£', £id_modello_test£, 'contratti', '£object_key£')",
				"keymap": [
					{
						"source": "codice_azienda",
						"destination": "codice_azienda"
					},
					{
						"source": "id_modello_test",
						"destination": "id_modello_test"
					},
					{
						"source": "object_key",
						"destination": "object_key"
					}
				],
				"confirmAction": true,
				"confirmMessage": {
					"title": "Valutazione contratto di fornitura",
					"text": "Si vuole inserire una valutazione della fornitura?"
				},
				"onSuccessAction": "navigate",
				"onSuccessActionKeymap": [
					{
						"source": "codice_azienda",
						"destination": "codice_azienda"
					},
					{
						"source": "id_sondaggio",
						"destination": "id_sondaggio"
					},
					{
						"source": "id_somministrazione",
						"destination": "id_somministrazione"
					}
				]
			}
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": true,
			"width": "23%",
			"key": "descr_asset",
			"label": "Asset"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "object_key",
			"label": "object_key"
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "id_modello_test",
			"label": "id_modello_test"
		}
	],
	"search_keys": [
		{
			"fieldName": "id_anagrafica_s",
			"format": {
				"dataType": "number",
				"viewType": "input"
			},
			"label": "ID Cliente",
			"newLine": false,
			"queryCond": "avr.id_cliente=$id_anagrafica_s$"
		},
		{
			"fieldName": "nome_rs",
			"format": {
				"dataType": "text",
				"viewType": "input"
			},
			"label": "Nome/Cognome/Ragione Sociale",
			"newLine": true,
			"queryCond": "(UPPER(entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_cliente)) like '%'||UPPER('€nome_rs€')||'%' or UPPER(entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_fornitore)) like '%'||UPPER('€nome_rs€')||'%' or UPPER(entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_strumento_finanziario)) like '%'||UPPER('€nome_rs€')||'%')"
		},
		{
			"fieldName": "numero_contratto_s",
			"format": {
				"dataType": "text",
				"viewType": "input"
			},
			"label": "Numero Contratto",
			"newLine": false,
			"queryCond": "UPPER(numero_contratto) like '%'||UPPER('€numero_contratto_s€')||'%'"
		},
		{
			"fieldName": "id_strumento_fin_s",
			"format": {
				"comboQuery": "SELECT an.id_anagrafica as id , entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name FROM entrasp.anagrafiche_id an JOIN entrasp.anagrafiche_vr avr ON an.codice_part=avr.codice_part AND an.id_anagrafica=avr.id_anagrafica join entrasp.ruoli_anagrafiche ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica WHERE an.codice_part='€global_codice_part€' and avr.prog_vr=entrasp.anagrafiche_vr_max('€global_codice_part€', an.id_anagrafica) and codice_ruolo = 'FONDO';",
				"options": [],
				"viewType": "combobox"
			},
			"label": "Fondo/strumento finanziario",
			"newLine": false,
			"queryCond": "id_strumento_finanziario=$id_strumento_fin_s$"
		}
	],
	"hideActions": [
