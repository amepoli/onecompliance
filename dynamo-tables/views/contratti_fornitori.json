        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "id_strumento_finanziario",
            "queryFunct": "entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_strumento_finanziario)",
            "label": "Fondo",
            "width": "20%",
            "translate": "RESOURCES.id_strumento_finanziario"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
