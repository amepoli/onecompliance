			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "N. Contratto",
			"key": "numero_contratto",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Descrizione",
			"key": "descrizione",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT an.id_anagrafica AS id, concat(codice, ' - ', ragione_sociale) as name from entrasp.anagrafiche_vr an join  entrasp.ruoli_anagrafiche  ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica  WHERE an.codice_part='€global_codice_part€' and codice_ruolo= 'FONDO';",
				"options": [],
				"viewType": "combobox"
			},
			"label": "Fondo Gestito",
			"key": "id_strumento_finanziario",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT id_asset AS id, descrizione as name from entrasp.asset WHERE codice_azienda='€global_codice_azienda€';",
				"options": [],
				"viewType": "combobox"
			},
			"label": "Asset",
			"key": "id_asset",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"dataType": "date",
				"viewType": "input"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_stipulazione",
			"label": "Data Stipula",
			"newLine": false,
			"size": 2,
			"readOnly": false
		},
		{
			"autoGenerate": false,
			"format": {
				"dataType": "date",
				"viewType": "input"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_cessazione",
			"label": "Data Cessazione",
			"newLine": false,
			"size": 2,
			"readOnly": false
		},
		{
			"autoGenerate": false,
			"format": {
				"dataType": "date",
				"viewType": "input"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_contratto_da",
			"label": "Data Contratto Da",
			"newLine": false,
			"size": 2,
			"readOnly": false
		},
		{
			"autoGenerate": false,
			"format": {
				"dataType": "date",
				"viewType": "input"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_contratto_a",
			"label": "Data Contratto a",
			"newLine": false,
			"size": 2,
			"readOnly": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "object_key",
			"key": "object_key",
			"queryFunct": "codice_azienda||'|'||id_contratto",
			"readOnly": false,
			"isHidden": true,
			"isPrimary": false,
			"newLine": false
		}
	],
	"table_keys": [
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": false,
			"isPrimary": true,
			"width": "5%",
