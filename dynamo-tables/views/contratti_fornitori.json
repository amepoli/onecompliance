{
	"$schema": "../views.schema.json",
	"entryKey": "contratti_fornitori",
	"businessObjectName": "contratti",
	"origin": "entrasp.contratti",
	"predefinedQueries": [
		{
			"operation": "update",
			"type": "postProcessing",
			"queryString": "UPDATE entrasp.contratti cnt set codice_part=az.codice_part from entrasp.aziende az where cnt.codice_azienda=az.codice_azienda"
		},
		{
			"operation": "update",
			"type": "postProcessing",
			"queryString": "select entrasp.sondaggi_delete_after_contract_end($codice_azienda$, $id_contratto$)"
		},
		{
			"operation": "insert",
			"type": "postProcessing",
			"queryString": "UPDATE entrasp.contratti cnt set codice_part=az.codice_part from entrasp.aziende az where cnt.codice_azienda=az.codice_azienda"
		},
		{
			"operation": "selectTable",
			"type": "main",
			"queryString": "select *,(select a.descrizione from entrasp.asset a where a.id_asset = c.id_asset and codice_azienda=$codice_azienda$ and a.id_asset is not null) as descr_asset,c.codice_azienda||'|'||c.id_contratto as object_key, (select id_modello_test from entrasp.modelli_test where codice_azienda=$codice_azienda$ and id_tipo_modello_test=54 limit 1), true as create_somministrazione, entrasp.argomenti_descr(c.id_argomento_contratto) as tipo_contratto, entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', c.id_cliente) as id_cliente,entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', c.id_fornitore) as id_fornitore, entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', c.id_strumento_finanziario) as id_strumento_finanziario from entrasp.contratti c where array[c.id_argomento_contratto] <@ any(select entrasp.sotto_argomenti(3428)) and c.id_argomento_contratto is not null and c.codice_azienda=$codice_azienda$"
		}
	],
	"outputEvents": [
		{
			"eventName": "onSaveContratto",
			"eventTrigger": "onSave"
		},
		{
			"eventName": "onLoadContratto",
			"eventTrigger": "onReload"
		}
	],
	"form_keys": [
		{
			"autoGenerate": false,
