{
    "$schema": "../views.schema.json",
    "entryKey": "contratti_fornitori",
    "businessObjectName": "contratti",
    "origin": "entrasp.contratti",
    "inheritsFrom": "contracts_investment",
    "predefinedQueries": [
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "select entrasp.sondaggi_delete_after_contract_end($codice_azienda$, $id_contratto$)"
        },
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select *,(select a.descrizione from entrasp.asset a where a.id_asset = c.id_asset and codice_azienda=$codice_azienda$ and a.id_asset is not null) as descr_asset,c.codice_azienda||'|'||c.id_contratto as object_key, (select id_modello_test from entrasp.modelli_test where codice_azienda=$codice_azienda$ and id_tipo_modello_test=54 limit 1), true as create_somministrazione, entrasp.argomenti_descr(c.id_argomento_contratto) as tipo_contratto, entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', c.id_cliente) as id_cliente,entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', c.id_cliente) as fornitore, entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', c.id_strumento_finanziario) as id_strumento_finanziario from entrasp.contratti c left join entrasp.ruoli_anagrafiche ra on c.codice_part=ra.codice_part and c.id_cliente=ra.id_anagrafica where ra.codice_ruolo='FOR' and c.codice_azienda=$codice_azienda$"
        }
    ],
    "outputEvents": [
        {
            "eventName": "onSaveContratto",
            "eventTrigger": "onSave"
        },
        {
            "eventName": "onLoadContratto",
            "eventTrigger": "onReload"
        }
    ],
    "define": {
        "is_hidden_conflicts": "true",
        "is_hidden_invisible_field": "true",
        "label_id_controparte": "id_fornitore",
        "label_controparte": "Fornitore",
        "is_hidden_mifid": "false",
        "size_with_or_without_mifid": "1.57",
        "is_hidden_fornitori": "false",
        "id_argomento_tipo_contratto": "3428",
        "is_hidden_finanziamenti": "true",
        "codice_ruolo": "FOR",
        "is_hidden_esternalizzazioni": "false"
    },
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": true,
            "width": "5%",
            "key": "id_contratto",
            "label": "#",
            "translate": "RESOURCES.id_contratto"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
