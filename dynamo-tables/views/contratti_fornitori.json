            "label": "object_key",
            "translate": "RESOURCES.object_key"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_modello_test",
            "label": "id_modello_test",
            "translate": "RESOURCES.id_check_template"
        }
    ],
    "search_keys": [
        {
            "fieldName": "id_anagrafica_s",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID Cliente",
            "newLine": false,
            "queryCond": "avr.id_cliente=$id_anagrafica_s$",
            "translate": "RESOURCES.id_cliente"
        },
        {
            "fieldName": "nome_rs",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Nome/Cognome/Ragione Sociale",
            "newLine": true,
            "queryCond": "(UPPER(entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_cliente)) like '%'||UPPER('€nome_rs€')||'%' or UPPER(entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_fornitore)) like '%'||UPPER('€nome_rs€')||'%' or UPPER(entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_strumento_finanziario)) like '%'||UPPER('€nome_rs€')||'%')",
            "translate": "RESOURCES.nomecognomeragione_sociale"
        },
        {
            "fieldName": "numero_contratto_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Numero Contratto",
            "newLine": false,
            "queryCond": "UPPER(numero_contratto) like '%'||UPPER('€numero_contratto_s€')||'%'",
            "translate": "RESOURCES.numero_contratto"
        },
        {
            "fieldName": "id_strumento_fin_s",
            "format": {
                "comboQuery": "SELECT an.id_anagrafica as id , entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name FROM entrasp.anagrafiche_id an JOIN entrasp.anagrafiche_vr avr ON an.codice_part=avr.codice_part AND an.id_anagrafica=avr.id_anagrafica join entrasp.ruoli_anagrafiche ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica WHERE an.codice_part='€global_codice_part€' and avr.prog_vr=entrasp.anagrafiche_vr_max('€global_codice_part€', an.id_anagrafica) and ra.codice_ruolo = 'FONDO';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Fondo/strumento finanziario",
            "newLine": false,
            "queryCond": "id_strumento_finanziario=$id_strumento_fin_s$",
            "translate": "RESOURCES.fondostrumento_finanziario"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by id_contratto desc limit 100"
    },
    "subTables": [
        {
            "entryKey": "sondaggi_somministrati_sub_of_contratti_fornitori",
            "isHidden": false,
            "keys": [
