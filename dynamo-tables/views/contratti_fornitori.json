            "queryFunct": "entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_fornitore)",
            "label": "Fornitore",
            "width": "20%",
            "style": [
                {
                    "value": "*",
                    "font_weight": "599"
                }
            ],
            "translate": "RESOURCES.fornitore"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "tipo_contratto",
            "queryFunct": "entrasp.argomenti_descr(id_argomento_contratto)",
            "label": "Tipo Contratto",
            "translate": "RESOURCES.tipo_contratto"
        },
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "data_stipulazione",
            "width": "10%",
            "label": "Data Stipula",
            "translate": "RESOURCES.data_stipulazione"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "width": "12%",
            "key": "create_somministrazione",
            "queryFunct": "true",
            "label": "Valuta fornitura",
            "isButton": true,
            "buttonAction": {
                "target": "sondaggi_somministrati",
                "viewType": "form",
                "action": "query",
                "query": "select codice_azienda, id_sondaggio, id_somministrazione from entrasp.somministrazione_insert_from_list('£codice_azienda£', £id_modello_test£, 'contratti', '£object_key£')",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_modello_test",
                        "destination": "id_modello_test"
                    },
                    {
                        "source": "object_key",
                        "destination": "object_key"
                    }
                ],
                "confirmAction": true,
                "confirmMessage": {
                    "title": "Valutazione contratto di fornitura",
                    "text": "Si vuole inserire una valutazione della fornitura?"
                },
                "onSuccessAction": "navigate",
                "onSuccessActionKeymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_sondaggio",
                        "destination": "id_sondaggio"
                    },
                    {
                        "source": "id_somministrazione",
                        "destination": "id_somministrazione"
                    }
                ]
            },
            "style": [
                {
                    "button_icon": "",
                    "value": "*"
                }
            ],
            "translate": "RESOURCES.create_somministrazione"
        },
        {
