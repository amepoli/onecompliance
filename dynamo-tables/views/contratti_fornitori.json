		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"width": "10%",
			"isPrimary": false,
			"key": "numero_contratto",
			"label": "N° Contratto",
			"style": [
				{
					"value": "*",
					"background_color": "lightblue",
					"text_align": "center",
					"font_weight": "599"
				}
			]
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "id_strumento_finanziario",
			"queryFunct": "entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_strumento_finanziario)",
			"label": "Fondo",
			"width": "20%"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "fornitore",
			"queryFunct": "entrasp.anagrafiche_vr_dati_identificativi('€global_codice_part€', id_fornitore)",
			"label": "Fornitore",
			"width": "20%"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "tipo_contratto",
			"queryFunct": "entrasp.argomenti_descr(id_argomento_contratto)",
			"label": "Tipo Contratto"
		},
		{
			"format": {
				"dataType": "date"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_stipulazione",
