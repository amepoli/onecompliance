                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": true,
            "width": "23%",
            "key": "descr_asset",
            "label": "Asset",
            "translate": "RESOURCES.descr_asset"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": false,
