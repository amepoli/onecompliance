        },
        {
            "fieldName": "servizio_richiesto",
            "format": {
                "comboQuery": "SELECT distinct id_argomento AS id, descrizione_breve AS name  FROM entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father =52332 order by descrizione_breve",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Servizio Richiesto",
            "newLine": false,
            "queryCond": "id_tipo_servizio=$servizio_richiesto$",
            "translate": "RESOURCES.servizio_richiesto"
