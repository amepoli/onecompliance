        },
        {
            "type": "postProcessing",
            "operation": "insert",
            "queryString": "update entrasp.cdms_risorse rs set id_anagrafica=az.id_anagrafica from entrasp.aziende az where rs.codice_azienda=az.codice_azienda and rs.id_anagrafica is null"
        },
        {
            "type": "postProcessing",
