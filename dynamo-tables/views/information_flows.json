            "queryString": "select id_anagrafica, entrasp.argomenti_descr_breve_no_num ((select entrasp.scadenza_documento(codice_azienda, id_risorsa))) as validita,  entrasp.stato_information_flow(crs.codice_azienda, crs.id_risorsa) as stato, case when (select count(prog_revisione) from entrasp.cdms_risorse_revisioni rev where rev.codice_azienda=crs.codice_azienda and rev.id_risorsa=crs.id_risorsa)=0 then true else false end as delete_documents, entrasp.anagrafiche_vr_dati_identificativi_nom(crs.codice_part, crs.id_anagrafica) as anagrafica_descr,entrasp.argomenti_descr_breve(crs.id_argomento_tipo_allegato) as tipo_allegato, crs.codice_azienda,crs.codice_part,crs.id_risorsa,crs.data_rif,crs.nickname, crs.descrizione_breve, crs.descrizione, crs.data_scadenza, crs.descrizione FROM entrasp.cdms_risorse crs WHERE crs.codice_azienda=$codice_azienda$ and id_argomento_tipo_allegato in(select entrasp.descendants_of_argomento($P{id_argomento_father}, 1)) and $P{id_anagrafica_if_clientela} and crs.descrizione_breve != 'tbd' and crs.codice_azienda in(€global_user_companies€)",
            "type": "main"
        },
        {
            "operation": "selectForm",
            "queryString": "update entrasp.argomenti_argomenti set id_argomento_relazione=45069 where id_argomento_father=3511 and id_argomento_relazione is null",
