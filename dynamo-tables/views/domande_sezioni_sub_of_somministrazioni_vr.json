    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select ssrs.sezione_completata, ssrs.id_somministrazione_vr, ssrs.pct_risultato_ottenuto_calcolato_ponderato, round(ssrs.punteggio_ottenuto,2) as punteggio, pct_risultato_ottenuto_calcolato, ds.peso as pesosezione, round(ssrs.pct_risultato_ottenuto_calcolato*ds.peso, 2), ssrs.codice_azienda, ssrs.id_somministrazione, ssrs.id_sondaggio, ssrs.id_modello_test, ssrs.id_modello_test_vr, ssrs.id_sezione, ds.ordinamento, ds.descrizione as descr_sezione from entrasp.sondaggi_somministrati_risultati_sezioni_vr ssrs inner join  entrasp.domande_sezioni ds on ssrs.id_sezione=ds.id_sezione and ssrs.codice_azienda=ds.codice_azienda and ssrs.id_modello_test=ds.id_modello_test and ssrs.id_modello_test_vr=ds.id_modello_test_vr where ssrs.codice_azienda=$codice_azienda$ and ssrs.id_sondaggio=$id_sondaggio$ and ssrs.id_somministrazione=$id_somministrazione$ and ssrs.id_somministrazione_vr=$id_somministrazione_vr$ and ds.flag_non_applicabile_sezione='0';",
            "type": "main"
        },
        {
            "operation": "selectForm",
            "queryString": "select '€global_username€' as username, id_somministrazione_vr, case when object_name = 'anagraficheId' then coalesce(ss.id_anagrafica, nullif(split_part(ss.object_key,'|',2),'')::numeric) else null end as id_anagrafica, round(ssrs.punteggio_ottenuto,2) as punteggio, round(ssrs.pct_risultato_ottenuto_calcolato, 2) as risultatopercsezione, ds.peso as pesosezione, ds.note as notesezione, round(ssrs.pct_risultato_ottenuto_calcolato*ds.peso, 2), ssrs.codice_azienda, ssrs.id_somministrazione, ssrs.id_sondaggio, ssrs.id_modello_test, ssrs.id_modello_test_vr, ssrs.id_sezione, ds.ordinamento, ds.descrizione as descr_sezione, ss.object_description from entrasp.sondaggi_somministrati_risultati_sezioni_vr ssrs inner join entrasp.domande_sezioni ds on ssrs.id_sezione=ds.id_sezione and ssrs.codice_azienda=ds.codice_azienda and ssrs.id_modello_test=ds.id_modello_test and ssrs.id_modello_test_vr=ds.id_modello_test_vr inner join entrasp.sondaggi_somministrati ss on ssrs.codice_azienda=ss.codice_azienda and ssrs.id_sondaggio=ss.id_sondaggio and ssrs.id_somministrazione=ss.id_somministrazione where ssrs.codice_azienda=$codice_azienda$ and ssrs.id_modello_test=$id_modello_test$ and ssrs.id_modello_test_vr=$id_modello_test_vr$ and ssrs.id_sondaggio=$id_sondaggio$ and ssrs.id_somministrazione=$id_somministrazione$ and ssrs.id_somministrazione_vr=$id_somministrazione_vr$ and ssrs.id_sezione=$id_sezione$",
            "type": "main"
        }
