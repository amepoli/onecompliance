    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menuanag",
            "label": "Actions",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "modifica_domande",
                    "icon": "edit",
                    "label": "Modifica domande",
                    "translate": "RESOURCES.modifica_domande",
                    "reloadOnSuccess": true,
                    "customDialogEntryName": "dialog_domande",
                    "customDialogTitle": "Modifica domande"
                },
                {
                    "key": "cancella_domande",
                    "icon": "delete",
                    "label": "Elimina domande",
                    "translate": "RESOURCES.elimina_domande",
                    "query": "SELECT entrasp.domanda_delete(s.codiceazienda, s.idmodellotest::numeric, s.idmodellotestvr::numeric, s.iddomanda::numeric)FROM (SELECT split_part(arr,'~',1) AS codiceazienda,split_part(arr,'~',2) AS iddomanda,split_part(arr,'~',3) AS idmodellotest,split_part(arr,'~',4) AS idmodellotestvr FROM unnest(ARRAY[$selected_rows_data$]) arr) AS s;",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Eliminare le domande selezionate?"
                }
            ]
        }
    ],
    "addElementSettings": {
        "labelQuickAdd": "Nuova domanda",
        "labelAdd": "Nuova domanda",
        "navigateOnSuccess": false
    },

    "predefinedQueries": [
        {
          "operation": "selectTable",
          "type": "main",
          "queryString": "select cn.nota, cn.codice_azienda, cn.id_nota,nd.id_modello_test,nd.id_domanda,nd.id_modello_test_vr,nd.id_risposte_prev, entrasp.controlla_note(cn.codice_azienda, nd.id_domanda, nd.id_modello_test, nd.id_modello_test_vr, nd.id_nota) ::boolean as associato from entrasp.catalogo_note cn left join entrasp.note_domande nd on cn.codice_azienda=nd.codice_azienda where cn.codice_azienda=$codice_azienda$  "


        }
    ],
  
