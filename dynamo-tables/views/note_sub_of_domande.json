{
    "$schema": "../views.schema.json",
    "businessObjectName": "domande",
    "entryKey": "note_sub_of_domande",
    "origin": "entrasp.note_domande",

    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menuanag",
            "label": "Actions",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "associa_nota",
                    "icon": "edit",
                    "label": "Associa Note",
                    "query": "INSERT INTO entrasp.note_domande(codice_azienda,id_domanda, id_modello_test, id_modello_test_vr,id_nota) WITH split_input AS (SELECT unnest(string_to_array($selected_rows_data$, ',')) AS item),split_columns AS (SELECT (string_to_array(item, '~'))[1],(string_to_array(item, '~'))[2]::numeric,(string_to_array(item, '~'))[3]::numeric,(string_to_array(item, '~'))[4]::numeric,(string_to_array(item, '~'))[5]::numeric FROM split_input) SELECT * FROM split_columns",
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Associare Le note scelte alla domanda in oggetto?",
                    "confirmAction": true
                }
            ]
        }
    ],

    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select cn.nota, cn.codice_azienda, cn.id_nota,$id_modello_test$ as id_modello_test,$id_domanda$ as id_domanda,$id_modello_test_vr$ as id_modello_test_vr,id_risposte_prev, entrasp.controlla_note(cn.codice_azienda, nd.id_domanda, nd.id_modello_test, nd.id_modello_test_vr, nd.id_nota) ::boolean as associato from entrasp.catalogo_note cn left join entrasp.note_domande nd on cn.codice_azienda=nd.codice_azienda where cn.codice_azienda=$codice_azienda$  "
        }
    ],

