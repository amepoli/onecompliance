	"entryKey": "sondaggi_for_state",
	"origin": "entrasp.transcodifiche",
	"businessObjectName": "transcodifiche",
	"predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select ts.codice,ts.transcodifica,count(snd.id_sondaggio) as num_sondaggi from entrasp.transcodifiche ts inner join entrasp.sondaggi snd on ts.codice=snd.stato where ts.tipo_dato='STATO_SONDAGGI' group by ts.codice, ts.transcodifica, ts.ordinamento order by ts.ordinamento"
        }
	],
