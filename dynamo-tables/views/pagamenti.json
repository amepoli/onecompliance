        "dataType": "text",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "note",
      "label": "Note",
      "readOnly": false,
      "newLine": true
    }
  ],
  "table_keys": [
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": true,
      "isPrimary": true,
      "key": "codice_azienda",
      "label": "codice_azienda",
      "translate": "RESOURCES.company_code"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
