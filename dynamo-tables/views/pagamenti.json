      "isPrimary": false,
      "newLine": false,
      "size": 2,
      "key": "id_conto_corrente",
      "label": "Conto Corrente",
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
