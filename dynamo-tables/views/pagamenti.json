      "size": 2.5,
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "viewType": "combobox",
        "options": [],
        "comboQuery": "SELECT distinct an.id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name from entrasp.anagrafiche_id an join  entrasp.ruoli_anagrafiche  ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica  WHERE an.codice_part='€global_codice_part€'",
        "validations": [
          {
            "message": "Controparte necessaria",
            "name": "required",
            "validator": "Validators.required"
          }
        ]
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "id_controparte",
      "label": "Controparte",
      "size": 2.5,
      "readOnly": false,
      "newLine": false
    },
    {
      "autoGenerate": false,
      "format": {
        "viewType": "combobox",
        "options": [],
        "comboQuery": "select distinct n_mandato as id, n_mandato ||' - '||entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_mandante) as name from entrasp.mandati where codice_azienda='€global_codice_azienda€' "
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_mandato",
      "label": "N. Mandato",
      "readOnly": false,
      "size": 2.5,
      "newLine": false
    },
