{
  "$schema": "../views.schema.json",
  "entryKey": "pagamenti",
  "origin": "entrasp.pagamenti_crediti",
  "label": "Pagamenti",
  "businessObjectName": "pagamenti_crediti",
  "form_keys": [
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "isHidden": true,
      "isPrimary": true,
      "key": "codice_azienda",
      "label": "codice_azienda",
      "translate": "RESOURCES.company_code",
      "readOnly": true
    },
    {
      "autoGenerate": true,
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": true,
      "newLine": false,
      "key": "id_pagamento",
      "label": "ID Pagamento",
      "readOnly": true,
      "size": 1.5
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "data_pagamento",
      "label": "Data Pagamento",
      "newLine": false,
      "size": 1.5,
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "newLine": true,
      "key": "importo",
      "label": "Importo",
      "readOnly": false,
      "size": 2,
      "outputEvent": {
        "eventName": "colore_importo",
        "eventTrigger": "load"
      },
      "inputEvents": [
        {
          "eventName": "colore_importo",
          "condition": "none",
          "values": [],
          "actionType": "query_style",
          "styleAttribute": "background_color",
          "queryFunct": "select case when importo<0 then'red' else 'green' end as importo_background_color from entrasp.pagamenti_crediti where codice_azienda=$codice_azienda$ and id_pagamento=$id_pagamento$"
        }
      ]
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "combobox",
        "comboQuery": "select id_cessione as ID, id_cessione||' - '||entrasp.contratti_descr(id_contratto, codice_azienda)||' - '||entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_cedente)||' - '||n_fattura||' - '||data_fattura as name from entrasp.crediti_ceduti where codice_azienda=$codice_azienda$",
        "options": []
      },
      "isHidden": false,
      "isPrimary": true,
      "newLine": false,
      "key": "id_cessione",
      "label": "Credito",
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "combobox",
        "comboQuery": "select descrizione as id, id_argomento||'-'||descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=51485",
        "options": []
      },
      "isHidden": false,
      "isPrimary": true,
      "newLine": false,
      "key": "id_argomento_tipo_pag",
      "label": "Causale",
      "readOnly": false
    }
  ],
  "table_keys": [
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": true,
      "isPrimary": true,
      "key": "codice_azienda",
      "label": "codice_azienda",
      "translate": "RESOURCES.company_code"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": true,
      "key": "id_pagamento",
      "label": "ID"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "id_argomento_tipo_pag",
      "queryFunct": "entrasp.argomenti_descr_breve(id_argomento_tipo_pag)",
      "label": "Causale"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "id_cessione",
      "label": "Cessione"
    },
    {
      "format": {
        "dataType": "date"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "data_pagamento",
      "label": "Data pagamento",
      "width": "8%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "importo",
      "label": "Importo",
      "width": "6%",
      "style": [
        {
          "value": "*",
          "text_align": "end"
        }
      ]
    }
  ],
  "search_keys": [],
  "querySuffixes": {
    "tableViewSuffix": "order by data_pagamento desc limit 200"
  },
  "hideActions": [
    {
      "formActionType": "attachments",
      "viewType": "form"
    }
  ]
}