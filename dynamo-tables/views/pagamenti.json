{
  "$schema": "../views.schema.json",
  "entryKey": "pagamenti",
  "origin": "entrasp.pagamenti_crediti",
  "label": "Pagamenti",
  "businessObjectName": "pagamenti_crediti",
  "define": {
    "is_hidden_cessione": "false"
  },
  "form_keys": [
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "isHidden": true,
      "isPrimary": true,
      "key": "codice_azienda",
      "label": "codice_azienda",
      "translate": "RESOURCES.company_code",
      "readOnly": true
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "isHidden": true,
      "isPrimary": false,
      "key": "codice_part",
      "label": "codice_part",
      "readOnly": true
    },
    {
      "autoGenerate": true,
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": true,
      "newLine": false,
      "key": "id_pagamento",
      "label": "ID Pagamento",
      "readOnly": true,
      "size": 2.5
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "date",
        "viewType": "input",
        "validations": [
          {
            "message": "Data pagamento necessaria",
            "name": "required",
            "validator": "Validators.required"
          }
        ]
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "data_pagamento",
      "label": "Data Pagamento",
      "newLine": false,
      "size": 2.5,
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "number",
        "viewType": "input",
        "validations": [
          {
            "message": "Importo necessario",
            "name": "required",
            "validator": "Validators.required"
          }
        ]
      },
      "isHidden": false,
      "isPrimary": false,
      "newLine": false,
      "key": "importo",
      "label": "Importo",
      "readOnly": false,
      "size": 1.5,
      "outputEvent": {
        "eventName": "colore_importo",
        "eventTrigger": "load"
      },
      "inputEvents": [
        {
          "eventName": "colore_importo",
          "condition": "none",
          "values": [],
          "actionType": "query_style",
          "styleAttribute": "background_color",
          "queryFunct": "select case when importo<0 then'red' else 'green' end as importo_background_color from entrasp.pagamenti_crediti where codice_azienda=$codice_azienda$ and id_pagamento=$id_pagamento$"
        }
      ]
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "combobox",
        "comboQuery": "select id_cessione as ID, id_cessione||' - '||entrasp.contratti_descr(id_contratto, codice_azienda)||' - '||entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_cedente)||' - '||n_fattura||' - '||data_fattura as name from entrasp.crediti_ceduti where codice_azienda=$codice_azienda$",
        "options": [],
        "validations": [
          {
            "message": "ID cessione necessaria",
            "name": "required",
            "validator": "Validators.required"
          }
        ]
      },
      "isHidden": "$Q{is_hidden_cessione}",
      "isPrimary": false,
      "newLine": true,
      "size": 3.5,
      "key": "id_cessione",
      "label": "Credito",
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "viewType": "combobox",
        "comboQuery": "select id_argomento as id, id_argomento||'-'||descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=51485",
        "options": [],
        "validations": [
          {
            "message": "Causale necessaria",
            "name": "required",
            "validator": "Validators.required"
          }
        ]
      },
      "isHidden": false,
      "isPrimary": false,
      "newLine": false,
      "key": "id_argomento_tipo_pag",
      "label": "Causale",
      "size": 2.5,
      "readOnly": false
    },
    {
      "autoGenerate": false,
      "format": {
        "viewType": "combobox",
        "options": [],
        "comboQuery": "SELECT distinct an.id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(an.codice_part, an.id_anagrafica) as name from entrasp.anagrafiche_id an join  entrasp.ruoli_anagrafiche  ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica  WHERE an.codice_part='€global_codice_part€'",
        "validations": [
          {
            "message": "Controparte necessaria",
            "name": "required",
            "validator": "Validators.required"
          }
        ]
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "id_controparte",
      "label": "Controparte",
      "size": 2.5,
      "readOnly": false,
      "newLine": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_mandato",
      "label": "N. Mandato",
      "readOnly": false,
      "size": 2.5,
      "newLine": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "data_mandato",
      "label": "Data Mandato",
      "readOnly": false,
      "size": 2.5,
      "newLine": true
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "interessi",
      "label": "Interessi Legali",
      "readOnly": true,
      "size": 3.3,
      "newLine": false
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "data_scadenza",
      "label": "Scadenza Credito",
      "size": 3.3,
      "readOnly": true,
      "newLine": false
    },
    {
      "autoGenerate": false,
      "format": {
        "viewType": "combobox",
        "options": [],
        "comboQuery": "select arg.id_argomento as ID, arg.id_argomento ||'-'||arg.descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=49920"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "id_argomento_inatteso",
      "label": "Inatteso",
      "size": 3.3,
      "readOnly": false,
      "newLine": true
    },
    {
      "autoGenerate": false,
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "note",
      "label": "Note",
      "readOnly": false,
      "newLine": true
    }
  ],
  "table_keys": [
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": true,
      "isPrimary": true,
      "key": "codice_azienda",
      "label": "codice_azienda",
      "translate": "RESOURCES.company_code"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "width": "5%",
      "isPrimary": true,
      "key": "id_pagamento",
      "label": "ID"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": true,
      "isPrimary": false,
      "key": "id_cessione",
      "label": "ID"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "id_argomento_tipo_pag",
      "width": "15%",
      "queryFunct": "entrasp.argomenti_descr_breve(id_argomento_tipo_pag)",
      "label": "Causale"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isPrimary": false,
      "isHidden": "$Q{is_hidden_cessione}",
      "queryFunct": "entrasp.cessione_descr(id_cessione, codice_azienda)",
      "key": "descr_cessione",
      "label": "Cessione",
      "width": "25%"
    },
    {
      "format": {
        "dataType": "date"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "data_pagamento",
      "label": "Data pagamento",
      "width": "8%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "importo",
      "label": "Importo",
      "width": "6%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isPrimary": false,
      "isHidden": false,
      "queryFunct": "entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_controparte)",
      "key": "descr_controparte",
      "label": "Controparte",
      "width": "18%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "interessi",
      "label": "Interessi"
    }
  ],
  "search_keys": [
    {
      "fieldName": "id_cessione",
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "label": "ID Cessione",
      "newLine": false,
      "size": 3.3,
      "queryCond": "id_cessione=$id_cessione$"
    },
    {
      "fieldName": "id_controparte_s",
      "format": {
        "comboQuery": "SELECT id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_anagrafica) AS name  FROM entrasp.anagrafiche_id WHERE codice_part='€global_codice_part€' order by entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_anagrafica);",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Controparte",
      "newLine": false,
      "size": 3.3,
      "queryCond": "id_controparte=$id_controparte_s$"
    },
    {
      "fieldName": "n_mandato_s",
      "format": {
        "comboQuery": "SELECT distinct n_mandato AS id, n_mandato as name  FROM entrasp.pagamenti_crediti WHERE codice_azienda=$codice_azienda$;",
        "options": [],
        "viewType": "combobox",
        "dataType": "number"
      },
      "label": "N mandato",
      "newLine": true,
      "size": 3.4,
      "queryCond": "n_mandato=$n_mandato_s$"
    },
    {
      "fieldName": "data_pagamento_min",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Pagamento dopo il",
      "newLine": false,
      "size": 3.3,
      "queryCond": "data_pagamento>='€data_pagamento_min€'"
    },
    {
      "fieldName": "data_pagamento_max",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Pagamento entro il",
      "newLine": false,
      "size": 3.3,
      "queryCond": "data_pagamento<='€data_pagamento_max€'"
    },
    {
      "fieldName": "id_argomento_tipo_pag_s",
      "format": {
        "comboQuery": "select arg.id_argomento as ID, arg.id_argomento ||'-'||arg.descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=51485",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Tipo Pagamento",
      "newLine": true,
      "size": 3.4,
      "queryCond": "id_argomento_tipo_pag=$id_argomento_tipo_pag_s$"
    },
    {
      "fieldName": "id_argomento_inatteso_s",
      "format": {
        "comboQuery": "select arg.id_argomento as ID, arg.id_argomento ||'-'||arg.descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=49920",
        "options": [],
        "viewType": "combobox"
      },
      "label": "Intatteso",
      "newLine": true,
      "queryCond": "id_argomento_inatteso=$id_argomento_inatteso_s$"
    }
  ],
  "querySuffixes": {
    "tableViewSuffix": "order by data_pagamento desc limit 200"
  },
  "hideActions": [
    {
      "formActionType": "attachments",
      "viewType": "form"
    }
  ],
  "importQueries": {
    "tableQueries": [
      {
        "label": "Importa crediti da cedere",
        "queryString": "select entrasp.import_crediti_da_cedere($codice_azienda$, $nome_file$, '€global_username€')"
      }
    ]
  }
}