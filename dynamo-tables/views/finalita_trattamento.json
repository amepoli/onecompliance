{
	"$schema": "../views.schema.json",
	"origin": "entrasp.argomenti",
	"entryKey": "finalita_trattamento",
	"inheritsFrom": "template_argomenti",
	"define": {
		"id_argomento_father": "44987",
		"label_id": "ID Categoria Dati Personali",
		"array_argomenti_father_da_aggiungere": "array[44987]",
		"campo_id_argomento": "id_argomento",
		"label_unifica": "Unifica id_categorie_dati_personali",
		"is_hidden_unifica_all": "true",
		"id_argomento_bigger_than": "and true",
		"id_argomento_father_s2": "44987",
		"label_argomento_s2": "Livello di controllo"
	},
	"predefinedQueries": [
		{
			"type": "main",
			"operation": "selectTable",
			"queryString": "select arg.*, (select count(aa2.id_argomento_father) from entrasp.argomenti_argomenti aa2 where aa2.id_argomento_son=arg.id_argomento) as num_argomenti_padre from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=$P{id_argomento_father} and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€') $P{id_argomento_bigger_than};"
		},
		{
			"operation": "insert",
			"queryString": "select entrasp.argomenti_classification_insert($descrizione$, $descrizione$, $codice$, $P{array_argomenti_father_da_aggiungere}) as id_argomento;",
			"type": "main"
		},
		{
			"operation": "update",
			"queryString": "update entrasp.argomenti arg set descrizione_breve=replace(descrizione_breve, '/', ','), nickname=replace(nickname, '/', ',') from entrasp.argomenti_argomenti aa  where arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=3576 and (position('/' in descrizione_breve)!=0 or position('/' in nickname)!=0)",
			"type": "postProcessing"
		},
		{
			"operation": "delete",
			"queryString": "delete from entrasp.argomenti_argomenti where id_argomento_father=$P{id_argomento_father} and id_argomento_son=$id_argomento$;",
			"type": "preProcessing"
		},
		{
			"operation": "isInsert",
			"queryString": "select $id_argomento$ is null as label;",
			"type": "main"
		},
		{
			"operation": "insert",
			"type": "preCheck",
			"queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£'",
			"messageNotNull": "Inserimento: Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
		},
		{
			"operation": "update",
			"type": "preCheck",
			"queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£' and id_argomento!=$id_argomento$",
			"messageNotNull": "Aggiornamento: Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
		}
	],
