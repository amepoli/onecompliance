{
    "$schema": "../views.schema.json",
    "entryKey": "sondaggi_sub_of_compiti",
    "inheritsFrom": "sondaggi",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select distinct true as disassocia_segnalazione, snd.id_modello_test||'-'||snd.id_modello_test_vr as id_e_vr, snd2.id_sondaggio as id_sondaggio_precedente,snd.id_sondaggio,snd.id_contratto,entrasp.anagrafiche_vr_dati_identificativi(snd.codice_part, snd.id_anagrafica) as id_anagrafica_assegnataria,snd.id_sondaggio_parent, snd.id_modello_test,snd.id_modello_test_vr,snd.sondaggio_completato, snd.giudizio,snd.titolo, snd.codice_azienda, snd.id_centro_gest, snd.data_prevista, snd.data_comp, snd.data_esecuzione,substring(entrasp.object_descriptions_from_sondaggio(snd.codice_azienda, snd.id_sondaggio), 1, 150) as sondaggio_su, entrasp.centri_gestionali_descr(snd.codice_part, snd.id_centro_gest) as centro_gest,entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da_manuale, snd.codice_azienda) as giudizio_manuale,entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da, snd.codice_azienda) as giudizio,entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', snd.stato) as stato, mt.titolo as modello_test from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr left JOIN entrasp.sondaggi snd2 on snd.codice_azienda=snd2.codice_azienda and snd.id_sondaggio=snd2.id_sondaggio_succ inner join entrasp.modelli_test mt on mvr.codice_azienda=mt.codice_azienda and mvr.id_modello_test=mt.id_modello_test inner join entrasp.compiti_rif_bo crb on crb.codice_azienda=mt.codice_azienda and crb.id_sondaggio=snd.id_sondaggio where snd.codice_azienda=$codice_azienda$ and crb.codice_compito=$codice_compito$"
        },
        {
            "operation": "selectForm",
            "type": "preProcessing",
            "queryString": "select entrasp.aggiorna_sondaggi_pre_loading($codice_azienda$, $id_sondaggio$);"
        },
        {
            "operation": "selectForm",
            "type": "main",
            "queryString": "select 'Sondaggio '||(id_sondaggio)::text as sondaggio_id_descr,snd.*,entrasp.contratto_descr_id( $codice_azienda$, snd.id_contratto) as descr_contratto, mvr.id_risultato, mvr.flag_no_domande, entrasp. id_sondaggio_rif(snd.codice_azienda, snd.id_sondaggio)  as id_sondaggio_rif, entrasp.mdt_codtitolo(snd.codice_azienda, snd.id_modello_test) as descr_modello_test, (select id_fase from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$ limit 1) as id_fase_orig, (select id_progetto from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$ limit 1) as id_progetto, entrasp.sondaggi_flags_sezioni_appsingola(snd.codice_azienda, snd.id_sondaggio) as flags_sezioni_multi, entrasp.sezioni_domande_activate(snd.codice_azienda, snd.id_sondaggio) as flags_sezioni_activate, entrasp.descrizione_risultato_from_sondaggio(snd.codice_azienda, snd.id_sondaggio) as criterio_analisi from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr where snd.codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        },
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "select  id_somministrazione from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$ limit 1"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.progetti_fasi set stato=$stato$ where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.sondaggi set titolo_cartella=$titolo_cartella$, descrizione=$descrizione$, data_prevista=$data_prevista$, data_comp=$data_comp$, id_contratto=$id_contratto$,id_anagrafica_assegnataria=$id_anagrafica_assegnataria$, id_centro_gest=$id_centro_gest$ where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        },
        {
            "operation": "stopEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text);"
        },
        {
            "operation": "startEvent",
            "type": "main",
            "queryString": "select entrasp.business_object_play((€global_id_anagrafiche€)::text, 'sondaggi', $id_sondaggio$, '$codice_azienda$'::varchar) as play_time_report"
        },
        {
            "operation": "delete",
            "type": "main",
            "queryString": "select entrasp.sondaggio_delete($codice_azienda$::varchar, $id_sondaggio$)"
        }
    ],
