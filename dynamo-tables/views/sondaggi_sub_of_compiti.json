            "newLine": false,
            "queryCond": "snd.id_sondaggio in(select id_sondaggio from entrasp.sondaggi_somministrati ss where UPPER(ss.object_description) like '%'||UPPER('€object_description€')||'%')"
        },
        {
            "fieldName": "no_progect_associated",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Non associati a progetto",
            "newLine": false,
            "size": 1,
            "queryCond": "id_sondaggio not in(select id_sondaggio from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_sondaggio is not null)"
        },
        {
            "fieldName": "no_somministrazione",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Senza somministrazione",
            "newLine": true,
            "size": 1,
            "queryCond": "id_sondaggio not in(select id_sondaggio from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$)"
        },
        {
            "fieldName": "parola_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola chiave",
            "translate": "RESOURCES.key_word",
            "newLine": true,
            "queryCond": "(upper(mt.titolo) like '%'||upper('€parola_search€')||'%' or upper(snd.descrizione) like '%'||upper('€parola_search€')||'%' or upper(snd.titolo) like '%'||upper('€parola_search€')||'%')"
        },
        {
            "fieldName": "flag_ultimo_modello_test",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Ultimo Modello Verifica",
            "newLine": false,
            "size": 1.5,
            "queryCond": "entrasp.is_max_modello_test(snd.codice_azienda, snd.id_sondaggio)"
        },
        {
            "fieldName": "flag_ultimo_modello_test_rett",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Ultimo Modello Verifica Rett.",
            "newLine": false,
            "size": 1.5,
            "queryCond": "entrasp.is_max_modello_test_rett(snd.codice_azienda, snd.id_sondaggio)"
        },
        {
            "fieldName": "flag_sondaggio_riprogrammato",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Sondaggio riprogrammato",
            "newLine": false,
            "size": 1.5,
            "queryCond": "snd2.id_sondaggio is not null"
        },
        {
            "fieldName": "flag_sondaggi_scaduti",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Sondaggi scaduti",
            "newLine": false,
            "size": 1.5,
            "queryCond": "snd.data_prevista<CURRENT_DATE"
        },
        {
            "fieldName": "flag_no_data_esec",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Senza data esecuz.",
            "newLine": false,
            "size": 1.5,
            "queryCond": "snd.data_esecuzione is null"
        },
        {
            "fieldName": "flag_sondaggi_aperti",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Sondaggi aperti",
            "newLine": false,
            "size": 1.5,
            "queryCond": "snd.stato not in ('C', 'N')"
        }
    ]
}