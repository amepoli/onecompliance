{
	"$schema": "../views.schema.json",
	"entryKey": "sondaggi_consultant_hp",
	"inheritsFrom": "sondaggi_consultant",
	"toolbar_elements": [
        {
            "fieldName": "stato",
            "viewType": "combobox",
            "position": "left",
            "label": "Status",
            "options": [],
            "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
            "queryCond": "snd.stato = '$stato$'"
        },
        {
            "fieldName": "flag_sondaggi_aperti",
            "viewType": "toggle",
            "position": "right",
            "label": "Progetti aperti",
            "toggleOffLabel": "Tutti Progetti",            
            "queryCond": "snd.stato not in ('C', 'N')"
        }
    ],
    "tiles": [
        {
            "title": "Sondaggi chiusi",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(id_sondaggio) as sondaggi_chiusi from entrasp.sondaggi WHERE stato='C'",
                "queryCond": "",
                "fieldName": "sondaggi_chiusi",
                "value_color": "green",
				"title_color": "green",
				"background_color": "lightblue"		
            },
			"new_line": false
        },
		{
            "title": "Sondaggi aperti",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(id_sondaggio) as sondaggi_aperti from entrasp.sondaggi WHERE stato!='C'",
                "queryCond": "",
                "fieldName": "sondaggi_aperti",
                "value_color": "red",
				"title_color": "red",
				"background_color": "white"		
            },
			"new_line": true
        }
    ]
}