{
	"$schema": "../views.schema.json",
	"entryKey": "sondaggi_consultant_hp",
	"toolbar_elements": [
        {
            "fieldName": "codice_azienda_s",
            "viewType": "combobox",
            "position": "left",
            "label": "Azienda",
            "options": [],
            "comboQuery": "SELECT codice_azienda AS id, codice_azienda AS name  FROM entrasp.aziende WHERE codice_azienda in(€global_user_companies€) order by codice_azienda;",
            "queryCond": "snd.codice_azienda = '$codice_azienda_s$'"
        }
    ],
    "tiles": [
        {
            "title": "Sondaggi chiusi",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(snd.id_sondaggio) from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr inner join entrasp.modelli_test mt on snd.codice_azienda=mt.codice_azienda and snd.id_modello_test=mt.id_modello_test inner join entrasp.centri_gestionali cg on snd.codice_part=cg.codice_part and snd.id_centro_gest=cg.id_centro_gest inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where dynamo_user='€global_username€' and snd.stato='C'",
                "queryCond": "",
                "fieldName": "sondaggi_chiusi",
                "value_color": "green",
				"title_color": "green",
				"background_color": "lightblue"		
            },
			"new_line": false
        },
		{
            "title": "Sondaggi aperti",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(snd.id_sondaggio) from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr inner join entrasp.modelli_test mt on snd.codice_azienda=mt.codice_azienda and snd.id_modello_test=mt.id_modello_test inner join entrasp.centri_gestionali cg on snd.codice_part=cg.codice_part and snd.id_centro_gest=cg.id_centro_gest inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where dynamo_user='€global_username€' and snd.stato!='C'",
                "queryCond": "",
                "fieldName": "sondaggi_aperti",
                "value_color": "red",
				"title_color": "red",
				"background_color": "white"		
            },
			"new_line": true
        }
    ],
