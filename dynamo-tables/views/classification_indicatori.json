{
    "$schema": "../views.schema.json",
    "entryKey": "classification_indicatori",
    "inheritsFrom": "argomenti",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select arg.* from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento =aa.id_argomento_son  where id_argomento_father=697",
            "type": "main"
        },
        {
            "operation": "insert",
            "queryString": "select entrasp.argomenti_classification_insert($descrizione_breve$, $descrizione$, $codice$, 697) as id_argomento;",
            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "delete from entrasp.argomenti_argomenti where id_argomento_father=697 and id_argomento_son=$id_argomento$;",
            "type": "preProcessing"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_argomento$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£'",
            "messageNotNull": "Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti where codice='£codice£' and id_argomento!=$id_argomento$",
            "messageNotNull": "Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
        }
    ],
    "search_keys": [
        {
            "fieldName": "id_argomento",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID",
            "newLine": false,
            "queryCond": "arg.id_argomento=$id_argomento$",
            "translate": "RESOURCES.id_classification_indicatori"
        },
        {
            "fieldName": "descr_rs",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Descrizione",
            "newLine": true,
            "queryCond": "(UPPER(arg.descrizione) like '%'||UPPER('€descr_rs')||'%' or UPPER(arg.descrizione_breve) like '%'||UPPER('€descr_rs€')||'%')",
            "translate": "RESOURCES.descrizione_classification_indicatori"
        },
        {
            "fieldName": "no_modello_test",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Senza modelli di test",
            "newLine": true,
            "size": 1,
            "queryCond": "arg.id_argomento not in(select mt.id_argomento from entrasp.modelli_test mt)",
            "translate": "RESOURCES.senza_modelli_di_test_classification_indicatori"
        },
        {
            "fieldName": "no_modello_test",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Con modelli di test",
            "newLine": true,
            "size": 1,
            "queryCond": "arg.id_argomento in(select mt.id_argomento from entrasp.modelli_test mt)",
            "translate": "RESOURCES.con_modelli_di_test_classification_indicatori"
        }
    ],
    "subTables": [
        {
            "entryKey": "argomenti_sub_of_argomenti_son",
            "keys": [
                {
                    "parent": "id_argomento",
                    "son": "id_argomento_father"
                }
            ],
            "label": "Argomenti figli",
            "translate": "RESOURCES.Argomentifigli_argomenti_sub_of_argomenti_son"
        },
        {
            "entryKey": "argomenti_sub_of_argomenti_father",
            "keys": [
                {
                    "parent": "id_argomento",
                    "son": "id_argomento_son"
                }
            ],
            "label": "Argomenti padre",
            "translate": "RESOURCES.Argomentipadre_argomenti_sub_of_argomenti_father"
        },
        {
            "entryKey": "indicatori",
            "keys": [
                {
                    "parent": "id_argomento",
                    "son": "id_argomento"
                }
            ],
            "label": "Indicatori associati",
            "translate": "RESOURCES.Indicatoriassociati_indicatori"
        }
    ]
}