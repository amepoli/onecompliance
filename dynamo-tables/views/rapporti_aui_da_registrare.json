{
    "$schema": "../views.schema.json",
    "entryKey": "rapporti_aui_da_registrare",
    "origin": "entrasp.anagrafiche_vr",
    "businessObjectName": "anagrafiche_vr",
    "label": "Rapporti da registrare",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select distinct rra.id_registrazione_rapp, cnt.id_contratto, cnt.data_stipulazione, cnt.data_cessazione, entrasp.transcodifiche_transcodifica('GIUDIZIO_MIFID', entrasp.giudizio_mifid_appropriatezza(cnt.codice_azienda, cnt.id_contratto))as giudizio, cnt.codice_azienda, cnt.numero_contratto, cnt.id_cliente as id_anagrafica, entrasp.anagrafiche_vr_dati_identificativi(az.codice_part, cnt.id_cliente) as cliente, entrasp.argomenti_descr_breve_no_num(id_argomento_contratto) as id_argomento_contratto, cnt.id_strumento_finanziario, entrasp.anagrafiche_vr_dati_identificativi_nom1(az.codice_part, cnt.id_strumento_finanziario) as fondo_gestito, entrasp.transcodifiche_transcodifica('STATO_CONTRATTI', cnt.stato) as descr_stato from entrasp.contratti cnt inner join entrasp.aziende az on cnt.codice_azienda=az.codice_azienda left join entrasp.registrazioni_rapporti_aui rra on cnt.codice_azienda=rra.codice_azienda and cnt.id_contratto=rra.id_contratto where az.codice_part='€global_codice_part€' and cnt.id_argomento_contratto in(select id_argomento_descendants from entrasp.descendants_of_argomento(5408,2)) AND cnt.stato != 'C'"
        },
        {
            "operation": "selectForm",
            "type": "main",
            "queryString": "select an.id_anagrafica, ct.codice_azienda, ct.codice_part, ct.id_contratto,arg.codice_esterno as tipo_intermediario, az.codice_esterno as codice_intermediario,ct.numero_contratto as identificativo_rapporto, az.codice_filiale, az.cab_filiale,arg2.codice_esterno as tipo_rapporto, to_char(ct.data_stipulazione,'DD/MM/YYYY') as data_apertura, to_char(ct.data_cessazione,'DD/MM/YYYY') as data_chiusura,entrasp.valuta_codice_descr(ct.id_valuta) as codice_valuta,an.codice as ndg_rapporto,'01' as tipo_soggetto, to_char(ct.data_stipulazione,'DD/MM/YYYY') as data_inizio_validita, to_char(ct.data_cessazione,'DD/MM/YYYY') as data_fine_validita, an.codice, entrasp.anagrafiche_cognnome(az.codice_part, an.id_anagrafica)as cognome_nome_rag_sociale_soggetto, an.sesso,avr.codice_fiscale, an.nascita_data,an.nascita_luogo,  avr.annotazioni_interne,avr.indirizzo, avr.codice_comune, avr.codice_nazione, ate.id_ateco, sae.cod_sae from entrasp.contratti ct inner join entrasp.anagrafiche_id an on ct.codice_part=an.codice_part and ct.id_cliente=an.id_anagrafica inner join entrasp.anagrafiche_vr avr on an.codice_part=avr.codice_part and an.id_anagrafica=avr.id_anagrafica inner join entrasp.aziende az on ct.codice_azienda=az.codice_azienda inner join entrasp.argomenti arg on az.id_argomento=arg.id_argomento inner join entrasp.argomenti arg2 on ct.id_argomento_contratto=arg2.id_argomento left join entrasp.ateco ate on avr.id_ateco=ate.id_ateco left join entrasp.sae sae on avr.cod_sae=sae.cod_sae left join entrasp.nazioni naz on avr.codice_nazione=naz.codice_nazione where ct.codice_azienda=$codice_azienda$ and ct.id_contratto=$id_contratto$;"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select 1 as one",
            "messageNotNull": "Foo Foos Foo"
        }
    ],
