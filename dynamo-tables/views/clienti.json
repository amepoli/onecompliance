        "queryString": "SELECT distinct a.codice_part, a.id_anagrafica, a.codice, a.cognome, a.nome, avr.ragione_sociale, avr.denominazione, avr.prog_vr FROM entrasp.anagrafiche_id a inner join entrasp.anagrafiche_vr avr on avr.codice_part =a.codice_part and a.id_anagrafica=avr.id_anagrafica inner join entrasp.ruoli_anagrafiche ra on a.codice_part =ra.codice_part inner join entrasp.ruoli r on ra.codice_ruolo = r.codice_ruolo AND r.codice_ruolo ='CLI' AND a.codice_part = $codice_part$ and avr.prog_vr=(select max(avr.prog_vr) from entrasp.anagrafiche_vr avr where avr.id_anagrafica=a.id_anagrafica and a.codice_part = $codice_part$);",
