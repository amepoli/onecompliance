     "format": {
                "comboQuery": "SELECT prog_codice_part AS id, entrasp.centri_gestionali_descr(codice_part, id_centro_gest)||'-'||entrasp.articoli_titolo_no_id(codice_azienda, id_articolo) AS name FROM entrasp.articoli_centri_gestionali WHERE codice_part='€global_codice_part€';",
