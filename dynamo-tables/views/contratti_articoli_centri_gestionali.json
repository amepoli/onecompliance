  },
  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectTable",
      "queryString": "SELECT *, entrasp.centri_gestionali_descr(cacg.codice_part, acg.id_centro_gest)||'-'||entrasp.articoli_titolo_no_id(cacg.codice_azienda, acg.id_articolo) as funzione_servizio FROM entrasp.contratti_articoli_centri_gestionali cacg inner join entrasp.articoli_centri_gestionali acg on cacg.codice_part=acg.codice_part and cacg.prog_codice_part=acg.prog_codice_part WHERE cacg.codice_azienda=$codice_azienda$ and cacg.id_contratto=$id_contratto$"
    }
  ],
