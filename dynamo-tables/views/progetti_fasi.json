	"predefinedQueries": [
		
		{
			"operation": "selectForm",
			"queryString": "update entrasp.progetti_fasi pf set stato=snd.stato from entrasp.sondaggi snd where pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio and id_fase=$id_fase$",
			"type": "preProcessing"
		},
		{
			"operation": "selectForm",
			"queryString": "select pf.*, snd.data_prevista, ss.id_somministrazione from entrasp.progetti_fasi pf left join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio left join entrasp.sondaggi_somministrati ss on snd.codice_azienda=ss.codice_azienda and snd.id_sondaggio=ss.id_sondaggio  where pf.codice_azienda=$codice_azienda$ and pf.id_fase=$id_fase$;",
			"type": "main"
		},
		{
			"operation": "insert",
			"queryString": "select entrasp.progetti_fasi_order($codice_azienda$, $id_progetto$, $id_fase$);",
			"type": "postProcessing"
		},
		{
			"operation": "update",
			"queryString": "select entrasp.progetti_fasi_order($codice_azienda$, $id_progetto$, $id_fase$);",
			"type": "postProcessing"
		},
		{
			"operation": "selectTable",
			"queryString": "select pf.*, (select case when id_somministrazione is null then false else true end as visible_button_somministrazione from entrasp.sondaggi_somministrati ss where ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio limit 1), (select case when id_somministrazione is null then false else true end as visible_button_modello_test from entrasp.sondaggi_somministrati ss where ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio limit 1), (select id_somministrazione from entrasp.sondaggi_somministrati ss where ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio limit 1), entrasp.transcodifiche_transcodifica('STATO', pf.stato) as stato_trans, snd.sondaggio_completato, snd.data_prevista, snd.data_esecuzione, snd.id_modello_test, snd. id_modello_test_vr, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da, snd.codice_azienda) as giudizio  from entrasp.progetti_fasi pf left join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio left join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr where pf.id_progetto=$id_progetto$ and pf.codice_azienda=$codice_azienda$;",
			"type": "main"
		}		
	],
