	"predefinedQueries": [
		{
			"operation": "selectForm",
			"queryString": "select entrasp.progetti_fasi_stato_update($codice_azienda$, (select id_progetto from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_fase=$id_fase$ limit 1));",
			"type": "preProcessing"
		},
		{
			"operation": "selectForm",
			"queryString": "select pf.ordinamento, pf.id_fase, pf.codice, pf.titolo, pf.stato, pf.id_progetto, pf.id_progetto as id_progetto2, pf.id_fase_sup, pf.codice_azienda, pf.id_sondaggio, pf.id_sondaggio as id_sondaggio2, (select id_somministrazione from entrasp.sondaggi_somministrati ss where ss.codice_azienda=pf.codice_azienda and ss.id_sondaggio=pf.id_sondaggio limit 1) as id_somministrazione, snd.data_prevista, (select id_somministrazione from entrasp.sondaggi_somministrati where codice_azienda=pf.codice_azienda and id_sondaggio=pf.id_sondaggio limit 1)as idsomministrazione ,entrasp.fase_avg_result(pf.codice_azienda, pf.id_fase) as avg_risultato,  entrasp.fase_avg_result_worst(pf.codice_azienda, pf.id_fase) as avg_risultato_worst,  entrasp.fase_giudizio_avg_result(pf.codice_azienda, pf.id_fase) as avg_giudizio, entrasp.fase_giudizio_avg_result_worst(pf.codice_azienda, pf.id_fase) as avg_giudizio_worst from entrasp.progetti_fasi pf left join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio where pf.codice_azienda=$codice_azienda$ and pf.id_fase=$id_fase$",
			"type": "main"
		},
		{
			"operation": "insert",
			"queryString": "select entrasp.progetti_fasi_order($codice_azienda$, $id_progetto$, $id_fase$);",
			"type": "postProcessing"
		},
		{
			"operation": "delete",
			"type": "main",
			"queryString": "select entrasp.progetto_fase_delete($codice_azienda$, $id_fase$);"
		},
		{
			"operation": "update",
			"queryString": "select entrasp.progetti_fasi_order($codice_azienda$, $id_progetto$, $id_fase$);",
			"type": "postProcessing"
		},
		{
			"operation": "selectTable",
			"queryString": "select pf.id_fase, pf.id_progetto, entrasp.somministrazione_mono_domanda(pf.codice_azienda, pf.id_sondaggio) as check, entrasp.snd_doc_completa(pf.codice_azienda, pf.id_sondaggio) as doc_completa,  pf.codice_azienda, coalesce(pf.id_sondaggio||'-'::varchar,'')||pf.titolo as titolo, pf.id_fase_sup, pf.id_sondaggio, pf.codice, entrasp.grc_max_id_mdt_vr(snd.codice_azienda, snd.id_modello_test) as id_modello_test_vr, true as duplica_fase, true as time_report_play,entrasp.time_report_stop_active((€global_id_anagrafiche€)::text, (select codice_compito from entrasp.compiti cmp where cmp.codice_azienda=pf.codice_azienda and cmp.id_fase=pf.id_fase limit 1), pf.codice_azienda),snd.id_anagrafica_assegnataria,(€global_id_anagrafiche€)::text as user_companies, true as delete_fase, (select id_somministrazione from entrasp.sondaggi_somministrati ss where ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio limit 1) as id_somministrazione, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', pf.stato) as stato_trans, snd.sondaggio_completato, snd.data_prevista, snd.data_esecuzione, snd.id_modello_test, snd. id_modello_test_vr, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da, snd.codice_azienda) as giudizio, entrasp.anagrafiche_vr_dati_identificativi(snd.codice_part, snd.id_anagrafica_assegnataria) as id_anagrafica_assegnataria, pf.id_sondaggio as id_sondaggio2, mt.id_tipo_modello_test from entrasp.progetti_fasi pf left join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio left join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr left join entrasp.modelli_test mt on mvr.id_modello_test=mt.id_modello_test and mvr.codice_azienda=mt.codice_azienda where pf.id_progetto=$id_progetto$ and pf.codice_azienda=$codice_azienda$",
			"type": "main"
		}
	],
