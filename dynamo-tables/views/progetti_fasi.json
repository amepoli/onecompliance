	"predefinedQueries": [
		{
			"operation": "selectForm",
			"queryString": "select stato, data_prevista from entrasp.sondaggi where codice_azienda=$codice_azienda$ and id_sondaggio=coalesce(£id_sondaggio£,0);",
			"type": "postProcessing"
		},
		{
			"operation": "selectForm",
			"queryString": "select id_somministrazione from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$ and id_sondaggio=coalesce(£id_sondaggio£,0) limit 1;",
			"type": "postProcessing"
		},
		{
			"operation": "selectForm",
			"queryString": "select count(id_somministrazione) as n_somministrazioni from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$ and id_sondaggio=coalesce(£id_sondaggio£,0);",
			"type": "postProcessing"
		},
		{
			"operation": "insert",
			"queryString": "select entrasp.progetti_fasi_order($codice_azienda$, $id_progetto$, $id_fase$);",
			"type": "postProcessing"
		},
		{
			"operation": "update",
			"queryString": "select entrasp.progetti_fasi_order($codice_azienda$, $id_progetto$, $id_fase$);",
			"type": "postProcessing"
		},
		{
			"operation": "selectTable",
			"queryString": "select pf.*, entrasp.transcodifiche_transcodifica('STATO', pf.stato) as stato_trans, snd.sondaggio_completato, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da, snd.codice_azienda) as giudizio  from entrasp.progetti_fasi pf left join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr where pf.id_progetto=$id_progetto$ and pf.codice_azienda=$codice_azienda$ order by pf.codice limit 100;",
			"type": "main"
		}
	],
