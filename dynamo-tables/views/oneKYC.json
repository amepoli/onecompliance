            "viewType": "table"
        },
        {
            "tableActionType": "quick-add",
            "viewType": "table"
        }
    ],
    "exportQueries": {
        "tableQueries": [
            {
                "label": "Admin: estrazioni per tipo e mese",
                "key": "count_one_kyc_admin",
                "queryString": "select codice_azienda, extract(year from date_of_scan) as anno, extract(month from date_of_scan) as mese, CASE scan_data->>'scanType' WHEN 'LIGHTSCAN' THEN 'Light Scan' ELSE 'Deep Scan' END as scan_type, count(id_scan) as conta_per_scan, count(distinct id_anagrafica) as conta_per_anagrafica from imports.aml_scans where codice_azienda in(€global_user_companies€) group by codice_azienda,extract(year from date_of_scan), extract(month from date_of_scan),(CASE scan_data->>'scanType' WHEN 'LIGHTSCAN' THEN 'Light Scan' ELSE 'Deep Scan' end) order by codice_azienda, extract(year from date_of_scan), extract(month from date_of_scan)"
            },
            {
                "label": "Estrazioni per tipo e mese",
                "queryString": "select codice_azienda, extract(year from date_of_scan) as anno, extract(month from date_of_scan) as mese, CASE scan_data->>'scanType' WHEN 'LIGHTSCAN' THEN 'Light Scan' ELSE 'Deep Scan' END as scan_type, count(id_scan) as conta_per_scan, count(distinct id_anagrafica) as conta_per_anagrafica from imports.aml_scans where codice_azienda in(€global_user_companies€) group by codice_azienda,extract(year from date_of_scan), extract(month from date_of_scan),(CASE scan_data->>'scanType' WHEN 'LIGHTSCAN' THEN 'Light Scan' ELSE 'Deep Scan' end) where codice_azienda=$codice_azienda$ order by codice_azienda,  extract(year from date_of_scan), extract(month from date_of_scan)"
            }
        ]
    },
    "search_keys": [
        {
            "fieldName": "data_esec_prevista_min",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Esecuzione dopo il",
            "newLine": false,
            "size": 1.25,
            "queryCond": "date_of_scan>=$data_esec_prevista_min$",
            "translate": "RESOURCES.esecuzione_dopo_il_onekyc"
        },
        {
            "fieldName": "data_esec_prevista_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Esecuzione prima del",
            "newLine": false,
            "size": 1.25,
            "queryCond": "date_of_scan<='€data_esec_prevista_max€'",
            "translate": "RESOURCES.esecuzione_prima_del_onekyc"
        },
        {
            "fieldName": "anagrafica_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Soggetto verificato",
            "newLine": false,
            "size": 1.25,
            "queryCond": "entrasp.anagrafiche_vr_dati_identificativi(entrasp.codice_part_from_azienda(ams.codice_azienda), id_anagrafica) ilike '%'||$anagrafica_s$||'%'",
            "translate": "RESOURCES.soggetto_verificato_onekyc"
        },
        {
            "fieldName": "tipo_scansione",
            "format": {
                "comboQuery": " SELECT DISTINCT tipo_scan AS id, tipo_scan AS name FROM imports.aml_scans WHERE codice_azienda='€global_codice_azienda€';",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Tipo scansione",
            "newLine": false,
            "size": 2,
            "queryCond": "(CASE scan_data->>'scanType' WHEN 'LIGHTSCAN' THEN 'Light Scan' else 'Deep scan' end)=$tipo_scansione$",
            "translate": "RESOURCES.tipo_scansione_onekyc"
        },
        {
            "fieldName": "dynamo_user_s",
            "format": {
                "comboQuery": "SELECT DISTINCT dynamo_user AS id, dynamo_user AS name FROM imports.aml_scans WHERE codice_azienda='€global_codice_azienda€' order by dynamo_user;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "User",
            "newLine": false,
            "size": 2,
            "queryCond": "dynamo_user=$dynamo_user_s$",
            "translate": "RESOURCES.user_onekyc"
        },
        {
            "fieldName": "mt_s",
            "format": {
                "comboQuery": "select distinct mt.id_modello_test as id, mt.id_modello_test||'-'||mt.titolo as name from imports.aml_scans inner join entrasp.sondaggi_somministrati ss using (codice_azienda, id_somministrazione) inner join entrasp.sondaggi snd on ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio inner join entrasp.modelli_test mt on snd.codice_azienda=mt.codice_azienda and snd.id_modello_Test=mt.id_modello_test where mt.codice_Azienda='€global_codice_azienda€'",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Modello test",
            "size": 3.5,
            "newLine": false,
            "queryCond": "ams.codice_azienda||'-'||ams.id_somministrazione in(select ss.codice_azienda||'-'||ss.id_somministrazione from entrasp.sondaggi_somministrati ss inner join entrasp.sondaggi snd using(codice_azienda, id_sondaggio) where snd.id_modello_test=$mt_s$ and snd.codice_azienda='€global_codice_azienda€')",
            "translate": "RESOURCES.modello_test_onekyc"
        },
        {
            "fieldName": "con_riscontri",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Con riscontri",
            "newLine": false,
            "size": 2,
            "queryCond": "anti_money_laundering!='[]'"
        }
    ]
}