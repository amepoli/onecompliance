            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "width": "12%",
            "queryFunct": "select true",
            "key": "create_somministrazione",
            "label": "$P{label_crea_sondaggio}",
            "isButton": true,
            "style": [
                {
                    "button_icon": "add",
                    "value": "*"
                }
            ],
            "buttonAction": {
                "target": "lessons",
                "viewType": "form",
                "keyToCheck": "id_tipo_modello_test",
                "navigationConditions": [
                    {
                        "ifValue": "52",
                        "newTarget": "lessons"
                    },
                    {
                        "ifValue": "5",
                        "newTarget": "lessons"
                    }
                ],
                "action": "query",
                "query": "select codaz as codice_azienda, idsnd as new_id_sondaggio, idss as new_id_somministrazione from entrasp.crea_singola_verifica('£codice_azienda£', £id_modello_test£)",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_modello_test",
                        "destination": "id_modello_test"
                    }
                ],
                "confirmAction": true,
                "confirmMessage": {
                    "title": "Nuova $P{tipo_sondaggio}",
                    "text": "Si vuole creare una nuova $P{tipo_sondaggio}?"
                },
                "onSuccessAction": "navigate",
                "onSuccessActionKeymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "new_id_sondaggio",
                        "destination": "id_sondaggio"
                    }
                ]
            },
            "translate": "RESOURCES.plabel_crea_sondaggio_modelli_valutazione_dipendenti"
        },
