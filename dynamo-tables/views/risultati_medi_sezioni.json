  "origin": "entrasp.sondaggi_somministrati_risultati_sezioni",
  "predefinedQueries": [
    {
      "operation": "selectTable",
      "type": "main",
      "queryString": "SELECT ssrs.codice_azienda, ssrs.id_sondaggio, ssrs.id_modello_test, ssrs.id_modello_test_vr, ssrs.id_sezione, ds.ordinamento, ds.descrizione as descr_sezione,ssrs.sezione_completata, round(AVG(round(ssrs.punteggio_ottenuto,2)),2) as punteggio_medio,round(AVG(pct_risultato_ottenuto_calcolato),2) as pct_ottenuto_medio,round(AVG(ssrs.pct_risultato_ottenuto_calcolato_ponderato),2) as ponderato_medio,entrasp.giudizio_da_pct(ssrs.codice_azienda,mtvr.id_risultato, round(AVG(pct_risultato_ottenuto_calcolato),2)) as giudizio_automatico,entrasp.codice_colore_da_pct(ssrs.codice_azienda,mtvr.id_risultato, round(AVG(pct_risultato_ottenuto_calcolato),2)) as codice_colore FROM entrasp.sondaggi_somministrati_risultati_sezioni ssrs INNER JOIN entrasp.domande_sezioni ds on ssrs.id_sezione=ds.id_sezione and ssrs.codice_azienda=ds.codice_azienda and ssrs.id_modello_test=ds.id_modello_test and ssrs.id_modello_test_vr=ds.id_modello_test_vr INNER JOIN entrasp.modelli_test_vr mtvr on ds.codice_azienda=mtvr.codice_azienda and mtvr.id_modello_test=ds.id_modello_test and mtvr.id_modello_test_vr=ds.id_modello_test_vr WHERE ssrs.codice_azienda=$codice_azienda$ and ssrs.id_sondaggio=$id_sondaggio$ and ds.flag_non_applicabile_sezione='0' GROUP BY ssrs.sezione_completata, ssrs.codice_azienda, ssrs.id_sondaggio, ssrs.id_modello_test, ssrs.id_modello_test_vr, ssrs.id_sezione, ds.ordinamento, ds.descrizione, mtvr.id_risultato"
    }
  ],
