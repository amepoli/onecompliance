{
    "$schema": "../views.schema.json",
    "businessObjectName": "aziende",
    "origin": "entrasp.aziende",
    "entryKey": "aziende",
    "predefinedQueries": [
        {
            "type": "main",
            "operation": "selectTable",
            "queryString": "select codice_azienda, codice_part from entrasp.aziende where codice_azienda in(€global_user_companies€) and codice_azienda in(select distinct csn.codice_azienda from entrasp.consuntivazioni csn inner join entrasp.anagrafiche_id an on csn.id_risorsa=an.id_anagrafica and csn.codice_part=an.codice_part and an.dynamo_user in(select entrasp.colleghi('€global_username€')))"
        },
        {
            "type": "postProcessing",
            "operation": "selectForm",
            "queryString": "select codice_azienda, entrasp.consuntivazioni_time_consumed_azienda(codiceaziendaerogante => codice_azienda , datainizio=>entrasp.first_day_year(now()::date), datafine =>entrasp.last_day_year(now()::date)) as time_consumed_current_year,  entrasp.consuntivazioni_time_consumed_azienda(codiceaziendaerogante => codice_azienda , datainizio=>entrasp.first_day_year((now()- interval '365 days')::date), datafine =>entrasp.last_day_year((now()- interval '365 days')::date)) as time_consumed_previous_year, entrasp.consuntivazioni_time_consumed_azienda(codiceaziendaerogante => codice_azienda,  datainizio=>entrasp.first_day_month(now()::date), datafine =>entrasp.last_day_month(now()::date)) as time_consumed_current_month, entrasp.consuntivazioni_time_consumed_azienda(codiceaziendaerogante => codice_azienda , datainizio=>entrasp.first_day_previous_month(now()::date), datafine =>entrasp.last_day_previous_month(now()::date)) as time_consumed_previous_month from entrasp.aziende where codice_azienda=$codice_azienda$ and codice_azienda in(€global_user_companies€)"
        }
    ],
