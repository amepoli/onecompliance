    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "SELECT *,'€global_username€' as global_username,entrasp.centri_costo_del_compito(cc.codice_azienda, cc.codice_compito) as centro_costo_aggregato,entrasp.time_report_stop_active_du('€global_username€',cc.codice_compito,cc.codice_azienda) as time_report_stop_active from entrasp.compiti_collaboratori cc inner join entrasp.compiti cmp on cc.codice_azienda=cmp.codice_azienda and cc.codice_compito=cmp.codice_compito where cc.codice_azienda in (€global_user_companies€) and cc.codice_azienda||'-'||cc.codice_compito in(select csn.codice_azienda||'-'||csn.codice_compito from entrasp.consuntivazioni csn inner join entrasp.anagrafiche_id an on csn.codice_part=an.codice_part and csn.id_risorsa=an.id_anagrafica where an.dynamo_user='€global_username€')"
        },
        {
            "operation": "startEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_play_du('€global_username€', '$codice_compito$', '$codice_azienda$') as play_time_report"
        },
        {
            "operation": "stopEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
        }
    ],
