      "operation": "selectTable",
      "type": "main",
      "queryString": "select entrasp.time_report_stop_active((€global_id_anagrafiche€)::text,a.codice_compito,a.codice_azienda), true as time_report_play,(€global_id_anagrafiche€)::text as user_companies,a.codice_azienda,a.codice_compito,a.titolo,entrasp.consuntivazioni_time_consumed(a.codice_azienda,entrasp.first_day_month(CURRENT_DATE),entrasp.last_day_month(CURRENT_DATE),a.codice_compito,'€global_username€'::text) as minuti_mensili,entrasp.consuntivazioni_time_consumed(a.codice_azienda, codicecompito => a.codice_compito, dynamouser => '€global_username€'::text) minuti_totali,entrasp.tipo_segnalazione_descr_new(a.id_tipo_segnalazione) as tipo_segnalazione from entrasp.compiti a inner join entrasp.consuntivazioni b on a.codice_azienda=b.codice_azienda and a.codice_compito=b.codice_compito where a.codice_azienda in (€global_user_companies€) and entrasp.consuntivazioni_time_consumed(a.codice_azienda, codicecompito => a.codice_compito, dynamouser => '€global_username€'::text) is not null group by a.codice_azienda, a.codice_compito, a.titolo, b.codice_part, b.id_risorsa having  entrasp.dynamo_user_from_id_an(b.codice_part, b.id_risorsa)='€global_username€'::text order by a.data_ins desc"
    },
    {
      "operation": "startEvent",
      "type": "main",
      "queryString": "select entrasp.time_report_play((€global_id_anagrafiche€)::text, '$codice_compito$', '$codice_azienda$') as play_time_report"
    },
    {
      "operation": "stopEvent",
      "type": "main",
      "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
    }
  ],
