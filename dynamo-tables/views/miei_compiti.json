            "newLine": false,
            "queryCond": "codice_compito=$codice_compito$",
            "size": 1.67,
            "translate": "RESOURCES._identificativo_miei_compiti"
        },
        {
            "format": {
                "comboQuery": "SELECT codice_azienda AS id, codice_azienda AS name FROM entrasp.aziende where codice_azienda in(€global_user_companies€) order by codice_azienda;",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "queryCond": "codice_azienda='€codice_azienda_s€'",
            "fieldName": "codice_azienda_s",
            "label": "Codice Azienda",
            "newLine": false,
            "size": 1.67,
            "translate": "RESOURCES.codice_azienda_miei_compiti"
        },
        {
            "fieldName": "parola_search",
            "format": {
