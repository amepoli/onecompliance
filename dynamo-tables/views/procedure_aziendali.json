    "exportQueries": {
        "tableQueries": [
            {
                "label": "Processi e rischi associati",
                "queryString": "select pa1.id_procedura as liv1_id_proc, pa1.codice as liv1_cod, pa1.descrizione_breve as liv1_proc_titolo, pa1.id_procedura_parent as liv1_id_pp, rsk1.codice as rsk1_codice, rsk1.titolo as rsk1_titolo, pa2.id_procedura as liv2_id_proc, pa2.codice as liv2_cod, pa2.descrizione_breve as liv2_proc_titolo, pa2.id_procedura_parent as liv2_id_pp, rsk2.codice as rsk2_codice, rsk2.titolo as rsk2_titolo, pa3.id_procedura as liv3_id_proc, pa3.codice as liv3_cod ,pa3.descrizione_breve as liv3_proc_titolo, pa3.id_procedura_parent as liv3_id_pp, rsk3.codice as rsk3_codice, rsk3.titolo as rsk3_titolo from entrasp.procedure_aziendali pa1 left join entrasp.procedure_aziendali pa2 on pa1.id_procedura=pa2.id_procedura_parent and pa1.codice_azienda=pa2.codice_azienda left join entrasp.procedure_aziendali pa3 on pa2.id_procedura=pa3.id_procedura_parent and pa2.codice_azienda=pa3.codice_azienda left join entrasp.fonti_rischio fr1 on pa1.id_procedura=fr1.id_procedura and pa1.codice_azienda=fr1.codice_azienda left join entrasp.rischi rsk1 on fr1.codice_rischio=rsk1.codice_rischio and fr1.codice_azienda=rsk1.codice_azienda left join entrasp.fonti_rischio fr2 on pa2.id_procedura=fr2.id_procedura and pa2.codice_azienda=fr2.codice_azienda left join entrasp.rischi rsk2 on fr2.codice_rischio=rsk2.codice_rischio and fr2.codice_azienda=rsk2.codice_azienda left join entrasp.fonti_rischio fr3 on pa1.id_procedura=fr3.id_procedura and pa3.codice_azienda=fr3.codice_azienda left join entrasp.rischi rsk3 on fr3.codice_rischio=rsk3.codice_rischio and fr3.codice_azienda=rsk3.codice_azienda where pa1.id_procedura_parent is null and pa1.codice_azienda=$codice_azienda$ order by pa1.codice, pa2.codice, pa3.codice"
            }
