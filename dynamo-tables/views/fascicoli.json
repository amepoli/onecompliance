    "search_keys": [
        {
            "fieldName": "id_fascicolo_s",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Id Fascicolo",
            "newLine": false,
            "queryCond": "id_fascicolo=$id_fascicolo_s$"
        },
        {
            "fieldName": "id_legale_s",
            "format": {
                "comboQuery": "SELECT distinct id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_anagrafica) AS name FROM entrasp.anagrafiche_vr WHERE codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Legale",
            "newLine": false,
            "queryCond": "id_legale=$id_legale_s$"
        },
        {
            "fieldName": "cod_fascicolo_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Fascicolo",
            "newLine": false,
            "queryCond": "cod_fascicolo like '%'||$cod_fascicolo_s$||'%'"
        },
        {
            "fieldName": "interessi_leg_min",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Interessi maggiori di",
            "newLine": false,
            "queryCond": "interessi_legali_totali>=$interessi_leg_min$"
        },
        {
            "fieldName": "flag_con_pagamenti",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Fascicoli con pagamenti",
            "newLine": false,
            "queryCond": "codice_azienda||'-'||id_fascicolo in(select codice_azienda||'-'||id_fascicolo from entrasp.pagamenti_fascicoli where codice_azienda=$codice_azienda$)"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by data_incarico desc"
    },
    "hideActions": [
        {
            "formActionType": "attachments",
            "viewType": "form"
        }
    ],
    "subTables": [
        {
            "entryKey": "crediti_sub_of_fascicoli",
            "type": "table",
            "label": "Crediti del fascicolo",
            "keys": [
                {
                    "parent": "id_fascicolo",
                    "son": "id_fascicolo"
                },
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                }
            ]
        },
        {
            "entryKey": "pagamenti_fascicoli_sub_of_fascicoli",
            "type": "table",
            "label": "Pagamenti fascicolo",
            "keys": [
                {
                    "parent": "id_fascicolo",
                    "son": "id_fascicolo"
                },
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                }
            ]
        }
    ]
