            "translate": "RESOURCES.data_fascicolo_fascicoli"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "capitale_totale",
            "label": "Capitale totale",
