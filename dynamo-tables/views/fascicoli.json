    "search_keys": [
        {
            "fieldName": "id_fascicolo_s",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Id Fascicolo",
            "newLine": false,
            "queryCond": "id_fascicolo=$id_fascicolo_s$",
            "translate": "RESOURCES.id_fascicolo_fascicoli"
        },
        {
            "fieldName": "id_legale_s",
            "format": {
                "comboQuery": "SELECT distinct id_anagrafica AS id, entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_anagrafica) AS name FROM entrasp.anagrafiche_vr WHERE codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Legale",
            "newLine": false,
            "queryCond": "id_legale=$id_legale_s$",
            "translate": "RESOURCES.legale_fascicoli"
        },
        {
            "fieldName": "cod_fascicolo_s",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Codice",
            "newLine": false,
            "queryCond": "cod_fascicolo ilike '%'||$cod_fascicolo_s$||'%'",
            "translate": "RESOURCES.codice_fascicoli"
        },
        {
            "fieldName": "interessi_leg_min",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "Interessi maggiori di",
            "newLine": false,
            "queryCond": "interessi_legali_totali>=$interessi_leg_min$",
            "translate": "RESOURCES.interessi_maggiori_di_fascicoli"
        },
        {
            "fieldName": "con_agg_leg",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Con agg.leg.",
            "newLine": false,
            "queryCond": "codice_azienda||'-'||id_fascicolo in(select codice_azienda||'-'||id_fascicolo from entrasp.consuntivazioni csn where codice_azienda=$codice_azienda$)",
            "translate": "RESOURCES.con_aggleg_fascicoli"
        },
        {
            "fieldName": "senza_agg_da_numero_giorni",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "No agg.leg. da n_gg",
            "tooltip": "Senza aggiornamenti legali da un numero di giorni corrispondenti a quelli scritti nella casella",
            "newLine": false,
            "queryCond": "codice_azienda||'-'||id_fascicolo not in(select csn.codice_azienda||'-'||csn.id_fascicolo from entrasp.consuntivazioni csn where codice_azienda=$codice_azienda$ and data_intervento>=(current_date-$senza_agg_da_numero_giorni$) and csn.codice_azienda||'-'||csn.id_fascicolo is not null)",
            "translate": "RESOURCES.no_aggleg_da_n_gg_fascicoli"
        },
        {
            "fieldName": "flag_con_pagamenti",
            "format": {
                "viewType": "checkbox"
            },
            "label": "Fascicoli con pagamenti",
            "newLine": false,
            "queryCond": "codice_azienda||'-'||id_fascicolo in(select codice_azienda||'-'||id_fascicolo from entrasp.pagamenti_fascicoli where codice_azienda=$codice_azienda$)",
            "translate": "RESOURCES.fascicoli_con_pagamenti_fascicoli"
        }
