    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "SELECT an.codice_part, an.id_anagrafica, avr.ragione_sociale, avr.denominazione,an.codice,entrasp.transcodifiche_transcodifica('TIPO_SOGGETTO',an.tipo_soggetto)as tipo_soggetto, avr.prog_vr, entrasp.ruoli_of_anagrafiche_vr(an.codice_part, an.id_anagrafica) as ruolo_s, avr.codice_fiscale, avr.partita_iva FROM entrasp.anagrafiche_id an JOIN entrasp.anagrafiche_vr avr ON an.codice_part=avr.codice_part AND an.id_anagrafica=avr.id_anagrafica join entrasp.ruoli_anagrafiche ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica WHERE an.codice_part=$codice_part$ and avr.prog_vr=entrasp.anagrafiche_vr_max($codice_part$, an.id_anagrafica) and codice_ruolo = 'FONDO';",
            "type": "main"
        },
        {
            "operation": "insert",
            "queryString": "SELECT idnew as id_anagrafica, progvr as prog_vr from entrasp.anagrafica_id_insert(codiceazienda=>'€global_codice_azienda€', tiposoggetto=>$tipo_soggetto$, codiceruolo=>'FONDO', codiceanagrafica=>$codice$, ragionesociale=>$ragione_sociale$::varchar, flagfondo=>'€flag_fondo€', annotazioniinterne=>$annotazioni_interne$);",
            "type": "main"
        },
        {
            "operation": "update",
            "queryString": "SELECT entrasp.anagrafica_id_update(codicepart=>$codice_part$, anagraficaid=>$id_anagrafica$, codiceazienda=>'€global_codice_azienda€', codiceanagrafica=>$codice$, ragionesociale=>$ragione_sociale$, flagfondo=>'€flag_fondo€', annotazioniinterne=>$annotazioni_interne$);",
            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "SELECT entrasp.anagrafica_id_delete($codice_part$, '€global_codice_azienda€', $id_anagrafica$);",
            "type": "main"
        }
