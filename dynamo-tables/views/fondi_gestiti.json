    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "preProcessing",
            "queryString": "update entrasp.anagrafiche_vr avr set liv_min_toll_rischio_per_sottoscrizione= entrasp.giudizio_mifid_strum_fin('€global_codice_azienda€', avr.id_anagrafica)from entrasp.ruoli_anagrafiche ra where avr.codice_part=ra.codice_part and avr.id_anagrafica=ra.id_anagrafica and avr.codice_part = '€global_codice_part€' and ra.codice_ruolo='FONDO'"
        },
        {
            "operation": "selectTable",
            "queryString": "SELECT an.codice_part, an.id_anagrafica,avr.data_upd, avr.liv_min_toll_rischio_per_sottoscrizione, avr.ragione_sociale, avr.denominazione,an.codice,entrasp.transcodifiche_transcodifica('TIPO_SOGGETTO',an.tipo_soggetto)as tipo_soggetto, avr.prog_vr, entrasp.ruoli_of_anagrafiche_vr(an.codice_part, an.id_anagrafica) as ruolo_s, avr.codice_fiscale, avr.partita_iva FROM entrasp.anagrafiche_id an JOIN entrasp.anagrafiche_vr avr ON an.codice_part=avr.codice_part AND an.id_anagrafica=avr.id_anagrafica join entrasp.ruoli_anagrafiche ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica WHERE an.codice_part=$codice_part$ and avr.prog_vr=entrasp.anagrafiche_vr_max($codice_part$, an.id_anagrafica) and ra.codice_ruolo = 'FONDO';",
            "type": "main"
        },
        {
            "operation": "insert",
            "queryString": "SELECT idnew as id_anagrafica, progvr as prog_vr from entrasp.anagrafica_id_insert(codiceazienda=>'€global_codice_azienda€', tiposoggetto=>$tipo_soggetto$, codiceruolo=>'FONDO', codiceanagrafica=>$codice$, ragionesociale=>$ragione_sociale$::varchar, flagfondo=>'€flag_fondo€', annotazioniinterne=>$annotazioni_interne$);",
            "type": "main"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_anagrafica$ is null as label;",
            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "SELECT entrasp.anagrafica_id_delete($codice_part$, '€global_codice_azienda€', $id_anagrafica$);",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select codice from entrasp.anagrafiche_id where codice_part=$codice_part$ and codice=$codice$",
            "messageNotNull": "Attenzione esiste già un'anagrafica con lo stesso codice!"
        }
    ],
