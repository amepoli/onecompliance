            "operation": "selectTable",
            "queryString": "SELECT an.codice_part, an.id_anagrafica, an.nome,  an.cognome, avr.ragione_sociale, avr.denominazione, avr.prog_vr, avr.codice_fiscale, avr.partita_iva FROM entrasp.anagrafiche_id an JOIN entrasp.anagrafiche_vr avr ON an.codice_part=avr.codice_part AND an.id_anagrafica=avr.id_anagrafica WHERE an.codice_part=$codice_part$ and avr.prog_vr=entrasp.anagrafiche_vr_max($codice_part$, an.id_anagrafica);"
        },
        {
            "type": "main",
            "operation": "insert",
            "queryString": "SELECT entrasp.anagrafica_id_insert(codiceazienda=>$codice_azienda$, anagraficaid=>$id_anagrafica$, codiceruolo=>'CLI', codice=>$codice$, name=>$nome$,surname=>$cognome$, ragionesociale=>$ragione_sociale$, codicefiscale=>$codice_fiscale$, partitaiva=>$partita_iva$, flagcliente=>$flag_cliente$, flagfornitore=>$flag_fornitore$, flagfornitore=>$flag_dipendente$);"
        },
        {
            "type": "main",
            "operation": "update",
            "queryString": "SELECT entrasp.anagrafica_id_update(codicepart=>$codice_part$, anagraficaid=>$id_anagrafica$, codiceanagrafica=>$codice$,name=>$nome$, surname=>$cognome$,ragionesociale=>$ragione_sociale$,codicefiscale=>$codice_fiscale$, partitaiva=>$partita_iva$, flagcliente=>$flag_cliente$);"
        }
