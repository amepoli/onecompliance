    "entryKey": "fogli_informativi",
    "inheritsFrom": "contracts_investment",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select cnt.id_contratto, cnt.descrizione, cnt.data_stipulazione, cnt.data_cessazione,cnt.data_contratto_a, cnt.codice_azienda, cnt.tan, cnt.numero_contratto, entrasp.transcodifiche_transcodifica('STATO_CONTRATTI', cnt.stato) as descr_stato, teg, spread, tax_min, tax_max, tass_mo, moraperc  from entrasp.contratti cnt inner join entrasp.aziende az on cnt.codice_azienda=az.codice_azienda where az.codice_part='€global_codice_part€' and cnt.codice_ruolo='CLI' and cnt.id_argomento_contratto=49580"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "select entrasp.sondaggi_delete_after_contract_end($codice_azienda$, $id_contratto$)"
        }
    ],
