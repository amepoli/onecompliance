            "actionOnYes": {
              "actionType": "query",
              "queryFunct": "select entrasp.sezioni_domande_delete ($codice_azienda$, $id_sezione$, $id_modello_test$, $id_modello_test_vr$);"
            }
          },
          "outputEventWhenComplete": "reLoad_form_domande_sezioni"
