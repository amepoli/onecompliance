	"origin": "entrasp.argomenti",
	"businessObjectName": "argomenti",
	"predefinedQueries": [
		{
			"operation": "selectTable",
			"type": "main",
			"queryString": "select arg.codice, arg.id_argomento, arg.descrizione, arg.descrizione_breve ,count(cns.id_cons) as num_cons from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son inner join entrasp.consuntivazioni cns on arg.id_argomento=cns.id_argomento where id_argomento_father=3492 and cns.id_risorsa in (select id_anagrafica from entrasp.anagrafiche_id where dynamo_user='€global_username€') group by arg.codice, arg.id_argomento, arg.descrizione, arg.descrizione_breve"
		}
