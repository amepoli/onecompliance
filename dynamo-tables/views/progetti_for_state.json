{
    "businessObjectName": "transcodifiche",
    "predefinedQueries": [
        {
            "queryString": "select ts.tipo_dato, ts.codice,ts.transcodifica,count(distinct prg.id_progetto) as num_progetti from entrasp.transcodifiche ts inner join entrasp.progetti prg on ts.codice=prg.stato inner join entrasp.progetti_fasi pf on prg.codice_azienda=pf.codice_azienda and prg.id_progetto=pf.id_progetto inner join entrasp.sondaggi snd on pf.codice_azienda=snd.codice_azienda and pf.id_sondaggio=snd.id_sondaggio inner join entrasp.centri_gestionali cg on snd.codice_part=cg.codice_part and snd.id_centro_gest=cg.id_centro_gest inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where ts.tipo_dato='STATO_SONDAGGI'  and prg.codice_azienda=('€global_codice_azienda€') group by ts.tipo_dato, ts.codice, ts.transcodifica, ts.ordinamento",
            "operation": "selectTable",
            "type": "main"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by ts.ordinamento"
    },
    "search_keys": [
        {
            "fieldName": "tipo_dato_s",
