{
    "$schema": "../views.schema.json",
    "entryKey": "classification_odg",
    "inheritsFrom": "argomenti",
    "addElementSettings": {
        "labelAdd": "Nuovo Tipo Punto",
        "navigateOnSuccess": false,
        "translateAdd": "RESOURCES.nuovo_tipo_punto"
    },
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select arg.* from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento =aa.id_argomento_son where id_argomento_father=3405",
            "type": "main"
        },
        {
            "operation": "insert",
            "queryString": "select entrasp.argomenti_classification_insert($descrizione_breve$, $descrizione$, $codice$, 3405) as id_argomento;",
            "type": "main"
        },
        {
            "operation": "delete",
            "queryString": "delete from entrasp.argomenti_argomenti where id_argomento_father=3405 and id_argomento_son=$id_argomento$;",
            "type": "preProcessing"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_argomento$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£'",
            "messageNotNull": "Inserimento: Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
        },
        {
            "operation": "update",
            "type": "preCheck",
            "queryString": "select id_argomento from entrasp.argomenti WHERE codice='£codice£' and id_argomento!=$id_argomento$",
            "messageNotNull": "Aggiornamento: Il codice inserito è già stato utilizzato per un altro argomento: prego utilizzarne un codice diverso"
        }
    ],
    "search_keys": [
        {
            "fieldName": "id_argomento_s",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID",
            "newLine": false,
            "queryCond": "arg.id_argomento=$id_argomento_s$",
            "translate": "RESOURCES.id_classification_odg"
        },
        {
            "fieldName": "codice",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Codice",
            "newLine": false,
            "queryCond": "arg.codice=$codice$",
            "translate": "RESOURCES.codice_classification_odg"
        },
        {
            "fieldName": "descr_rs",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Descrizione",
            "newLine": true,
            "queryCond": "(UPPER(arg.descrizione) like '%'||UPPER('€descr_rs')||'%' or UPPER(arg.descrizione_breve) like '%'||UPPER('€descr_rs€')||'%')",
            "translate": "RESOURCES.descrizione_classification_odg"
        },
        {
            "fieldName": "no_modello_test",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Senza modelli di test",
            "newLine": true,
            "size": 1,
            "queryCond": "arg.id_argomento not in(select mt.id_argomento from entrasp.modelli_test mt)",
            "translate": "RESOURCES.senza_modelli_di_test_classification_odg"
        },
        {
            "fieldName": "no_modello_test",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Con modelli di test",
            "newLine": true,
            "size": 1,
            "queryCond": "arg.id_argomento in(select mt.id_argomento from entrasp.modelli_test mt)",
            "translate": "RESOURCES.con_modelli_di_test_classification_odg"
        },
        {
            "fieldName": "categorie_modello_test_s",
            "format": {
                "comboQuery": "SELECT id_argomento AS id, id_argomento||'-'||descrizione AS name  FROM entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=3425 order by descrizione",
                "options": [],
                "viewType": "combobox",
                "dataType": "text"
            },
            "label": "Categorie modelli test",
            "newLine": false,
            "queryCond": "array[arg.id_argomento]<@any(select entrasp.sotto_argomenti($categorie_modello_test_s$))",
            "translate": "RESOURCES.categorie_modelli_test_classification_odg"
        }
    ],
    "subTables": [
        {
            "entryKey": "argomenti_sub_of_argomenti_father",
            "keys": [
                {
                    "parent": "id_argomento",
                    "son": "id_argomento_son"
                }
            ],
            "label": "Argomenti padre",
            "translate": "RESOURCES.Argomentipadre_argomenti_sub_of_argomenti_father"
        },
        {
            "entryKey": "odg_associated_at_odg",
            "isHidden": false,
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                },
                {
                    "parent": "id_argomento",
                    "son": "id_argomento"
                }
            ],
            "label": "Trattazioni del Medesimo Argomento",
            "translate": "RESOURCES.TrattazionidelMedesimoArgomento_odg_associated_at_odg"
        },
        {
            "entryKey": "documenti_sub_of_tipi_odg",
            "keys": [
                {
                    "parent": "id_argomento",
                    "son": "id_argomento_father"
                }
            ],
            "label": "Tipi documenti approvati",
            "translate": "RESOURCES.Tipidocumentiapprovati_documenti_sub_of_tipi_odg"
        }
    ],
    "hideActions": [
        {
            "viewType": "form",
            "formActionType": "attachments"
        },
        {
            "viewType": "table",
            "tableActionType": "quick-add"
        }
    ]
}