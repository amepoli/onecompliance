{
    "$schema": "../views.schema.json",
    "entryKey": "compiti_consultant_hp",
    "inheritsFrom": "compiti_consultant_micro_task",
    "toolbar_elements": [
        {
            "fieldName": "tipo_s",
            "viewType": "combobox",
            "position": "left",
            "label": "Tipo",
            "translate": "RESOURCES.type",
            "options": [],
            "comboQuery": "SELECT id_tipo_segnalazione AS id, descrizione AS name  FROM entrasp.tipi_segnalazioni order by descrizione;",
            "queryCond": "cmp.id_tipo_segnalazione = '$tipo_s$'"
        },
        {
            "fieldName": "flag_progetti_aperti",
            "viewType": "toggle",
            "position": "right",
            "label": "Solo Anomalie",
            "toggleOffLabel": "Tutti i compiti aperti",
            "queryCond": "cmp.id_tipo_segnalazione in(5, 11, 50, 86, 300)"
        }
    ],
    "tiles": [
        {
            "title": "Compiti chiusi",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(codice_compito) as compiti_chiusi FROM entrasp.compiti cmp WHERE (cmp.codice_azienda in(€global_user_companies€) and entrasp.compito_belongs_user((€global_id_anagrafiche€)::text, cmp.codice_compito, cmp.codice_azienda)) and cmp.stato='C'",
                "queryCond": "",
                "fieldName": "compiti_chiusi",
                "value_color": "green",
                "title_color": "green",
                "background_color": "white",
                "navigationAdditionalKeys": {
                    "stato": "C"
                }
            },
            "new_line": false
        },
        {
            "title": "Compiti aperti",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(codice_compito) as compiti_aperti FROM entrasp.compiti cmp WHERE (cmp.codice_azienda in(€global_user_companies€) and entrasp.compito_belongs_user((€global_id_anagrafiche€)::text, cmp.codice_compito, cmp.codice_azienda)) and cmp.stato='A'",
                "queryCond": "",
                "fieldName": "compiti_aperti",
                "value_color": "red",
                "title_color": "red",
                "background_color": "white",
                "navigationAdditionalKeys": {
                    "stato": "A"
                }
            },
            "new_line": true
        },
        {
            "title": "Compiti provvisori",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(codice_compito) as compiti_aperti FROM entrasp.compiti cmp WHERE (cmp.codice_azienda in(€global_user_companies€) and entrasp.compito_belongs_user((€global_id_anagrafiche€)::text, cmp.codice_compito, cmp.codice_azienda)) and cmp.stato='P'",
                "queryCond": "",
                "fieldName": "compiti_provvisori",
                "value_color": "blue",
                "title_color": "blue",
                "background_color": "white",
                "navigationAdditionalKeys": {
                    "stato": "P"
                }
            },
            "new_line": true
        }
    ]
}