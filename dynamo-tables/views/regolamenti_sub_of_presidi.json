            "queryString": "select entrasp.argomenti_codice_descr_breve(aa.id_argomento_father) as controllo, vaf.stringa, vaf.id_risorsa from entrasp.argomenti_argomenti aa inner join entrasp.views_attachments_fast vaf on aa.id_argomento_father=vaf.id_argomento_tipo_allegato where aa.id_argomento_son in(select aa2.id_argomento_son from entrasp.argomenti_argomenti aa2 where aa2.id_argomento_father in (5328,48976,48975)) and aa.id_argomento_father in (select aa3.id_argomento_son from entrasp.argomenti_argomenti aa3 where aa3.id_argomento_father=3511) and aa.id_argomento_son=$id_argomento_son$ and vaf.codice_azienda='€global_codice_azienda€' and vaf.prog_revisione=entrasp.max_id_risorsa_rev(vaf.codice_azienda, vaf.id_risorsa)",
