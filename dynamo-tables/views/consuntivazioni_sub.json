                "comboQuery": "SELECT distinct an.id_anagrafica AS id, concat(codice, ' - ', nome, ' ', cognome) as name from entrasp.anagrafiche_id an inner join entrasp.ruoli_anagrafiche ra on an.id_anagrafica=ra.id_anagrafica and an.codice_part=ra.codice_part WHERE an.codice_part='€global_codice_part€' and ra.codice_ruolo='RSRSA';",
                "options": [],
                "viewType": "combobox",
                "validations": [
                    {
                        "message": "Esecutore necessario",
                        "name": "required",
                        "validator": "Validators.required",
                        "translate": "RESOURCES.esecutore_necessario"
                    }
                ]
            },
            "label": "Esecutore",
            "translate": "RESOURCES.esecutore",
            "newLine": false,
            "queryCond": "id_risorsa=$id_risorsa_search$"
        },
        {
            "fieldName": "note_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Note",
            "translate": "RESOURCES.notes",
            "newLine": true,
            "queryCond": "UPPER (note) like '%'||UPPER('€note_search€')||'%'"
        },
