{
    "$schema": "../views.schema.json",
    "entryKey": "fe_attachment_form",
    "form_keys": [
      {
        "format": {
          "comboQuery": "select id_argomento as id, descrizione as name from entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son where aa.id_argomento_father=3576 and (arg.codice_azienda is null or arg.codice_azienda='€global_codice_azienda€');",
          "viewType": "combobox",
          "options": []
        },
        "isHidden": false,
        "isPrimary": false,
        "key": "type",
        "label": "Tipo Documento",
        "newLine": false,
        "readOnly": false
      },
      {
        "format": {
          "dataType": "text",
          "viewType": "input"
        },
        "isHidden": true,
        "isPrimary": false,
        "key": "codice_azienda",
        "label": "Azienda",
        "readOnly": true
      },
      {
        "format": {
          "dataType": "text",
          "viewType": "input"
        },
        "isHidden": false,
        "isPrimary": false,
        "key": "fileName",
        "label": "Nome file",
        "readOnly": false
      },
      {
        "format": {
          "dataType": "text",
          "viewType": "input"
        },
        "isHidden": false,
        "isPrimary": false,
        "key": "dimension",
        "label": "Dimensione",
        "readOnly": true
      },
      {
        "format": {
          "dataType": "text",
          "viewType": "input"
        },
        "isHidden": false,
        "isPrimary": false,
