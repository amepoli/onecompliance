            "autoGenerate": false,
            "format": {
                "comboQuery": "SELECT distinct prg.id_progetto AS id,CONCAT (prg.id_progetto, ' - ', prg.titolo) AS name FROM entrasp.progetti prg LEFT JOIN entrasp.progetti_fasi pf USING (codice_azienda,id_progetto) LEFT JOIN entrasp.sondaggi snd ON pf.codice_azienda=snd.codice_azienda AND pf.id_sondaggio=snd.id_sondaggio WHERE prg.id_progetto IN (SELECT pf.id_progetto FROM entrasp.progetti_fasi pf INNER JOIN entrasp.sondaggi s ON pf.codice_azienda=s.codice_azienda AND pf.id_sondaggio=s.id_sondaggio WHERE s.id_centro_gest in (select id_centro_gest from entrasp.sondaggi where id_sondaggio=$id_sondaggio$ and codice_azienda=$codice_azienda$) AND pf.codice_azienda=$codice_azienda$ UNION SELECT id_progetto FROM entrasp.progetti prg2 WHERE prg2.codice_azienda=$codice_azienda$ AND prg2.id_centro_gest in (select id_centro_gest from entrasp.sondaggi where id_sondaggio=$id_sondaggio$ and codice_azienda=$codice_azienda$))AND prg.codice_azienda=$codice_azienda$ order by prg.id_progetto asc;",
