{
    "$schema": "../views.schema.json",
    "entryKey": "consuntivazioni_sovrapposte_sub_of_user",
    "origin": "entrasp.consuntivazioni",
    "businessObjectName": "consuntivazioni",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select *, date_time_begin::date as data, case when date_time_end>date_time_begin2 then true else false end as anticipa_fine, case when date_time_begin2>date_time_end then true else false end as posticipa_inizio from entrasp.consuntivazioni_sovrapposte where dynamo_user=$dynamo_user$ and durata>5 and durata2>5",
            "type": "main"
        }
    ],
    "restrictions": {
        "preventNavigationToForm": true
    },
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "width": "4%",
            "queryFunct": "select true",
            "key": "anticipa_fine",
            "label": "End 1° before",
            "style": [
                {
                    "button_icon": "arrow_back",
                    "value": "*"
                }
            ],
            "tooltip": "Anticipa la fine della consuntivazione 1 all'inizio della consuntivazione 2",
            "isButton": true,
            "buttonAction": {
                "target": "consuntivazioni_sovrapposte",
                "viewType": "table",
                "query": "update entrasp.consuntivazioni csn1 set date_time_end=csn2.date_time_begin from entrasp.consuntivazioni csn2 where csn1.codice_azienda='£codice_azienda£' and csn1.id_cons=£id_cons£ and csn2.codice_azienda='£codice_azienda2£' and csn2.id_cons=£id_cons2£",
                "action": "query",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_cons",
                        "destination": "id_cons"
                    },
                    {
                        "source": "codice_azienda2",
                        "destination": "codice_azienda2"
                    },
                    {
                        "source": "id_cons2",
                        "destination": "id_cons2"
                    }
                ],
                "onSuccessAction": "reload",
                "confirmMessage": {
                    "text": "Anticipare la fine della prima consuntivazione all'inizio della seconda? ATTENZIONE! L'effetto della modifica sarà efficace entro massimo 2 ore",
                    "title": "Anticipo fine 1° consuntivazione"                    
                }
            }
        },
        {
            "format": {
                "dataType": "number"
            },
