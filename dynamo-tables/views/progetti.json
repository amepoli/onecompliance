{
	"$schema": "../views.schema.json",
	"entryKey": "progetti",
	"predefinedQueries": [
		{
			"type": "main",
			"operation": "insert",
			"queryString": "select entrasp.progetti_insert($codice_azienda$,$titolo$,$codice_progetto$,'€codice_attivita€');"
		}
	],
	"form_keys": [
		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO';",
				"options": [],
				"viewType": "combobox",
				"dataType": "text",
				"value": "A"
			},
			"label": "Stato",
			"key": "stato",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT codice_attivita AS id, descrizione AS name  FROM entrasp.attivita  WHERE codice_azienda=$codice_azienda$ and codice_attivita_parent is null;",
				"options": [],
				"viewType": "combobox",
				"dataType": "text"
			},
			"label": "Modello di Progetto",
			"key": "codice_attivita",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "number",
				"value": "0"
			},
			"label": "id_tipo_progetto",
			"key": "id_tipo_progetto",
			"readOnly": false,
			"isHidden": true,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": true,
			"format": {
				"viewType": "input",
				"dataType": "number"
			},
			"label": "Id Progetto",
			"key": "id_progetto",
			"readOnly": true,
			"isHidden": false,
			"isPrimary": true,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Codice Progetto",
			"key": "codice_progetto",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": false
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Codice Part",
			"key": "codice_part",
			"readOnly": false,
			"isHidden": true,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text"
			},
			"label": "Azienda",
			"key": "codice_azienda",
			"readOnly": false,
			"isHidden": true,
			"isPrimary": true,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "text",
				"validations": [
					{
					  "message": "Necessario specificare un titolo del progetto",
					  "name": "required",
					  "validator": "Validators.required"
					}
				]		  
			},
			"label": "Titolo",
			"key": "titolo",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"comboQuery": "SELECT an.id_anagrafica AS id, concat(codice, ' - ', nome, ' ', cognome) as name from entrasp.anagrafiche_id an join  entrasp.ruoli_anagrafiche  ra on an.codice_part=ra.codice_part and an.id_anagrafica=ra.id_anagrafica  WHERE  ra.codice_ruolo='CLI' and an.codice_part=$codice_part$;",
				"options": [],
				"viewType": "combobox"
			},
			"label": "Id Cliente",
			"key": "id_cliente",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		},
		{
			"autoGenerate": false,
			"format": {
				"viewType": "input",
				"dataType": "date",
				"value": "£CURRENT_DATE£"
			},
			"label": "Data Inserimento",
			"key": "data_inserimento",
			"readOnly": false,
			"isHidden": false,
			"isPrimary": false,
			"newLine": true
		}
	],
	"origin": "entrasp.progetti",
	"search_keys": [
		{
			"label": "Stato",
			"format": {
				"dataType": "text",
				"viewType": "input"
			},
			"fieldName": "stato",
			"newLine": true,
			"queryCond": "stato=$stato$"
		},
		{
			"label": "Id Progetto",
			"format": {
				"dataType": "number",
				"viewType": "input"
			},
			"fieldName": "id_progetto",
			"newLine": true,
			"queryCond": "id_progetto=$id_progetto$"
		},
		{
			"label": "Id Cliente",
			"format": {
				"dataType": "number",
				"viewType": "input"
			},
			"fieldName": "id_cliente",
			"newLine": true,
			"queryCond": "id_cliente=$id_cliente$"
		}
	],
	"subTables": [
		{
			"entryKey": "consuntivazioni_sub",
			"keys": [
				{
					"parent": "codice_azienda",
					"son": "codice_azienda"
				},
				{
					"parent": "id_progetto",
					"son": "id_progetto"
				}
			],
			"label": "Consuntivazioni"
		},
		{
			"entryKey": "progetti_fasi",
			"type": "tableForm",
			"keys": [
				{
					"parent": "codice_azienda",
					"son": "codice_azienda"
				},
				{
					"parent": "id_progetto",
					"son": "id_progetto"
				}
			],
			"label": "Fasi del Progetto"
		}
	],
	"table_keys": [
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "stato",
			"queryFunct": "entrasp.transcodifiche_transcodifica('STATO', stato)",
			"label": "Stato"
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "id_tipo_progetto",
			"label": "id_tipo_progetto"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "codice_attivita",
			"label": "Codice Attività"
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": false,
			"isPrimary": true,
			"key": "id_progetto",
			"label": "Id Progetto"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": true,
			"key": "codice_azienda",
			"label": "codice_azienda"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "codice_part",
			"label": "codice_part"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "titolo",
			"label": "Titolo"
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "id_cliente",
			"label": "Id Cliente"
		}
	]
}