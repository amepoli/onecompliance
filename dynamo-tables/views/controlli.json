{
  "$schema": "../views.schema.json",
  "origin": "entrasp.controlli",
  "businessObjectName": "controlli",
  "entryKey": "controlli",
  "restrictions": {
    "preventNavigationToForm": true
  },
  "table_keys": [
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": true,
      "isPrimary": true,
      "key": "codice_azienda",
      "label": "codice_azienda"
    },
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "secondo_strato_controllo",
      "label": "2° Strato",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "text"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "primo_strato_controllo",
      "label": "1° Strato",
      "width": "25%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_controlli_effettuati_1",
      "label": "Controlli 1^ livello",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_controlli_effettuati_2",
      "label": "Controlli 2^ livello",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_controlli_periodici_effettuati",
      "label": "Controlli periodici",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_controlli_per_non_def_1",
      "label": "Contr.period.indet.1Liv",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "n_controlli_per_non_def_effettuati",
      "label": "Contr.period.indet.",
      "width": "10%"
    },
    {
      "format": {
        "dataType": "number"
      },
      "isHidden": false,
      "isPrimary": false,
      "key": "risultato_medio",
      "label": "Risult.medio",
      "width": "10%"
    }
  ],
  "exportQueries": {
    "tableQueries": [
      {
        "queryString": "select c1.* from entrasp.controlli c1 inner join (select max(data_riferimento) as maxdata from entrasp.controlli where codice_azienda=$codice_azienda$) c2 on c1.data_riferimento=c2.maxdata where c1.codice_azienda=$codice_azienda$ order by primo_strato_controllo",
        "label": "Conteggio controlli complessivi"
      }
    ]
  },
  "search_keys": [
    {
      "fieldName": "id_risposta_s",
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "label": "Id Risposta",
      "newLine": false,
      "queryCond": "rp.id_risposta=$id_risposta_s$"
    },
    {
      "fieldName": "id_somministrazione",
      "format": {
        "dataType": "number",
        "viewType": "input"
      },
      "label": "Id Verifica",
      "newLine": true,
      "queryCond": "ss.id_somministrazione=$id_somministrazione$"
    },
    {
      "fieldName": "data_comp",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data Competenza",
      "newLine": false,
      "queryCond": "snd.data_comp='€data_comp€'"
    },
    {
      "fieldName": "object_description",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Oggetto di verifica",
      "newLine": false,
      "queryCond": "(UPPER (ss.object_description) like '%'||UPPER('€object_description€')||'%')"
    },
    {
      "fieldName": "incompleto_s",
      "format": {
        "viewType": "checkbox",
        "value": "0"
      },
      "label": "Incompleto",
      "newLine": false,
      "queryCond": "ss.somministrazione_completata!='Completo'"
    },
    {
      "fieldName": "no_giudizio",
      "format": {
        "viewType": "checkbox",
        "value": "0"
      },
      "label": "Senza giudizio",
      "newLine": false,
      "queryCond": "ss.giudizio is null"
    }
  ],
  "hideActions": [
    {
      "formActionType": "add",
      "viewType": "form"
    },
    {
      "formActionType": "quick-add",
      "viewType": "form"
    },
    {
      "formActionType": "startEvent",
      "viewType": "form"
    },
    {
      "formActionType": "stopEvent",
      "viewType": "form"
    },
    {
      "tableActionType": "add",
      "viewType": "table"
    },
    {
      "tableActionType": "quick-add",
      "viewType": "table"
    }
  ],
  "querySuffixes": {
    "tableViewSuffix": "limit 100"
  }
}