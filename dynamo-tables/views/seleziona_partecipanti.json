{
    "$schema": "../views.schema.json",
    "businessObjectName": "sondaggiSomministrati",
    "entryKey": "seleziona_partecipanti",
    "origin": "entrasp.sondaggi_somministrati",
    "inheritsFrom": "seleziona_campione",
    "outputEvents": [
        {
            "eventName": "onSaveSelezionaCampione",
            "eventTrigger": "onSave"
        },
        {
            "eventName": "onLoadSelezionaCampione",
            "eventTrigger": "onReload"
        }
    ],
    "addElementSettings": {
        "labelQuickAdd": "Aggiungi Partecipante",
        "navigateOnSuccess": false
    },
    "define": {
        "translate_verifica_su": "RESOURCES.participant",
        "is_hidden_incaricato": "true"
    },
    "inputEvents": [
        {
            "actionTarget": {
                "name": "lessons",
                "type": "form",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_sondaggio",
                        "destination": "id_sondaggio"
                    },
                    {
                        "source": "id_somministrazione",
                        "destination": "id_somministrazione"
                    }
                ]
            },
            "actionType": "navigate",
            "eventName": "to_comprehension_tests_from_selezione_partecipanti"
        },
        {
            "actionType": "reload",
            "eventName": "reloadSelezionaCampione"
        }
    ],
    "predefinedQueries": [
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "update entrasp.sondaggi_somministrati set somministrazione_completata=entrasp.sondaggi_somministrati_complete($codice_azienda$, £id_somministrazione£) where codice_azienda=$codice_azienda$ and id_somministrazione=£id_somministrazione£"
        },
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "select round(ss.ris_percentuale,2) as ris_percentuale, ss.giudizio, ss.punteggio_description from entrasp.sondaggi_somministrati ss where codice_azienda=$codice_azienda$ and id_somministrazione=£id_somministrazione£;"
        },
        {
            "operation": "isInsert",
            "queryString": "select $id_somministrazione$ is null as label;",
            "type": "main"
        },
        {
            "operation": "insert",
            "type": "main",
            "queryString": "select entrasp.campione_insert($codice_azienda$, $id_sondaggio$, $object_key$, $id_anagrafica$) as id_somministrazione;"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "update entrasp.sondaggi_somministrati set id_anagrafica=split_part(object_key, '|', 2)::numeric where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.sondaggi_somministrati set id_anagrafica=split_part(object_key, '|', 2)::numeric where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        }
    ],
    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menumdt",
            "label": "Actions",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "cancella_campione",
                    "icon": "delete",
                    "label": "Elimina partecipante",
                    "query": "select entrasp.sondaggio_somministrato_delete(s.codiceazienda::varchar, s.idsomministrazione::integer) from (SELECT split_part(arr,'~',1) AS codiceazienda,split_part(arr,'~',2) AS idsomministrazione FROM unnest(ARRAY[$selected_rows_data$]) arr) AS s;",
                    "confirmAction": true,
                    "reloadOnSuccess": true,
                    "confirmActionMessage": "Eliminare i campioni selezionati?"
                }
            ]
        }
    ],
    "hideActions": [
        {
            "tableActionType": "add",
            "viewType": "table"
        },
        {
            "formActionType": "attachments",
            "viewType": "form"
        }
    ]
}
