                            "actionType": "query",
                            "queryFunct": "select £id_riunione£ as id_riunione"
                        },
                        "actionOnYes": {
                            "actionType": "query",
                            "queryFunct": "select entrasp.riunioni_duplica($codice_azienda$::varchar, $id_riunione$::numeric)as id_riunione;"
                        }
                    },
                    "outputEventWhenComplete": "navigate_to_riunione_new"
