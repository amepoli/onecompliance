      "operation": "selectTable",
      "queryString": "select true as delete_domanda, codice_azienda, id_domanda, ordinamento, id_argomento, id_sezione, id_modello_test, id_modello_test_vr, case when length(descrizione) > 125 THEN left(descrizione,125)||' ...' ELSE descrizione END as descrizione, flag_non_applicabile_domanda, note, case when length(entrasp.risposte_previste_mostra1(codice_azienda, id_modello_test, id_modello_test_vr, id_domanda)) > 60 then left(entrasp.risposte_previste_mostra1(codice_azienda, id_modello_test, id_modello_test_vr, id_domanda),60)||' ...' else entrasp.risposte_previste_mostra1(codice_azienda, id_modello_test, id_modello_test_vr, id_domanda) end as modelli_test_risposte_possibili from entrasp.domande where codice_azienda=$codice_azienda$ and id_modello_test=$id_modello_test$ and id_modello_test_vr=$id_modello_test_vr$",
      "type": "main"
    },
    {
      "operation": "insert",
      "queryString": "SELECT entrasp.domande_order_and_settle($codice_azienda$, $id_modello_test$, $id_modello_test_vr$, £id_domanda£, $ordinamento$, $id_sezione$, $id_template_rp$)",
      "type": "postProcessing"
    },
    {
      "operation": "update",
      "queryString": "SELECT entrasp.domande_order_and_settle($codice_azienda$, $id_modello_test$, $id_modello_test_vr$, $id_domanda$, $ordinamento$, $id_sezione$, $id_template_rp$)",
      "type": "postProcessing"
    },
    {
      "operation": "update",
      "queryString": "update entrasp.risposte rp set punteggio = dm.punteggio from entrasp.domande dm where rp.codice_azienda= dm.codice_azienda and rp.id_domanda = dm.id_domanda and rp.id_modello_test = dm.id_modello_test and rp.id_modello_test_vr = dm.id_modello_test_vr and rp.punteggio!=dm.punteggio and rp.codice_azienda = $codice_azienda$ and rp.id_modello_test =$id_modello_test$ and rp.id_domanda =$id_domanda$ and rp.id_modello_test_vr = $id_modello_test_vr$;",
      "type": "postProcessing"
    }
  ],
