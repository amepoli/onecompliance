  "predefinedQueries": [
    {
      "operation": "selectForm",
      "queryString": "select entrasp.inizializza_sondaggi_somministrati_risultati_sezioni($codice_azienda$, $id_sondaggio$, $id_somministrazione$)",
      "type": "preProcessing"
    },
    {
      "operation": "selectTable",
      "queryString": "update entrasp.sondaggi_somministrati ss set data_esecuzione=coalesce(ss.data_esecuzione, snd.data_esecuzione) from entrasp.sondaggi snd, entrasp.aziende az where ss.codice_part=az.codice_part and ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio and ss.codice_azienda=$codice_azienda$ and (ss.codice_part is null or ss.data_esecuzione is null) and ss.stato='C';",
      "type": "preProcessing"
    },
    {
      "operation": "selectForm",
      "type": "postProcessing",
      "queryString": "SELECT mdt.flag_sezioni,  mdt.titolo as titolo_modello_test, snd.id_sondaggio_parent, mdt.flag_applicazione_singola, snd.titolo, snd.id_modello_test, snd.id_modello_test_vr, snd.data_prevista, snd.data_comp from entrasp.sondaggi snd join entrasp.modelli_test mdt on mdt.codice_azienda=snd.codice_azienda and mdt.id_modello_test=snd.id_modello_test join entrasp.modelli_test_vr mvr on mvr.codice_azienda=snd.codice_azienda and mvr.id_modello_test=snd.id_modello_test and mvr.id_modello_test_vr=snd.id_modello_test_vr WHERE snd.codice_azienda=$codice_azienda$ AND id_sondaggio=$id_sondaggio$"
    },
    {
      "operation": "selectForm",
      "type": "postProcessing",
      "queryString": "SELECT mdt.flag_sezioni,  mdt.titolo as titolo_modello_test, mdt.flag_applicazione_singola, snd.titolo, snd.id_modello_test, snd.id_modello_test_vr, snd.data_prevista, snd.data_comp from entrasp.sondaggi snd join entrasp.modelli_test mdt on mdt.codice_azienda=snd.codice_azienda and mdt.id_modello_test=snd.id_modello_test join entrasp.modelli_test_vr mvr on mvr.codice_azienda=snd.codice_azienda and mvr.id_modello_test=snd.id_modello_test and mvr.id_modello_test_vr=snd.id_modello_test_vr WHERE snd.codice_azienda=$codice_azienda$ AND id_sondaggio=$id_sondaggio$"
    },
    {
      "operation": "delete",
      "type": "main",
      "queryString": "select entrasp.somministrazione_delete($codice_azienda$, $id_somministrazione$)"
    },
    {
      "operation": "selectTable",
      "type": "main",
      "queryString": "select entrasp.id_progetto_from_sondaggio(ss.codice_azienda, ss.id_sondaggio) as id_progetto,ss.id_anagrafica, entrasp.anagrafiche_id_codcognnome(ss.codice_part, ss.id_anagrafica) as incaricato_risposta, ss.id_anagrafica, ss.codice_azienda, ss.id_somministrazione, ss.somministrazione_completata, ss.object_description, ss.object_key, ss.stato, ss.id_sondaggio, snd.id_centro_gest, snd.codice_part, snd.data_comp, snd.data_esecuzione, snd.data_prevista, entrasp.field_value_from_key(ss.object_key, ss.object_name, 'id_anagrafica','|')::numeric as id_anagrafica, entrasp.sondaggio_riprogrammato(ss.codice_azienda, ss.id_sondaggio), entrasp.id_somministrazione_precedente(ss.codice_azienda, ss.id_sondaggio, ss.id_somministrazione), entrasp.modelli_test_risultati_righe_descr(mtvr.id_risultato, ss.pct_da_manuale, ss.codice_azienda) as giudizio_manuale, entrasp.modelli_test_risultati_righe_descr(mtvr.id_risultato, ss.pct_da, ss.codice_azienda) as giudizio, substring(entrasp.sondaggio_titolo(ss.codice_azienda,ss.id_sondaggio),1,120) as titolo_sondaggio, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', ss.stato) as stato, snd.id_modello_test, case when snd.data_prevista<now() and ss.stato!='C' then 'Scaduto' else 'Non scaduto' end as scaduto from entrasp.sondaggi_somministrati ss inner join entrasp.sondaggi snd on ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio inner join entrasp.modelli_test_vr mtvr on snd.codice_azienda=mtvr.codice_azienda and snd.id_modello_test=mtvr.id_modello_test and snd.id_modello_test_vr=mtvr.id_modello_test_vr inner join entrasp.modelli_test_vr mt on snd.codice_azienda=mt.codice_azienda and snd.id_modello_test=mt.id_modello_test where ((ss.codice_azienda=$codice_azienda$ and (snd.data_prevista<=CURRENT_DATE or ss.data_esecuzione is not null)) or (ss.codice_azienda=$codice_azienda$ and snd.data_prevista is null and ss.data_esecuzione is null)) and ( snd.id_centro_gest in (select id_centro_gest from entrasp.centri_gestionali where id_gruppo_lavoro in(select id_gruppo_lavoro from entrasp.gruppi_lavoro_membri where id_anagrafica=€global_userid€ and codice_part='€global_codice_part€') and codice_part='€global_codice_part€') or snd.id_anagrafica_assegnataria=€global_userid€ or ss.id_anagrafica=€global_userid€ )"
    },
    {
      "operation": "startEvent",
      "type": "main",
      "queryString": "select entrasp.business_object_play((€global_id_anagrafiche€)::text, 'sondaggi', $id_sondaggio$, '$codice_azienda$'::varchar) as play_time_report"
    },
    {
      "operation": "stopEvent",
      "type": "main",
      "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text)"
    }
  ],
