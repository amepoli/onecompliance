ntro_gest in (select id_centro_gest from entrasp.centri_gestionali where id_gruppo_lavoro in(select id_gruppo_lavoro from entrasp.gruppi_lavoro_membri where id_anagrafica=€global_userid€ and codice_part='€global_codice_part€') and codice_part='€global_codice_part€') or snd.id_anagrafica_assegnataria=€global_userid€ or ss.id_anagrafica=€global_userid€ )"
        },
