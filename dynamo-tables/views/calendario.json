{
    "$schema": "../views.schema.json",
    "entryKey": "calendario",
    "origin": "entrasp.eventi",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "SELECT 'Sondaggio' AS object_name, id_sondaggio AS object_id, titolo as object_description, codice_azienda, data_comp as data_rif,coalesce(data_scadenza,data_prevista) AS data_scadenza FROM entrasp.sondaggi WHERE codice_azienda = $codice_azienda$ LIMIT 100 UNION SELECT 'Verifica' AS object_name, ss.id_somministrazione AS object_id, snd.titolo||' - '||coalesce(ss.object_description,'') as object_description, ss.codice_azienda, snd.data_comp as data_rif,coalesce(snd.data_scadenza,snd.data_prevista) AS data_scadenza FROM entrasp.sondaggi_somministrati ss INNER JOIN entrasp.sondaggi snd ON snd.id_sondaggio=ss.id_sondaggio AND snd.codice_azienda=ss.codice_azienda WHERE snd.codice_azienda = $codice_azienda$ LIMIT 100",
            "type": "main"
        }
    ],
    "table_multiselection_actions": [
        {
            "viewType": "menu",
            "key": "menuEventi",
            "label": "Azioni",
            "icon": "more_vert",
            "menuOptions": [
                {
                    "key": "delete_eventi",
                    "icon": "delete",
                    "label": "Elimina",
                    "confirmAction": true,
                    "confirmActionMessage": "Eliminare definitivamente gli eventi selezionati e i relativi sondaggi?",
                    "query": "select entrasp.cancella_evento(codice_azienda,id_evento) from entrasp.eventi where codice_azienda||'-'||id_evento in ($selected_rows_data$)",
                    "reloadOnSuccess": true
                },
                {
                    "key": "close_eventi",
                    "icon": "check",
                    "label": "Contrassegna come eseguiti",
                    "confirmAction": true,
                    "confirmActionMessage": "Contrassegnare come eseguiti gli eventi selezionati?",
                    "query": "select entrasp.chiudi_evento(codice_azienda,id_evento) from entrasp.eventi where codice_azienda||'-'||id_evento in ($selected_rows_data$);",
                    "reloadOnSuccess": true
                }
            ]
        }
    ],
