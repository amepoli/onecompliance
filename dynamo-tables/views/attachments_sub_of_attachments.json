{
  "$schema": "../views.schema.json",
  "entryKey": "attachments_sub_of_attachments",
  "inheritsFrom": "attachments",
  "predefinedQueries": [
    {
      "type": "main",
      "operation": "selectTable",
      "queryString": "select *, entrasp.argomenti_descr_stato(rev_id_argomento_stato) as descr_stato, entrasp.odg_data(codice_azienda, id_odg, id_riunione) as data_riunione, entrasp.riunioni_descr(id_riunione, codice_azienda) as riunione_descr, entrasp.odg_titolo(codice_azienda, id_odg, id_riunione) as titolo from entrasp.views_attachments_fast_no_bo af where codice_azienda=$codice_azienda$ and (id_risorsa=$id_risorsa$ or id_risorsa= (select id_risorsa from entrasp.cdms_risorse_oggetti ro where ro.nome_business_object='cdms_risorse' and ro.codice_azienda=$codice_azienda$ and replace(ro.chiave, ro.codice_azienda||'^', '')::numeric=$id_risorsa$ limit 1))"
    },
    {
      "type": "main",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set id_riunione=$id_riunione$, id_odg=$id_odg$ where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    }
  ],
