{
    "$schema": "../views.schema.json",
    "businessObjectName": "odg_riunioni",
    "origin": "entrasp.odg_riunioni",
    "entryKey": "odg_riunioni",
    "label": "Ordini del giorno",
    "addElementSettings": {
        "labelQuickAdd": "Nuovo Punto",
        "navigateOnSuccess": false
    },
    "define": {
        "is_hidden_id_riunione": "false"
    },
    "form_keys": [
        {
            "autoGenerate": false,
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "codice_azienda",
            "label": "Codice Azienda",
            "newLine": false,
            "readOnly": false,
            "translate": "RESOURCES.codice_azienda_odg_riunioni"
        },
        {
            "autoGenerate": true,
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "isHidden": false,
            "isPrimary": true,
            "key": "id_odg",
            "label": "ID OdG",
            "newLine": false,
            "readOnly": true,
            "size": 1,
            "translate": "RESOURCES.id_odg_odg_riunioni"
        },
        {
            "autoGenerate": false,
            "format": {
                "dataType": "number",
                "options": [],
                "viewType": "combobox",
                "comboQuery": "select id_riunione as id, id_riunione||'-'||oggetto as name from entrasp.riunioni where codice_azienda = $codice_azienda$"
            },
            "isHidden": "$Q{is_hidden_id_riunione}",
            "isPrimary": true,
            "key": "id_riunione",
            "label": "Riunione",
            "newLine": false,
            "readOnly": false,
            "size": 3,
            "translate": "RESOURCES.riunione_odg_riunioni"
        },
        {
            "autoGenerate": false,
            "format": {
                "viewType": "combobox",
                "options": [],
                "comboQuery": "SELECT id_argomento AS id, id_argomento||'-'||descrizione AS name  FROM entrasp.argomenti arg inner join entrasp.argomenti_argomenti aa on arg.id_argomento=aa.id_argomento_son and aa.id_argomento_father=3405 order by descrizione"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "id_argomento",
            "label": "Tipo Odg",
            "newLine": false,
            "readOnly": false,
            "size": 3,
            "translate": "RESOURCES.tipo_odg_odg_riunioni"
        },
        {
            "autoGenerate": false,
            "format": {
                "dataType": "number",
                "viewType": "input",
                "validations": [
                    {
                        "message": "Inserire una numerazione!",
                        "name": "required",
                        "validator": "Validators.required",
                        "translate": "RESOURCES.inserire_una_numerazione_odg_riunioni"
                    }
                ]
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "ordinamento_odg",
            "label": "Ordinamento",
            "newLine": false,
            "readOnly": false,
            "size": 1.5,
            "translate": "RESOURCES.ordinamento_odg_riunioni"
        },
        {
            "autoGenerate": false,
            "format": {
                "dataType": "text",
                "viewType": "combobox",
                "options": [],
                "comboQuery": "select id_odg as id, titolo as name from entrasp.odg_riunioni where codice_azienda = $codice_azienda$ and id_odg!=£id_odg£"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "id_odg_parent",
            "label": "ID OdG Parent",
            "newLine": true,
            "readOnly": false,
            "size": 1,
            "translate": "RESOURCES.id_odg_parent_odg_riunioni"
        },
        {
            "autoGenerate": false,
            "format": {
                "dataType": "text",
                "viewType": "textarea",
                "validations": [
                    {
                        "message": "Breve descrizione necessaria",
                        "name": "required",
                        "validator": "Validators.required",
                        "translate": "RESOURCES.breve_descrizione_necessaria_odg_riunioni"
                    }
                ]
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "titolo",
            "label": "Punto",
            "newLine": true,
            "readOnly": false,
            "translate": "RESOURCES.punto_odg_riunioni"
        },
        {
            "autoGenerate": false,
            "format": {
                "dataType": "text",
                "viewType": "textarea"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "annotazioni",
            "label": "Note",
            "newLine": true,
            "readOnly": false,
            "size": 10,
            "translate": "RESOURCES.note_odg_riunioni"
        }
    ],
    "search_keys": [
        {
            "fieldName": "stato",
            "format": {
                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_COMPITI';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Stato",
            "newLine": true,
            "queryCond": "stato='€stato€'",
            "translate": "RESOURCES.stato_odg_riunioni"
        },
        {
            "fieldName": "note_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parole Chiavi",
            "newLine": false,
            "queryCond": "UPPER (annotazioni) like '%'||UPPER('€note_search€')||'%' or UPPER (titolo) like '%'||UPPER('€note_search€')||'%'",
            "translate": "RESOURCES.parole_chiavi_odg_riunioni"
        },
        {
            "fieldName": "id_tipo_segnalazione_s",
            "format": {
                "comboQuery": "select id_tipo_segnalazione as id, descrizione as name from entrasp.tipi_segnalazioni where id_tipo_segnalazione!=0 order by descrizione;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "ID Tipo Segnal.",
            "newLine": false,
            "queryCond": "id_tipo_segnalazione=$id_tipo_segnalazione_s$",
            "translate": "RESOURCES.id_tipo_segnal_odg_riunioni"
        },
        {
            "fieldName": "no_subject",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Non classificati",
            "newLine": false,
            "size": 1,
            "queryCond": "id_argomento is null",
            "translate": "RESOURCES.non_classificati_odg_riunioni"
        }
    ],
    "subTables": [
        {
            "entryKey": "attachments_sub_of_riunioni",
            "isHidden": false,
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                },
                {
                    "parent": "id_riunione",
                    "son": "id_riunione"
                },
                {
                    "parent": "id_odg",
                    "son": "id_odg"
                }
            ],
            "label": "Documenti Allegati",
            "translate": "RESOURCES.documenti_allegati_attachments_sub_of_riunioni"
        },
        {
            "entryKey": "odg_associated_at_odg",
            "isHidden": false,
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                },
                {
                    "parent": "id_argomento",
                    "son": "id_argomento"
                }
            ],
            "label": "Trattazioni del Medesimo Argomento",
            "translate": "RESOURCES.trattazioni_del_medesimo_argomento_odg_associated_at_odg"
        },
        {
            "entryKey": "odg_sub_of_odg",
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                },
                {
                    "parent": "id_riunione",
                    "son": "id_riunione"
                },
                {
                    "parent": "id_odg",
                    "son": "id_odg_parent"
                }
            ],
            "label": "Sotto Ordini",
            "translate": "RESOURCES.sotto_ordini_odg_sub_of_odg"
        },
        {
            "entryKey": "consuntivazioni_sub_of_riunioni",
            "keys": [
                {
                    "parent": "codice_azienda",
                    "son": "codice_azienda"
                },
                {
                    "parent": "id_riunione",
                    "son": "id_riunione"
                },
                {
                    "parent": "id_odg",
                    "son": "id_odg"
                }
            ],
            "label": "Aggiornamenti(mail, tr)",
            "translate": "RESOURCES.aggiornamentimail_tr_consuntivazioni_sub_of_riunioni"
        }
    ],
    "table_keys": [
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "width": "4%",
            "queryFunct": "select true",
            "key": "delete_procedure_aziendali",
            "label": "",
            "style": [
                {
                    "button_icon": "delete",
                    "value": "*"
                }
            ],
            "isButton": true,
            "buttonAction": {
                "target": "odg_riunioni",
                "viewType": "form",
                "query": "delete from entrasp.odg_riunioni where codice_azienda='£codice_azienda£' and id_riunione=£id_riunione£ and id_odg=£id_odg£",
                "action": "query",
                "keymap": [
                    {
                        "source": "codice_azienda",
                        "destination": "codice_azienda"
                    },
                    {
                        "source": "id_riunione",
                        "destination": "id_riunione"
                    },
                    {
                        "source": "id_odg",
                        "destination": "id_odg"
                    }
                ],
                "confirmAction": true,
                "confirmMessage": {
                    "text": "Sei sicuro di voler cancellare il punto all'ordine del giorno?",
                    "title": "Cancellazione ordine del giorno"
                },
                "onSuccessAction": "reload"
            },
            "translate": "RESOURCES.void"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "id_odg",
            "width": "5%",
            "label": "ID OdG",
            "translate": "RESOURCES.id_odg_odg_riunioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_odg_parent",
            "width": "5%",
            "label": "ID OdG",
            "translate": "RESOURCES.id_odg_odg_riunioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": false,
            "key": "id_argomento",
            "label": "Argomento",
            "translate": "RESOURCES.argomento_odg_riunioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "id_riunione",
            "label": "ID riunione",
            "translate": "RESOURCES.id_riunione_odg_riunioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": true,
            "isPrimary": true,
            "key": "codice_azienda",
            "label": "Codice Azienda",
            "translate": "RESOURCES.codice_azienda_odg_riunioni"
        },
        {
            "format": {
                "dataType": "date"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "data_riunione",
            "queryFunct": "entrasp.odg_data(codice_azienda, id_odg, id_riunione)",
            "label": "Data riunione",
            "width": "7%",
            "translate": "RESOURCES.data_riunione_odg_riunioni"
        },
        {
            "format": {
                "dataType": "number"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "ordinamento_odg",
            "width": "4%",
            "label": "Ord.",
            "translate": "RESOURCES.ord_odg_riunioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "titolo",
            "width": "30%",
            "label": "Titolo",
            "translate": "RESOURCES.titolo_odg_riunioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "riunione_descr",
            "queryFunct": "entrasp.riunioni_descr(id_riunione, codice_azienda)",
            "label": "Riunione",
            "width": "15%",
            "translate": "RESOURCES.riunione_odg_riunioni"
        },
        {
            "format": {
                "dataType": "text"
            },
            "isHidden": false,
            "isPrimary": false,
            "key": "annotazioni",
            "label": "Note",
            "width": "45%",
            "translate": "RESOURCES.note_odg_riunioni"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by data_riunione desc,  ordinamento_odg asc"
    },
    "hideActions": [
        {
            "viewType": "form",
            "formActionType": "attachments"
        },
        {
            "viewType": "table",
            "tableActionType": "add"
        }
    ],
    "translate": "RESOURCES.ordini_del_giorno_odg_riunioni"
}