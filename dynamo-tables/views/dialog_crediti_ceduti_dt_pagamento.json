tteso$, cc2.id_argomento_inatteso), note_inatteso = coalesce($note_inatteso$, cc2.note_inatteso), id_avvocato = case  when coalesce($id_avvocato_checkbox$::boolean,false)  then null else coalesce($id_avvocato$, cc2.id_avvocato) end, data_inatteso = coalesce($data_inatteso$::date, cc2.data_inatteso), autorita_giudiziaria = case  when coalesce($autorita_giudiziaria_checkbox$::boolean,false)  then null else coalesce($autorita_giudiziaria$, cc2.autorita_giudiziaria) end, fascicolo = case  when coalesce($fascicolo_checkbox$::boolean,false)  then null else coalesce($fascicolo$, cc2.fascicolo) end, n_mandato = case  when coalesce($n_mandato_checkbox$::boolean,false)  then null else coalesce($n_mandato$, cc2.n_mandato) end, data_mandato = case  when coalesce($data_mandato_checkbox$::boolean,false)  then null else coalesce($data_mandato$::date, cc2.data_mandato) end, note = coalesce($note$, cc2.note) from entrasp.crediti_ceduti cc2 where cc1.codice_azienda = cc2.codice_azienda and cc1.id_cessione = cc2.id_cessione and cc1.id_cessione in (select split_part(arr,'~',2)::numeric from unnest(ARRAY[$selected_rows_data$]) as arr) and cc1.codice_azienda='€global_codice_azienda€';"
