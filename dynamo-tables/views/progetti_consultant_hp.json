	"businessObjectName": "progetti",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select * from entrasp.sondaggi limit 100",
            "type": "main"
        }
    ],
	"toolbar_elements": [
        {
            "fieldName": "stato",
            "viewType": "combobox",
            "position": "left",
            "label": "Status",
            "options": [],
            "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
            "queryCond": "stato = '$stato$'"
        },
        {
            "fieldName": "flag_progetti_aperti",
            "viewType": "toggle",
            "position": "right",
            "label": "Progetti aperti",
            "toggleOffLabel": "Tutti Progetti",            
            "queryCond": "stato not in ('C', 'N')"
        }
    ],
    "tiles": [
        {
            "title": "Progetti chiusi",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(id_progetto) from entrasp.progetti WHERE stato!='C'",
                "queryCond": "",
                "fieldName": "progetti_aperti",
                "value_color": "green",
				"title_color": "green",
				"background_color": "lightblue"		
            },
			"new_line": false
        },
		{
            "title": "Progetti aperti",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(id_progetto) as progetti_chiusi from entrasp.progetti WHERE stato='C'",
                "queryCond": "",
                "fieldName": "progetti_chiusi",
                "value_color": "red",
				"title_color": "red",
				"background_color": "white"		
            },
			"new_line": true
