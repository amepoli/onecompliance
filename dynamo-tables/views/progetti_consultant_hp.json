{
	"$schema": "../views.schema.json",
	"origin": "entrasp.progetti",
	"entryKey": "progetti_consultant_hp",
	"inheritsFrom": "progetti_consultant",
	"businessObjectName": "progetti",
	"toolbar_elements": [
        {
            "fieldName": "stato",
            "viewType": "combobox",
            "position": "left",
            "label": "Status",
            "options": [],
            "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
            "queryCond": "stato = '$stato$'"
        },
        {
            "fieldName": "flag_progetti_aperti",
            "viewType": "toggle",
            "position": "right",
            "label": "Progetti aperti",
            "toggleOffLabel": "Tutti Progetti",            
            "queryCond": "stato not in ('C', 'N')"
        }
    ],
    "tiles": [
        {
            "title": "Progetti chiusi",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(id_progetto) from entrasp.progetti WHERE codice_azienda='€global_codice_azienda€' and stato='C'",
                "queryCond": "",
                "fieldName": "id_argomento",
                "value_color": "green",
				"title_color": "green",
				"background_color": "lightblue"		
            },
			"new_line": true
        },
        {
            "title": "Temperature",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select 15",
                "fieldName": "temp",
                "value_color": "crimson",
				"title_color": "black",
				"background_color": "lightblue"	
            }
        }
    ]
}