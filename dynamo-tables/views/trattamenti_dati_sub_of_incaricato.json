{
  "$schema": "../views.schema.json",
  "entryKey": "trattamenti_dati_sub_of_incaricato",
  "origin": "entrasp.cpl_trattamenti_dati",
  "predefinedQueries": [
    {
      "queryString": "SELECT g.id_anagrafica,t.codice_part,t.id_trattamento_dati,t.codice,t.titolo,t.descrizione,t.id_argomento_tipo_trattamento_dato,t.codice_azienda,t.flag_trattamento_conto_terzi,entrasp.argomenti_descr_breve(t.id_argomento_tipo_trattamento_dato) as id_argomento_tipo_trattamento_dato,entrasp.centri_gestionali_descr('MOBISEC',t.id_centro_gest) as centro_gest FROM entrasp.cpl_trattamenti_dati t INNER JOIN entrasp.cpl_trattamenti_centri_gestionali c ON t.id_trattamento_dati=c.id_trattamento_dati AND t.codice_azienda=c.codice_azienda INNER JOIN entrasp.gruppi_lavoro_membri g ON c.id_centro_gest=g.id_gruppo_lavoro AND c.codice_part=g.codice_part where t.codice_part=$codice_azienda$ AND g.id_anagrafica=$id_anagrafica$",
      "operation": "selectTable",
      "type": "main"
    }
  ],
