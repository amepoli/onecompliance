{
  "$schema": "../views.schema.json",
  "inheritsFrom": "sondaggi_somministrati",
  "entryKey": "verifiche_asset",
  "dashboardTables": [
    "dashboard_sondaggi"
  ],
  "predefinedQueries": [
    {
      "operation": "selectTable",
      "type": "main",
      "queryString": "select case when snd.data_prevista<now() and ss.stato!='C' then 'Si' else 'No' end as scaduto, cnt.numero_contratto, ss.codice_azienda, ss.id_somministrazione, ss.somministrazione_completata, ss.object_description, ss.object_key, ss.stato, ss.id_sondaggio, snd.data_comp, ss.data_esecuzione, snd.data_prevista, split_part(ss.object_key, '|', 2) as id_anagrafica, entrasp.modelli_test_risultati_righe_descr(mtvr.id_risultato, ss.pct_da_manuale, ss.codice_azienda) as giudizio_manuale, entrasp.modelli_test_risultati_righe_descr(mtvr.id_risultato, ss.pct_da, ss.codice_azienda) as giudizio, entrasp.sondaggio_titolo(ss.codice_azienda,ss.id_sondaggio) as titolo_sondaggio, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', ss.stato) as stato, snd.id_modello_test, (SELECT ss.data_esecuzione + (interval ' 1 days' * giorni_rischedulazione) FROM entrasp.modelli_test_risultati_righe WHERE codice_azienda=ss.codice_azienda AND pct_da = ss.pct_da AND id_risultato=mtvr.id_risultato) as data_scadenza from entrasp.sondaggi_somministrati ss inner join entrasp.sondaggi snd on ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio inner join entrasp.modelli_test_vr mtvr on snd.codice_azienda=mtvr.codice_azienda and snd.id_modello_test=mtvr.id_modello_test and snd.id_modello_test_vr=mtvr.id_modello_test_vr inner join entrasp.modelli_test mt on snd.codice_azienda = mt.codice_azienda and snd.id_modello_test = mt.id_modello_test left join entrasp.contratti cnt on snd.codice_azienda=cnt.codice_azienda and snd.id_contratto=cnt.id_contratto where ss.codice_azienda=$codice_azienda$ and ((ss.codice_azienda=$codice_azienda$ and mt.id_tipo_modello_test = 59 and (snd.data_prevista<=CURRENT_DATE+ INTERVAL '100 days' or ss.data_esecuzione is not null)) or (ss.codice_azienda=$codice_azienda$ and mt.id_tipo_modello_test = 59 and snd.data_prevista is null and ss.data_esecuzione is null))"
    },
    {
      "operation": "selectForm",
      "queryString": "select entrasp.inizializza_sondaggi_somministrati_risultati_sezioni($codice_azienda$, $id_sondaggio$, $id_somministrazione$)",
      "type": "preProcessing"
    },
    {
      "operation": "selectForm",
      "type": "postProcessing",
      "queryString": "SELECT mvr.flag_sezioni,  mdt.titolo as titolo_modello_test, mdt.flag_applicazione_singola, snd.titolo, snd.id_modello_test, snd.id_modello_test_vr, snd.data_prevista, snd.id_anagrafica_assegnataria, snd.data_comp from entrasp.sondaggi snd join entrasp.modelli_test mdt on mdt.codice_azienda=snd.codice_azienda and mdt.id_modello_test=snd.id_modello_test join entrasp.modelli_test_vr mvr on mvr.codice_azienda=snd.codice_azienda and mvr.id_modello_test=snd.id_modello_test and mvr.id_modello_test_vr=snd.id_modello_test_vr WHERE snd.codice_azienda=$codice_azienda$ AND id_sondaggio=$id_sondaggio$"
    },
    {
      "operation": "delete",
      "type": "main",
      "queryString": "select entrasp.somministrazione_delete($codice_azienda$, $id_somministrazione$)"
    },
    {
      "operation": "selectTable",
      "queryString": "update entrasp.sondaggi_somministrati ss set codice_part=az.codice_part, data_esecuzione=coalesce(ss.data_esecuzione, snd.data_esecuzione) from entrasp.sondaggi snd, entrasp.aziende az where ss.codice_part=az.codice_part and ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio and ss.codice_azienda=$codice_azienda$ and (ss.codice_part is null or ss.data_esecuzione is null) and ss.stato='C';",
      "type": "preProcessing"
    }
  ],
