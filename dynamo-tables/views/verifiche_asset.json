  "exportQueries": {
    "tableQueries": [
      {
        "label": "Estrazione profilazioni AML",
        "queryString": "SELECT ss.id_somministrazione, snd.id_sondaggio, ss.codice_azienda, ss.data_esecuzione, snd.id_modello_test, snd.id_modello_test_vr, ss.object_description, ss.stato, ss.somministrazione_completata, snd.descrizione, snd.data_prevista,nullif(split_part(ss.object_key,'|',2),'')::numeric as id_anagrafica_somministrazione, (select codice_fiscale from entrasp.anagrafiche_vr avr where id_anagrafica=(case when ss.object_name='anagraficheId' then nullif(split_part(ss.object_key,'|',2),'')::numeric else null::numeric end)::numeric and codice_part='€global_codice_part€' and prog_vr=entrasp.anagrafiche_vr_max('€global_codice_part€', id_anagrafica)), entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da, snd.codice_azienda) as giudizio_sondaggio, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, ss.pct_da, snd.codice_azienda) as giudizio_somministrazione, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, ss.pct_da_manuale, snd.codice_azienda) as giudizio_manuale, entrasp.is_max_modello_test(ss.codice_azienda, ss.id_sondaggio) as ultimo_sond_per_cliente_per_data, entrasp.is_max_modello_test_rett(ss.codice_azienda, ss.id_sondaggio) as ultimo_cliente_son_per_cliente_per_data_rett, (SELECT ss.data_esecuzione + (interval ' 1 days' * giorni_rischedulazione) FROM entrasp.modelli_test_risultati_righe WHERE codice_azienda=ss.codice_azienda AND pct_da = ss.pct_da AND id_risultato=mvr.id_risultato)::date as data_scadenza FROM entrasp.sondaggi_somministrati ss inner join entrasp.sondaggi snd on ss.codice_azienda=snd.codice_azienda and ss.id_sondaggio=snd.id_sondaggio inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr inner join entrasp.modelli_test mv on snd.codice_azienda=mv.codice_azienda and snd.id_modello_test=mv.id_modello_test where ss.codice_azienda=$codice_azienda$ and mv.id_tipo_modello_test=59"
      }
    ],
    "formQueries": [
      {
        "label": "Risposte punteggio diverso da 0",
        "queryString": "select ds.descrizione as sezione, dm.ordinamento as n_domanda, ri.id_sondaggio, ri.id_somministrazione, entrasp.domande_descrizione(ri.codice_azienda, dm.id_modello_test, dm.id_modello_test_vr, dm.id_domanda) as domanda, entrasp.risposte_previste_risposta(dm.codice_azienda, dm.id_modello_test, dm.id_modello_test_vr, dm.id_domanda, ri.id_risposta_prev) as risposta, ri.note, ri.peso from entrasp.risposte ri inner join entrasp.domande dm on ri.codice_azienda = dm.codice_azienda and ri.id_modello_test =dm.id_modello_test and ri.id_modello_test_vr=dm.id_modello_test_vr and ri.id_domanda=dm.id_domanda left join entrasp.domande_sezioni ds on dm.codice_azienda = ds.codice_azienda and dm.id_modello_test = ds.id_modello_test and dm.id_modello_test_vr= ds.id_modello_test_vr and dm.id_sezione = ds.id_sezione where ri.codice_azienda = $codice_azienda$ and ri.id_sondaggio = $id_sondaggio$ and ri.id_somministrazione=$id_somministrazione$ and ri.peso!= 0"
      }
    ]
  }
