      "fieldName": "id_argomento_stato_s",
      "size": 2,
      "label": "Stato",
      "newLine": true,
      "queryCond": "a.id_argomento_stato=$id_argomento_stato_s$"
    },
    {
      "fieldName": "file_con_allegati_da_associare",
      "format": {
        "viewType": "checkbox",
        "value": "0"
      },
      "label": "Con allegati da associare",
      "newLine": false,
      "queryCond": "a.id_risorsa in(select id_risorsa from entrasp.cdms_risorse_revisioni group by codice_azienda, id_risorsa, id_argomento_stato having count(prog_revisione)>0 and codice_azienda=$codice_azienda$ and id_argomento_stato=4035)"
    },
    {
      "fieldName": "data_da_s",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data da",
      "newLine": false,
      "queryCond": "data_creazione>=$data_da_s$"
    },
    {
      "fieldName": "data_a_s",
      "format": {
        "dataType": "date",
        "viewType": "input"
      },
      "label": "Data a",
      "newLine": false,
      "queryCond": "data_creazione<=$data_a_s$"
    },
    {
      "fieldName": "parola_search_s",
      "format": {
        "dataType": "text",
        "viewType": "input"
      },
      "label": "Parola chiave",
      "newLine": false,
      "queryCond": "(upper(client_file_name) like '%'||upper('€parola_search_s€')||'%')"
    },
    {
      "fieldName": "non_allegato_toggle",
      "format": {
        "value": "1",
        "viewType": "toggle"
      },
      "label": "Da allegare",
      "newLine": false,
      "queryCond": "a.id_argomento_stato in(4034)"
    }
  ]
}