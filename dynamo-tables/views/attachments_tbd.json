{
  "$schema": "../views.schema.json",
  "entryKey": "attachments_tbd",
  "inheritsFrom": "attachments",
  "businessObjectName": "uploadFile",
  "label": "Documenti richiesti",
  "define": {
    "isHiddenDownload": "true",
    "jsonFileDelFlussoInformativo": "attachments_sub_of_attachments_tbd",
