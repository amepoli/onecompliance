    },
    {
      "type": "main",
      "operation": "update",
      "queryString": "update entrasp.cdms_risorse_revisioni set data_rif=$data_rif$, data_rif_a=$data_rif_a$, data_scadenza=$data_scadenza$, id_riunione=$id_riunione$, id_odg=$id_odg$, descrizione=$rev_descrizione$, id_argomento_stato=$rev_id_argomento_stato$, commento_revisione=$commento_revisione$, client_file_name=$client_file_name$ where codice_azienda=$codice_azienda$ and id_risorsa=$id_risorsa$ and prog_revisione=$prog_revisione$;"
    },
    {
      "type": "postProcessing",
