                "queryString": "select id_centro_gest, entrasp.anagrafiche_vr_dati_identificativi(cg.codice_part, cg.id_anagrafica_societa) as Società, cg.descrizione, entrasp.anagrafiche_cognnome(glm.codice_part, glm.id_anagrafica) as nome from entrasp.centri_gestionali cg inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part where id_centro_gest>0 and cg.codice_part=$codice_part$ order by cg.descrizione, glm.id_anagrafica"
