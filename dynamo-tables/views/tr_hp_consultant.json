{
    "$schema": "../views.schema.json",
    "entryKey": "tr_hp_consultant",
    "inheritsFrom": "tr_hp_manager",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select distinct true as dettaglio, true as insert_missing_mins, true as segna_ferie, true as segna_permesso, coll.giorno::date, coll.dynamo_user, entrasp.dynamo_employer(coll.dynamo_user) as employer,  coalesce(csn.minuti_rendicontati,0) as minuti_rendicontati, entrasp.minuti_richiesti_user(coll.dynamo_user, coll.giorno::date) as minuti_richiesti, greatest(0,(entrasp.minuti_richiesti_user(coll.dynamo_user, coll.giorno::date)- coalesce(csn.minuti_rendicontati,0))) as minuti_mancanti from (SELECT date_trunc('day', gg):: date as giorno, '€global_username€' as dynamo_user FROM generate_series (current_date-400*interval '1 day', current_date, '1 day'::interval) gg, entrasp.colleghi('€global_username€') du where date_trunc('day', gg)::date>entrasp.dynamo_data_assunzione('€global_username€')) coll left join (select con.date_time_begin::date, an.dynamo_user, sum(coalesce(con.durata, 0)) as minuti_rendicontati from entrasp.consuntivazioni con inner join entrasp.anagrafiche_id an on con.id_risorsa=an.id_anagrafica and con.codice_part=an.codice_part where an.dynamo_user is not null group by con.date_time_begin::date, an.dynamo_user) csn on coll.giorno::date=csn.date_time_begin::date and coll.dynamo_user=csn.dynamo_user where coll.giorno::date<=current_date and entrasp.minuti_richiesti_user(coll.dynamo_user, coll.giorno::date) != 0 and greatest(0,(entrasp.minuti_richiesti_user(coll.dynamo_user, coll.giorno::date)- coalesce(csn.minuti_rendicontati,0))) != 0",
            "type": "main"
        },
        {
            "operation": "selectForm",
            "queryString": "select $giorno$ as giorno, to_char($giorno$::date, 'Day DD-MM-YYYY') as giorno_descr, $dynamo_user$ as dynamo_user",
            "type": "main"
        }
    ],
    "toolbar_elements": [],
    "tiles": [
        {
            "title": "Giorni incompleti",
            "content": {
                "contentType": "value",
                "value": "Scooby Doo",
                "query": "select count(gdr.giorno) from entrasp.giornate_e_users_da_rendicontare gdr left join entrasp.minuti_rendicontati_users mr on gdr.giorno=mr.data_rend and gdr.dynamo_user=mr.dynamo_user where (gdr.min_richiesti-coalesce(min_rendicontati,0))>0 and gdr.dynamo_user in(select colleghi from entrasp.colleghi('€global_username€', '€global_codice_part€')) and (gdr.min_richiesti-coalesce(min_rendicontati,0))>0",
                "queryCond": "",
                "fieldName": "conta_giorni_incompleti",
