{
	"$schema": "../views.schema.json",
	"entryKey": "contracts_investment_sub_of_clientela",
	"inheritsFrom": "contracts_investment",
	"predefinedQueries": [
		{
			"operation": "selectTable",
			"type": "main",
			"queryString": "select cnt.id_contratto, cnt.data_stipulazione, cnt.data_cessazione, entrasp.transcodifiche_transcodifica('GIUDIZIO_MIFID', entrasp.giudizio_mifid_appropriatezza(cnt.codice_azienda, cnt.id_contratto))as giudizio, cnt.codice_azienda, cnt.numero_contratto, cnt.id_cliente, entrasp.anagrafiche_vr_dati_identificativi(az.codice_part, cnt.id_cliente) as cliente, entrasp.tipi_contratto_descr(cnt.codice_azienda, cnt.id_tipo_contratto) as tipo_contratto, cnt.id_strumento_finanziario, entrasp.anagrafiche_vr_dati_identificativi(az.codice_part, cnt.id_strumento_finanziario) ,entrasp.transcodifiche_transcodifica('STATO_CONTRATTI', cnt.stato) as descr_stato from entrasp.contratti cnt inner join entrasp.aziende az on cnt.codice_azienda=az.codice_azienda where az.codice_part=$codice_part$ and cnt.id_cliente=$id_cliente$;"
		}
	],
	"table_keys": [
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": true,
			"isPrimary": true,
			"key": "id_contratto",
			"label": "ID"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": true,
			"key": "codice_azienda",
			"label": "codice_azienda"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "codice_part",
			"label": "codice_part",
			"queryFunct": "entrasp.codice_partizione(codice_azienda::text)"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "numero_contratto",
			"width": "8%",
			"label": "N. Contratto"
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "id_cliente",
			"width": "5%",
			"label": "ID"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "cliente",
			"width": "30%",
			"queryFunct": "entrasp.anagrafiche_vr_dati_identificativi(codice_part, id_cliente)",
			"label": "Cliente"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "tipo_contratto",
			"width": "30%",
			"queryFunct": "entrasp.tipi_contratto_descr(codice_azienda, id_tipo_contratto)",
			"label": "Tipo Contratto"
			
		},
		{
			"format": {
				"dataType": "date"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_stipulazione",
			"width": "6%",
			"label": "Data Stipula"
			
		},
		{
			"format": {
				"dataType": "date"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "data_cessazione",
			"width": "6%",
			"label": "Data Cessazione"
			
		},
		{
			"format": {
				"dataType": "number"
			},
			"isHidden": true,
			"isPrimary": false,
			"key": "id_strumento_finanziario",
			"label": "id_strumento_finanziario"
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": false,
			"isPrimary": false,
			"key": "descr_stato",
			"label": "Stato",
			"style": [
				{
					"value": "Cessato",
					"font_color": "green",
					"font_weight": "500"
				},
				{
					"value": "Attivo",
					"font_color": "#FF0000",
					"font_weight": "500"
				},
				{
					"value": "In Scadenza",
					"font_color": "#FFE118",
					"font_weight": "500"
				}
			],
			"sameOrigin": false,
			"width": "8%"
		},
		{
			"format": {	
				"dataType": "text"
			},
			"label": "Giudizio Appropriatezza",
			"width": "11%",
			"key": "giudizio",
			"queryFunct": "entrasp.transcodifiche_transcodifica('GIUDIZIO_MIFID', entrasp.giudizio_mifid_appropriatezza(codice_azienda, id_contratto))",
			"isHidden": false,
			"isPrimary": false
		},
		{
			"format": {
				"dataType": "text"
			},
			"isHidden": true,
			"isPrimary": false,
			"sameOrigin": false,
			"key": "anagrafiche_key",
			"label": "anagrafiche_key"
		}	
	]
}