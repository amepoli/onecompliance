{
    "$schema": "../views.schema.json",
    "entryKey": "domande_sub_of_compiti",
    "inheritsFrom": "domande",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "queryString": "select true as delete_domanda, d.punteggio, crb.codice_compito, true as disassocia_segnalazione, d.codice_azienda, d.id_domanda, d.ordinamento, d.id_argomento, d.id_sezione, d.id_modello_test, d.id_modello_test_vr, d.descrizione, d.flag_non_applicabile_domanda, d.note, entrasp.risposte_previste_mostra1(d.codice_azienda, d.id_modello_test, d.id_modello_test_vr, d.id_domanda) as modelli_test_risposte_possibili,rp.risposta,r.note as note_risposta, (select ordinamento from entrasp.domande_sezioni where codice_azienda=$codice_azienda$ and id_sezione=d.id_sezione and id_modello_test=d.id_modello_test and id_modello_test_vr=d.id_modello_test_vr) as ordinamento_sezione from entrasp.domande d inner join entrasp.compiti_rif_bo crb on d.codice_azienda=crb.codice_azienda and d.id_domanda=crb.id_domanda and d.id_modello_test=crb.id_modello_test and d.id_modello_test_vr=crb.id_modello_test_vr inner join entrasp.risposte r on r.id_domanda=d.id_domanda and r.codice_azienda=d.codice_azienda and r.id_modello_test=d.id_modello_test and r.id_modello_test_vr=d.id_modello_test_vr and r.id_sondaggio=crb.id_sondaggio and r.id_somministrazione=crb.id_somministrazione inner join entrasp.risposte_previste rp on r.codice_azienda=rp.codice_azienda and r.id_modello_test=rp.id_modello_test and r.id_modello_test_vr=rp.id_modello_test_vr and r.id_risposta_prev=rp.id_risposta_prev where d.codice_azienda=$codice_azienda$ and crb.codice_compito=$codice_compito$",
            "type": "main"
        },
        {
            "operation": "insert",
            "queryString": "SELECT entrasp.domande_order_and_settle($codice_azienda$, $id_modello_test$, $id_modello_test_vr$, £id_domanda£, $ordinamento$, $id_sezione$, $id_template_rp$)",
            "type": "postProcessing"
        },
        {
            "operation": "update",
            "queryString": "SELECT entrasp.domande_order_and_settle($codice_azienda$, $id_modello_test$, $id_modello_test_vr$, $id_domanda$, $ordinamento$, $id_sezione$, $id_template_rp$)",
            "type": "postProcessing"
        },
        {
            "operation": "update",
            "queryString": "update entrasp.risposte rp set punteggio = dm.punteggio from entrasp.domande dm where rp.codice_azienda= dm.codice_azienda and rp.id_domanda = dm.id_domanda and rp.id_modello_test = dm.id_modello_test and rp.id_modello_test_vr = dm.id_modello_test_vr and rp.punteggio!=dm.punteggio and rp.codice_azienda = $codice_azienda$ and rp.id_modello_test =$id_modello_test$ and rp.id_domanda =$id_domanda$ and rp.id_modello_test_vr = $id_modello_test_vr$;",
            "type": "postProcessing"
        },
        {
            "operation": "delete",
            "queryString": "select entrasp.domanda_delete($codice_azienda$, $id_modello_test$, $id_modello_test_vr$, $id_domanda$)",
            "type": "main"
        }
    ],
