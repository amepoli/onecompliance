  "predefinedQueries": [
    {
      "operation": "selectForm",
      "type": "main",
      "queryString": "SELECT codice_part,codice_azienda,codice,codice_rischio,titolo,id_centro_gest, id_centro_gest_liv2, coalesce(intensita_singola_post_rilevata,0) as intensita_singola_post_rilevata,flag_modalita_valutazione_rischi_avanzata,vulnerabilita,descrizione,id_centro_gest,probabilita_pre,entrasp.cpl_soglie_descrizione(codice_azienda,'P', coalesce(probabilita_pre,0)) AS probabilita_pre_descrizione,intensita_singola_pre,entrasp.cpl_soglie_descrizione(codice_azienda,'I', coalesce(intensita_singola_pre,0)) AS intensita_pre_descrizione,intensita_totale_pre,entrasp.cpl_soglie_descrizione(codice_azienda,'T',coalesce(intensita_totale_pre,0)) AS intensita_totale_pre_descrizione,coalesce(probabilita_post,0) as probabilita_post,entrasp.cpl_soglie_descrizione(codice_azienda,'P', coalesce(probabilita_post,0)) AS probabilita_post_descrizione, coalesce(intensita_singola_post,0) as intensita_singola_post,entrasp.cpl_soglie_descrizione(codice_azienda,'I', coalesce(intensita_singola_post,0)) AS impatto_post_descrizione,coalesce(intensita_totale_post,0) as intensita_totale_post,coalesce(probabilita_post_rilevata,0) as probabilita_post_rilevata,entrasp.cpl_soglie_descrizione(codice_azienda,'P', coalesce(probabilita_post_rilevata,0)) AS probabilita_rett_descrizione,coalesce(intensita_singola_post_rilevata,0) as intensita_singola_post_rilevata,entrasp.cpl_soglie_descrizione(codice_azienda,'I', coalesce(intensita_singola_post_rilevata)) AS intensita_singola_post_rett_descrizione,coalesce(intensita_totale_pre,0) as intensita_totale_pre FROM entrasp.rischi WHERE codice_azienda=$codice_azienda$ AND codice_rischio=$codice_rischio$;"
    },
    {
      "operation": "insert",
      "type": "postProcessing",
      "queryString": "update entrasp.rischi set codice_part='£global_codice_part£' WHERE codice_azienda=$codice_azienda$ AND codice_rischio=$codice_rischio$;"
    },
    {
      "operation": "delete",
      "type": "main",
      "queryString": "SELECT entrasp.rischi_delete($codice_azienda$, $codice_rischio$);"
    }
  ],
