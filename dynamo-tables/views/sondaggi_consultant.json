    "search_keys": [
        {
            "fieldName": "id_modello_test",
            "format": {
                "comboQuery": "SELECT id_modello_test AS id, id_modello_test||' - '||titolo AS name  FROM entrasp.modelli_test WHERE codice_azienda='€global_codice_azienda€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Id Modello di Verifica",
            "newLine": false,
