            },
            "label": "Tipo modello test",
            "newLine": false,
            "queryCond": "mt.id_tipo_modello_test=$id_tipo_modello_test$"
        },
        {
            "fieldName": "id_sondaggio",
            "format": {
                "dataType": "number",
                "viewType": "input"
            },
            "label": "ID Sondaggio",
