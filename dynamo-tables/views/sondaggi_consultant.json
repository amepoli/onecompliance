{
    "$schema": "../views.schema.json",
    "inheritsFrom": "sondaggi",
    "businessObjectName": "sondaggi",
    "entryKey": "sondaggi_consultant",
    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select snd.*,entrasp.giudizio_scadenza(snd.data_prevista, snd.stato) as scaduto, snd2.id_sondaggio as id_sondaggio_successivo, snd.id_modello_test||'-'||snd.id_modello_test_vr as id_e_vr, entrasp.anagrafiche_cognnome(snd.codice_part, snd.id_anagrafica_assegnataria) as id_anagrafica_assegnataria, entrasp.centri_gestionali_descr(snd.codice_part,snd.id_centro_gest) as centro_gest, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da_manuale, snd.codice_azienda) as giudizio_manuale, entrasp.modelli_test_risultati_righe_descr(mvr.id_risultato, snd.pct_da, snd.codice_azienda) as giudizio, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI', snd.stato) as descr_stato, mt.titolo as modello_test from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr inner join entrasp.modelli_test mt on snd.codice_azienda=mt.codice_azienda and snd.id_modello_test=mt.id_modello_test left join entrasp.sondaggi snd2 on snd.codice_azienda=snd2.codice_azienda and snd.id_sondaggio=snd2.id_sondaggio_succ inner join entrasp.centri_gestionali cg on snd.codice_part=cg.codice_part and snd.id_centro_gest=cg.id_centro_gest inner join entrasp.gruppi_lavoro_membri glm on cg.id_gruppo_lavoro=glm.id_gruppo_lavoro and cg.codice_part=glm.codice_part inner join entrasp.anagrafiche_id an on glm.id_anagrafica=an.id_anagrafica and glm.codice_part=an.codice_part where dynamo_user='€global_username€' and snd.codice_azienda not in ('DEMO', 'TEST') and snd.codice_azienda in(€global_user_companies€)"
        },
        {
            "operation": "selectForm",
            "type": "preProcessing",
            "queryString": "select entrasp.aggiorna_sondaggi_pre_loading($codice_azienda$, $id_sondaggio$);"
        },
        {
            "operation": "selectForm",
            "type": "main",
            "queryString": "select snd.*, mvr.id_risultato, mvr.flag_no_domande, entrasp. id_sondaggio_rif(snd.codice_azienda, snd.id_sondaggio)  as id_sondaggio_rif, entrasp.mdt_codtitolo(snd.codice_azienda, snd.id_modello_test) as descr_modello_test, (select id_fase from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$ limit 1) as id_fase_orig, (select id_progetto from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$ limit 1) as id_progetto, entrasp.sondaggi_flags_sezioni_appsingola(snd.codice_azienda, snd.id_sondaggio) as flags_sezioni_multi, entrasp.sezioni_domande_activate(snd.codice_azienda, snd.id_sondaggio) as flags_sezioni_activate, entrasp.descrizione_risultato_from_sondaggio(snd.codice_azienda, snd.id_sondaggio) as criterio_analisi from entrasp.sondaggi snd inner join entrasp.modelli_test_vr mvr on snd.codice_azienda=mvr.codice_azienda and snd.id_modello_test=mvr.id_modello_test and snd.id_modello_test_vr=mvr.id_modello_test_vr where snd.codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        },
        {
            "operation": "selectForm",
            "type": "postProcessing",
            "queryString": "select  id_somministrazione from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$ limit 1"
        },
        {
            "operation": "insert",
            "type": "postProcessing",
            "queryString": "update entrasp.sondaggi set pct_da=(select pct_da from entrasp.grc_punteggi_giudizi_finali_per_sondaggio($codice_azienda$, $id_sondaggio$)) where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$;"
        },
        {
            "operation": "update",
            "type": "postProcessing",
            "queryString": "update entrasp.progetti_fasi set stato=$stato$ where codice_azienda=$codice_azienda$ and id_sondaggio=$id_sondaggio$"
        },
        {
            "operation": "delete",
            "type": "main",
            "queryString": "select entrasp.sondaggio_delete($codice_azienda$, $id_sondaggio$)"
        },
        {
            "operation": "stopEvent",
            "type": "main",
            "queryString": "select entrasp.time_report_stop((€global_id_anagrafiche€)::text);"
        },
        {
            "operation": "startEvent",
            "type": "main",
            "queryString": "select entrasp.business_object_play((€global_id_anagrafiche€)::text, 'sondaggi', $id_sondaggio$, '$codice_azienda$'::varchar) as play_time_report"
        }
    ],
