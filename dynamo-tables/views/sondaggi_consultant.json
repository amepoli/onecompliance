            "newLine": false,
            "queryCond": "snd.data_esecuzione>='€data_esec_min€'"
        },
        {
            "fieldName": "data_esec_max",
            "format": {
                "dataType": "date",
                "viewType": "input"
            },
            "label": "Data Esecuzione entro il",
            "translate": "RESOURCES.execution_date_by",
            "newLine": true,
            "queryCond": "snd.data_esecuzione<='€data_esec_max€'"
        },
        {
            "fieldName": "id_centro_gest",
            "format": {
                "comboQuery": "SELECT id_centro_gest AS id, descrizione AS name  FROM entrasp.centri_gestionali WHERE codice_part='€global_codice_part€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Centro Gestionale",
            "translate": "RESOURCES.office",
            "newLine": false,
            "queryCond": "snd.id_centro_gest=$id_centro_gest$"
        },
        {
            "fieldName": "id_progetto_s",
            "format": {
                "comboQuery": "SELECT id_progetto AS id, id_progetto||'-'||titolo AS name  FROM entrasp.progetti WHERE codice_azienda='€global_codice_azienda€';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Id Progetto",
            "translate": "RESOURCES.Project_ID",
            "newLine": false,
            "queryCond": "snd.id_sondaggio in(select id_sondaggio from entrasp.progetti_fasi pf where pf.id_progetto=$id_progetto_s$ and pf.codice_azienda='€global_codice_azienda€' and pf.id_sondaggio is not null)"
        },
        {
            "fieldName": "stato",
            "format": {
                "comboQuery": "SELECT codice AS id, transcodifica AS name  FROM entrasp.transcodifiche WHERE tipo_dato='STATO_SONDAGGI';",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Stato",
            "translate": "RESOURCES.status",
            "newLine": false,
            "queryCond": "snd.stato='€stato€'"
        },
        {
            "fieldName": "completo",
            "format": {
                "comboQuery": "SELECT distinct sondaggio_completato AS id, sondaggio_completato AS name  FROM entrasp.sondaggi WHERE codice_azienda=$codice_azienda$;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Completezza",
            "newLine": false,
            "queryCond": "snd.sondaggio_completato='€completo€'"
        },
        {
            "fieldName": "object_description",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Campione Oggetto del Sondaggio",
            "newLine": false,
            "queryCond": "snd.id_sondaggio in(select id_sondaggio from entrasp.sondaggi_somministrati ss where UPPER(ss.object_description) like '%'||UPPER('€object_description€')||'%')"
        },
        {
            "fieldName": "no_progect_associated",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Non associati a progetto",
            "newLine": false,
            "size": 1,
            "queryCond": "id_sondaggio not in(select id_sondaggio from entrasp.progetti_fasi where codice_azienda=$codice_azienda$ and id_sondaggio is not null)"
        },
        {
            "fieldName": "no_somministrazione",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Senza somministrazione",
            "newLine": true,
            "size": 1,
            "queryCond": "id_sondaggio not in(select id_sondaggio from entrasp.sondaggi_somministrati where codice_azienda=$codice_azienda$)"
        },
        {
            "fieldName": "codice_azienda_s",
            "format": {
                "comboQuery": "SELECT codice_azienda AS id, codice_azienda AS name FROM entrasp.aziende;",
                "options": [],
                "viewType": "combobox"
            },
            "label": "Azienda",
            "newLine": false,
            "queryCond": "mt.codice_azienda='€codice_azienda_s€'"
        },
        {
            "fieldName": "parola_search",
            "format": {
                "dataType": "text",
                "viewType": "input"
            },
            "label": "Parola chiave",
            "translate": "RESOURCES.key_word",
            "newLine": true,
            "queryCond": "(upper(mt.titolo) like '%'||upper('€parola_search€')||'%' or upper(snd.descrizione) like '%'||upper('€parola_search€')||'%' or upper(snd.titolo) like '%'||upper('€parola_search€')||'%')"
        },
        {
            "fieldName": "flag_ultimo_modello_test",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Ultimo Modello Verifica",
            "translate": "RESOURCES.last_check_template",
            "newLine": false,
            "queryCond": "entrasp.is_max_modello_test(snd.codice_azienda, snd.id_sondaggio)"
        },
        {
            "fieldName": "flag_ultimo_modello_test_rett",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Ultimo Modello Verifica Rett.",
            "translate": "RESOURCES.last_rectified_check_template",
            "newLine": false,
            "queryCond": "entrasp.is_max_modello_test_rett(snd.codice_azienda, snd.id_sondaggio)"
        },
        {
            "fieldName": "flag_sondaggio_riprogrammato",
            "format": {
                "value": "0",
                "viewType": "checkbox"
            },
            "label": "Sondaggio riprogrammato",
            "newLine": false,
            "queryCond": "snd2.id_sondaggio is not null"
        },
        {
            "fieldName": "flag_sondaggi_scaduti",
            "format": {
                "value": "1",
                "viewType": "toggle"
            },
            "label": "Sondaggi aperti",
            "newLine": false,
            "queryCond": "snd.stato not in ('C', 'N', 'R')"
        },
        {
            "fieldName": "azienda_corrente",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Azienda corrente",
            "newLine": false,
            "queryCond": "snd.codice_azienda='€global_codice_azienda€'"
        },
        {
            "fieldName": "doc_completa",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Doc.completa",
            "translate": "RESOURCES.complete_documentation",
            "newLine": false,
            "queryCond": "entrasp.is_doc_completa_sondaggio(snd.codice_azienda, snd.id_sondaggio)=true"
        },
        {
            "fieldName": "doc_incompleta",
            "format": {
                "value": "0",
                "viewType": "toggle"
            },
            "label": "Doc.incompleta",
            "translate": "RESOURCES.incomplete_documentation",
            "newLine": false,
            "queryCond": "entrasp.is_doc_completa_sondaggio(snd.codice_azienda, snd.id_sondaggio)=false"
        },
        {
            "fieldName": "competenza_corrente",
            "format": {
                "value": "1",
                "viewType": "toggle"
            },
            "label": "Comp. Corrente",
            "translate": "RESOURCES.current_reference",
            "newLine": false,
            "queryCond": "(extract(year from snd.data_comp)>=extract(year from current_date) or snd.data_comp is null)"
        }
    ],
    "querySuffixes": {
        "tableViewSuffix": "order by snd.data_prevista"
    }
}