    {
      "operation": "selectTable",
      "queryString": "select INITCAP(csn.codice_azienda) as codice_azienda_s, case when csn.km_percorsi is not null then 'Sì' else 'No' end as is_trasferta, csn.date_time_begin, csn.id_argomento, entrasp.transcodifiche_transcodifica('STATO_SONDAGGI',csn.stato) as descr_stato,  csn.thread ,csn.date_time_end, csn.id_cons, csn.codice_compito, substring(entrasp.descrizione_consuntivazione(csn.codice_azienda, csn.id_cons), 1, 200) as titolo_compito, csn.codice_azienda, csn.data_intervento, csn.durata, csn.durata_ft, csn.codice_attivita, csn.id_progetto, csn.id_modello_test, csn.id_fase, csn.id_sondaggio, entrasp.anagrafiche_cognnome(csn.codice_part, csn.id_risorsa) as esecutore, substring(csn.note from 1 for 100) as note_restricted, (€global_id_anagrafiche€)::text as user_companies, entrasp.time_report_stop_active_cons(csn.codice_azienda, csn.id_cons), case when entrasp.time_report_stop_active_cons((€global_id_anagrafiche€)::text,csn.codice_azienda,csn.id_cons) then false else true end as time_report_play from entrasp.consuntivazioni csn inner join entrasp.aziende az on csn.codice_azienda=az.codice_azienda WHERE csn.codice_azienda in(€global_user_companies€) and entrasp.dynamo_user_from_id_an(csn.codice_part, csn.id_risorsa)='€global_username€'",
      "type": "main"
    },
    {
      "operation": "insert",
