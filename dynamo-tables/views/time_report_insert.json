      {
        "label": "Time report utente",
        "queryString": "select substring(entrasp.descrizione_consuntivazione(csn.codice_azienda, csn.id_cons), 1, 200), csn.codice_compito, csn.codice_azienda, csn.data_intervento, csn.durata, csn.durata_ft, csn.codice_attivita, csn.id_progetto, csn.id_modello_test, csn.id_fase, csn.id_sondaggio, entrasp.anagrafiche_cognnome(csn.codice_part, csn.id_risorsa) as esecutore from entrasp.consuntivazioni csn inner join entrasp.aziende az on csn.codice_azienda=az.codice_azienda WHERE csn.codice_azienda in(€global_user_companies€) and entrasp.idutente_from_aziende_utenti((€global_id_anagrafiche€)::text, az.codice_part)::numeric=csn.id_risorsa;"
      },
      {
        "label": "Trasferte utente",
        "queryString": "select csn.codice_azienda, csn.id_cons, csn.km_percorsi, csn.date_time_begin, csn.date_time_end, extract(year from csn.data_intervento) as anno, csn.data_intervento, csn.id_risorsa, csn.indirizzo_partenza, csn.indirizzo_arrivo, an.dynamo_user from entrasp.consuntivazioni csn inner join entrasp.anagrafiche_id an on csn.id_risorsa=an.id_anagrafica and csn.codice_part=an.codice_part where km_percorsi is not null"
      },
      {
        "label": "Compiti Utente",
        "queryString": "select cmp.codice_azienda,EXTRACT (year from coalesce(prg.data_competenza, current_date))||'-'||pf.titolo as compito, pf.titolo,EXTRACT (year from coalesce(prg.data_competenza, current_date)) as anno_compentenza, cmp.codice_azienda||'-'||EXTRACT (year from coalesce(prg.data_competenza, current_date))||'-'||pf.titolo as per_ricerca, cmp.codice_compito, prg.id_progetto, pf.id_fase  from entrasp.compiti cmp inner join entrasp.progetti_fasi pf on cmp.codice_azienda=pf.codice_azienda and cmp.id_fase=pf.id_fase inner join entrasp.progetti prg on pf.codice_azienda=prg.codice_azienda and pf.id_progetto=prg.id_progetto where entrasp.compito_belongs_user2('€global_username€', cmp.codice_compito, cmp.codice_azienda)=true and prg.stato='A'  order by codice_azienda ASC, EXTRACT (year from prg.data_competenza) DESC"
      }
    ]
  }
