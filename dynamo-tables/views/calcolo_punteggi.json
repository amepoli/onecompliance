    "predefinedQueries": [
        {
            "operation": "selectTable",
            "type": "main",
            "queryString": "select pr.codice_azienda,pr.id_sondaggio,pr.id_somministrazione,pr.pct_da,pr.id_sezione, pr.descrizione,pr.flag_non_applicabile_sezione,pr.flag_non_applicabile_domanda,pr.flag_non_applicabile_risposta,pr.base,count(pr.id_domanda) as conta_domande,round(pr2.punt_limite*pct_limite/100, 2) as punteggio_risposte_limit, round(pr2.punt_limite*pr.pct_limite_floor/100, 2) as punteggio_risposte_floor, sum(pr.punteggio_risposta) as punteggio_risposte,round(sum(pr.punteggio_risposta)*base^count(pr.id_domanda),2) as punteggio_risposte_penalizzato,entrasp.valore_intervallo( sum(pr.punteggio_risposta)*base^count(pr.id_domanda), pr2.punt_limite*pct_limite_floor/100, pr2.punt_limite*pct_limite/100) as punteggio_risposte_limitato, pr.pct_limite_floor, pr.pct_limite, sum(pr.punteggio) as punteggio_domande from entrasp.punteggi_domande_delle_risposte pr inner join (select id_sondaggio, id_somministrazione, codice_azienda, id_modello_test, id_modello_test_vr, sum(punteggio) as punt_limite from entrasp.punteggi_domande_delle_risposte  group by id_sondaggio, id_somministrazione, codice_azienda, id_modello_test, id_modello_test_vr) pr2 on pr.codice_azienda=pr2.codice_azienda and pr.id_modello_test=pr2.id_modello_test and pr.id_modello_test_vr=pr2.id_modello_test_vr and pr.id_sondaggio=pr2.id_sondaggio and pr.id_somministrazione=pr2.id_somministrazione where pr.codice_azienda=$codice_azienda$ and pr.id_sondaggio=$id_sondaggio$ and pr.id_somministrazione=$id_somministrazione$ group by pr.codice_azienda,pr.id_sondaggio,pr.pct_limite, pr.pct_limite_floor, pr.num_criticita,pr.id_somministrazione,pr.descrizione,pr.pct_da,pr.flag_non_applicabile_sezione,pr.flag_non_applicabile_domanda,pr.flag_non_applicabile_risposta,pr.base,pr.id_modello_test,pr.id_modello_test_vr,pr2.punt_limite"
        }
    ],
