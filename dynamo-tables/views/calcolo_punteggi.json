      "queryString": "select pr.codice_azienda, pr.id_sondaggio, pr.id_somministrazione, pr.pct_da, pr.descrizione, pr.flag_non_applicabile_sezione, pr.flag_non_applicabile_domanda, pr.flag_non_applicabile_risposta, pr.base, count(pr.id_domanda) as conta_domande, round((sum(pr.punteggio_risposta)/count(pr.id_domanda))^pr.num_criticita*100/nullif(pct_target,0)*pct_limite, 2) as punteggio_risposte_limit, sum(pr.punteggio_risposta) as punteggio_risposte, round(sum(pr.punteggio_risposta)*base^count(pr.id_domanda),2) as punteggio_risposte_penalizzato, pr.pct_limite, sum(pr.punteggio) as punteggio_domande from entrasp.punteggi_domande_delle_risposte pr where pr.codice_azienda=$codice_azienda$ and pr.id_sondaggio=$id_sondaggio$ and pr.id_somministrazione=$id_somministrazione$ group by pr.codice_azienda, pr.id_sondaggio, pr.pct_limite, pct_target, pr.num_criticita, pr.id_somministrazione, pr.descrizione, pr.pct_da, pr.flag_non_applicabile_sezione, pr.flag_non_applicabile_domanda, pr.flag_non_applicabile_risposta, pr.base"
