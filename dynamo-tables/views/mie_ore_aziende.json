{
	"$schema": "../views.schema.json",
	"entryKey": "mie_ore_aziende",
	"businessObjectName": "aziende",
	"origin": "entrasp.aziende",
	"label": "Time report per azienda",
	"predefinedQueries": [
		{
			"operation": "selectForm",
			"queryString": "SELECT INITCAP(csn.codice_azienda) AS codice_azienda_s, csn.codice_azienda, csn.codice_part, ROUND(SUM(csn.durata)/480,2) as time_consumed FROM entrasp.consuntivazioni csn INNER JOIN entrasp.aziende az on csn.codice_azienda=az.codice_azienda where csn.codice_azienda=$codice_azienda$ and entrasp.dynamo_user_from_id_an(csn.codice_part, csn.id_risorsa)='€global_username€' GROUP BY csn.codice_azienda,csn.codice_part",
			"type": "main"
		},
		{
			"operation": "selectTable",
			"queryString": "SELECT INITCAP(csn.codice_azienda) AS codice_azienda_s, csn.codice_azienda, csn.codice_part, ROUND(SUM(csn.durata)/480,2) as time_consumed FROM entrasp.consuntivazioni csn INNER JOIN entrasp.aziende az on csn.codice_azienda=az.codice_azienda WHERE csn.codice_azienda in(€global_user_companies€) and entrasp.dynamo_user_from_id_an(csn.codice_part, csn.id_risorsa)='€global_username€' GROUP BY csn.codice_azienda,csn.codice_part HAVING sum(csn.durata) > 0",
			"type": "main"
		}
	],
