{
    "title": "DynamoDB Email Templates Entries",
    "type": "object",
    "required": [
        "templateKey"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "templateKey": {
            "type": "string",
            "description": "M: DynamoDB primary key (entry)"
        },
        "body": {
            "type": "string",
            "description": "M: Body of the email"
        },
        "company": {
            "type": "string",
            "description": "M: Company name"
        },
        "frequency": {
            "type": "string",
            "description": "M: Frequency to send email in days (currently doesn't work)"
        },
        "query": {
            "type": "string",
            "description": "?: Postgresql query"
        },
        "to": {
            "type": "string",
            "description": "?: Comma (,) separated list of recipients"
        }
    }
}