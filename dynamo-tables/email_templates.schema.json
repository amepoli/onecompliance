{
    "title": "DynamoDB Email Templates Entries",
    "type": "object",
    "required": [
        "templateKey"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "templateKey": {
            "type": "string",
            "description": "M: DynamoDB primary key (entry)"
        },
        "subject": {
            "type": "string",
            "description": "M: Subject of the email"
        },
        "body": {
            "type": "object",
            "description": "M: Body of the email",
            "properties": {
                "header": {
                    "type": "string",
                    "description": "M: Body header of the email"
                },
                "query": {
                    "type": "string",
                    "description": "M: Query for getting the body of the email"
                },
                "footer": {
                    "type": "string",
                    "description": "M: Body footer of the email"
                }
            }
        },
        "company": {
            "type": "string",
            "description": "M: Company name"
        },
        "conditionQuery": {
            "type": "string",
            "description": "M: Query to check whether to send email"
        },
        "to": {
            "type": "object",
            "description": "M: Comma (,) separated list of recipients",
            "properties": {
                "list": {
                    "type": "string",
                    "description": "?: constant list of receipients"
                },
                "query": {
                    "type": "string",
                    "description": "?: Query for getting list of receipients"
                }
            }
        },
        "cc": {
            "type": "object",
            "description": "M: Comma (,) separated list of CC recipients",
            "properties": {
                "list": {
                    "type": "string",
                    "description": "?: constant list of CC receipients"
                },
                "query": {
                    "type": "string",
                    "description": "?: Query for getting list of CC receipients"
                }
            }
        }
    }
}