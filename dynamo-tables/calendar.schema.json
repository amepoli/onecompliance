{
    "title": "Calendar description",
    "type": "object",
    "required": [
        "entryKey", "navigationObjects"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "entryKey": {
            "type": "string"
        },
        "navigationAction": {
            "type": "object",
            "description": "M: Action to perform on the different event",
            "required": [
                "objectName",
                "viewType",
                "keymap"
            ],
            "additionalProperties": false,
            "properties": {
                "objectName": {
                    "type": "string",
                    "description": "M: Object name returned from the query (target of navigation)"
                },
                "viewType": {
                    "type": "string",
                    "description": "M: View Type",
                    "enum": [
                        "form",
                        "table"
                    ]
                },
                "confirmAction": {
                    "type": "boolean",
                    "description": "?: Confirm before performing action"
                },
                "confirmMessage": {
                    "type": "object",
                    "description": "?: Action to perform if button",
                    "required": [
                        "title",
                        "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "title": {
                            "type": "string",
                            "description": "M: Confirmation message title"
                        },
                        "text": {
                            "type": "string",
                            "description": "M: Confirmation message text"
                        }
                    }
                },
                "keymap": {
                    "type": "array",
                    "description": "M: Keymap for mapping keys, depends on the fields returned from the query",
                    "items": {
                        "type": "object",
                        "required": [
                            "source",
                            "destination"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "source": {
                                "type": "object",
                                "description": "M: Source key (the value of the query)"
                            },
                            "destination": {
                                "type": "string",
                                "description": "M: Destination key"
                            }
                        }
                    }
                }
            }
        }
    }
}