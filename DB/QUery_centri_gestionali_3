/* FUNZIONE 1 */
CREATE OR REPLACE FUNCTION entrasp.descrcentrogest(
    codicepart text,
    idcg numeric)
  RETURNS text AS
$BODY$
SELECT 
descrizione
FROM 
  entrasp.centri_gestionali

WHERE 
  codice_part=$1 AND
  id_centro_gest=$2
$BODY$
  LANGUAGE sql VOLATILE
  COST 100;
ALTER FUNCTION entrasp.descrcentrogest(text, numeric)
  OWNER TO postgres;


/* FUNZIONE 2 */
CREATE OR REPLACE FUNCTION entrasp.codcognnomeanag(
    codicepart text,
    idanagrafica numeric)
  RETURNS text AS
$BODY$
SELECT 
codice || ' - ' || cognome || ' ' || nome  
FROM 
  entrasp.anagrafiche_id

WHERE 
  codice_part=$1 AND
  id_anagrafica=$2
$BODY$
  LANGUAGE sql VOLATILE
  COST 100;
ALTER FUNCTION entrasp.codcognnomeanag(text, numeric)
  OWNER TO postgres;
  
  
/* QUERY */

SELECT cg.id_centro_gest, CG.codice, CG.descrizione, 
entrasp.CodCognNomeAnag('DEMO',cg.id_responsabile) as responsabile,
cg.ute_ref,
entrasp.DescrCentroGest('DEMO',cg.id_centro_gest_parent) as parente
FROM entrasp.centri_gestionali CG WHERE cg.codice_part='DEMO';